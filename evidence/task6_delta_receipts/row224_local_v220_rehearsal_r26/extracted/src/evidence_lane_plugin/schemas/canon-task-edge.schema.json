{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lane.local/schemas/canon-task-edge.v1.json",
  "title": "Evidence Lane Canon Task Edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "edge_id",
    "edge_sha256",
    "source",
    "destination",
    "direction",
    "contract_sha256",
    "schema_sha256",
    "edge_revision",
    "permitted_actions",
    "dependency_ids",
    "expected_return_contract_sha256",
    "independent_hil_owner_task_uuid",
    "task_mode",
    "scope_class",
    "permitted_paths",
    "permitted_tools",
    "one_writer",
    "subagent_hil_allowed",
    "approval_propagation_allowed",
    "pointer_propagation_allowed",
    "source_write_authority_granted",
    "source_write_authority_source",
    "host_write_authorization_sha256",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema": { "const": "evidence-lane.canon-task-edge.v1" },
    "edge_id": { "type": "string", "minLength": 1 },
    "edge_sha256": { "$ref": "canon-envelope.schema.json#/$defs/sha256" },
    "source": { "$ref": "canon-envelope.schema.json#/$defs/endpoint" },
    "destination": { "$ref": "canon-envelope.schema.json#/$defs/endpoint" },
    "direction": { "enum": ["UPSTREAM", "DOWNSTREAM", "LATERAL"] },
    "contract_sha256": { "$ref": "canon-envelope.schema.json#/$defs/sha256" },
    "schema_sha256": { "$ref": "canon-envelope.schema.json#/$defs/sha256" },
    "edge_revision": { "type": "integer", "minimum": 1 },
    "permitted_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "dependency_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "expected_return_contract_sha256": { "$ref": "canon-envelope.schema.json#/$defs/sha256" },
    "independent_hil_owner_task_uuid": { "type": "string", "minLength": 1 },
    "task_mode": { "enum": ["TOP_LEVEL_TASK", "SUBAGENT"] },
    "scope_class": { "enum": ["READ_ONLY", "GOVERNED_READ_WRITE"] },
    "permitted_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "permitted_tools": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "one_writer": { "const": true },
    "subagent_hil_allowed": { "const": false },
    "approval_propagation_allowed": { "const": false },
    "pointer_propagation_allowed": { "const": false },
    "source_write_authority_granted": { "const": false },
    "source_write_authority_source": { "enum": ["NONE", "HOST_TASK_CONTRACT"] },
    "host_write_authorization_sha256": {
      "oneOf": [
        { "$ref": "canon-envelope.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
