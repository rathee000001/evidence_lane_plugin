{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lane.local/schemas/canon-expected-contract.v1.json",
  "title": "Evidence Lane Expected Canon Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_id",
    "contract_version",
    "contract_sha256",
    "active",
    "destination",
    "source_allowlist",
    "accepted_source_pointers",
    "schema_id",
    "schema_version",
    "schema_sha256",
    "canon_types",
    "authority_requested",
    "permitted_payload_keys",
    "permitted_actions",
    "expected_return_contract_sha256",
    "independent_hil_owner_task_uuid",
    "expires_at"
  ],
  "properties": {
    "schema": { "const": "evidence-lane.canon-expected-contract.v1" },
    "contract_id": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "integer", "minimum": 1 },
    "contract_sha256": { "$ref": "canon-envelope.schema.json#/$defs/sha256" },
    "active": { "type": "boolean" },
    "destination": { "$ref": "canon-envelope.schema.json#/$defs/endpoint" },
    "source_allowlist": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "canon-envelope.schema.json#/$defs/endpoint" }
    },
    "accepted_source_pointers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "canon-envelope.schema.json#/$defs/sourcePointer" }
    },
    "schema_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "schema_sha256": { "$ref": "canon-envelope.schema.json#/$defs/sha256" },
    "canon_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authority_requested": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "BOUNDED_INPUT",
          "CORRECTION_PROPOSAL",
          "EVIDENCE_RESPONSE",
          "PLAN_STEER",
          "TASK_RESULT"
        ]
      }
    },
    "permitted_payload_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "permitted_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_return_contract_sha256": {
      "oneOf": [
        { "$ref": "canon-envelope.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "independent_hil_owner_task_uuid": { "type": "string", "minLength": 1 },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
