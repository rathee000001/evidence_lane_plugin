{
  "schema": "evidence-lane.codex-hook-event-isolation-policy.v1",
  "version": 1,
  "upstream_contract": {
    "authority": "OPENAI_CODEX_REPOSITORY_GENERATED_HOOK_SCHEMAS",
    "repository_path": "codex-rs/hooks/schema/generated",
    "verified_at": "2026-08-15",
    "upstream_event_count": 11,
    "governed_event_count": 8,
    "unsupported_events_not_relabelled": [
      "PermissionRequest",
      "SubagentStart",
      "SubagentStop"
    ]
  },
  "events": [
    {
      "event_name": "SessionStart",
      "scope": "THREAD",
      "input_schema": "session-start.command.input.schema.json",
      "output_schema": "session-start.command.output.schema.json"
    },
    {
      "event_name": "UserPromptSubmit",
      "scope": "TURN",
      "input_schema": "user-prompt-submit.command.input.schema.json",
      "output_schema": "user-prompt-submit.command.output.schema.json"
    },
    {
      "event_name": "PreToolUse",
      "scope": "TURN",
      "input_schema": "pre-tool-use.command.input.schema.json",
      "output_schema": "pre-tool-use.command.output.schema.json"
    },
    {
      "event_name": "PostToolUse",
      "scope": "TURN",
      "input_schema": "post-tool-use.command.input.schema.json",
      "output_schema": "post-tool-use.command.output.schema.json"
    },
    {
      "event_name": "PreCompact",
      "scope": "TURN",
      "input_schema": "pre-compact.command.input.schema.json",
      "output_schema": "pre-compact.command.output.schema.json"
    },
    {
      "event_name": "PostCompact",
      "scope": "TURN",
      "input_schema": "post-compact.command.input.schema.json",
      "output_schema": "post-compact.command.output.schema.json"
    },
    {
      "event_name": "Stop",
      "scope": "TURN",
      "input_schema": "stop.command.input.schema.json",
      "output_schema": "stop.command.output.schema.json",
      "project_output_profile": "EXACT_EMPTY_OBJECT_STRICT_SUBSET",
      "host_schema_allows_control_fields": true,
      "evidence_lane_control_fields_allowed": false
    },
    {
      "event_name": "SessionEnd",
      "scope": "THREAD",
      "input_schema": "session-end.command.input.schema.json",
      "output_schema": "HOST_IGNORED_EMPTY_OBJECT",
      "host_timeout_seconds": 3,
      "internal_handler_timeout_seconds": 2
    }
  ],
  "input": {
    "max_bytes": 1048576,
    "additional_properties_allowed": false,
    "raw_payload_persisted": false,
    "payload_sha256_persisted": true
  },
  "output": {
    "max_bytes": 32768,
    "json_object_required": true,
    "event_specific_schema_required": true,
    "raw_stderr_persisted": false
  },
  "correlation": {
    "algorithm": "SHA256",
    "owner_fields": ["session_id", "cwd"],
    "occurrence_fields": [
      "event_name",
      "session_id",
      "turn_id",
      "tool_use_id",
      "source",
      "trigger",
      "reason"
    ],
    "stop_hook_active_is_occurrence_identity": false
  },
  "stop_contract": {
    "authority": "OPENAI_CODEX_GENERATED_STOP_WIRE_PLUS_STRICT_EVIDENCE_LANE_SUBSET",
    "official_input_schema": "stop.command.input.schema.json",
    "official_output_schema": "stop.command.output.schema.json",
    "official_output_control_fields_permitted": [
      "continue",
      "decision",
      "reason",
      "stopReason",
      "suppressOutput",
      "systemMessage"
    ],
    "evidence_lane_exact_output": {},
    "evidence_lane_control_fields_emitted": false,
    "continuation_requested": false,
    "first_delivery_stop_hook_active": false,
    "replay_delivery_stop_hook_active": true,
    "replay_identity_ignored_fields": ["stop_hook_active"],
    "first_and_replay_share_occurrence": true,
    "first_and_replay_output_identical": true,
    "handler": "stop_response.py",
    "python_launcher": "invoke_hook.py",
    "windows_launcher": "EvidenceLaneHookHost.exe",
    "windows_powershell_bridge": "invoke_hook.ps1",
    "windows_child_create_no_window": true
  },
  "exactly_once": {
    "store": "SQLITE",
    "claim_state": "IN_PROGRESS",
    "terminal_states": ["COMPLETE", "FAIL_CLOSED"],
    "completed_output_replayed": true,
    "in_progress_reentry_denied": true
  },
  "reentrancy": {
    "lock_scope": "EXACT_OWNER",
    "cross_process_os_file_lock": true,
    "lock_is_released_on_process_exit": true
  },
  "behavior_handoff": {
    "schema": "evidence-lane.codex-hook-behavior-handoff.v1",
    "issue_timing": "AFTER_EXACT_SKILL_CONSUMER_RETURNS",
    "consume_timing": "BEFORE_HANDLER_OUTPUT",
    "skill_consumer_module": "evidence_lane_plugin.hook_skill_runtime",
    "skill_consumer_source": "PLUGIN_ROOT/src/evidence_lane_plugin/hook_skill_runtime.py",
    "consumer_module_function_path_and_sha256_required": true,
    "transport_receipt_sha256_required": true,
    "event_isolation_correlation_bound_when_present": true,
    "partial_event_isolation_binding": "FAIL_CLOSED",
    "hook_behavior_executed": false,
    "skill_action_executed": true,
    "skill_result_success_inferred": false,
    "session_end_durable_skill_handoff_claimed": false
  },
  "host_memory_boundary": {
    "official_documentation": "https://learn.chatgpt.com/docs/customization/memories",
    "authority": "NONAUTHORITATIVE_HELPFUL_RECALL_ONLY",
    "automatic_import": false,
    "hook_import": false,
    "explicit_provenance_receipt_required": true,
    "raw_host_memory_stored": false,
    "learning_candidate_creation": "SEPARATE_EXPLICIT_ACTION_REQUIRED",
    "learning_hil_invocation": "SEPARATE_EXPLICIT_ACTION_REQUIRED",
    "project_hil_invocation": "FORBIDDEN"
  },
  "kill_switch": {
    "scope": "ALL_EVIDENCE_LANE_HOOK_EVENTS_FOR_ONE_INSTALLATION",
    "persistent_self_sealed_receipt_required": true,
    "missing_receipt_state": "FAIL_CLOSED",
    "active_state": "HOOK_EXECUTION_DISABLED",
    "inactive_state": "HOOK_EXECUTION_ELIGIBLE",
    "install_activation_must_bind_exact_receipt_path_and_sha256": true
  },
  "causation": {
    "restart_count_is_causation_proof": false,
    "only_correlated_event_receipts_are_hook_execution_proof": true
  }
}
