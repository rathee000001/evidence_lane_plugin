{
  "schema": "evidence-lane.cross-project-query-contract.v1",
  "contract_version": 1,
  "scope": "EXPLICIT_PROJECT_SET_EXACT_IMMUTABLE_PVS",
  "default_behavior": {
    "single_project_isolation_preserved": true,
    "implicit_project_discovery": false,
    "cross_project_fallback": false,
    "permission_provider_required": true
  },
  "project_set": {
    "minimum_projects": 2,
    "maximum_projects": 4,
    "canonical_and_unique": true,
    "exact_pv_ref_required": true,
    "candidate_pv_allowed": false
  },
  "permission_grant": {
    "schema": "evidence-lane.cross-project-read-grant.v1",
    "provider_injected": true,
    "scope": "READ_IMMUTABLE_PV",
    "sealed_by": "SHA256_CANONICAL_JSON_WITHOUT_GRANT_SHA256",
    "binds": [
      "principal_id",
      "project_id",
      "pv_ref",
      "scope",
      "grant_id"
    ],
    "secret_values_persisted": false
  },
  "ranking": {
    "mode": "SEPARATE_PROJECT_AGGREGATE_RANK_DOMAINS",
    "cross_project_score_emitted": false,
    "raw_retrieval_scores_compared_between_projects": false,
    "result_order": "PROJECT_INPUT_INDEX_THEN_PROJECT_SOURCE_ORDER"
  },
  "budgets": {
    "default_project_workers": 2,
    "maximum_project_workers": 2,
    "default_project_timeout_ms": 30000,
    "maximum_project_timeout_ms": 120000,
    "maximum_lane_queries_per_project": 8,
    "maximum_lane_workers_per_project": 4,
    "maximum_results_per_project": 200,
    "project_result_budget_rule": "SELECTED_PROJECT_LIMIT_MUST_COVER_SUM_OF_EXPLICIT_LANE_QUERY_LIMITS",
    "default_overall_results": 200,
    "maximum_overall_results": 400,
    "overall_result_budget_rule": "SELECTED_OVERALL_LIMIT_MUST_COVER_SUM_OF_EXPLICIT_PROJECT_LIMITS"
  },
  "authority_provenance": [
    "project_id",
    "pv_ref",
    "bundle_sha256",
    "pointer.accepted_pv",
    "pointer.accepted_manifest_sha256",
    "pointer.generation",
    "permission_grant_sha256",
    "canonical_lane_id",
    "ref_id",
    "path",
    "locator",
    "source_sha256",
    "chunk_sha256"
  ],
  "receipt": {
    "schema": "evidence-lane.cross-project-query-receipt.v1",
    "sealed_by": "SHA256_CANONICAL_JSON_WITHOUT_RECEIPT_SHA256",
    "binds": [
      "principal_id",
      "project_set",
      "ranking",
      "budgets",
      "project_receipts_sha256",
      "results_sha256"
    ],
    "persisted": false,
    "reason_not_persisted": "QUERY_ROUTE_IS_READ_ONLY"
  }
}
