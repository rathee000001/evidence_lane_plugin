    CHUNK_CAS [label="chunk_content_cas\nrows=2",fillcolor="#eaf8f1",color="#24805c"];
    CHUNK_INDEX -> CHUNK_CAS;
    CHUNK_HISTORY [label="chunk_history\nrows=2",fillcolor="#eaf8f1",color="#24805c"];
    CHUNK_CAS -> CHUNK_HISTORY;
    FTS [label="data_fts\nrows=2",fillcolor="#eaf8f1",color="#24805c"];
    CHUNK_HISTORY -> FTS;
    TFIDF [label="tfidf_vector\nrows=6",fillcolor="#eaf8f1",color="#24805c"];
    FTS -> TFIDF;
  }
  subgraph cluster_lifecycle { label="6. Refresh, pointer, and mutation evidence";
    REFRESH [label="refresh classification\nunchanged_reuse=0 | changed_rebuild=0 | new_register=2 | removed_tombstone=0 | blocked_unsupported=0 | changed_section_reused=0 | changed_section_reindexed=2",fillcolor="#fff1f0",color="#ba4236"];
    POINTER [label="lane pointer evidence\nentered_from=None | generation=0\nproposed=PV-PUBLIC-DUMMY-1",fillcolor="#fff1f0",color="#ba4236"];
    MUTATION [label="append-only change evidence\ntombstones=0 | mutations=0",fillcolor="#fff1f0",color="#ba4236"];
    TFIDF -> REFRESH;
    REFRESH -> POINTER;
    REFRESH -> MUTATION;
  }
  subgraph cluster_outputs { label="7. Inspectable lane package";
    SQLITE_OUT [label="data_excel_sector_v001.sqlite\nSQLite/FK/FTS authority",fillcolor="#f7f9fc",color="#667085"];
    MMD_OUT [label="data_excel.mmd\nsemantic Mermaid authority",fillcolor="#f7f9fc",color="#667085"];
    DOT_OUT [label="data_excel.dot\nsemantic DOT authority",fillcolor="#f7f9fc",color="#667085"];
    POINTER_OUT [label="lane_pointer.json\ncandidate pointer evidence",fillcolor="#f7f9fc",color="#667085"];
    RECEIPT_OUT [label="refresh_receipt.json\nclassification + validation",fillcolor="#f7f9fc",color="#667085"];
    POINTER -> SQLITE_OUT;
    SQLITE_OUT -> MMD_OUT;
    SQLITE_OUT -> DOT_OUT;
    SQLITE_OUT -> POINTER_OUT;
    SQLITE_OUT -> RECEIPT_OUT;
  }
}
