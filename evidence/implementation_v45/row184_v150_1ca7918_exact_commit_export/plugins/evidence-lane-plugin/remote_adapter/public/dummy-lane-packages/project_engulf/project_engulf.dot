    POINTER_OUT [label="lane_pointer.json\ncandidate pointer evidence",fillcolor="#f7f9fc",color="#667085"];
    RECEIPT_OUT [label="refresh_receipt.json\nclassification + validation",fillcolor="#f7f9fc",color="#667085"];
    POINTER -> SQLITE_OUT;
    SQLITE_OUT -> MMD_OUT;
    SQLITE_OUT -> DOT_OUT;
    SQLITE_OUT -> POINTER_OUT;
    SQLITE_OUT -> RECEIPT_OUT;
  }
}
