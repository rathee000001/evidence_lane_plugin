flowchart TD
  %% UEPC ENV12 CLEAN RUNPACK FULL TOPOLOGY
  %% Scope: ENV + UOP sector + unpopulated PROJECT template only.
  %% Excludes RIL and any populated project payload.

  START([User prompt enters chat display window]) --> ENTRY[ENTRY SLIP: read package pointers first]
  ENTRY --> DOTENV[.uepc_env / env HEAD]
  ENTRY --> DOTPROJECT[.uepc_project / project HEAD template]
  ENTRY --> DOTUOP[.uepc_profile / UOP PROFILE HEAD]

  subgraph ENV_HEAD[ENV HEAD / LOCKED GOVERNANCE ROOT]
    DOTENV --> ENVSQL[env/env_sqlite.sqlite]
    ENVSQL --> ENVROOT[env_governance_root_v12]
    ENVROOT --> LOCK[env_write_lock_policy / env core locked]
    LOCK --> FLASHQ{mode == flash_env?}
    FLASHQ -- Yes --> ENV_MUTATE[env_flash_approval_log_v11 / env mutation allowed only this run]
    FLASHQ -- No --> ENV_RO[READ ONLY env law/schema/MMD]
    ENVROOT --> ENVTRUST[env_trust_state_v11]
    ENVTRUST --> ROOTKEY[root_key_policy_v11 / public verification, private root key external]
    ROOTKEY --> SIG[env_signature_manifest_v11 / official seal]
    SIG --> TRUSTFAIL[OFFICIAL_SIGNATURE_FAILED / UNTRUSTED_FORK_MODE / PROJECT_DATA_SAFE]
    ENVROOT --> NOCI[no_autonomous_cicd_gate / human route control]
    ENVROOT --> SAFE[safe tamper response / read-only quarantine + recovery export]
  end

  subgraph SOURCE_INTAKE[SOURCE INTAKE + LOSSLESS CHUNKING]
    UPLOADS[Uploaded source files / zips / brains / docs / images] --> CLASS[source_classifier_registry_v12]
    CLASS --> TYPEQ{source type?}
    TYPEQ --> DOCS[DOCX/PDF/MD/TXT/HTML/JSON parse once]
    TYPEQ --> SHEETS[CSV/XLSX sheet/table/formula chunks]
    TYPEQ --> CODE[Raw code repo / .git / symbol/import/API chunks]
    TYPEQ --> SQLBRAIN[SQLite brain ZIP / schema + table import]
    TYPEQ --> IMAGE[Image/video metadata, OCR only if needed]
    TYPEQ --> ZIPROUTE[ZIP vertical route / nested package audit]
    DOCS --> RAWREG[artifact_raw_registry]
    SHEETS --> RAWREG
    CODE --> RAWREG
    SQLBRAIN --> RAWREG
    IMAGE --> RAWREG
    ZIPROUTE --> RAWREG
    RAWREG --> BYTE[artifact_byte_range_index]
    RAWREG --> PARSE[artifact_parse_event]
    PARSE --> CHUNK[artifact_chunk_index]
    CHUNK --> UINDEX[universal_index_registry]
    CHUNK --> FTS[source_chunk_fts / artifact_chunk_fts]
    RAWREG --> COVER[artifact_coverage_audit]
    COVER --> STATUS[REGISTERED / PARSED / CHUNKED / METADATA_ONLY / BLOCKED / REVIEW_REQUIRED]
  end

  subgraph AUTHORITY[AUTHORITY, PRECEDENCE, QUARANTINE]
    ENVROOT --> PRECEDENCE[source_precedence_matrix_v12]
    PRECEDENCE --> AUTHSTACK[sparse_active_source_stack / top source IDs only]
    AUTHSTACK --> ACTIVE[active_source_stack / lane-specific evidence pull]
    PRECEDENCE --> QUAR[source_instruction_quarantine_v12]
    QUAR --> PROMO{promoted by user as route law?}
    PROMO -- No --> EVIDENCE_ONLY[uploaded text is evidence only]
    PROMO -- Yes --> ROUTE_LAW[accepted delta / route law candidate]
    ROUTE_LAW --> DELTA[delta_ledger]
  end

  subgraph MODE_ROUTER[MODE + LANE ROUTER]
    ENVROOT --> MODENS[mode_namespace_registry]
    ENVROOT --> COMBO[combined_mode_namespace_rule]
    ENVROOT --> HINDEX[hierarchical_index_registry]
    MODENS --> D[D discussion]
    MODENS --> AL[AL analysis]
    MODENS --> PL[PL planning]
    MODENS --> CD[CD code]
    MODENS --> OP[OP output]
    MODENS --> VAL[VAL validation]
    MODENS --> RS[RS research]
    MODENS --> JD[JD job/JD]
    MODENS --> XL[XL Excel]
    MODENS --> PPT[PPT presentation]
    MODENS --> DOC[DOC document]
    MODENS --> PB[PB project brain builder]
    MODENS --> ENG[ENG project engulf]
    MODENS --> CE[CE clean exit]
    MODENS --> RCV[RCV recovery]
    MODENS --> X[X custom user-defined mode]
    CD --> CDREC[lane_recursive_policy: scan discussion -> planning -> code -> validation -> error/open deltas]
    XL --> XLREC[sheet/formula/pivot dependency lane]
    PPT --> PPTREC[slide/story/source-state lane]
    DOC --> DOCREC[section/render-QA lane]
    PB --> PBLANE[project_brain_builder_lane_v11]
  end

  subgraph PCM_MBA[PCM + MBA OPERATOR ENGINE / FIRED ONLY WHEN NEEDED]
    ENVROOT --> PCM[pcm_mba_operator]
    PCM --> MATH[Math: sets, relations, matrices, graph, indexing, hashes]
    PCM --> PHYS[Physics: state, entropy, continuity, signal/noise]
    PCM --> CHEM[Chemistry: redox, quarantine, irreversible fusion risk]
    PCM --> MBA[MBA/Ops: audit, risk, supply chain, rollback, human control]
    PCM --> FORMULA[formula_component / task formula receipt]
  end

  subgraph UOP_SECTOR[UOP GOVERNANCE SECTOR / MANDATORY BUT SEPARATE]
    DOTUOP --> UOPROOT[uop_governance_root_v12]
    UOPROOT --> UOPSLOT[UOP slot exists in clean env / no private payload in env core]
    UOPSLOT --> UOPPKG[uop/uop_sqlite.sqlite / clean governance sector]
    UOPPKG --> UOPSQL[uop/uop_sqlite.sqlite]
    UOPSQL --> UOPSRC[uop_source_registry / governance extraction only]
    UOPSQL --> UOPCHUNK[uop_spatial_operator + uop_knowledge_compression_operator]
    UOPSQL --> UOPPRIV[uop_privacy_boundary]
    UOPPRIV --> UOPRULE[UOP guides profile/operator context only]
    UOPRULE --> NOOVERRIDE[UOP cannot override env law or project truth]
    UOPSQL --> UOPMMD[UOP governance MMD / own topology]
    UOPROOT --> FLASHUOP{mode == flash_uop?}
    FLASHUOP -- Yes --> UOPUPDATE[scoped UOP update allowed]
    FLASHUOP -- No --> UOPLOCK[UOP sector locked/read-only]
  end

  subgraph PROJECT_TEMPLATE[UNPOPULATED PROJECT SECTOR / TEMPLATE ONLY]
    DOTPROJECT --> PROOT[project_growth_root_v12]
    PROOT --> PSECTION[project_section template / no project payload]
    PROOT --> PPACKET[project_packet_section template]
    PROOT --> PTURN[project_turn_packet template]
    PROOT --> PSRC[project source registry placeholder]
    PROOT --> PCHUNK[prompt_chunk / source_chunk / visible_reasoning_chunk / response_chunk]
    PROOT --> PART[artifact_registry + artifact_link_state]
    PROOT --> PCONSIST[project_pointer_consistency_check_v12]
    PCONSIST --> PASSQ{.uepc_project + project_section + packet + MMD agree?}
    PASSQ -- Yes --> PREADY[project template ready]
    PASSQ -- No --> PBLOCK[BLOCKED_POINTER_MISMATCH]
    PROOT --> PMMD[project_mmd_generation_event_v12]
    PMMD --> PMMDT[project topology MMD grows from project section]
    PMMDT --> PNGOPT[project PNG/SVG optional unless requested]
  end

  subgraph PB_BUILDER[PROJECT BRAIN BUILDER LANES / EMPTY UNTIL PROJECT ENGULF]
    PBLANE --> PB_CODE[PB_CODE_REPO: raw code + .git]
    PBLANE --> PB_SQL[PB_SQLITE_IMPORT: project brain sqlite]
    PBLANE --> PB_DOC[PB_DOC_CORPUS: reports/docs]
    PBLANE --> PB_CSV[PB_CSV_FACT: master fact CSV]
    PBLANE --> PB_MIXED[PB_MIXED_PROJECT_ZIP]
    PB_CODE --> FUTUREPROJECT[future project section population]
    PB_SQL --> FUTUREPROJECT
    PB_DOC --> FUTUREPROJECT
    PB_CSV --> FUTUREPROJECT
    PB_MIXED --> FUTUREPROJECT
    FUTUREPROJECT --> PMMD
  end

  subgraph TURN_WRITEBACK[PROMPT / RESPONSE / ARTIFACT WRITEBACK]
    START --> PTURNLOG[prompt_turn]
    PTURNLOG --> PCHUNKS[prompt_chunk indexed by mode namespace]
    ENTRY --> ERECEIPT[env_receipt ENTRY]
    MODE_ROUTER --> MODELOG[mode_classification_run + operator_activation_run]
    MODELOG --> GATERUN[gate_evaluation_run]
    GATERUN --> VREASON[visible_reasoning_chunk only / no hidden chain-of-thought]
    VREASON --> RESPONSE[response_chunk]
    RESPONSE --> GENART[generated_artifact_link_state]
    GENART --> ARTREG[artifact_registry / output_artifact]
    ARTREG --> WRITE[env_sqlite_write_receipt]
    WRITE --> STATEHASH[state_hash_chain]
  end

  subgraph ENV_MMD_EXIT[ENV MMD LOCK + CLEAN EXIT]
    ENVROOT --> ENVMMDLOCK[env_mmd_lock_state / env MMD changes only in flash_env]
    ENVMMDLOCK --> ENVMMD[env topology MMD generated after env SQLite migration]
    ENVMMD --> CHECKSUM[diagram_checksum_registry / MMD_STALE_WARN]
    STATEHASH --> EXIT[EXIT SLIP]
    EXIT --> MANIFEST[external hash manifest + artifact manifest + availability ledger]
    MANIFEST --> CLEANEXIT[clean_exit_protocol_v12]
    CLEANEXIT --> PACKAGE[one-upload continuation package]
    PACKAGE --> NEXT([Next prompt / next chat re-entry])
    CLEANEXIT --> RECOVERY[recovery_command_registry_v12]
  end

  ENVROOT --> SOURCE_INTAKE
  ENVROOT --> AUTHORITY
  ENVROOT --> MODE_ROUTER
  ENVROOT --> PCM_MBA
  ENVROOT --> UOP_SECTOR
  ENVROOT --> PROJECT_TEMPLATE
  PROJECT_TEMPLATE --> PB_BUILDER
  AUTHORITY --> MODE_ROUTER
  MODE_ROUTER --> TURN_WRITEBACK
  PROJECT_TEMPLATE --> TURN_WRITEBACK
  UOP_SECTOR --> TURN_WRITEBACK
  TURN_WRITEBACK --> ENV_MMD_EXIT


  subgraph ENV12_BREAKER[ENV12 INVALID-ANSWER BREAKER GATES]
    PREINDEX[Prompt indexed first] --> RAWCOVER[Raw artifact byte coverage]
    RAWCOVER --> INDEXGATE[No reasoning before index gate]
    INDEXGATE --> RELOCK1[RELOCK_GATE_FILE_NOT_INDEXED_BEFORE_REASONING]
    DOTENV --> CHATBLOCK[CHAT_WINDOW_LOOKUP_VIOLATION if package exists]
    DOTENV --> ENVCONT[ENV_CONTINUITY_DROP_DETECTED if any law drops]
    ENVMMDLOCK --> MMDREPACK[MMD_REPACK_NO_MUTATION_GATE]
  end
  ENVROOT --> ENV12_BREAKER

%% ENV14 SUPERSSEDE DELTAS ADDED WITHOUT TRUNCATING ENV12 BASE
  subgraph ENV14_AUTHORITY[ENV14 ROOT AUTHORITY + PROMPT OVERRIDE CONTROL]
    ENV14ROOT[env_governance_root_v14] --> E14AUTH[ROOT_AUTHORITY_LADDER]
    E14AUTH --> E14PROMPTBLOCK[PROMPT_CANNOT_OVERRIDE_ENV]
    E14PROMPTBLOCK --> E14LOCALDISPLAY[LOCAL_DISPLAY_ONLY_ALLOWED]
    E14LOCALDISPLAY --> E14TELEMETRY[VISIBLE_TELEMETRY_MINIMUM]
    E14TELEMETRY --> E14RELOCK[RELOCK_ON_PARTIAL_COMPLIANCE]
    E14PROMPTBLOCK --> E14NOEXCUSE[NO_NARRATIVE_EXCUSE_FOR_GATE_FAILURE]
    E14TELEMETRY --> E14VISDROP[VISIBLE_TELEMETRY_LAYER_DROPPED]
    E14PROMPTBLOCK --> E14DETECT[PROMPT_OVERRIDE_ATTEMPT_DETECTED]
    E14DETECT --> E14LEDGER[SUPERSEDE_LEDGER_REQUIRED]
    E14LEDGER --> E14FLASHREQ[FLASH_MODE_REQUIRED_FOR_MUTATION]
  end

  subgraph ENV14_DEEPRESEARCH[ENV14 DEEP RESEARCH ACCESS + AUDIT SIDECAR]
    E14DRROOT[deep_research_access_triage_v14] --> E14READLOCK[READ_LOCK_MUST_NOT_BLOCK_AUDIT]
    E14READLOCK --> E14WRITELOCK[WRITE_LOCK_IS_NOT_READ_LOCK]
    E14WRITELOCK --> E14NOPASS[PASSWORD_NEVER_REQUIRED_FOR_READ_ONLY_AUDIT]
    E14DRROOT --> E14SIDECAR[DEEP_RESEARCH_AUDIT_SIDECAR_REQUIRED]
    E14SIDECAR --> E14ZIPBLOCK[ZIP_BLOCKED_USE_HASHED_SIDECAR]
    E14ZIPBLOCK --> E14MIRROR[research/UEPC_ENV14_DEEPRESEARCH_AUDIT_MIRROR.md]
    E14MIRROR --> E14LINKAGE[research/SIDECAR_HASH_LINKAGE.json]
    E14DRROOT --> E14TRIAGE[research/DEEP_RESEARCH_ACCESS_TRIAGE.md]
  end

  subgraph ENV14_MMD_SVG[ENV14 MMD SOURCE + SVG RENDER LOCK]
    E14MMDROOT[locked_mmd_hash_registry_v14] --> E14ENVMMD[env/env_mmd.mmd full source]
    E14ENVMMD --> E14ENVSVG[env/env_mmd.svg exact render]
    E14MMDROOT --> E14UOPMMD[uop/uop_mmd.mmd full source]
    E14UOPMMD --> E14UOPSVG[uop/uop_mmd.svg exact render]
    E14MMDROOT --> E14PROJMMD[project/project_topology_template.mmd full source]
    E14PROJMMD --> E14PROJSVG[project/project_topology_template.svg exact render]
    E14MMDROOT --> E14NOSHRINK[MMD_SIZE_OR_NODE_DROP_FAIL_BUILD]
    E14NOSHRINK --> E14RENDERQA[validation/RENDER_QA_REPORT.md]
  end

  subgraph ENV14_PROJECT_EXPANSION[ENV14 PROJECT TEMPLATE EXPANSION CONTROL]
    E14PROJEXP[project_template_expansion_audit_v14] --> E14LEGACY[legacy unpopulated count 14]
    E14PROJEXP --> E14CURRENT[current framework count 41]
    E14CURRENT --> E14PAYLOADZERO[PROJECT_PAYLOAD_ROWS=0]
    E14PAYLOADZERO --> E14SUPERPASS[SUPERSEDED_PASS not population failure]
    E14SUPERPASS --> E14FOOTPRINT[manifests/PROJECT_TEMPLATE_FOOTPRINT_AUDIT.json]
  end

  subgraph ENV14_CLEAN_PACKAGE[ENV14 CLEAN PACKAGE / NO BASELINE ZIP COPY]
    E14PKGCLASS[PACKAGE_CLASS=CLEAN_ENV14_SUPERSEDE] --> E14NOBASE[NO baseline/ folder]
    E14NOBASE --> E14BASEHASH[manifests/BASELINE_HASH_REFERENCE.txt]
    E14BASEHASH --> E14DIFF[manifests/BASELINE_DIFF_MANIFEST.json]
    E14DIFF --> E14OBJ[manifests/BASELINE_OBJECT_COUNT_COMPARISON.json]
    E14PKGCLASS --> E14V10REF[V10 packaging discipline reference only]
    E14V10REF --> E14FINALZIP[UEPC_ENV14_CLEAN_SUPERSEDE_ONE_UPLOAD.zip]
  end

  ENVROOT --> ENV14_AUTHORITY
  ENVROOT --> ENV14_DEEPRESEARCH
  ENVROOT --> ENV14_MMD_SVG
  ENVROOT --> ENV14_PROJECT_EXPANSION
  ENVROOT --> ENV14_CLEAN_PACKAGE
  E14AUTH --> MODE_ROUTER
  E14SIDECAR --> MANIFEST
  E14PROJEXP --> PROJECT_TEMPLATE
  E14MMDROOT --> ENV_MMD_EXIT
  E14FINALZIP --> NEXT

%% ENV15 ADDITIVE DELTAS — ENV14 BASE ABOVE IS PRESERVED EXACTLY
  subgraph ENV15_IMMUTABLE_BASE[ENV15 IMMUTABLE BASE + MUTABLE OVERLAY]
    E15BASE[Env + UOP + project base open mode=ro&immutable=1] --> E15AUTOWRITE[chat_lineage is only automatic append-write lane]
    E15AUTOWRITE --> E15OTHER[all other 13 project sectors preserved read-only by default]
    E15OTHER --> E15GRANT[explicit user-named one-turn mutation grant]
    E15GRANT --> E15RELOCK[mutation receipt + immediate sector relock]
    E15BASE --> E15ROAUDIT[WRITEBACK_POLICY=DISABLED_READ_ONLY_AUDIT]
    E15ROAUDIT --> E15SKIP[WRITEBACK_SKIPPED_BY_USER_READ_ONLY_GATE]
  end

  subgraph ENV15_STATE_TRAVEL[ENV15 EXACT TURN STATE TRAVEL]
    E15PREP[PREPARE exact raw prompt + attachments + entry slip] --> E15PREPCOMMIT[commit PREPARED]
    E15PREPCOMMIT --> E15TASK[mode/lane/gate/operator execution]
    E15TASK --> E15VISIBLE[exact visible response + visible reasoning summary]
    E15VISIBLE --> E15COMMIT[COMMIT response + links + exit receipt]
    E15COMMIT --> E15CHAIN[previous/current state hash chain]
    E15CHAIN --> E15HEAD[canonical lineage_head]
    E15HEAD --> E15NEXT[next expected index]
    E15PREPCOMMIT --> E15FAIL[PREPARED_NOT_COMMITTED recovery state]
  end

  subgraph ENV15_LEGACY[ENV15 LEGACY PROJECT CARRY-FORWARD]
    E15SCAN[scan older Env .uepc_project active write sector] --> E15COPY[copy without mutating older package]
    E15COPY --> E15MIRROR[chat_lineage/legacy_project_carry_forward mirror]
    E15MIRROR --> E15LABEL[PROJECT_HISTORY_SOURCE / NOT_ENV_LAW / NOT_UOP_TRUTH]
  end

  subgraph ENV15_PROJECT_SECTORS[ENV15 ALL 14 UNIVERSAL PROJECT SECTORS]
    E15SECTORS[project_sector_registry_v15 / 14 sectors] --> E15CHAT[chat_lineage auto append]
    E15SECTORS --> E15GH[github_code]
    E15SECTORS --> E15LOCAL[local_code]
    E15SECTORS --> E15SQL[sqlite_brain]
    E15SECTORS --> E15DOCS[docs]
    E15SECTORS --> E15DATA[data_excel]
    E15SECTORS --> E15PDF[pdf_ocr]
    E15SECTORS --> E15PPT[ppt]
    E15SECTORS --> E15IMG[images_ocr]
    E15SECTORS --> E15ART[artifacts]
    E15SECTORS --> E15CUSTOM[custom schema-first]
    E15SECTORS --> E15LOADER[brain_loader]
    E15SECTORS --> E15RESEARCH[research]
    E15SECTORS --> E15ENGULF[project_engulf]
  end

  subgraph ENV15_CODE_INDEX[ENV15 CODE SNAPSHOT + GIT LINEAGE INDEX]
    E15CODESRC[GitHub / Local Code source] --> E15SNAP[Code Snapshot Layer]
    E15CODESRC --> E15GIT[Git Lineage Layer]
    E15SNAP --> E15FILE[file chunks]
    E15FILE --> E15SYMBOL[function/class/symbol]
    E15FILE --> E15IMPORT[import/dependency]
    E15FILE --> E15API[route/API boundary]
    E15FILE --> E15CONFIG[config/build/test]
    E15GIT --> E15COMMITS[commit/file-change/diff chunks]
    E15SNAP --> E15STRUCT[structured text artifacts]
    E15SNAP --> E15BINARY[binary/image/video/GLB metadata-only]
  end

  subgraph ENV15_RESEARCH_LEDGER[ENV15 CREDIT TOKEN ESTIMATE RESEARCH LEDGER]
    E15TOKENPOL[credit_token_estimate_policy_v15] --> E15TOKENMD[credit_token_estimate_comparison.md]
    E15TOKENMD --> E15FORMULA[naive vs SQLite token + iteration estimate formulas]
    E15FORMULA --> E15RQ[5 constant research questions per prompt]
    E15RQ --> E15PROF[professor-facing estimate with assumptions/confidence]
  end

  subgraph ENV15_RENDER_LOCK[ENV15 FULL MMD + SVG + PNG LOCK]
    E15MMDLAW[Env14 exact MMD base required] --> E15ADD[append Env15 delta only]
    E15ADD --> E15SVGP[render exact packaged MMD to SVG + PNG]
    E15SVGP --> E15PNGSTORE[PNG stored ZIP_STORED]
    E15MMDLAW --> E15NOSHRINK[MMD_BASE_TEXT_MISSING or shrink = FAIL]
  end

  subgraph ENV15_CODEX_HANDOFF[ENV15 CODEX PUBLIC SECTION HANDOFF]
    E15CODEXPKG[Env15 public package] --> E15CODEXPROMPT[Codex locked-section update handoff]
    E15CODEXPROMPT --> E15PATCH[patch Env/UOP/project + all sectors only]
    E15PATCH --> E15KEEPUI[preserve T020 visual/backend authority]
    E15PATCH --> E15TESTS[CI/CD tests + receipts + no unrelated changes]
  end

  ENVROOT --> ENV15_IMMUTABLE_BASE
  TURN_WRITEBACK --> ENV15_STATE_TRAVEL
  PROJECT_TEMPLATE --> ENV15_LEGACY
  PROJECT_TEMPLATE --> ENV15_PROJECT_SECTORS
  PB_BUILDER --> ENV15_CODE_INDEX
  TURN_WRITEBACK --> ENV15_RESEARCH_LEDGER
  ENV_MMD_EXIT --> ENV15_RENDER_LOCK
  ENV15_CLEAN_PACKAGE --> ENV15_CODEX_HANDOFF
  E15AUTOWRITE --> E15PREP
  E15MIRROR --> E15PREP
  E15CHAT --> E15PREP
  E15OTHER --> E15GRANT
  E15HEAD --> EXIT

