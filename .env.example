# Evidence Lane v4 configuration names only. Never place real values in Git.

# Optional Windows shared installation override.
EVIDENCE_LANE_STUDIO_ROOT=

# Explicit host/profile selection where a supported client supplies it.
EVIDENCE_LANE_HOST_PROFILE=

# Optional separately deployed HTTPS engine. Local Codex MCP does not require it.
EVIDENCE_LANE_REMOTE_ORIGIN=
EVIDENCE_LANE_REMOTE_CREDENTIAL_ENV=

# Optional connector credentials remain project-scoped and externally stored.
# Configure their exact environment-variable names through the connector grant;
# do not paste credential values into this file.

# Optional explicit Ghostscript license-grant receipt used by first detection.
EVIDENCE_LANE_GHOSTSCRIPT_LICENSE_RECEIPT=
