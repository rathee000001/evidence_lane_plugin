# Evidence Lane current-route refresh: 3.0.0 / 2026-08-23
# Optional local data root. Keep the actual path user-owned and durable.
EVIDENCE_LANE_DATA_ROOT=

# Required only for the separately authorized Google Drive persistence route.
EVIDENCE_LANE_GOOGLE_DRIVE_ACCESS_TOKEN=
EVIDENCE_LANE_GOOGLE_DRIVE_FOLDER_ID=
EVIDENCE_LANE_DRIVE_ENCRYPTION_KEY=

# Optional authentication for an explicitly deployed headless/API Streamable
# HTTP service. The Codex desktop plugin uses its package-local native MCP route
# and does not need these values for normal attachment. Keep real credentials in
# an approved secret manager, never in this file.
EVIDENCE_LANE_MCP_BEARER_TOKEN=
# Exact externally visible HTTPS resource origin for that headless/API service.
# The public Vercel documentation site is not an MCP adapter or authority route.
EVIDENCE_LANE_MCP_BASE_URL=

# Optional standards-based OAuth resource-server configuration for the same
# headless/API service. The issuer must support the service's MCP-compatible
# CIMD, DCR, or predefined-client contract.
# Use separate issuers/audiences/client IDs/data roots for staging and production.
# The base transport gate is read-only; tool policy adds write or remote-Git
# scopes and checks the exact environment, client, role, and project claims.
EVIDENCE_LANE_MCP_OAUTH_ISSUER_URL=
EVIDENCE_LANE_MCP_OAUTH_JWKS_URL=
# Must exactly equal the externally visible MCP resource URL, including /mcp.
# Example: https://mcp.evidencelane.org/mcp
EVIDENCE_LANE_MCP_OAUTH_AUDIENCE=
EVIDENCE_LANE_MCP_OAUTH_ENVIRONMENT=
# Comma-separated exact CIMD URLs, DCR client IDs, or predefined client IDs.
EVIDENCE_LANE_MCP_OAUTH_ALLOWED_CLIENT_IDS=
# Tokens may use only these app roles. Production lifecycle writes and every
# remote Git action require the owner role; tester writes are staging-only.
EVIDENCE_LANE_MCP_OAUTH_ALLOWED_ROLES=owner,tester
EVIDENCE_LANE_MCP_OAUTH_SCOPES=evidence-lane:read
EVIDENCE_LANE_MCP_OAUTH_ALGORITHMS=RS256

# The established IdP must issue exp, nbf, jti, iss, aud, sub, and client ID,
# plus these fixed application claims. Project values are exact IDs; only an
# owner token may use "*". These are claim contracts, never secret values.
# evidence_lane_environment = staging | production
# evidence_lane_roles = [owner] | [tester]
# evidence_lane_projects = [exact-project-id] | ["*"] for owner only

# This transport configuration is not the post-HIL tester entitlement or
# GitHub App distribution design. It grants no repository, install, candidate,
# pointer, publication, deployment, or HIL authority by itself.

# Optional Mermaid CLI executable. Rendering is derived; .mmd remains authority.
EVIDENCE_LANE_MERMAID_CLI=

# Optional browser override for Mermaid CLI. When omitted, Evidence Lane probes
# standard installed Chrome/Edge locations without downloading a browser.
PUPPETEER_EXECUTABLE_PATH=

# Never place an OpenAI API key in this file. The key exposed during the July 31
# intake must be revoked manually before any release or deployment.
