flowchart TD
    A["/ev selected"] --> A1["Verify installed release and exact ENV15/UOP15 flash"]
    A1 --> A2{"Authority exact?"}
    A2 -- "No" --> Z["FAIL closed: no source, PV, or pointer mutation"]
    A2 -- "Yes" --> A3["Verify required Google Drive host connector boundary"]
    A3 --> B{"Registered project selected?"}

    B -- "No" --> B1["Reveal /git and /local intake"]
    B1 --> B2["Register exact source and branch; no remote write"]
    B2 --> C
    B -- "Yes" --> C{"Persistent governed session active?"}
    C -- "Yes" --> C1["session_resume: bind host session and prompt index"]
    C -- "No" --> C2["session_boot: bind host, filesystem, and edit capabilities"]
    C1 --> D
    C2 --> D{"Accepted PV exists?"}

    D -- "No" --> E{"Preserved PV1 candidate pending?"}
    E -- "No" --> E1["Build full eighteen-lane PV1 candidate once"]
    E -- "Yes" --> H["Present pending six-way HIL"]
    E1 --> H

    D -- "Yes" --> F["Load accepted PVn directly as current session entry"]
    F --> G["Classify one bounded task; many may wait linearly"]
    G --> G1["Read or modify only authorized source"]
    G1 --> G2["Confirm exact final source boundary"]
    G2 --> G3["/pv-refresh: automatic internal entry/exit slips"]
    G3 --> G4["Reuse unchanged; rebuild changed/new; tombstone removed"]
    G4 --> H

    H --> I{"Exact human decision"}
    I -- "APPROVE via /pv-fuse" --> J["Byte-preserving promotion and CAS pointer advance"]
    J --> J1["Direct handoff: update entry PV, seals, freshness, and prompt boundary"]
    J1 --> F

    I -- "APPROVE_WITH_DELTA" --> K["Preserve candidate; exact correction pending"]
    K --> K1{"Accepted parent exists?"}
    K1 -- "Yes" --> G
    K1 -- "No" --> K2["Classify exact correction against preserved PV1 source"]
    K2 --> K3["Commit clean corrected source and Refresh as another PV1 candidate"]
    K3 --> H

    I -- "MORE_RESEARCH" --> L["Preserve candidate; exact research pending"]
    L --> G
    I -- "REJECT" --> M["Preserve candidate and rejection receipt"]
    I -- "FAIL" --> N["Preserve candidate and failed gate"]

    I -- "ROLLBACK [PVn | PROMPT n | TURN id]" --> R["Resolve immutable accepted target"]
    F --> R0["Idle rollback; bare target uses current prompt/session entry"]
    R0 --> R
    R --> R1{"Pointer CAS succeeds?"}
    R1 -- "No" --> Z
    R1 -- "Same target" --> R2["Record no-op; generation unchanged"]
    R1 -- "Moved" --> R3["Move pointer only; generation increments"]
    R2 --> R4["Preserve source, candidates, accepted history, and ordinals"]
    R3 --> R4
    R4 --> F

    M --> X{"Exact accepted source restored?"}
    N --> X
    X -- "Yes" --> F
    X -- "No" --> Y["Close or remain blocked; never infer accepted truth"]
