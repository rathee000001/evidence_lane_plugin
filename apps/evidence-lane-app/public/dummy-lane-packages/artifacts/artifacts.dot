    FACT_KIND_3 [label="json_structure\nrows=1" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FACT_SAMPLE_3_0 [label="$" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
