digraph lane_artifacts {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  LANE_ROOT [label="Artifacts\n1 sources | 1 chunks | 5 structured facts" color="#101828" fillcolor="#101828" fontcolor=white shape=box style="rounded,filled"]
  subgraph cluster_source_intake {
    label="1. Source intake and exact-byte registry" rankdir=TB
    SOURCE_REG [label="source_registry\nrows=1 | SHA-256 + parser state" color="#125cdd" fillcolor="#edf5ff" shape=box style="rounded,filled"]
    SOURCE_TYPE_0 [label=".json\n1 sources" color="#125cdd" fillcolor="#edf5ff" shape=box style="rounded,filled"]
  }
  subgraph cluster_semantic_model {
    label="2. Lane-specific semantic model from SQLite" rankdir=TB
