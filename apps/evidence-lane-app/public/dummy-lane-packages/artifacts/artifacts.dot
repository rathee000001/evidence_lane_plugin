    MMD_OUT [label="artifacts.mmd\nsemantic Mermaid authority" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    DOT_OUT [label="artifacts.dot\nsemantic DOT authority" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    POINTER_OUT [label="lane_pointer.json\ncandidate pointer evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    RECEIPT_OUT [label="refresh_receipt.json\nclassification + validation" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  }
