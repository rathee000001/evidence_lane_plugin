digraph env_operating_framework {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  ROOT [label="ENV: locked operating policy and current executable bindings" color="#101828" fillcolor="#101828" fontcolor=white shape=box style="rounded,filled"]
  subgraph cluster_group_env_host_compute {
    label="Host and compute" rankdir=TB
    DOMAIN_env_host_compute [label="Host and compute" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    TABLE_codex_host_variant_v4 [label="codex_host_variant_v4\n2 policy rows\nkey: host_id\ncolumns: host_id, host_profile, app_variant, application_id, lifetime, native_mcp, persistence_policy, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_accelerator_profile_v4 [label="env_accelerator_profile_v4\n4 policy rows\nkey: provider_id\ncolumns: provider_id, vendor_plugin, runtime, eligible_action_classes_json, default_memory_budget_percent, selection_rule, provider_is_tool, provider_is_agent, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_tool_registry_v4 [label="env_tool_registry_v4\n103 policy rows\nkey: tool_id\ncolumns: tool_id, requirement, surfaces_json, role, agent_authority, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_group_env_intent_workflow {
    label="Intent and workflow" rankdir=TB
    DOMAIN_env_intent_workflow [label="Intent and workflow" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    TABLE_env_mode_policy_v4 [label="env_mode_policy_v4\n16 policy rows\nkey: mode_id\ncolumns: mode_id, policy_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_work_policy_v4 [label="env_work_policy_v4\n16 policy rows\nkey: work_id\ncolumns: work_id, work_name, lane_templates_json, scan_order, unit_of_work, workflow_order, recursive_loop, validation_gate, exit_write_target, action_classes_json, ci_cd_required, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_project_class_policy_v4 [label="env_project_class_policy_v4\n7 policy rows\nkey: project_class\ncolumns: project_class, lane_ids_json, ci_strategy, decision_strategy, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_skill_binding_v4 [label="env_skill_binding_v4\n24 policy rows\nkey: skill_name\ncolumns: skill_name, description, workflow_json, member_count, routing_manifest_sha256, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_workflow_policy_v4 [label="env_workflow_policy_v4\n24 policy rows\nkey: workflow_id\ncolumns: workflow_id, skill_name, title, description, action_names_json, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_group_env_action_transport {
    label="Actions and transports" rankdir=TB
    DOMAIN_env_action_transport [label="Actions and transports" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    TABLE_env_action_binding_v4 [label="env_action_binding_v4\n295 policy rows\nkey: action_name\ncolumns: action_name, workflow_classes_json, owner_skill, internal_sdk_json, mcp_json, skill_workflows_json, entry_event, ordered_tools_json, schema_sha256, binding_sha256, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_operation_pipeline_v4 [label="env_operation_pipeline_v4\n408 policy rows\nkey: action_name, route_id\ncolumns: action_name, route_id, ordinal, pipeline_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_sdk_action_binding_v4 [label="env_sdk_action_binding_v4\n295 policy rows\nkey: action_name\ncolumns: action_name, internal_sdk_json, outer_route_json, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_mcp_action_binding_v4 [label="env_mcp_action_binding_v4\n295 policy rows\nkey: action_name\ncolumns: action_name, server_identity, tool_name, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_group_env_lane_source {
    label="Lanes and source classification" rankdir=TB
    DOMAIN_env_lane_source [label="Lanes and source classification" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    TABLE_env_lane_binding_v4 [label="env_lane_binding_v4\n22 policy rows\nkey: lane_id\ncolumns: lane_id, source_types_json, parser_id, chunker_version, fts_table, ordered_tools_json, binding_sha256, status, action_names_json, action_classes_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_source_lane_classification_v4 [label="env_source_lane_classification_v4\n22 policy rows\nkey: lane_id\ncolumns: lane_id, lane_kind, source_types_json, owner_folder, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_group_env_host_observation {
    label="Host projection and observation" rankdir=TB
    DOMAIN_env_host_observation [label="Host projection and observation" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    TABLE_env_hook_binding_v4 [label="env_hook_binding_v4\n12 policy rows\nkey: event_name\ncolumns: event_name, event_number, handler_count, event_path, event_sha256, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_plan_projection_binding_v4 [label="env_plan_projection_binding_v4\n1 policy rows\nkey: binding_id\ncolumns: binding_id, source_owner, destination, full_list, partial_window, write_order, collision_policy, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_studio_binding_v4 [label="env_studio_binding_v4\n1 policy rows\nkey: binding_id\ncolumns: binding_id, platform, human_access, source_owner, mutation_allowed, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_group_env_current_flow {
    label="Current Codex workflow schema" rankdir=TB
    DOMAIN_env_current_flow [label="Current Codex workflow schema" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    TABLE_env_codex_workflow_stage_v4 [label="env_codex_workflow_stage_v4\n13 policy rows\nkey: stage_id\ncolumns: stage_id, ordinal, label, source_owner, output_contract, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_env_codex_workflow_edge_v4 [label="env_codex_workflow_edge_v4\n12 policy rows\nkey: edge_id\ncolumns: edge_id, source_stage, target_stage, condition, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_current_codex_flow {
    label="Current Codex and Evidence Lane workflow" rankdir=TB
    CODEX_USER_INTENT [label="User request and current instructions" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_HOST_CONTEXT [label="Measured host and client context" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_PROJECT_BINDING [label="Explicit project and local persistence binding" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_SKILL_RESOLUTION [label="Business-intent skill selection" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_ACTION_CONTRACT [label="Typed action and lane contract" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_PLAN_STATE [label="Current Plan revision and task contract" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_UOP_ADMISSION [label="Permission and operation-policy gates" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_TOOL_SELECTION [label="Ready primary or same-contract fallback" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_EXECUTION [label="One writer and owned OS workers" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_VERIFICATION [label="Current acceptance and effect reconciliation" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_PLAN_PROJECTION [label="Plan database then exact linked PLAN.md" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_EVIDENCE_PUBLICATION [label="Coherent lane heads, receipts, memory and lessons" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    CODEX_STUDIO_OBSERVATION [label="Read-only live Studio snapshot" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  ROOT -> DOMAIN_env_host_compute [label=governs]
  DOMAIN_env_host_compute -> TABLE_codex_host_variant_v4 [label="indexes 2 rows"]
  DOMAIN_env_host_compute -> TABLE_env_accelerator_profile_v4 [label="indexes 4 rows"]
  DOMAIN_env_host_compute -> TABLE_env_tool_registry_v4 [label="indexes 103 rows"]
  ROOT -> DOMAIN_env_intent_workflow [label=governs]
  DOMAIN_env_intent_workflow -> TABLE_env_mode_policy_v4 [label="indexes 16 rows"]
  DOMAIN_env_intent_workflow -> TABLE_env_work_policy_v4 [label="indexes 16 rows"]
  DOMAIN_env_intent_workflow -> TABLE_env_project_class_policy_v4 [label="indexes 7 rows"]
  DOMAIN_env_intent_workflow -> TABLE_env_skill_binding_v4 [label="indexes 24 rows"]
  DOMAIN_env_intent_workflow -> TABLE_env_workflow_policy_v4 [label="indexes 24 rows"]
  ROOT -> DOMAIN_env_action_transport [label=governs]
  DOMAIN_env_action_transport -> TABLE_env_action_binding_v4 [label="indexes 295 rows"]
  DOMAIN_env_action_transport -> TABLE_env_operation_pipeline_v4 [label="indexes 408 rows"]
  DOMAIN_env_action_transport -> TABLE_env_sdk_action_binding_v4 [label="indexes 295 rows"]
  DOMAIN_env_action_transport -> TABLE_env_mcp_action_binding_v4 [label="indexes 295 rows"]
  ROOT -> DOMAIN_env_lane_source [label=governs]
  DOMAIN_env_lane_source -> TABLE_env_lane_binding_v4 [label="indexes 22 rows"]
  DOMAIN_env_lane_source -> TABLE_env_source_lane_classification_v4 [label="indexes 22 rows"]
  ROOT -> DOMAIN_env_host_observation [label=governs]
  DOMAIN_env_host_observation -> TABLE_env_hook_binding_v4 [label="indexes 12 rows"]
  DOMAIN_env_host_observation -> TABLE_env_plan_projection_binding_v4 [label="indexes 1 rows"]
  DOMAIN_env_host_observation -> TABLE_env_studio_binding_v4 [label="indexes 1 rows"]
  ROOT -> DOMAIN_env_current_flow [label=governs]
  DOMAIN_env_current_flow -> TABLE_env_codex_workflow_stage_v4 [label="indexes 13 rows"]
  DOMAIN_env_current_flow -> TABLE_env_codex_workflow_edge_v4 [label="indexes 12 rows"]
  TABLE_codex_host_variant_v4 -> TABLE_env_hook_binding_v4 [label="hosts documented events"]
  TABLE_codex_host_variant_v4 -> TABLE_env_plan_projection_binding_v4 [label="hosts exact Plan projection"]
  TABLE_codex_host_variant_v4 -> TABLE_env_studio_binding_v4 [label="hosts read-only Studio"]
  TABLE_env_accelerator_profile_v4 -> TABLE_env_tool_registry_v4 [label="provides compatible compute"]
  TABLE_env_mode_policy_v4 -> TABLE_env_work_policy_v4 [label="binds work policy"]
  TABLE_env_work_policy_v4 -> TABLE_env_project_class_policy_v4 [label="selects project validation"]
  TABLE_env_skill_binding_v4 -> TABLE_env_workflow_policy_v4 [label="owns public workflow"]
  TABLE_env_workflow_policy_v4 -> TABLE_env_action_binding_v4 [label="selects registered actions"]
  TABLE_env_action_binding_v4 -> TABLE_env_operation_pipeline_v4 [label="orders routes"]
  TABLE_env_action_binding_v4 -> TABLE_env_sdk_action_binding_v4 [label="binds internal and outer SDK"]
  TABLE_env_action_binding_v4 -> TABLE_env_mcp_action_binding_v4 [label="binds native MCP tool"]
  TABLE_env_project_class_policy_v4 -> TABLE_env_lane_binding_v4 [label="selects lane families"]
  TABLE_env_source_lane_classification_v4 -> TABLE_env_lane_binding_v4 [label="classifies owning lane"]
  TABLE_env_lane_binding_v4 -> TABLE_env_tool_registry_v4 [label="declares ordered tools"]
  TABLE_env_codex_workflow_stage_v4 -> TABLE_env_codex_workflow_edge_v4 [label="defines stage transitions"]
  TABLE_env_plan_projection_binding_v4 -> TABLE_env_studio_binding_v4 [label="exposes read-only observation"]
  CODEX_USER_INTENT -> CODEX_HOST_CONTEXT
  CODEX_HOST_CONTEXT -> CODEX_PROJECT_BINDING
  CODEX_PROJECT_BINDING -> CODEX_SKILL_RESOLUTION
  CODEX_SKILL_RESOLUTION -> CODEX_ACTION_CONTRACT
  CODEX_ACTION_CONTRACT -> CODEX_PLAN_STATE
  CODEX_PLAN_STATE -> CODEX_UOP_ADMISSION
  CODEX_UOP_ADMISSION -> CODEX_TOOL_SELECTION
  CODEX_TOOL_SELECTION -> CODEX_EXECUTION
  CODEX_EXECUTION -> CODEX_VERIFICATION
  CODEX_VERIFICATION -> CODEX_PLAN_PROJECTION
  CODEX_PLAN_PROJECTION -> CODEX_EVIDENCE_PUBLICATION
  CODEX_EVIDENCE_PUBLICATION -> CODEX_STUDIO_OBSERVATION
  DOMAIN_env_current_flow -> CODEX_USER_INTENT [label="projects current workflow"]
  TABLE_env_project_class_policy_v4 -> TABLE_env_skill_binding_v4 [constraint=true style=invis weight=100]
}
