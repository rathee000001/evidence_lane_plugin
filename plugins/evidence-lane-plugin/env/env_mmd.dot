    MODES_RESEARCH [label="RESEARCH: PROJECT_CLASS_POLICY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MODES_RUNTIME [label="RUNTIME: NO_PROJECT_HIL" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_formulas {
    label=Formulas rankdir=TB
    FORMULAS_CODE_BOOLEAN_GATE [label="CODE_BOOLEAN_GATE: ALL_REQUIRED_GATES == PASS" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FORMULAS_DELTA_COMPLETION [label="DELTA_COMPLETION: TARGETED_RECEIPTS_PASS AND DIRECT_PURGE_COMPLETE" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FORMULAS_GOAL_OPTION_2_READY [label="GOAL_OPTION_2_READY: GOAL_METRICS_SEALED AND FINAL_BOUNDARY_VERIFIED" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FORMULAS_LEARNING_HIL_READY [label="LEARNING_HIL_READY: LEARNING_CANDIDATE_VALID" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FORMULAS_PROJECT_HIL_READY [label="PROJECT_HIL_READY: CANDIDATE_VALID AND PROJECT_EVIDENCE_COMPLETE" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
