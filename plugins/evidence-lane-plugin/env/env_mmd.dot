digraph env_codex_action_plane {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  PROMPT [label="Prompt or steer" color="#101828" fillcolor="#101828" fontcolor=white shape=box style="rounded,filled"]
  ENTRY_SLIP [label="Entry Slip: intent, focus, source route, workflow and bounded next action" color="#125cdd" fillcolor="#edf5ff" shape=box style="rounded,filled"]
  SOURCE_INTAKE [label="Source Intake and exact authority/lane classification" color="#125cdd" fillcolor="#edf5ff" shape=box style="rounded,filled"]
  MODE [label="Codex mode + Project Recipe + project-class policy" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  ACTION [label="Typed action + schema + internal SDK owner" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  ENV [label="ENV selects host, context, locality, workflow and conditional pipeline" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  UOP [label="UOP applies governance, gates, HIL and fallback policy" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
  TOOLS [label="Condition-true multi-tool pipeline; Codex remains sole agent" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  OUTER [label="Outer SDK + FastMCP/native/domain MCP/tunnel transport" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  HOOKS [label="Ordered host hook events" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  VALIDATE [label="Validate result, authority effects and direct purge" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
  DELTA_EXIT [label="Adaptive Delta-exit append for continuing work" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  EXIT_SLIP [label="Exit Slip only for Goal option 2 or completed State Travel" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  subgraph cluster_hosts {
    label=Hosts rankdir=TB
    HOSTS_CODEX_CLI [label="CODEX_CLI: CLI" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOSTS_CODEX_DESKTOP_BETA [label="CODEX_DESKTOP_BETA: BETA" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOSTS_CODEX_DESKTOP_STABLE [label="CODEX_DESKTOP_STABLE: STABLE" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOSTS_CODEX_VM_EPHEMERAL [label="CODEX_VM_EPHEMERAL: EPHEMERAL_VM" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOSTS_CODEX_VM_PERSISTENT [label="CODEX_VM_PERSISTENT: PERSISTENT_VM" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_accelerators {
    label=Accelerators rankdir=TB
    ACCELERATORS_AMD_DIRECTML [label="AMD_DIRECTML: USER_PLUGIN_GRANT_AND_DIRECTML_PROVIDER_TELEMETRY_PASS" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    ACCELERATORS_AMD_ROCM [label="AMD_ROCM: USER_PLUGIN_GRANT_AND_HIP_RUNTIME_TELEMETRY_PASS" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    ACCELERATORS_CPU [label="CPU: DEFAULT_OR_VISIBLE_GPU_FALLBACK" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    ACCELERATORS_NVIDIA_CUDA [label="NVIDIA_CUDA: USER_PLUGIN_GRANT_AND_DRIVER_RUNTIME_TELEMETRY_PASS" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_modes {
    label=Modes rankdir=TB
    MODES_ANALYSIS [label="ANALYSIS: PROJECT_CLASS_POLICY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MODES_CODE [label="CODE: PROJECT_CLASS_POLICY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MODES_CUSTOM [label="CUSTOM: EXPLICIT_CUSTOM_SCHEMA" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MODES_DATA [label="DATA: PROJECT_CLASS_POLICY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MODES_DOCUMENT [label="DOCUMENT: PROJECT_CLASS_POLICY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MODES_MEDIA [label="MEDIA: PROJECT_CLASS_POLICY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MODES_PLAN [label="PLAN: PLAN_ACCEPTANCE_SEPARATE_FROM_PROJECT_HIL" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
