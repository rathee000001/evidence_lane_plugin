  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  PROMPT [label="Prompt or steer" color="#101828" fillcolor="#101828" fontcolor=white shape=box style="rounded,filled"]
  ENTRY_SLIP [label="Entry Slip: intent, focus, source route, workflow and bounded next action" color="#125cdd" fillcolor="#edf5ff" shape=box style="rounded,filled"]
  SOURCE_INTAKE [label="Source Intake and exact authority/lane classification" color="#125cdd" fillcolor="#edf5ff" shape=box style="rounded,filled"]
  MODE [label="Codex mode + Project Recipe + project-class policy" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  ACTION [label="Typed action + schema + internal SDK owner" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  ENV [label="ENV selects host, context, locality, workflow and conditional pipeline" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
