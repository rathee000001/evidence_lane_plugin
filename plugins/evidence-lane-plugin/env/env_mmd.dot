  ACTION_MODE_CLASSIFY -> ACTION_PROJECT_MEMORY_QUERY [constraint=true style=invis weight=100]
  ACTION_RENDER_RUNTIME_PANEL -> ACTION_RUNTIME_ACTIVATION_STATUS [constraint=true style=invis weight=100]
  ACTION_TASK_COMPLETE_AND_REFRESH -> ACTION_TASK_CONFIRM_SOURCE_UPDATE [constraint=true style=invis weight=100]
  ENV153_ENV14_DEEPRESEARCH -> ENV153_ENV14_MMD_SVG [constraint=true style=invis weight=100]
  ENV153_PHYS -> ENV153_CHEM [constraint=true style=invis weight=100]
  ENV153_E15LOADER -> ENV153_E15RESEARCH [constraint=true style=invis weight=100]
}
