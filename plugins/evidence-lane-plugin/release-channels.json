{
  "schema": "evidence-lane.release-channels.v3",
  "product": "Evidence Lane",
  "slots": {
    "main_git_release": {
      "release_line": "3.0.0",
      "slot_role": "main-git-release",
      "codex_marketplace_slot": "evidence-lane-github",
      "marketplace_display_name": "Main Git Plugin Version",
      "install_source": "GIT_MAIN_EXACT_COMMIT_AFTER_GOVERNED_MERGE",
      "update_gate": "GOVERNED_MAIN_MERGE_AND_CLEAN_CI",
      "enabled": false
    },
    "local_testing": {
      "release_line": "3.0.0",
      "slot_role": "versioned-local-testing",
      "codex_marketplace_slot": "evidence-lane-v300-testing-new",
      "marketplace_display_name": "Local Testing Slot",
      "install_source": "FRESH_VERSIONED_LOCAL_PACKAGE",
      "same_marketplace_selector_reused": true,
      "fresh_package_version_per_local_build": true,
      "enabled_during_current_local_test": true
    }
  },
  "live_slot_policy": {
    "exact_slot_count": 2,
    "exact_registered_plugin_count": 2,
    "max_enabled_plugin_count": 1,
    "max_active_native_mcp_count": 1,
    "max_active_tunnel_count": 1,
    "allowed_marketplaces": [
      "evidence-lane-github",
      "evidence-lane-v300-testing-new"
    ],
    "forbidden_obsolete_marketplaces": [
      "evidence-lane-v300-local-successor",
      "evidence-lane-v300-stable-recovery",
      "evidence-lane-pv11-fallback"
    ],
    "obsolete_registrations_removed_through_supported_codex_cli": true,
    "manual_loaded_cache_deletion_allowed": false
  },
  "local_build_cycle": {
    "required_order": [
      "BUILD_FRESH_LOCAL_PACKAGE_VERSION",
      "INSTALL_IN_EXISTING_LOCAL_TESTING_MARKETPLACE",
      "VERIFY_EXACT_EIGHT_HOOKS_AND_NATIVE_SURFACE",
      "STAGE_VERSION_MATCHED_TUNNEL",
      "RESTART_EXACT_CALLING_APP_AND_TASK_ONCE",
      "RUN_LOCAL_DELTA_TESTS"
    ],
    "restart_helper": "scripts/codex_release/Restart-EvidenceLaneCodex.ps1",
    "restart_helper_installs_plugin": false,
    "combined_post_stop_installer_retired": true,
    "stable_git_main_mutated_by_local_build": false,
    "third_slot_creation_allowed": false
  },
  "checkpoint_convergence": {
    "trigger": "LOCAL_TEST_GREEN_AND_GOVERNED_MAIN_MERGE",
    "required_order": [
      "SEAL_EXACT_MAIN_COMMIT_PACKAGE",
      "REFRESH_MAIN_GIT_RELEASE_SLOT",
      "REFRESH_LOCAL_TESTING_SLOT",
      "VERIFY_EXACTLY_TWO_SLOTS_AND_ONE_ACTIVE_RUNTIME"
    ],
    "stable_main_and_local_slots_byte_identical_after_checkpoint": true,
    "branch_recovery_selector_retired": true,
    "pre_3_0_recovery_allowed": false
  },
  "failure_recovery": {
    "source_slot": "versioned-local-testing",
    "target_slot": "main-git-release",
    "main_git_slot_requires_verified_exact_main_commit": true,
    "branch_recovery_selector_retired": true,
    "controlled_exact_task_restart_required": true,
    "post_restart_native_catalog_and_project_session_proof_required": true
  },
  "history": {
    "append_only": true,
    "hash_chained": true,
    "receipts_preserved_after_obsolete_slot_unregistration": true
  }
}
