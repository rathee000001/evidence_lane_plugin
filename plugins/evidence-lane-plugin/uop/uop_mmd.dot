    GATE_SOURCE_CURRENTNESS [label="SOURCE_CURRENTNESS\nverify selected source bytes and route before effect" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_TOOL_READINESS [label="TOOL_READINESS\nmeasure every required tool before invocation" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_USER_AUTHORITY [label="USER_AUTHORITY\ncurrent user instructions and explicit decisions retain precedence" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
