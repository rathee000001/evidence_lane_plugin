digraph uop_codex_governance {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  INPUT [label="ENV-selected Codex action context" color="#101828" fillcolor="#101828" fontcolor=white shape=box style="rounded,filled"]
  SOURCE [label="Source and authority precedence" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  GATES [label="Work, privacy, disclosure, direct-purge and HIL gates" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
  OPERATOR [label="Applicable governance operators only" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  FALLBACK [label="Declared same-class fallback only" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  OUTPUT [label="Governed result + receipt; cannot override ENV or Project Truth" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  subgraph cluster_operators {
    label=Operators rankdir=TB
    OPERATORS_ACCELERATOR_BUDGET_GATE [label="ACCELERATOR_BUDGET_GATE: Require user vendor-plugin grant, compatible runtime, bounded telemetry, no throttle, configured VRAM budget, and visible CPU fallback" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OPERATORS_DIRECT_PURGE_GATE [label="DIRECT_PURGE_GATE: Remove replaced route and references in the same Delta" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OPERATORS_DISCLOSURE_GATE [label="DISCLOSURE_GATE: Emit only user-visible result and receipt" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OPERATORS_ENTRY_SLIP_GATE [label="ENTRY_SLIP_GATE: Entry Slip classifies intent and focus; it is not an Exit Slip" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OPERATORS_EXIT_SLIP_GATE [label="EXIT_SLIP_GATE: Delta-exit append never emits an Exit Slip" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OPERATORS_FALLBACK_GATE [label="FALLBACK_GATE: Only declared same-class fallback may run and failure remains visible" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OPERATORS_LEARNING_HIL_GATE [label="LEARNING_HIL_GATE: Learning approval remains separate from Project approval" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OPERATORS_PRIVACY_GATE [label="PRIVACY_GATE: Secrets and private reasoning never leave their authority" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OPERATORS_PROJECT_HIL_GATE [label="PROJECT_HIL_GATE: Only exact owning Project token may promote" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OPERATORS_SOURCE_PRECEDENCE [label="SOURCE_PRECEDENCE: No source payload changes authority by itself" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OPERATORS_WORK_GATE [label="WORK_GATE: Only condition-true bounded work may run" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_hil_policies {
    label=Hil_Policies rankdir=TB
    HIL_POLICIES_CODE_REPOSITORY [label="CODE_REPOSITORY: PROJECT_AND_LEARNING" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    HIL_POLICIES_CUSTOM_PROJECT [label="CUSTOM_PROJECT: EXPLICIT_CUSTOM_SCHEMA" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    HIL_POLICIES_DATA_PROJECT [label="DATA_PROJECT: PROJECT_AND_LEARNING" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    HIL_POLICIES_DOCUMENT_PROJECT [label="DOCUMENT_PROJECT: PROJECT_AND_LEARNING" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    HIL_POLICIES_MEDIA_PROJECT [label="MEDIA_PROJECT: PROJECT_AND_LEARNING" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    HIL_POLICIES_MIXED_PROJECT [label="MIXED_PROJECT: PROJECT_AND_LEARNING" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    HIL_POLICIES_RESEARCH_STUDY [label="RESEARCH_STUDY: PROJECT_AND_LEARNING" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
  }
  subgraph cluster_host_policies {
    label=Host_Policies rankdir=TB
    HOST_POLICIES_CODEX_CLI [label="CODEX_CLI: CODEX_HOST_VARIANT_BOUND_TO_CURRENT_RUNTIME" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOST_POLICIES_CODEX_DESKTOP_BETA [label="CODEX_DESKTOP_BETA: CODEX_HOST_VARIANT_BOUND_TO_CURRENT_RUNTIME" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOST_POLICIES_CODEX_DESKTOP_STABLE [label="CODEX_DESKTOP_STABLE: CODEX_HOST_VARIANT_BOUND_TO_CURRENT_RUNTIME" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOST_POLICIES_CODEX_VM_EPHEMERAL [label="CODEX_VM_EPHEMERAL: CODEX_HOST_VARIANT_BOUND_TO_CURRENT_RUNTIME" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOST_POLICIES_CODEX_VM_PERSISTENT [label="CODEX_VM_PERSISTENT: CODEX_HOST_VARIANT_BOUND_TO_CURRENT_RUNTIME" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_accelerator_policies {
    label=Accelerator_Policies rankdir=TB
    ACCELERATOR_POLICIES_AMD_DIRECTML [label="AMD_DIRECTML: 80" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    ACCELERATOR_POLICIES_AMD_ROCM [label="AMD_ROCM: 80" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    ACCELERATOR_POLICIES_CPU [label="CPU: 100" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    ACCELERATOR_POLICIES_NVIDIA_CUDA [label="NVIDIA_CUDA: 80" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_fallbacks {
    label=Fallbacks rankdir=TB
    FALLBACKS_CODE [label="CODE: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_DATA [label="DATA: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_DEPLOYMENT [label="DEPLOYMENT: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_DOCUMENT [label="DOCUMENT: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_EVALUATION [label="EVALUATION: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_FORMULA [label="FORMULA: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_GOVERNANCE [label="GOVERNANCE: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_GRAPH [label="GRAPH: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_MCP_TRANSPORT [label="MCP_TRANSPORT: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_OBSERVABILITY [label="OBSERVABILITY: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_OCR_MEDIA [label="OCR_MEDIA: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_RETRIEVAL [label="RETRIEVAL: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_RUNTIME [label="RUNTIME: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_SOURCE_ROUTING [label="SOURCE_ROUTING: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FALLBACKS_WEB_RESEARCH [label="WEB_RESEARCH: ORDERED_AVAILABLE_TOOL_WITHIN_SAME_WORKFLOW_CLASS_ONLY" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  INPUT -> SOURCE
  SOURCE -> GATES
  GATES -> OPERATOR
  OPERATOR -> FALLBACK
  FALLBACK -> OUTPUT
  OPERATOR -> OPERATORS_ACCELERATOR_BUDGET_GATE [label="governed member" style=dashed]
  OPERATOR -> OPERATORS_DIRECT_PURGE_GATE [label="governed member" style=dashed]
  OPERATOR -> OPERATORS_DISCLOSURE_GATE [label="governed member" style=dashed]
  OPERATOR -> OPERATORS_ENTRY_SLIP_GATE [label="governed member" style=dashed]
  OPERATOR -> OPERATORS_EXIT_SLIP_GATE [label="governed member" style=dashed]
  OPERATOR -> OPERATORS_FALLBACK_GATE [label="governed member" style=dashed]
  OPERATOR -> OPERATORS_LEARNING_HIL_GATE [label="governed member" style=dashed]
  OPERATOR -> OPERATORS_PRIVACY_GATE [label="governed member" style=dashed]
  OPERATOR -> OPERATORS_PROJECT_HIL_GATE [label="governed member" style=dashed]
  OPERATOR -> OPERATORS_SOURCE_PRECEDENCE [label="governed member" style=dashed]
  OPERATOR -> OPERATORS_WORK_GATE [label="governed member" style=dashed]
  GATES -> HIL_POLICIES_CODE_REPOSITORY [label="governed member" style=dashed]
  GATES -> HIL_POLICIES_CUSTOM_PROJECT [label="governed member" style=dashed]
  GATES -> HIL_POLICIES_DATA_PROJECT [label="governed member" style=dashed]
  GATES -> HIL_POLICIES_DOCUMENT_PROJECT [label="governed member" style=dashed]
  GATES -> HIL_POLICIES_MEDIA_PROJECT [label="governed member" style=dashed]
  GATES -> HIL_POLICIES_MIXED_PROJECT [label="governed member" style=dashed]
  GATES -> HIL_POLICIES_RESEARCH_STUDY [label="governed member" style=dashed]
  INPUT -> HOST_POLICIES_CODEX_CLI [label="governed member" style=dashed]
  INPUT -> HOST_POLICIES_CODEX_DESKTOP_BETA [label="governed member" style=dashed]
  INPUT -> HOST_POLICIES_CODEX_DESKTOP_STABLE [label="governed member" style=dashed]
  INPUT -> HOST_POLICIES_CODEX_VM_EPHEMERAL [label="governed member" style=dashed]
  INPUT -> HOST_POLICIES_CODEX_VM_PERSISTENT [label="governed member" style=dashed]
  GATES -> ACCELERATOR_POLICIES_AMD_DIRECTML [label="governed member" style=dashed]
  GATES -> ACCELERATOR_POLICIES_AMD_ROCM [label="governed member" style=dashed]
  GATES -> ACCELERATOR_POLICIES_CPU [label="governed member" style=dashed]
  GATES -> ACCELERATOR_POLICIES_NVIDIA_CUDA [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_CODE [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_DATA [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_DEPLOYMENT [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_DOCUMENT [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_EVALUATION [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_FORMULA [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_GOVERNANCE [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_GRAPH [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_MCP_TRANSPORT [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_OBSERVABILITY [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_OCR_MEDIA [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_RETRIEVAL [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_RUNTIME [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_SOURCE_ROUTING [label="governed member" style=dashed]
  FALLBACK -> FALLBACKS_WEB_RESEARCH [label="governed member" style=dashed]
  HOST_POLICIES_CODEX_CLI -> HOST_POLICIES_CODEX_DESKTOP_BETA [constraint=true style=invis weight=100]
  HOST_POLICIES_CODEX_DESKTOP_BETA -> HOST_POLICIES_CODEX_DESKTOP_STABLE [constraint=true style=invis weight=100]
  HOST_POLICIES_CODEX_DESKTOP_STABLE -> HOST_POLICIES_CODEX_VM_EPHEMERAL [constraint=true style=invis weight=100]
  HIL_POLICIES_CODE_REPOSITORY -> HIL_POLICIES_CUSTOM_PROJECT [constraint=true style=invis weight=100]
  HIL_POLICIES_CUSTOM_PROJECT -> HIL_POLICIES_DATA_PROJECT [constraint=true style=invis weight=100]
  HIL_POLICIES_DOCUMENT_PROJECT -> HIL_POLICIES_MEDIA_PROJECT [constraint=true style=invis weight=100]
  HIL_POLICIES_MEDIA_PROJECT -> HIL_POLICIES_MIXED_PROJECT [constraint=true style=invis weight=100]
  OPERATORS_ACCELERATOR_BUDGET_GATE -> OPERATORS_DIRECT_PURGE_GATE [constraint=true style=invis weight=100]
  OPERATORS_DIRECT_PURGE_GATE -> OPERATORS_DISCLOSURE_GATE [constraint=true style=invis weight=100]
  OPERATORS_DISCLOSURE_GATE -> OPERATORS_ENTRY_SLIP_GATE [constraint=true style=invis weight=100]
  OPERATORS_ENTRY_SLIP_GATE -> OPERATORS_EXIT_SLIP_GATE [constraint=true style=invis weight=100]
  OPERATORS_EXIT_SLIP_GATE -> OPERATORS_FALLBACK_GATE [constraint=true style=invis weight=100]
  OPERATORS_LEARNING_HIL_GATE -> OPERATORS_PRIVACY_GATE [constraint=true style=invis weight=100]
  OPERATORS_PRIVACY_GATE -> OPERATORS_PROJECT_HIL_GATE [constraint=true style=invis weight=100]
  OPERATORS_PROJECT_HIL_GATE -> OPERATORS_SOURCE_PRECEDENCE [constraint=true style=invis weight=100]
  OPERATORS_SOURCE_PRECEDENCE -> OPERATORS_WORK_GATE [constraint=true style=invis weight=100]
  FALLBACKS_CODE -> FALLBACKS_DATA [constraint=true style=invis weight=100]
  FALLBACKS_DATA -> FALLBACKS_DEPLOYMENT [constraint=true style=invis weight=100]
  FALLBACKS_DEPLOYMENT -> FALLBACKS_DOCUMENT [constraint=true style=invis weight=100]
  FALLBACKS_DOCUMENT -> FALLBACKS_EVALUATION [constraint=true style=invis weight=100]
  FALLBACKS_EVALUATION -> FALLBACKS_FORMULA [constraint=true style=invis weight=100]
  FALLBACKS_GOVERNANCE -> FALLBACKS_GRAPH [constraint=true style=invis weight=100]
  FALLBACKS_GRAPH -> FALLBACKS_MCP_TRANSPORT [constraint=true style=invis weight=100]
  FALLBACKS_MCP_TRANSPORT -> FALLBACKS_OBSERVABILITY [constraint=true style=invis weight=100]
  FALLBACKS_OBSERVABILITY -> FALLBACKS_OCR_MEDIA [constraint=true style=invis weight=100]
  FALLBACKS_OCR_MEDIA -> FALLBACKS_RETRIEVAL [constraint=true style=invis weight=100]
  FALLBACKS_RUNTIME -> FALLBACKS_SOURCE_ROUTING [constraint=true style=invis weight=100]
  FALLBACKS_SOURCE_ROUTING -> FALLBACKS_WEB_RESEARCH [constraint=true style=invis weight=100]
}
