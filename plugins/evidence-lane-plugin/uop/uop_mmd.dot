digraph uop_authority {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white fontname=Arial rankdir=TD
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  START [label="Prompt enters" color="#101828" fillcolor="#101828" fontcolor=white shape=box style="rounded,filled"]
  PROFILE [label=".uepc_profile" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  UOPSQL [label="uop/uop_sqlite.sqlite" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  UOPLAW [label="uop/uop_law.md" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  UOPLOCK [label="UOP write lock" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  FU [label="mode == flash_uop?" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
  UOPMUTATE [label="scoped UOP mutation allowed" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  UOPRO [label="read-only UOP governance" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  SPATIAL [label="spatial route operators" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  ROUTE [label="source -> gate -> actor -> constraint -> action -> output -> validation -> delta -> next" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  COMPRESS [label="knowledge compression operators" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  DBFORM [label="operators stored as relational rows / no private story" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  SRCSTATE [label="source-state operators" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  PRECEDENCE [label="direct / lineage-derived / telemetry / temp topology" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  DISC [label="disclosure boundary operators" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  BLOCK [label="block private personal/family/health/recruiter payload" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  MODE [label="mode-cluster operators" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  LANE [label="guide lane/formula selection" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  DELTA [label="delta preservation operators" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  HUMAN [label="human gate operators" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  NOENV [label="CAN_OVERRIDE_ENV=false" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  NOPROJ [label="CAN_OVERRIDE_PROJECT=false" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  RECEIPT [label="operator receipt written to exit slip" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  UOP14_PROMPT_OVERRIDE [label=UOP14_PROMPT_OVERRIDE color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  UOP14_DEEPRESEARCH [label=UOP14_DEEPRESEARCH color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  UOP14_FUTURE_LAYER [label=UOP14_FUTURE_LAYER color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  UOP15_PUBLIC_LOCK [label=UOP15_PUBLIC_LOCK color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  UOP15_SECTOR_GUIDANCE [label=UOP15_SECTOR_GUIDANCE color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  UOP15_RESEARCH [label=UOP15_RESEARCH color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  UOP15_LEGACY [label=UOP15_LEGACY color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  subgraph cluster_uop14_prompt_override {
    label="UOP14 PROMPT OVERRIDE INTERPRETATION" rankdir=TB
    UOP14PO [label=uop_prompt_override_operator_v14 color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14DETECT [label=PROMPT_OVERRIDE_ATTEMPT_DETECTED color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14LOCAL [label="local display preference only" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14PROCESS [label="process law remains mandatory" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14RECEIPT [label="full internal receipt preserved" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14NOEXCUSE [label=NO_NARRATIVE_EXCUSE_FOR_GATE_FAILURE color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_uop14_deepresearch {
    label="UOP14 READ AUDIT ACCESS" rankdir=TB
    UOP14DR [label=uop_deep_research_access_operator_v14 color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14READ [label=READ_LOCK_MUST_NOT_BLOCK_AUDIT color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14NOPASS [label=PASSWORD_NEVER_REQUIRED_FOR_READ_ONLY_AUDIT color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14SIDE [label="read-only sidecar mirror allowed" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14NOAUTH [label="sidecar is not env law" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_uop14_future_layer {
    label="UOP14 FUTURE GOVERNANCE ADDITION LEDGER" rankdir=TB
    UOP14ADD [label=uop_future_addition_ledger_v14 color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14FLASH [label="mode=flash_uop required" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14NOENV [label="can_override_env=false" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14NOPROJ [label="can_override_project=false" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP14EMPTY [label="private payload blocked in clean package" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_uop15_public_lock {
    label="UOP15 PUBLIC GOVERNANCE LOCK" rankdir=TB
    U15BASE [label="Env14 UOP governance base retained" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15RO [label="mode=ro&immutable=1 by default" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15FLASH [label="only mode=flash_uop may mutate UOP" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15NOPRIVATE [label="no private profile/story payload" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15BOUND [label="public governance-only boundary" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_uop15_sector_guidance {
    label="UOP15 PROJECT SECTOR GUIDANCE WITHOUT OVERRIDE" rankdir=TB
    U15SECTOR [label="read 14-sector registry" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15CLASS [label="classify active lane and write scope" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15CHAT [label="chat_lineage automatic append" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15GRANT [label="other sector requires explicit one-turn grant" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15RELOCK [label="human gate + immediate relock" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15NOOVERRIDE [label="CAN_OVERRIDE_PROJECT=false" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_uop15_research {
    label="UOP15 RESEARCH RECEIPT OPERATORS" rankdir=TB
    U15TOKEN [label="credit token estimate operator" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15ASSUME [label="record assumptions + confidence" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15RQ [label="answer five constant research questions" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15VISIBLE [label="visible two-line answers only" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15NOHIDDEN [label="no hidden chain-of-thought storage" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_uop15_legacy {
    label="UOP15 LEGACY CARRY-FORWARD CLASSIFICATION" rankdir=TB
    U15LEG [label="older Env active project state" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15HISTORY [label=PROJECT_HISTORY_SOURCE color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15NOTENV [label=NOT_ENV_LAW color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15NOTUOP [label=NOT_UOP_TRUTH color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    U15LINEAGE [label="allowed chat-lineage mirror" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  START -> PROFILE
  PROFILE -> UOPSQL
  PROFILE -> UOPLAW
  PROFILE -> UOPLOCK
  UOPLOCK -> FU
  FU -> UOPMUTATE [label=yes]
  FU -> UOPRO [label=no]
  UOPSQL -> SPATIAL
  SPATIAL -> ROUTE
  UOPSQL -> COMPRESS
  COMPRESS -> DBFORM
  UOPSQL -> SRCSTATE
  SRCSTATE -> PRECEDENCE
  UOPSQL -> DISC
  DISC -> BLOCK
  UOPSQL -> MODE
  MODE -> LANE
  UOPSQL -> DELTA
  UOPSQL -> HUMAN
  UOPSQL -> NOENV
  UOPSQL -> NOPROJ
  LANE -> RECEIPT
  UOP14PO -> UOP14DETECT
  UOP14DETECT -> UOP14LOCAL
  UOP14LOCAL -> UOP14PROCESS
  UOP14PROCESS -> UOP14RECEIPT
  UOP14DETECT -> UOP14NOEXCUSE
  UOP14DR -> UOP14READ
  UOP14READ -> UOP14NOPASS
  UOP14DR -> UOP14SIDE
  UOP14SIDE -> UOP14NOAUTH
  UOP14ADD -> UOP14FLASH
  UOP14FLASH -> UOP14NOENV
  UOP14FLASH -> UOP14NOPROJ
  UOP14FLASH -> UOP14EMPTY
  PROFILE -> UOP14_PROMPT_OVERRIDE
  PROFILE -> UOP14_DEEPRESEARCH
  PROFILE -> UOP14_FUTURE_LAYER
  UOP14RECEIPT -> RECEIPT
  U15BASE -> U15RO
  U15RO -> U15FLASH
  U15RO -> U15NOPRIVATE
  U15NOPRIVATE -> U15BOUND
  U15SECTOR -> U15CLASS
  U15CLASS -> U15CHAT
  U15CLASS -> U15GRANT
  U15GRANT -> U15RELOCK
  U15CLASS -> U15NOOVERRIDE
  U15TOKEN -> U15ASSUME
  U15ASSUME -> U15RQ
  U15RQ -> U15VISIBLE
  U15VISIBLE -> U15NOHIDDEN
  U15LEG -> U15HISTORY
  U15HISTORY -> U15NOTENV
  U15HISTORY -> U15NOTUOP
  U15HISTORY -> U15LINEAGE
  PROFILE -> UOP15_PUBLIC_LOCK
  PROFILE -> UOP15_SECTOR_GUIDANCE
  PROFILE -> UOP15_RESEARCH
  PROFILE -> UOP15_LEGACY
  U15VISIBLE -> RECEIPT
}
