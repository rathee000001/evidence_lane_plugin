digraph uop_operating_framework {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  ROOT [label="UOP: locked operating policy and current executable bindings" color="#101828" fillcolor="#101828" fontcolor=white shape=box style="rounded,filled"]
  subgraph cluster_group_uop_admission {
    label="Admission and task state" rankdir=TB
    DOMAIN_uop_admission [label="Admission and task state" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    TABLE_uop_required_gate_v4 [label="uop_required_gate_v4\n12 policy rows\nkey: gate_id\ncolumns: gate_id, applies_to, rule, failure_code, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_workflow_gate_v4 [label="uop_workflow_gate_v4\n12 policy rows\nkey: event_id\ncolumns: event_id, stage, predicate, failure_code, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_permission_policy_v4 [label="uop_permission_policy_v4\n8 policy rows\nkey: permission\ncolumns: permission, grant_owner, checked_at, may_mutate, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_task_state_policy_v4 [label="uop_task_state_policy_v4\n7 policy rows\nkey: task_state\ncolumns: task_state, host_status, execution_allowed, terminal, transition_owner, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_group_uop_execution {
    label="Execution and fallback" rankdir=TB
    DOMAIN_uop_execution [label="Execution and fallback" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    TABLE_uop_action_policy_v4 [label="uop_action_policy_v4\n295 policy rows\nkey: action_name\ncolumns: action_name, read_only, destructive, idempotent, requires_exact_user_decision, direct_purge_required, authority_effects_json, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_tool_policy_v4 [label="uop_tool_policy_v4\n103 policy rows\nkey: tool_id\ncolumns: tool_id, requirement, grant_required, locality_expiry_required, agent_authority, selection_rule, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_accelerator_policy_v4 [label="uop_accelerator_policy_v4\n4 policy rows\nkey: provider_id\ncolumns: provider_id, vendor_plugin_grant_required, memory_budget_configurable, default_memory_budget_percent, max_memory_budget_percent, telemetry_required, throttle_blocks_execution, cpu_fallback_required, authority_effect, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_host_policy_v4 [label="uop_host_policy_v4\n2 policy rows\nkey: host_id\ncolumns: host_id, host_profile, execution_allowed, reason, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_fallback_policy_v4 [label="uop_fallback_policy_v4\n10 policy rows\nkey: workflow_class\ncolumns: workflow_class, fallback_rule, cross_class_fallback_allowed, silent_fallback_allowed, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_group_uop_project_evidence {
    label="Project evidence and verification" rankdir=TB
    DOMAIN_uop_project_evidence [label="Project evidence and verification" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    TABLE_uop_work_classification_policy_v4 [label="uop_work_classification_policy_v4\n16 policy rows\nkey: work_id\ncolumns: work_id, selection_rule, authorizes_execution, creates_sector, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_project_class_validation_policy_v4 [label="uop_project_class_validation_policy_v4\n7 policy rows\nkey: project_class\ncolumns: project_class, project_validation, learning_validation, plan_acceptance_separate, direct_purge_required, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_source_policy_v4 [label="uop_source_policy_v4\n1 policy rows\nkey: policy_id\ncolumns: policy_id, applies_to, rule, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_disclosure_policy_v4 [label="uop_disclosure_policy_v4\n1 policy rows\nkey: policy_id\ncolumns: policy_id, applies_to, rule, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_verification_policy_v4 [label="uop_verification_policy_v4\n3 policy rows\nkey: policy_id\ncolumns: policy_id, applies_to, requirement, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TABLE_uop_plan_projection_policy_v4 [label="uop_plan_projection_policy_v4\n1 policy rows\nkey: policy_id\ncolumns: policy_id, source_owner, write_order, full_list_required, partial_window_allowed, failure_state, status" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_current_operation_gates {
    label="Current operation admission gates" rankdir=TB
    GATE_CONNECTION_SCOPE [label="CONNECTION_SCOPE\nuse the authenticated current engine client" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_DISCLOSURE [label="DISCLOSURE\nemit only permitted attributed data and no raw secrets" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_EFFECT_RECONCILIATION [label="EFFECT_RECONCILIATION\nreconcile uncertain external effects before retry" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_HOST_PLAN_PROJECTION [label="HOST_PLAN_PROJECTION\ncommit Plan database first, then atomically update the exact bound PLAN.md" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_PERMISSION [label="PERMISSION\nrequire the exact action permission" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_PLAN_TASK [label="PLAN_TASK\nbind execution to the current Plan revision and task" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_PROJECT_BINDING [label="PROJECT_BINDING\nuse the explicitly selected project and current grant" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_SAME_CONTRACT_FALLBACK [label="SAME_CONTRACT_FALLBACK\nuse only declared pre-invocation same-contract fallbacks" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_SOURCE_CURRENTNESS [label="SOURCE_CURRENTNESS\nverify selected source bytes and route before effect" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_TOOL_READINESS [label="TOOL_READINESS\nmeasure every required tool before invocation" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_USER_AUTHORITY [label="USER_AUTHORITY\ncurrent user instructions and explicit decisions retain precedence" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    GATE_VERIFICATION [label="VERIFICATION\nrequire current named acceptance checks and evidence" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  ROOT -> DOMAIN_uop_admission [label=governs]
  DOMAIN_uop_admission -> TABLE_uop_required_gate_v4 [label="indexes 12 rows"]
  DOMAIN_uop_admission -> TABLE_uop_workflow_gate_v4 [label="indexes 12 rows"]
  DOMAIN_uop_admission -> TABLE_uop_permission_policy_v4 [label="indexes 8 rows"]
  DOMAIN_uop_admission -> TABLE_uop_task_state_policy_v4 [label="indexes 7 rows"]
  ROOT -> DOMAIN_uop_execution [label=governs]
  DOMAIN_uop_execution -> TABLE_uop_action_policy_v4 [label="indexes 295 rows"]
  DOMAIN_uop_execution -> TABLE_uop_tool_policy_v4 [label="indexes 103 rows"]
  DOMAIN_uop_execution -> TABLE_uop_accelerator_policy_v4 [label="indexes 4 rows"]
  DOMAIN_uop_execution -> TABLE_uop_host_policy_v4 [label="indexes 2 rows"]
  DOMAIN_uop_execution -> TABLE_uop_fallback_policy_v4 [label="indexes 10 rows"]
  ROOT -> DOMAIN_uop_project_evidence [label=governs]
  DOMAIN_uop_project_evidence -> TABLE_uop_work_classification_policy_v4 [label="indexes 16 rows"]
  DOMAIN_uop_project_evidence -> TABLE_uop_project_class_validation_policy_v4 [label="indexes 7 rows"]
  DOMAIN_uop_project_evidence -> TABLE_uop_source_policy_v4 [label="indexes 1 rows"]
  DOMAIN_uop_project_evidence -> TABLE_uop_disclosure_policy_v4 [label="indexes 1 rows"]
  DOMAIN_uop_project_evidence -> TABLE_uop_verification_policy_v4 [label="indexes 3 rows"]
  DOMAIN_uop_project_evidence -> TABLE_uop_plan_projection_policy_v4 [label="indexes 1 rows"]
  TABLE_uop_host_policy_v4 -> TABLE_uop_action_policy_v4 [label="admits host action"]
  TABLE_uop_action_policy_v4 -> TABLE_uop_permission_policy_v4 [label="checks permission"]
  TABLE_uop_action_policy_v4 -> TABLE_uop_required_gate_v4 [label="must satisfy gates"]
  TABLE_uop_action_policy_v4 -> TABLE_uop_tool_policy_v4 [label="selects eligible tools"]
  TABLE_uop_accelerator_policy_v4 -> TABLE_uop_tool_policy_v4 [label="admits compute route"]
  TABLE_uop_fallback_policy_v4 -> TABLE_uop_tool_policy_v4 [label="limits same-contract fallback"]
  TABLE_uop_required_gate_v4 -> TABLE_uop_workflow_gate_v4 [label="binds stage checks"]
  TABLE_uop_task_state_policy_v4 -> TABLE_uop_plan_projection_policy_v4 [label="controls Plan eligibility"]
  TABLE_uop_work_classification_policy_v4 -> TABLE_uop_project_class_validation_policy_v4 [label="selects validation policy"]
  TABLE_uop_source_policy_v4 -> TABLE_uop_disclosure_policy_v4 [label="bounds source disclosure"]
  TABLE_uop_verification_policy_v4 -> TABLE_uop_plan_projection_policy_v4 [label="verifies before Plan advance"]
  TABLE_uop_plan_projection_policy_v4 -> TABLE_uop_disclosure_policy_v4 [label="publishes bounded result"]
  DOMAIN_uop_admission -> GATE_CONNECTION_SCOPE [label=requires]
  DOMAIN_uop_admission -> GATE_DISCLOSURE [label=requires]
  DOMAIN_uop_admission -> GATE_EFFECT_RECONCILIATION [label=requires]
  DOMAIN_uop_admission -> GATE_HOST_PLAN_PROJECTION [label=requires]
  DOMAIN_uop_admission -> GATE_PERMISSION [label=requires]
  DOMAIN_uop_admission -> GATE_PLAN_TASK [label=requires]
  DOMAIN_uop_admission -> GATE_PROJECT_BINDING [label=requires]
  DOMAIN_uop_admission -> GATE_SAME_CONTRACT_FALLBACK [label=requires]
  DOMAIN_uop_admission -> GATE_SOURCE_CURRENTNESS [label=requires]
  DOMAIN_uop_admission -> GATE_TOOL_READINESS [label=requires]
  DOMAIN_uop_admission -> GATE_USER_AUTHORITY [label=requires]
  DOMAIN_uop_admission -> GATE_VERIFICATION [label=requires]
  GATE_CONNECTION_SCOPE -> GATE_DISCLOSURE [constraint=true style=invis weight=100]
  GATE_DISCLOSURE -> GATE_EFFECT_RECONCILIATION [constraint=true style=invis weight=100]
  GATE_EFFECT_RECONCILIATION -> GATE_HOST_PLAN_PROJECTION [constraint=true style=invis weight=100]
  GATE_HOST_PLAN_PROJECTION -> GATE_PERMISSION [constraint=true style=invis weight=100]
  GATE_PLAN_TASK -> GATE_PROJECT_BINDING [constraint=true style=invis weight=100]
  GATE_PROJECT_BINDING -> GATE_SAME_CONTRACT_FALLBACK [constraint=true style=invis weight=100]
  GATE_SAME_CONTRACT_FALLBACK -> GATE_SOURCE_CURRENTNESS [constraint=true style=invis weight=100]
  GATE_SOURCE_CURRENTNESS -> GATE_TOOL_READINESS [constraint=true style=invis weight=100]
  GATE_USER_AUTHORITY -> GATE_VERIFICATION [constraint=true style=invis weight=100]
  TABLE_uop_accelerator_policy_v4 -> TABLE_uop_host_policy_v4 [constraint=true style=invis weight=100]
  TABLE_uop_host_policy_v4 -> TABLE_uop_fallback_policy_v4 [constraint=true style=invis weight=100]
  TABLE_uop_project_class_validation_policy_v4 -> TABLE_uop_source_policy_v4 [constraint=true style=invis weight=100]
}
