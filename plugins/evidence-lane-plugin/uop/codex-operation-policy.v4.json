          "status": "ACTIVE"
        },
        {
          "gate_id": "PERMISSION",
          "applies_to": "all operations",
          "rule": "require the exact action permission",
          "failure_code": "PERMISSION_DENIED",
          "status": "ACTIVE"
        },
        {
          "gate_id": "PLAN_TASK",
          "applies_to": "task work",
          "rule": "bind execution to the current Plan revision and task",
          "failure_code": "DELTA_REQUIRED",
          "status": "ACTIVE"
        },
        {
          "gate_id": "SOURCE_CURRENTNESS",
          "applies_to": "source effects",
          "rule": "verify selected source bytes and route before effect",
          "failure_code": "SOURCE_CHANGED",
          "status": "ACTIVE"
        },
        {
          "gate_id": "TOOL_READINESS",
          "applies_to": "tool operations",
          "rule": "measure every required tool before invocation",
          "failure_code": "PIPELINE_NOT_READY",
          "status": "ACTIVE"
        },
        {
          "gate_id": "SAME_CONTRACT_FALLBACK",
          "applies_to": "fallback",
          "rule": "use only declared pre-invocation same-contract fallbacks",
          "failure_code": "FALLBACK_UNAVAILABLE",
          "status": "ACTIVE"
        },
        {
          "gate_id": "EFFECT_RECONCILIATION",
          "applies_to": "mutations",
          "rule": "reconcile uncertain external effects before retry",
          "failure_code": "EFFECT_OUTCOME_UNCERTAIN",
          "status": "ACTIVE"
        },
        {
          "gate_id": "VERIFICATION",
          "applies_to": "completion",
          "rule": "require current named acceptance checks and evidence",
          "failure_code": "VERIFICATION_FAILED",
          "status": "ACTIVE"
        },
        {
          "gate_id": "HOST_PLAN_PROJECTION",
          "applies_to": "Plan mutation",
          "rule": "commit Plan database first, then atomically update the exact bound PLAN.md",
          "failure_code": "HOST_PLAN_PROJECTION_PENDING",
          "status": "ACTIVE"
        },
        {
          "gate_id": "DISCLOSURE",
          "applies_to": "all outputs",
          "rule": "emit only permitted attributed data and no raw secrets",
          "failure_code": "DISCLOSURE_BLOCKED",
          "status": "ACTIVE"
        }
      ]
    },
