digraph skill_evi_plugin {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  ENTRY [label="evi-plugin intent" color="#101828" fillcolor="#101828" fontcolor=white shape=box style="rounded,filled"]
  EXIT [label="Exact result / stop / next workflow" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  subgraph cluster_wf_inspect_connectors {
    label="inspect-connectors" rankdir=TB
    WF_INSPECT_CONNECTORS_START [label="inspect-connectors" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    WF_INSPECT_CONNECTORS_ACTION_001 [label="1. connector_plugin_catalog [['GOVERNANCE', 'RETRIEVAL', 'RUNTIME']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    WF_INSPECT_CONNECTORS_ACTION_002 [label="2. connector_plugin_settings [['GOVERNANCE', 'RETRIEVAL', 'RUNTIME']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_wf_change_connector_registration {
    label="change-connector-registration" rankdir=TB
    WF_CHANGE_CONNECTOR_REGISTRATION_START [label="change-connector-registration" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    WF_CHANGE_CONNECTOR_REGISTRATION_ACTION_001 [label="3. connector_plugin_register [['GOVERNANCE', 'RUNTIME']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    WF_CHANGE_CONNECTOR_REGISTRATION_ACTION_002 [label="3. connector_plugin_drop [['GOVERNANCE', 'RUNTIME']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_wf_route_connector {
    label="route-connector" rankdir=TB
    WF_ROUTE_CONNECTOR_START [label="route-connector" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    WF_ROUTE_CONNECTOR_ACTION_001 [label="4. connector_plugin_route [['GOVERNANCE', 'RUNTIME']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_execution {
    label="Shared typed execution contract" rankdir=TB
    SCHEMA [label="Current input/output schema" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    INTERNAL_SDK [label="Internal SDK execution owner" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    ENV [label="ENV15 environment selection" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP [label="UOP15 governance and gates" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    AUTHORITY [label="Owning authority and lane" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TOOLS [label="Conditional tool role resolution" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OUTER [label="Outer SDK / FastMCP / native compatibility" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOOKS [label="Only emitted ordered hooks" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    VALIDATE [label="Validate schema, result and effects" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    RECEIPT [label="Exact receipt" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  }
  ENTRY -> WF_INSPECT_CONNECTORS_START
  WF_INSPECT_CONNECTORS_START -> WF_INSPECT_CONNECTORS_ACTION_001
  WF_INSPECT_CONNECTORS_ACTION_001 -> WF_INSPECT_CONNECTORS_ACTION_002 [label="ordered action"]
  ENTRY -> WF_CHANGE_CONNECTOR_REGISTRATION_START
  WF_CHANGE_CONNECTOR_REGISTRATION_START -> WF_CHANGE_CONNECTOR_REGISTRATION_ACTION_001
  WF_CHANGE_CONNECTOR_REGISTRATION_ACTION_001 -> WF_CHANGE_CONNECTOR_REGISTRATION_ACTION_002 [label="ordered action"]
  ENTRY -> WF_ROUTE_CONNECTOR_START
  WF_ROUTE_CONNECTOR_START -> WF_ROUTE_CONNECTOR_ACTION_001
  SCHEMA -> INTERNAL_SDK
  INTERNAL_SDK -> ENV
  ENV -> UOP
  UOP -> AUTHORITY
  AUTHORITY -> TOOLS
  TOOLS -> OUTER
  OUTER -> HOOKS
  HOOKS -> VALIDATE
  VALIDATE -> RECEIPT
  WF_INSPECT_CONNECTORS_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_INSPECT_CONNECTORS_ACTION_002 -> SCHEMA [label="typed execution"]
  WF_CHANGE_CONNECTOR_REGISTRATION_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_CHANGE_CONNECTOR_REGISTRATION_ACTION_002 -> SCHEMA [label="typed execution"]
  WF_ROUTE_CONNECTOR_ACTION_001 -> SCHEMA [label="typed execution"]
  RECEIPT -> EXIT
}
