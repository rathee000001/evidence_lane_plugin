  WF_LIVE_ROOT_CURRENT_AUTHORITY_READ_ACTION_001 -> WF_LIVE_ROOT_CURRENT_AUTHORITY_READ_ACTION_002 [label="ordered action"]
  ENTRY -> WF_GOVERNANCE_READ_START
