  WF_LANE_EVIDENCE_READ_ACTION_001 -> WF_LANE_EVIDENCE_READ_ACTION_002 [label="ordered action"]
  WF_LANE_EVIDENCE_READ_ACTION_002 -> WF_LANE_EVIDENCE_READ_ACTION_003 [label="ordered action"]
  WF_LANE_EVIDENCE_READ_ACTION_003 -> WF_LANE_EVIDENCE_READ_ACTION_004 [label="ordered action"]
  ENTRY -> WF_EXACT_FUSE_START
  WF_EXACT_FUSE_START -> WF_EXACT_FUSE_ACTION_001
  ENTRY -> WF_SAME_HOST_NEXT_TURN_START
  WF_SAME_HOST_NEXT_TURN_START -> WF_SAME_HOST_NEXT_TURN_ACTION_001
  SCHEMA -> INTERNAL_SDK
  INTERNAL_SDK -> ENV
  ENV -> UOP
  UOP -> AUTHORITY
  AUTHORITY -> TOOLS
  TOOLS -> OUTER
  OUTER -> HOOKS
  HOOKS -> VALIDATE
  VALIDATE -> RECEIPT
  WF_LIVE_ROOT_AUTHORITY_READ_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_LIVE_ROOT_AUTHORITY_READ_ACTION_002 -> SCHEMA [label="typed execution"]
  WF_LIVE_ROOT_CURRENT_AUTHORITY_READ_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_LIVE_ROOT_CURRENT_AUTHORITY_READ_ACTION_002 -> SCHEMA [label="typed execution"]
  WF_GOVERNANCE_READ_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_GOVERNANCE_READ_ACTION_002 -> SCHEMA [label="typed execution"]
  WF_GOVERNANCE_READ_ACTION_003 -> SCHEMA [label="typed execution"]
  WF_PLAN_STEER_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_LANE_EVIDENCE_READ_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_LANE_EVIDENCE_READ_ACTION_002 -> SCHEMA [label="typed execution"]
  WF_LANE_EVIDENCE_READ_ACTION_003 -> SCHEMA [label="typed execution"]
  WF_LANE_EVIDENCE_READ_ACTION_004 -> SCHEMA [label="typed execution"]
  WF_EXACT_FUSE_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_SAME_HOST_NEXT_TURN_ACTION_001 -> SCHEMA [label="typed execution"]
  RECEIPT -> EXIT
}
