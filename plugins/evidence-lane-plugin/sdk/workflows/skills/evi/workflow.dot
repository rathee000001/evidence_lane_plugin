    WF_LIVE_ROOT_CURRENT_AUTHORITY_READ_ACTION_002 [label="3. search [['GOVERNANCE', 'RETRIEVAL']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_wf_governance_read {
    label="governance-read" rankdir=TB
    WF_GOVERNANCE_READ_START [label="governance-read" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    WF_GOVERNANCE_READ_ACTION_001 [label="4. lifecycle_transition_law [['GOVERNANCE', 'RETRIEVAL']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    WF_GOVERNANCE_READ_ACTION_002 [label="4. pv_summary [['GOVERNANCE', 'RETRIEVAL']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    WF_GOVERNANCE_READ_ACTION_003 [label="4. pv_diff [['GOVERNANCE', 'RETRIEVAL', 'GRAPH']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_wf_plan_steer {
    label="plan-steer" rankdir=TB
