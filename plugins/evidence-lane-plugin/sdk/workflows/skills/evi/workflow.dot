  WF_GOVERNANCE_READ_ACTION_001 -> WF_GOVERNANCE_READ_ACTION_002 [label="ordered action"]
  WF_GOVERNANCE_READ_ACTION_002 -> WF_GOVERNANCE_READ_ACTION_003 [label="ordered action"]
  ENTRY -> WF_PLAN_STEER_START
