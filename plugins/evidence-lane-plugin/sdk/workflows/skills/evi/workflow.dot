    WF_PLAN_STEER_ACTION_001 [label="5. pv_plan_steer_delta [['GOVERNANCE']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_wf_lane_evidence_read {
    label="lane-evidence-read" rankdir=TB
    WF_LANE_EVIDENCE_READ_START [label="lane-evidence-read" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    WF_LANE_EVIDENCE_READ_ACTION_001 [label="6. lane_catalog [['GOVERNANCE', 'RETRIEVAL']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    WF_LANE_EVIDENCE_READ_ACTION_002 [label="7. lane_status [['GOVERNANCE', 'RETRIEVAL']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
