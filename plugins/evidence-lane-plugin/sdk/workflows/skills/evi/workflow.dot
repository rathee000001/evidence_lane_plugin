  }
  subgraph cluster_wf_exact_fuse {
    label="exact-fuse" rankdir=TB
    WF_EXACT_FUSE_START [label="exact-fuse" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    WF_EXACT_FUSE_ACTION_001 [label="10. pv_fuse [['GOVERNANCE']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
