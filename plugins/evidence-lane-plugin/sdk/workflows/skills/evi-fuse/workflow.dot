  WF_DUAL_HIL_NON_PROMOTION_DECISION_ACTION_001 -> WF_DUAL_HIL_NON_PROMOTION_DECISION_ACTION_002 [label="ordered action"]
  ENTRY -> WF_EXACT_LEARNING_THEN_PROJECT_APPROVAL_PROMOTION_START
  WF_EXACT_LEARNING_THEN_PROJECT_APPROVAL_PROMOTION_START -> WF_EXACT_LEARNING_THEN_PROJECT_APPROVAL_PROMOTION_ACTION_001
  SCHEMA -> INTERNAL_SDK
  INTERNAL_SDK -> ENV
  ENV -> UOP
  UOP -> AUTHORITY
  AUTHORITY -> TOOLS
  TOOLS -> OUTER
  OUTER -> HOOKS
  HOOKS -> VALIDATE
  VALIDATE -> RECEIPT
  WF_DUAL_HIL_INTENT_CLASSIFICATION_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_DUAL_HIL_NON_PROMOTION_DECISION_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_DUAL_HIL_NON_PROMOTION_DECISION_ACTION_002 -> SCHEMA [label="typed execution"]
  WF_EXACT_LEARNING_THEN_PROJECT_APPROVAL_PROMOTION_ACTION_001 -> SCHEMA [label="typed execution"]
  RECEIPT -> EXIT
}
