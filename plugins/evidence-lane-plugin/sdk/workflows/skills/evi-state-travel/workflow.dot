  ENTRY -> WF_DIRECT_FORCE_SAME_WORKTREE_STATE_TRAVEL_START
  WF_DIRECT_FORCE_SAME_WORKTREE_STATE_TRAVEL_START -> WF_DIRECT_FORCE_SAME_WORKTREE_STATE_TRAVEL_ACTION_001
