    label="state-travel-plan-steer" rankdir=TB
    WF_STATE_TRAVEL_PLAN_STEER_START [label="state-travel-plan-steer" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    WF_STATE_TRAVEL_PLAN_STEER_ACTION_001 [label="9. pv_plan_steer_delta [['GOVERNANCE']]" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_execution {
    label="Shared typed execution contract" rankdir=TB
