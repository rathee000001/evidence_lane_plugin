    HOOKS [label="Only emitted ordered hooks" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    VALIDATE [label="Validate schema, result and effects" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    RECEIPT [label="Exact receipt" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  }
  ENTRY -> WF_DIRECT_DESTINATION_RUNTIME_DOCTOR_START
  WF_DIRECT_DESTINATION_RUNTIME_DOCTOR_START -> WF_DIRECT_DESTINATION_RUNTIME_DOCTOR_ACTION_001
  ENTRY -> WF_DIRECT_DESTINATION_LOCKED_FLASH_START
