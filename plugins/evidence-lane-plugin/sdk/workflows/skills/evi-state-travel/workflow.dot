  WF_POST_ENTRY_PLAN_AUTHORITY_READ_ACTION_002 -> WF_POST_ENTRY_PLAN_AUTHORITY_READ_ACTION_003 [label="ordered action"]
  ENTRY -> WF_STATE_TRAVEL_PLAN_STEER_START
  WF_STATE_TRAVEL_PLAN_STEER_START -> WF_STATE_TRAVEL_PLAN_STEER_ACTION_001
  SCHEMA -> INTERNAL_SDK
  INTERNAL_SDK -> ENV
  ENV -> UOP
  UOP -> AUTHORITY
  AUTHORITY -> TOOLS
  TOOLS -> OUTER
  OUTER -> HOOKS
  HOOKS -> VALIDATE
  VALIDATE -> RECEIPT
  WF_DIRECT_DESTINATION_RUNTIME_DOCTOR_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_DIRECT_DESTINATION_LOCKED_FLASH_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_DIRECT_DESTINATION_EXISTING_SESSION_ATTACHMENT_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_DIRECT_DESTINATION_ACTIVATION_VERIFICATION_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_DIRECT_FORCE_SAME_WORKTREE_STATE_TRAVEL_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_POST_ENTRY_PLAN_AUTHORITY_READ_ACTION_001 -> SCHEMA [label="typed execution"]
  WF_POST_ENTRY_PLAN_AUTHORITY_READ_ACTION_002 -> SCHEMA [label="typed execution"]
  WF_POST_ENTRY_PLAN_AUTHORITY_READ_ACTION_003 -> SCHEMA [label="typed execution"]
  WF_STATE_TRAVEL_PLAN_STEER_ACTION_001 -> SCHEMA [label="typed execution"]
  RECEIPT -> EXIT
}
