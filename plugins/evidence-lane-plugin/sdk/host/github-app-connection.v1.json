  "primary_profile": {
    "profile_id": "OAUTH_ON_INSTALL",
    "callback_urls": [
      "https://evidencelane.org/api/github-app/oauth/callback"
    ],
    "request_oauth_on_install": true,
    "device_flow_enabled": true,
