  subgraph cluster_retrieval { label="5. Retrieval and changed-section reuse";
    CHUNK_INDEX [label="chunk_index\nrows=1",fillcolor="#eaf8f1",color="#24805c"];
    FACT_INDEX -> CHUNK_INDEX;
    CHUNK_CAS [label="chunk_content_cas\nrows=1",fillcolor="#eaf8f1",color="#24805c"];
    CHUNK_INDEX -> CHUNK_CAS;
    CHUNK_HISTORY [label="chunk_history\nrows=1",fillcolor="#eaf8f1",color="#24805c"];
    CHUNK_CAS -> CHUNK_HISTORY;
    FTS [label="turn_fts\nrows=1",fillcolor="#eaf8f1",color="#24805c"];
    CHUNK_HISTORY -> FTS;
