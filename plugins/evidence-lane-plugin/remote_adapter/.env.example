# The general-AI route is off unless the owner explicitly enables it.
EVIDENCE_LANE_GENERAL_AI_ENABLED=false

# Server-only. Link the owner-managed Vercel Shared Sensitive Environment
# Variable to this project; never use a NEXT_PUBLIC_ name or commit its value.
OPENROUTER_API_KEY=

# Durable MCP/OAuth release variables are configured separately. OAuth issuer,
# audience, client allowlist, environment, role, project, and scope policy live
# at the durable origin, never in this stateless Vercel forwarding adapter.
EVIDENCE_LANE_DURABLE_MCP_ORIGIN=
EVIDENCE_LANE_RELEASE_SHA=

# Server-only domain-verification token copied from the OpenAI plugin portal.
# Never commit a real value; the public route returns only this exact token.
EVIDENCE_LANE_OPENAI_APPS_CHALLENGE_TOKEN=
