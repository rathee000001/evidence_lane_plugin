{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lane.local/schemas/canon-envelope.v2.json",
  "title": "Evidence Lane Canon Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canon_id",
    "canon_sha256",
    "canon_type",
    "contract_id",
    "contract_version",
    "schema_id",
    "schema_version",
    "schema_sha256",
    "source",
    "destination",
    "direction",
    "authority_requested",
    "source_pointer",
    "evidence_refs",
    "payload",
    "payload_sha256",
    "permitted_actions",
    "dependency_ids",
    "destination_contract_sha256",
    "expected_return_contract_sha256",
    "independent_hil_owner_task_uuid",
    "edge_id",
    "revision",
    "supersedes",
    "route_trace",
    "idempotency_key",
    "created_at",
    "expires_at",
    "input_state",
    "source_write_authority_granted",
    "project_truth_pointer_moved",
    "learning_pointer_moved",
    "hil_replayed",
    "private_reasoning_stored"
  ],
  "properties": {
    "schema": { "const": "evidence-lane.canon-envelope.v2" },
    "canon_id": { "type": "string", "pattern": "^canon_[a-f0-9]{28}$" },
    "canon_sha256": { "$ref": "#/$defs/sha256" },
    "canon_type": { "type": "string", "minLength": 1 },
    "contract_id": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "integer", "minimum": 1 },
    "schema_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "schema_sha256": { "$ref": "#/$defs/sha256" },
    "source": { "$ref": "#/$defs/endpoint" },
    "destination": { "$ref": "#/$defs/endpoint" },
    "direction": { "enum": ["UPSTREAM", "DOWNSTREAM", "LATERAL"] },
    "authority_requested": {
      "enum": [
        "BOUNDED_INPUT",
        "CORRECTION_PROPOSAL",
        "EVIDENCE_RESPONSE",
        "PLAN_STEER",
        "TASK_RESULT"
      ]
    },
    "source_pointer": { "$ref": "#/$defs/sourcePointer" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "payload": { "type": "object" },
    "payload_sha256": { "$ref": "#/$defs/sha256" },
    "permitted_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependency_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "destination_contract_sha256": { "$ref": "#/$defs/sha256" },
    "expected_return_contract_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "independent_hil_owner_task_uuid": { "type": "string", "minLength": 1 },
    "edge_id": { "type": ["string", "null"] },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes": { "type": ["string", "null"] },
    "route_trace": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "input_state": { "const": "PROPOSED" },
    "source_write_authority_granted": { "const": false },
    "project_truth_pointer_moved": { "const": false },
    "learning_pointer_moved": { "const": false },
    "hil_replayed": { "const": false },
    "private_reasoning_stored": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "task_uuid",
        "task_deep_link",
        "lane_id",
        "delta_id",
        "session_id"
      ],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "task_uuid": { "type": "string", "minLength": 1 },
        "task_deep_link": { "type": "string", "minLength": 1 },
        "lane_id": { "type": "string", "minLength": 1 },
        "delta_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": ["string", "null"] }
      }
    },
    "sourcePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "pv_ref",
        "generation",
        "manifest_sha256",
        "package_sha256"
      ],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "pv_ref": { "type": "string", "pattern": "^PV[1-9][0-9]*$" },
        "generation": { "type": "integer", "minimum": 1 },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "package_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
