{
  "schema": "evidence-lane.parallel-lane-query-contract.v1",
  "contract_version": 1,
  "scope": "ONE_PROJECT_LIVE_ROOT_BOUNDED_FAN_OUT",
  "execution": {
    "maximum_queries": 8,
    "maximum_workers": 4,
    "maximum_query_characters": 2000,
    "default_timeout_ms": 5000,
    "maximum_timeout_ms": 60000,
    "default_results_per_lane": 20,
    "maximum_results_per_lane": 100,
    "default_aggregate_results": 100,
    "maximum_aggregate_results": 200,
    "cancellation": "COOPERATIVE_AND_PENDING_FUTURE_CANCELLATION",
    "read_only": true
  },
  "ordering": {
    "request_receipts": "FIRST_INPUT_INDEX_ASCENDING",
    "aggregate_results": "INPUT_INDEX_THEN_SOURCE_RANK",
    "worker_completion_order_exposed": false
  },
  "dedupe_identity": [
    "project_id",
    "live_root_authority_ref",
    "canonical_lane_id",
    "ref_id",
    "path",
    "locator",
    "source_sha256",
    "chunk_sha256"
  ],
  "request_statuses": [
    "PASS",
    "EMPTY",
    "STALE",
    "BLOCKED",
    "MISMATCH",
    "FAIL",
    "TIMEOUT",
    "CANCELLED"
  ],
  "aggregate_statuses": [
    "PASS",
    "EMPTY",
    "STALE",
    "PARTIAL",
    "CANCELLED"
  ],
  "receipt": {
    "schema": "evidence-lane.parallel-lane-query-receipt.v1",
    "sealed_by": "SHA256_CANONICAL_JSON_WITHOUT_RECEIPT_SHA256",
    "binds": [
      "project_id",
      "live_root_authority_ref",
      "bundle_sha256",
      "authority_binding_sha256",
      "budgets",
      "normalized_request_hashes",
      "per_request_status_and_result_hash",
      "aggregate_result_hash",
      "ordering_and_dedupe_contract"
    ],
    "persisted": false,
    "reason_not_persisted": "QUERY_ROUTE_IS_READ_ONLY"
  }
}
