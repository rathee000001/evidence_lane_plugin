{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lane.local/schemas/lane-search-fts5.v001.json",
  "title": "Evidence Lane FTS5 Search Contract",
  "description": "Public, hooks-independent FTS5 retrieval contract shared by all eighteen sector lanes and every SDK/MCP lane-search consumer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "lane",
    "query"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": [
        "github_code",
        "local_code",
        "chat_lineage",
        "discussion",
        "analysis",
        "plan",
        "mode",
        "docs",
        "data_excel",
        "ppt",
        "pdf_ocr",
        "images_ocr",
        "artifacts",
        "custom",
        "brain_loader",
        "research",
        "project_engulf",
        "sqlite_brain"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "retrieval": {
      "type": "string",
      "enum": [
        "hybrid",
        "fts5",
        "bm25",
        "tfidf"
      ],
      "default": "hybrid"
    }
  },
  "x-evidence-lane-contract": {
    "schema": "evidence-lane.lane-search-fts5-contract.v1",
    "contract_version": 1,
    "hooks_required": false,
    "query_normalization": {
      "tokenizer": "unicode61",
      "maximum_lexical_terms": 12,
      "term_join": "OR",
      "raw_fts5_expression_accepted": false,
      "reason": "Bounded normalized terms prevent caller-supplied FTS5 operators from escaping the governed query grammar."
    },
    "physical_fts5_columns": [
      "path",
      "locator",
      "text_content",
      "chunk_id UNINDEXED"
    ],
    "retrieval_modes": {
      "fts5": "SQLite FTS5 MATCH with unicode61 tokenization and deterministic BM25 ordering.",
      "bm25": "Explicit alias for FTS5 MATCH ordered by SQLite bm25().",
      "tfidf": "Materialized deterministic TF-IDF vectors.",
      "hybrid": "Reciprocal-rank fusion of FTS5/BM25 and TF-IDF with k=60."
    },
    "fts5_tables": {
      "github_code": "code_chunk_fts",
      "local_code": "code_chunk_fts",
      "chat_lineage": "turn_fts",
      "discussion": "discussion_fts",
      "analysis": "analysis_fts",
      "plan": "plan_fts",
      "mode": "mode_fts",
      "docs": "doc_fts",
      "data_excel": "data_fts",
      "ppt": "ppt_fts",
      "pdf_ocr": "pdf_fts",
      "images_ocr": "image_ocr_fts",
      "artifacts": "artifact_fts",
      "custom": "custom_fts",
      "brain_loader": "brain_loader_fts",
      "research": "research_fts",
      "project_engulf": "project_engulf_fts",
      "sqlite_brain": "loaded_sqlite_brain_fts"
    },
    "public_consumers": [
      "lane_search",
      "parallel_lane_query",
      "cross_lane_query",
      "cross_project_query",
      "SDK lane reader",
      "MCP lane reader",
      "prompt-intent routing",
      "installed skills"
    ],
    "result_authority": [
      "project_id",
      "live_root_authority_ref",
      "canonical_lane_id",
      "ref_id",
      "path",
      "locator",
      "source_sha256",
      "chunk_sha256",
      "parser_state",
      "freshness"
    ],
    "fallback_order": [
      "fts5",
      "bm25",
      "tfidf",
      "bounded relevant-lane refresh when all governed retrieval authorities return no hit"
    ]
  }
}
