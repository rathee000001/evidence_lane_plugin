{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "aaf5bcde49b099d6bfedea0a0057f49ddca2624e26e8327d285bf62585bfd44a",
  "authority": "engine_typed_action_registry",
  "cross_project_read": false,
  "description": "Publish a new native Hyper extract or an exact selected XML edit as immutable lane-owned bytes.",
  "inputSchema": {
    "$defs": {
      "HyperColumn": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "nullable": {
            "default": true,
            "title": "Nullable",
            "type": "boolean"
          },
          "precision": {
            "default": 18,
            "maximum": 38,
            "minimum": 1,
            "title": "Precision",
            "type": "integer"
          },
          "scale": {
            "default": 4,
            "maximum": 38,
            "minimum": 0,
            "title": "Scale",
            "type": "integer"
          },
          "type": {
            "enum": [
              "text",
              "big_int",
              "double",
              "bool",
              "date",
              "timestamp",
              "numeric"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "title": "HyperColumn",
        "type": "object"
      },
      "HyperTable": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/$defs/HyperColumn"
            },
            "maxItems": 128,
            "minItems": 1,
            "title": "Columns",
            "type": "array"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "rows": {
            "items": {
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "array"
            },
            "maxItems": 1000,
            "title": "Rows",
            "type": "array"
          },
          "schema_name": {
            "default": "Extract",
            "maxLength": 200,
            "minLength": 1,
            "title": "Schema Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "columns"
        ],
        "title": "HyperTable",
        "type": "object"
      },
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "expected_snapshot": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Snapshot"
      },
      "lane_id": {
        "const": "tableau",
        "default": "tableau",
        "title": "Lane Id",
        "type": "string"
      },
      "logical_name": {
        "maxLength": 180,
        "pattern": "^[^/\\\\:]+\\.hyper$",
        "title": "Logical Name",
        "type": "string"
      },
      "tables": {
        "items": {
          "$ref": "#/$defs/HyperTable"
        },
        "maxItems": 16,
        "minItems": 1,
        "title": "Tables",
        "type": "array"
      }
    },
    "required": [
      "logical_name",
      "tables"
    ],
    "title": "TableauGenerate",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "tableau_generate",
  "outputSchema": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "lane_id": {
        "const": "tableau",
        "default": "tableau",
        "title": "Lane Id",
        "type": "string"
      },
      "operation": {
        "title": "Operation",
        "type": "string"
      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "result": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Result",
        "type": "object"
      }
    },
    "required": [
      "project_id",
      "operation",
      "result"
    ],
    "title": "TableauResult",
    "type": "object"
  },
  "path_fields": [],
  "permission": "write",
  "profile": "tableau",
  "project_required": true,
  "queryable_in_delta": false,
  "queued": false,
  "read_schemas": [],
  "required_tools": [],
  "requires_delta": true,
  "schema": "evidence-lane.action-schema.v4",
  "studio_read": false,
  "toolchain": {
    "contract_digest": "c467a1a23caf7c3901f8d3fb6e5d07b95b4334e5de0e627b03f50d0d88ff8ea3",
    "fallback_after_invocation": false,
    "installation_implied": false,
    "installation_matrix": "toolchains/shared-toolchain.v4.json",
    "no_fallback_reason": "No equivalent alternate adapter is registered.",
    "operation": "tableau_generate",
    "profile": "tableau",
    "routes": [
      {
        "adapter": "evidence_lane_plugin.tableau_profile:generate_tableau",
        "argument_suffixes": {},
        "argument_values": {},
        "extension": null,
        "fidelity": "exact_contract",
        "host_profiles": [],
        "provider": "engine_cpu",
        "reason": "Registered engine adapter",
        "route_id": "tableau_generate.native",
        "systems": [
          "Windows"
        ],
        "tool_ids": [
          "Python",
          "lxml",
          "Tableau_Hyper_API"
        ]
      }
    ],
    "selection": "ordered_pre_invocation_readiness_and_exact_fidelity",
    "worker_operations": [
      "tableau_generate"
    ]
  },
  "verification_checks": [
    "tableau_snapshot_integrity"
  ],
  "worker_operations": [
    "tableau_generate"
  ],
  "workflow": "execute-project-plan"
}
