        "type": "string"
      },
      "max_changed_lines": {
        "default": 50000,
        "maximum": 5000000,
        "minimum": 1,
        "title": "Max Changed Lines",
        "type": "integer"
      },
      "max_commits": {
        "default": 1000,
        "maximum": 100000,
        "minimum": 1,
        "title": "Max Commits",
        "type": "integer"
      },
      "max_file_changes": {
        "default": 20000,
        "maximum": 2000000,
        "minimum": 1,
        "title": "Max File Changes",
        "type": "integer"
      },
      "max_hunks": {
        "default": 20000,
        "maximum": 2000000,
        "minimum": 1,
        "title": "Max Hunks",
        "type": "integer"
      },
      "max_objects": {
        "default": 20000,
        "maximum": 2000000,
        "minimum": 1,
        "title": "Max Objects",
        "type": "integer"
      },
      "max_patch_bytes": {
        "default": 33554432,
        "maximum": 2147483648,
        "minimum": 1,
        "title": "Max Patch Bytes",
        "type": "integer"
      },
      "max_refs": {
        "default": 1000,
        "maximum": 20000,
        "minimum": 1,
        "title": "Max Refs",
        "type": "integer"
      },
      "max_single_object_bytes": {
        "default": 8388608,
        "maximum": 1073741824,
        "minimum": 1,
        "title": "Max Single Object Bytes",
        "type": "integer"
      },
      "max_total_object_bytes": {
        "default": 67108864,
        "maximum": 8589934592,
        "minimum": 1,
        "title": "Max Total Object Bytes",
        "type": "integer"
      },
      "max_tree_entries": {
        "default": 50000,
        "maximum": 5000000,
        "minimum": 1,
        "title": "Max Tree Entries",
        "type": "integer"
      },
      "occurrence_ordinal": {
        "maximum": 256,
        "minimum": 1,
        "title": "Occurrence Ordinal",
        "type": "integer"
      }
    },
    "required": [
      "batch_id",
      "occurrence_ordinal"
