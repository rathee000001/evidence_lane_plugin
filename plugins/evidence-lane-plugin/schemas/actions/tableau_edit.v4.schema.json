        "extension": null,
        "fidelity": "exact_contract",
        "host_profiles": [],
        "provider": "engine_cpu",
        "reason": "Registered engine adapter",
        "route_id": "tableau_edit.native",
        "systems": [
          "Windows"
        ],
        "tool_ids": [
          "Python",
          "lxml",
          "Tableau_Hyper_API"
        ]
      }
    ],
    "selection": "ordered_pre_invocation_readiness_and_exact_fidelity",
    "worker_operations": [
      "tableau_edit"
    ]
  },
  "verification_checks": [
