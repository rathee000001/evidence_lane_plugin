{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "e316b2b30bb83105369ba4e44ce356b253bdd9212266c68c1a19dcfd368366fe",
  "authority": "engine_typed_action_registry",
  "cross_project_read": false,
  "description": "Run one registered operation under the exact Plan task contract.",
  "inputSchema": {
    "$defs": {
      "JsonValue": {},
      "SourceRouteSelection": {
        "additionalProperties": false,
        "properties": {
          "occurrence_ordinals": {
            "items": {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Occurrence Ordinals",
            "type": "array"
          },
          "route_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Route Id",
            "type": "string"
          }
        },
        "required": [
          "route_id",
          "occurrence_ordinals"
        ],
        "title": "SourceRouteSelection",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "action": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "title": "Action",
        "type": "string"
      },
      "arguments": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Arguments",
        "type": "object"
      },
      "contract_digest": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Contract Digest",
        "type": "string"
      },
      "plan_revision": {
        "minimum": 1,
        "title": "Plan Revision",
        "type": "integer"
      },
      "source_route": {
        "anyOf": [
          {
            "$ref": "#/$defs/SourceRouteSelection"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "task_id": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "title": "Task Id",
        "type": "string"
      }
    },
    "required": [
      "task_id",
      "plan_revision",
      "contract_digest",
      "action"
    ],
    "title": "DeltaEnter",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "delta_enter",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "automatic_replay": {
        "default": false,
        "title": "Automatic Replay",
        "type": "boolean"
      },
      "contract_digest": {
        "title": "Contract Digest",
        "type": "string"
      },
      "job_id": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "title": "Job Id",
        "type": "string"
      },
      "plan_revision": {
        "title": "Plan Revision",
        "type": "integer"
      },
      "state": {
        "title": "State",
        "type": "string"
      },
      "task_id": {
        "title": "Task Id",
        "type": "string"
      }
    },
    "required": [
      "job_id",
      "task_id",
      "plan_revision",
      "contract_digest",
      "state"
    ],
    "title": "DeltaAdmission",
    "type": "object"
  },
  "path_fields": [],
  "permission": "write",
  "profile": "delta",
  "project_required": true,
  "queryable_in_delta": false,
  "queued": true,
  "read_schemas": [],
  "required_tools": [],
  "requires_delta": false,
  "schema": "evidence-lane.action-schema.v4",
  "studio_read": false,
  "toolchain": {
    "contract_digest": "21797030d8e73aff533d0a89103c3f876ba5d1026ac711f28e25105264132484",
    "fallback_after_invocation": false,
    "installation_implied": false,
    "installation_matrix": "toolchains/shared-toolchain.v4.json",
    "no_fallback_reason": "No equivalent alternate adapter is registered.",
    "operation": "delta_enter",
    "profile": "delta",
    "routes": [
      {
        "adapter": "evidence_lane_plugin.adaptive_delta_entry:DeltaService.enter",
        "argument_suffixes": {},
        "argument_values": {},
        "extension": null,
        "fidelity": "exact_contract",
        "host_profiles": [],
        "provider": "engine_cpu",
        "reason": "Registered engine adapter",
        "route_id": "delta_enter.engine",
        "systems": [
          "Windows",
          "Darwin",
          "Linux"
        ],
        "tool_ids": [
          "Python"
        ]
      }
    ],
    "selection": "ordered_pre_invocation_readiness_and_exact_fidelity",
    "worker_operations": []
