        "type": "string"
      },
      "capability": {
        "title": "Capability",
        "type": "string"
      },
      "canonical_lane_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Canonical Lane Id"
      },
      "host_profile": {
        "const": "CODEX",
        "default": "CODEX",
        "title": "Host Profile",
        "type": "string"
      },
      "preferred_plugin_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Preferred Plugin Id"
      }
    },
    "required": [
      "project_id",
      "capability"
    ],
    "title": "connector_plugin_routeArguments",
    "type": "object"
  },
  "output_schema": {
    "additionalProperties": true,
