{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "aaf5bcde49b099d6bfedea0a0057f49ddca2624e26e8327d285bf62585bfd44a",
  "authority": "engine_typed_action_registry",
  "cross_project_read": false,
  "description": "Publish bounded page derivatives tied to immutable PDF source bytes.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "dpi": {
        "default": 144,
        "maximum": 300,
        "minimum": 72,
        "title": "Dpi",
        "type": "integer"
      },
      "lane_id": {
        "const": "pdf_ocr",
        "default": "pdf_ocr",
        "title": "Lane Id",
        "type": "string"
      },
      "language": {
        "default": "eng",
        "pattern": "^[a-z]{3}(?:\\+[a-z]{3}){0,3}$",
        "title": "Language",
        "type": "string"
      },
      "max_pixels_per_page": {
        "default": 12000000,
        "maximum": 25000000,
        "minimum": 1000,
        "title": "Max Pixels Per Page",
        "type": "integer"
      },
      "min_confidence": {
        "default": 0.5,
        "maximum": 1,
        "minimum": 0,
        "title": "Min Confidence",
        "type": "number"
      },
      "mode": {
        "default": "text_poor_pages",
        "enum": [
          "text_poor_pages",
          "all_selected_pages"
        ],
        "title": "Mode",
        "type": "string"
      },
      "native_character_threshold": {
        "default": 10,
        "maximum": 1000,
        "minimum": 0,
        "title": "Native Character Threshold",
        "type": "integer"
      },
      "pages": {
        "items": {
          "type": "integer"
        },
        "maxItems": 50,
        "minItems": 1,
        "title": "Pages",
        "type": "array"
      },
      "snapshot_id": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Snapshot Id",
        "type": "string"
      }
    },
    "required": [
      "snapshot_id",
      "pages"
    ],
    "title": "PdfOcr",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "pdf_ocr",
