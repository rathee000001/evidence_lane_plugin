          "trace": {
            "items": {
              "$ref": "#/$defs/CanonTaskEndpoint"
            },
            "maxItems": 32,
            "title": "Trace",
            "type": "array"
          }
        },
        "required": [
          "admitted_exchange_id",
          "admitted_envelope_digest",
          "failure_class",
          "requested_revision",
          "return_route"
