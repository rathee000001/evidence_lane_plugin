  "cross_project_read": false,
  "description": "Classify a proposed task exchange authority message against the current receiver contract without storing or admitting it.",
  "inputSchema": {
    "$defs": {
      "CanonBackfireDetails": {
        "additionalProperties": false,
        "properties": {
          "admitted_envelope_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Admitted Envelope Digest",
            "type": "string"
          },
          "admitted_exchange_id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Admitted Exchange Id",
            "type": "string"
          },
          "automatic_retry_allowed": {
            "const": false,
            "default": false,
            "title": "Automatic Retry Allowed",
            "type": "boolean"
          },
          "dependency_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "title": "Dependency Ids",
            "type": "array"
