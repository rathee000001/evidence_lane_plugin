{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "evidence-lane.public-action-contract.v1",
  "name": "source_git_commit_impact",
  "title": "Map an exact Git parent diff to graph impact",
  "description": "Bind one indexed commit and exact parent ordinal to FILE nodes from the same registered source occurrence, then traverse a bounded semantic impact graph. Removed, excluded, ambiguous, or absent paths stay explicitly unmapped; no historical semantic state is fabricated and no source, Git repository, candidate, or pointer is changed.",
  "input_schema": {
    "properties": {
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "snapshot_id": {
        "title": "Snapshot Id",
        "type": "string"
      },
      "graph_id": {
        "title": "Graph Id",
        "type": "string"
      },
      "commit_sha": {
        "title": "Commit Sha",
        "type": "string"
      },
      "parent_ordinal": {
        "default": 0,
        "title": "Parent Ordinal",
        "type": "integer"
      },
      "relations": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Relations"
      },
      "direction": {
        "default": "UPSTREAM",
        "title": "Direction",
        "type": "string"
      },
      "max_depth": {
        "default": 3,
        "title": "Max Depth",
        "type": "integer"
      },
      "max_nodes": {
        "default": 1000,
        "title": "Max Nodes",
        "type": "integer"
      },
      "session_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Session Id"
      }
    },
    "required": [
      "project_id",
      "snapshot_id",
      "graph_id",
      "commit_sha"
    ],
    "title": "source_git_commit_impactArguments",
    "type": "object"
  },
  "output_schema": {
    "additionalProperties": true,
    "title": "source_git_commit_impactDictOutput",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
