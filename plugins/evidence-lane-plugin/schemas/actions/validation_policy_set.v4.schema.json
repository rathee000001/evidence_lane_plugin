        "title": "ValidationCommand",
        "type": "object"
      },
      "ValidationPolicy": {
        "additionalProperties": false,
        "description": "Only additional project checks; owning profile verifiers remain mandatory.",
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/$defs/ValidationRule"
            },
            "maxItems": 64,
            "title": "Checks",
            "type": "array"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
