{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "evidence-lane.public-action-contract.v1",
  "name": "pv_task_transition",
  "title": "Transition or correct one Delta",
  "description": "Append one explicit DROP or SUPERSEDE transition to the immutable Delta lifecycle ledger. SUPERSEDE requires a different queued replacement task. CORRECT_DROP is a hash-bound recovery for a DROP that was persisted before dependency validation failed. CORRECT_PREAPPROVAL_DONE is a hash-bound recovery for the exact premature TASK_DONE written while an unaccepted HIL proposal is still pending. Both preserve the failed event.",
  "input_schema": {
    "properties": {
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "task_id": {
        "title": "Task Id",
        "type": "string"
      },
      "transition": {
        "enum": [
          "DROP",
          "SUPERSEDE",
          "CORRECT_DROP",
          "CORRECT_PREAPPROVAL_DONE"
        ],
        "title": "Transition",
        "type": "string"
      },
      "decided_by": {
        "title": "Decided By",
        "type": "string"
      },
      "reason": {
        "title": "Reason",
        "type": "string"
      },
      "replacement_task_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Replacement Task Id"
      },
      "event_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Event Id"
      },
      "correction_of_event_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Correction Of Event Id"
      },
      "expected_backlog_sha256": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Backlog Sha256"
      }
    },
    "required": [
      "project_id",
      "task_id",
      "transition",
      "decided_by",
      "reason"
    ],
    "title": "pv_task_transitionArguments",
    "type": "object"
  },
  "output_schema": {
    "additionalProperties": true,
    "title": "pv_task_transitionDictOutput",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "route_contract": {
    "status": "CURRENT_ROUTE",
    "owner_skill": "evidence-lane-code-lifecycle",
    "mcp": {
      "server_identity": "evidence-lane",
      "tool_name": "pv_task_transition"
    },
    "internal_sdk": null,
    "service_dispatch": "PACKAGE_LOCAL_MCP_HANDLER",
    "skill_workflows": [
      {
        "owner_skill": "evidence-lane-code-lifecycle",
        "workflow": "task-execution",
        "order": 14
      }
    ],
    "executable": true
  },
