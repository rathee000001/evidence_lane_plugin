{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "aaf5bcde49b099d6bfedea0a0057f49ddca2624e26e8327d285bf62585bfd44a",
  "authority": "engine_typed_action_registry",
  "cross_project_read": false,
  "description": "Consume exact source-to-sector overrides in one attributed registration, optionally inheriting a prior route receipt.",
  "inputSchema": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "code_mode": {
        "default": "local_code",
        "enum": [
          "local_code",
          "github_code"
        ],
        "title": "Code Mode",
        "type": "string"
      },
      "git_mode": {
        "default": "AUTO",
        "enum": [
          "AUTO",
          "REQUIRED",
          "DISABLED"
        ],
        "title": "Git Mode",
        "type": "string"
      },
      "overrides": {
        "additionalProperties": {
          "type": "string"
        },
        "maxProperties": 100,
        "minProperties": 1,
        "title": "Overrides",
        "type": "object"
      },
      "parent_route_id": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Parent Route Id"
      },
      "source_assertions": {
        "additionalProperties": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "maxProperties": 256,
        "title": "Source Assertions",
        "type": "object"
      },
      "sources": {
        "items": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 256,
        "minItems": 1,
        "title": "Sources",
        "type": "array"
      }
    },
    "required": [
      "sources",
      "overrides"
    ],
    "title": "SourceRouteConfigure",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "lane_configure_routes",
  "outputSchema": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "lane_id": {
        "const": "sources",
        "default": "sources",
        "title": "Lane Id",
        "type": "string"
      },
      "metadata_provenance": {
        "const": "source_measurements_and_attributed_assertions",
        "default": "source_measurements_and_attributed_assertions",
        "title": "Metadata Provenance",
        "type": "string"
      },
      "operation": {
        "title": "Operation",
        "type": "string"
      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "result": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Result",
        "type": "object"
      },
      "source_bytes_mutated": {
        "const": false,
        "default": false,
        "title": "Source Bytes Mutated",
        "type": "boolean"
      }
    },
    "required": [
      "project_id",
      "operation",
      "result"
    ],
    "title": "SourceOperationResult",
    "type": "object"
  },
  "path_fields": [],
  "permission": "write",
