{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "e316b2b30bb83105369ba4e44ce356b253bdd9212266c68c1a19dcfd368366fe",
  "authority": "engine_typed_action_registry",
  "cross_project_read": false,
  "description": "Publish a new immutable lane-owned PPTX version with explicit structural and layout fidelity.",
  "inputSchema": {
    "$defs": {
      "PresentationReplacement": {
        "additionalProperties": false,
        "properties": {
          "expected_text": {
            "maxLength": 32768,
            "title": "Expected Text",
            "type": "string"
          },
          "paragraph_index": {
            "maximum": 8191,
            "minimum": 0,
            "title": "Paragraph Index",
            "type": "integer"
          },
          "part": {
            "pattern": "^ppt/(slides/slide|notesSlides/notesSlide)\\d+\\.xml$",
            "title": "Part",
            "type": "string"
          },
          "replacement_text": {
            "maxLength": 32768,
            "title": "Replacement Text",
            "type": "string"
          }
        },
        "required": [
          "part",
          "paragraph_index",
          "expected_text",
          "replacement_text"
        ],
        "title": "PresentationReplacement",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "expected_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Expected Sha256",
        "type": "string"
      },
      "lane_id": {
        "const": "ppt",
        "default": "ppt",
        "title": "Lane Id",
        "type": "string"
      },
      "replacements": {
        "items": {
          "$ref": "#/$defs/PresentationReplacement"
        },
        "maxItems": 32,
        "title": "Replacements",
        "type": "array"
      },
      "slide_order": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Slide Order"
      },
      "snapshot_id": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Snapshot Id",
        "type": "string"
      }
    },
    "required": [
      "snapshot_id",
      "expected_sha256"
    ],
    "title": "PresentationEdit",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "presentation_edit",
  "outputSchema": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "lane_id": {
        "const": "ppt",
        "default": "ppt",
        "title": "Lane Id",
        "type": "string"
      },
      "operation": {
        "title": "Operation",
        "type": "string"
      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "result": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Result",
        "type": "object"
      }
    },
    "required": [
      "project_id",
      "operation",
      "result"
    ],
    "title": "PresentationResult",
    "type": "object"
  },
  "path_fields": [],
  "permission": "write",
  "profile": "presentation",
  "project_required": true,
  "queryable_in_delta": false,
  "queued": false,
  "read_schemas": [],
  "required_tools": [],
  "requires_delta": true,
  "schema": "evidence-lane.action-schema.v4",
  "studio_read": false,
  "toolchain": {
    "contract_digest": "1589b4df821666596b6ecd1e1142d60cd757ead22fe03a040152d9aae00fda64",
    "fallback_after_invocation": false,
    "installation_implied": false,
    "installation_matrix": "toolchains/shared-toolchain.v4.json",
    "no_fallback_reason": "No equivalent alternate adapter is registered.",
    "operation": "presentation_edit",
    "profile": "presentation",
    "routes": [
      {
        "adapter": "evidence_lane_plugin.presentation_profile:edit_presentation",
        "argument_suffixes": {},
        "argument_values": {},
        "extension": null,
        "fidelity": "exact_contract",
        "host_profiles": [],
        "provider": "engine_cpu",
        "reason": "Registered engine adapter",
        "route_id": "presentation_edit.native_presentation",
        "systems": [
          "Windows",
          "Darwin",
          "Linux"
        ],
        "tool_ids": [
          "Python",
          "lxml"
        ]
      }
    ],
    "selection": "ordered_pre_invocation_readiness_and_exact_fidelity",
    "worker_operations": [
      "presentation_edit"
    ]
  },
  "verification_checks": [
    "presentation_snapshot_integrity"
  ],
  "worker_operations": [
    "presentation_edit"
  ],
  "workflow": "execute-project-plan"
}
