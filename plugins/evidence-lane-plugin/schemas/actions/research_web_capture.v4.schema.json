        "type": "integer"
      },
      "media": {
        "default": "auto",
        "enum": [
          "auto",
          "html",
          "text",
          "opaque"
        ],
        "title": "Media",
        "type": "string"
      },
      "timeout_seconds": {
        "default": 20,
        "maximum": 60,
        "minimum": 1,
        "title": "Timeout Seconds",
        "type": "integer"
      },
      "transport": {
        "default": "auto",
        "enum": [
          "auto",
          "httpx",
          "requests"
        ],
        "title": "Transport",
        "type": "string"
      },
      "url": {
        "maxLength": 8192,
        "minLength": 1,
        "title": "Url",
        "type": "string"
      }
    },
    "required": [
      "url"
    ],
    "title": "Capture",
    "type": "object"
  },
