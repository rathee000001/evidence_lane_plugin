{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "e316b2b30bb83105369ba4e44ce356b253bdd9212266c68c1a19dcfd368366fe",
  "authority": "engine_typed_action_registry",
  "cross_project_read": false,
  "description": "Build a bounded source graph only when an analysis consumer requests it.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "batch_id": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "title": "Batch Id",
        "type": "string"
      },
      "max_edges": {
        "default": 40000,
        "maximum": 1000000,
        "minimum": 1,
        "title": "Max Edges",
        "type": "integer"
      },
      "max_file_bytes": {
        "default": 4194304,
        "maximum": 8388608,
        "minimum": 1,
        "title": "Max File Bytes",
        "type": "integer"
      },
      "max_files": {
        "default": 2000,
        "maximum": 25000,
        "minimum": 1,
        "title": "Max Files",
        "type": "integer"
      },
      "max_nodes": {
        "default": 20000,
        "maximum": 500000,
        "minimum": 1,
        "title": "Max Nodes",
        "type": "integer"
      },
      "max_total_bytes": {
        "default": 67108864,
        "maximum": 1073741824,
        "minimum": 1,
        "title": "Max Total Bytes",
        "type": "integer"
      },
      "member_path_prefixes": {
        "anyOf": [
          {
            "items": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 256,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Member Path Prefixes"
      },
      "occurrence_ordinals": {
        "anyOf": [
          {
            "items": {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            "maxItems": 256,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Occurrence Ordinals"
      }
    },
    "required": [
      "batch_id"
    ],
    "title": "SourceGraphRequest",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "source_graph",
  "outputSchema": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "lane_id": {
        "const": "sources",
        "default": "sources",
        "title": "Lane Id",
        "type": "string"
      },
      "metadata_provenance": {
        "const": "source_measurements_and_attributed_assertions",
        "default": "source_measurements_and_attributed_assertions",
        "title": "Metadata Provenance",
        "type": "string"
      },
      "operation": {
        "title": "Operation",
        "type": "string"
      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "result": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Result",
        "type": "object"
      },
      "source_bytes_mutated": {
        "const": false,
        "default": false,
        "title": "Source Bytes Mutated",
        "type": "boolean"
      }
    },
    "required": [
      "project_id",
      "operation",
      "result"
    ],
    "title": "SourceOperationResult",
    "type": "object"
  },
  "path_fields": [],
  "permission": "write",
  "profile": "sources",
  "project_required": true,
  "queryable_in_delta": false,
  "queued": false,
  "read_schemas": [],
  "required_tools": [],
