{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "e316b2b30bb83105369ba4e44ce356b253bdd9212266c68c1a19dcfd368366fe",
  "authority": "engine_typed_action_registry",
  "cross_project_read": false,
  "description": "Send one bounded hash-only observation to an exact OTLP, Langfuse or Grafana connector resource.",
  "inputSchema": {
    "additionalProperties": false,
    "description": "Export one hash-only observation through one exact provider resource.",
    "properties": {
      "action_name": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "title": "Action Name",
        "type": "string"
      },
      "attribute_sha256": {
        "additionalProperties": {
          "type": "string"
        },
        "maxProperties": 32,
        "title": "Attribute Sha256",
        "type": "object"
      },
      "correlation_id": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
        "title": "Correlation Id",
        "type": "string"
      },
      "dashboard_uid": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Dashboard Uid"
      },
      "duration_nanoseconds": {
        "default": 0,
        "maximum": 86400000000000,
        "minimum": 0,
        "title": "Duration Nanoseconds",
        "type": "integer"
      },
      "input_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Input Sha256",
        "type": "string"
      },
      "lane_id": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "title": "Lane Id",
        "type": "string"
      },
      "max_request_bytes": {
        "default": 131072,
        "maximum": 262144,
        "minimum": 4096,
        "title": "Max Request Bytes",
        "type": "integer"
      },
      "max_response_bytes": {
        "default": 1048576,
        "maximum": 4194304,
        "minimum": 1024,
        "title": "Max Response Bytes",
        "type": "integer"
      },
      "metric_value": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Metric Value"
      },
      "observed_at_unix_nano": {
        "maximum": 4102444800000000000,
        "minimum": 1,
        "title": "Observed At Unix Nano",
        "type": "integer"
      },
      "plugin_id": {
        "anyOf": [
          {
            "pattern": "^[a-z][a-z0-9-]{2,63}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Plugin Id"
      },
      "redaction_receipt_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Redaction Receipt Sha256",
        "type": "string"
      },
      "resource_id": {
        "maxLength": 266,
        "minLength": 10,
        "title": "Resource Id",
        "type": "string"
      },
      "result_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Result Sha256",
        "type": "string"
      },
      "signal": {
        "maxLength": 32,
        "minLength": 3,
        "title": "Signal",
        "type": "string"
      },
      "timeout_seconds": {
        "default": 20,
        "exclusiveMinimum": 0,
        "maximum": 60,
        "title": "Timeout Seconds",
        "type": "number"
      },
      "tool_id": {
        "enum": [
          "OpenTelemetry",
          "Langfuse",
          "Grafana"
        ],
        "title": "Tool Id",
        "type": "string"
      }
    },
    "required": [
      "tool_id",
      "signal",
      "lane_id",
      "resource_id",
      "action_name",
      "correlation_id",
      "input_sha256",
      "result_sha256",
      "redaction_receipt_sha256",
      "observed_at_unix_nano"
    ],
    "title": "ObservabilityExportRequest",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "observability_export",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "delivery": {
        "additionalProperties": true,
        "title": "Delivery",
        "type": "object"
      },
      "kind": {
        "enum": [
          "evaluation",
          "observability"
        ],
        "title": "Kind",
        "type": "string"
      },
      "receipt_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Receipt Sha256",
        "type": "string"
      },
      "tool_id": {
        "enum": [
          "LangSmith",
          "OpenTelemetry",
          "Langfuse",
          "Grafana"
        ],
        "title": "Tool Id",
        "type": "string"
      }
    },
    "required": [
      "tool_id",
      "kind",
      "delivery",
      "receipt_sha256"
    ],
    "title": "ExternalEvidenceResult",
    "type": "object"
  },
