{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "efe2793f4f5d9005c546d5eaaa189f534ac94a76f4eabc7b67f08eaac1cdcb65",
  "authority": "engine_typed_action_registry",
  "cross_project_read": false,
  "description": "Snapshot one exact document and its bounded native structure in the separate Docs lane.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "expected_snapshot": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Snapshot"
      },
      "filename": {
        "maxLength": 1000,
        "minLength": 1,
        "title": "Filename",
        "type": "string"
      },
      "lane_id": {
        "const": "docs",
        "default": "docs",
        "title": "Lane Id",
        "type": "string"
      },
      "max_file_bytes": {
        "default": 1048576,
        "maximum": 8388608,
        "minimum": 1,
        "title": "Max File Bytes",
        "type": "integer"
      }
    },
    "required": [
      "filename"
    ],
    "title": "DocumentIndex",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "document_refresh",
  "outputSchema": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "lane_id": {
        "const": "docs",
        "default": "docs",
        "title": "Lane Id",
        "type": "string"
      },
      "operation": {
        "title": "Operation",
        "type": "string"
      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "result": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Result",
        "type": "object"
      }
    },
    "required": [
      "project_id",
      "operation",
      "result"
    ],
    "title": "DocumentResult",
    "type": "object"
  },
  "path_fields": [
    "filename"
  ],
  "permission": "write",
  "profile": "document",
  "project_required": true,
  "queryable_in_delta": false,
  "queued": false,
  "read_schemas": [],
  "required_tools": [],
  "requires_delta": true,
  "schema": "evidence-lane.action-schema.v4",
  "source_routes": {
    "implicit_global_default": false,
    "lanes": [
      "docs"
    ],
    "path_fields": [
      "filename"
    ],
    "selection": "delta_enter.source_route"
  },
  "studio_read": false,
  "toolchain": {
    "contract_digest": "8afcfbf43a06ed479838041c032bfe8f857da2ec3589dd38dcf5440cdfafb23e",
    "fallback_after_invocation": false,
    "installation_implied": false,
    "installation_matrix": "toolchains/shared-toolchain.v4.json",
    "no_fallback_reason": "No equivalent alternate adapter is registered.",
    "operation": "document_refresh",
    "profile": "document",
    "routes": [
      {
        "adapter": "evidence_lane_plugin.document_profile:index_document",
        "argument_suffixes": {},
        "argument_values": {},
        "extension": null,
        "fidelity": "exact_contract",
        "host_profiles": [],
        "provider": "engine_cpu",
        "reason": "Registered engine adapter",
        "route_id": "document_refresh.engine",
        "systems": [
          "Windows"
        ],
        "tool_ids": [
          "Python"
        ]
      }
    ],
    "selection": "ordered_pre_invocation_readiness_and_exact_fidelity",
    "worker_operations": [
      "document_parse_file"
    ]
  },
  "verification_checks": [
    "document_snapshot_integrity",
    "document_source_hash_unchanged"
  ],
  "worker_operations": [
    "document_parse_file"
  ],
  "workflow": "refresh-project-evidence"
}
