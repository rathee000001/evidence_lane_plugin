        "type": "integer"
      },
      "incompatible_input_decision": {
        "anyOf": [
          {
            "const": "ACCEPT",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Incompatible Input Decision"
      },
      "reason": {
        "maxLength": 1000,
        "minLength": 1,
        "title": "Reason",
        "type": "string"
      },
      "request_id": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "title": "Request Id",
        "type": "string"
      }
    },
    "required": [
      "exchange_id",
      "envelope_digest",
      "expected_version",
      "decision",
      "reason"
    ],
    "title": "CanonDecide",
    "type": "object"
  },
