        "title": "Project Id",
        "type": "string"
      },
      "lane": {
        "title": "Lane",
        "type": "string"
      },
      "query": {
        "title": "Query",
        "type": "string"
      },
      "limit": {
        "default": 20,
        "title": "Limit",
        "type": "integer"
      },
      "retrieval": {
        "default": "hybrid",
        "title": "Retrieval",
        "type": "string"
      }
    },
    "required": [
      "project_id",
      "lane",
      "query"
    ],
    "title": "lane_searchArguments",
    "type": "object"
  },
  "output_schema": {
