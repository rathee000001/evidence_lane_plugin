    "properties": {
      "batch_id": {
        "maxLength": 192,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "title": "Batch Id",
        "type": "string"
      },
      "code_lane": {
        "default": "local_code",
        "enum": [
          "local_code",
          "github_code"
        ],
        "title": "Code Lane",
        "type": "string"
      },
      "custom_work_classes": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "maxItems": 8,
        "title": "Custom Work Classes",
        "type": "array"
      },
      "explicit_project_type": {
        "anyOf": [
          {
            "maxLength": 128,
            "pattern": "^(CODE|DATA|DOCUMENT|MEDIA|RESEARCH|MIXED|CUSTOM:[A-Za-z0-9][A-Za-z0-9 ._/-]{0,119})$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Explicit Project Type"
      },
      "explicit_work_classes": {
        "items": {
          "type": "string"
        },
        "maxItems": 16,
        "title": "Explicit Work Classes",
        "type": "array"
      },
      "git_mode": {
        "default": "AUTO",
        "enum": [
          "AUTO",
          "REQUIRED",
          "DISABLED"
        ],
        "title": "Git Mode",
        "type": "string"
      },
      "max_result_bytes": {
        "default": 524288,
        "maximum": 2097152,
        "minimum": 8192,
        "title": "Max Result Bytes",
        "type": "integer"
      },
      "requested_outcome": {
        "maxLength": 4000,
        "minLength": 1,
        "title": "Requested Outcome",
        "type": "string"
      },
      "work_classification_request": {
        "anyOf": [
          {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Work Classification Request"
      }
    },
    "required": [
      "batch_id",
      "requested_outcome"
    ],
    "title": "ProjectWorkflowRequest",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": false,
