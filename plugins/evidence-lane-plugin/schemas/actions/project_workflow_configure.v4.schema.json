      },
      "workflow_and_work_classification_are_distinct": {
        "const": true,
        "default": true,
        "title": "Workflow And Work Classification Are Distinct",
        "type": "boolean"
      },
      "workflow_dependency_readiness_checked": {
        "const": false,
        "default": false,
        "title": "Workflow Dependency Readiness Checked",
        "type": "boolean"
      },
      "workflow_digest": {
        "title": "Workflow Digest",
        "type": "string"
      }
    },
    "required": [
      "project_id",
      "batch_id",
      "batch_digest",
      "project_type",
      "classification_basis",
      "selected_sector_lanes",
      "authority_references",
      "stage_sequence",
      "artifact_contracts",
      "project_class_policy",
