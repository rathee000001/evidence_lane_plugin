{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "aaf5bcde49b099d6bfedea0a0057f49ddca2624e26e8327d285bf62585bfd44a",
  "authority": "engine_typed_action_registry",
  "cross_project_read": false,
  "description": "Receive an exact source-sealed packet as its destination participant; never mutate the source project.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "envelope_digest": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Envelope Digest",
        "type": "string"
      },
      "exchange_id": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "title": "Exchange Id",
        "type": "string"
      },
      "request_id": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "title": "Request Id",
        "type": "string"
      },
      "source_project_id": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "title": "Source Project Id",
        "type": "string"
      }
    },
    "required": [
      "source_project_id",
      "exchange_id",
      "envelope_digest"
    ],
    "title": "CanonReceive",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "task_evidence_receive",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "artifact_path": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Artifact Path"
      },
      "authority": {
        "const": "canon",
        "default": "canon",
        "title": "Authority",
        "type": "string"
      },
      "compatibility_reasons": {
        "items": {
          "type": "string"
        },
        "title": "Compatibility Reasons",
        "type": "array"
      },
      "duplicate": {
        "default": false,
        "title": "Duplicate",
        "type": "boolean"
      },
      "envelope_digest": {
        "title": "Envelope Digest",
        "type": "string"
      },
      "exchange_id": {
        "title": "Exchange Id",
        "type": "string"
      },
      "local_role": {
        "default": "both",
        "enum": [
          "outbox",
          "inbox",
          "both"
        ],
        "title": "Local Role",
        "type": "string"
      },
      "plan_mutated": {
        "default": false,
        "title": "Plan Mutated",
        "type": "boolean"
      },
      "receiver_decision_required": {
        "default": false,
        "title": "Receiver Decision Required",
        "type": "boolean"
      },
      "source_write_granted": {
        "default": false,
        "title": "Source Write Granted",
        "type": "boolean"
      },
      "state": {
        "enum": [
          "sealed",
          "received",
          "admitted",
          "rejected",
          "needs_clarification",
          "superseded"
        ],
        "title": "State",
        "type": "string"
      }
    },
    "required": [
      "exchange_id",
      "envelope_digest",
      "state"
    ],
    "title": "CanonSent",
    "type": "object"
  },
  "path_fields": [],
  "permission": "write",
  "profile": "canon",
  "project_required": true,
  "queryable_in_delta": false,
