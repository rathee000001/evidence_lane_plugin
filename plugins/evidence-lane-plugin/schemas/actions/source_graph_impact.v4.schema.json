{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "aaf5bcde49b099d6bfedea0a0057f49ddca2624e26e8327d285bf62585bfd44a",
  "authority": "engine_typed_action_registry",
  "cross_project_read": false,
  "description": "Append bounded impact evidence from selected source graph nodes.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "direction": {
        "default": "UPSTREAM",
        "enum": [
          "UPSTREAM",
          "DOWNSTREAM",
          "BOTH"
        ],
        "title": "Direction",
        "type": "string"
      },
      "graph_id": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "title": "Graph Id",
        "type": "string"
      },
      "max_depth": {
        "default": 3,
        "maximum": 10,
        "minimum": 1,
        "title": "Max Depth",
        "type": "integer"
      },
      "max_nodes": {
        "default": 1000,
        "maximum": 10000,
        "minimum": 1,
        "title": "Max Nodes",
        "type": "integer"
      },
      "relations": {
        "anyOf": [
          {
            "items": {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Relations"
      },
      "seed_node_ids": {
        "items": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        "maxItems": 256,
        "minItems": 1,
        "title": "Seed Node Ids",
        "type": "array"
      }
    },
    "required": [
      "graph_id",
      "seed_node_ids"
    ],
    "title": "SourceGraphImpactRequest",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "source_graph_impact",
  "outputSchema": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "lane_id": {
        "const": "sources",
        "default": "sources",
        "title": "Lane Id",
        "type": "string"
      },
      "metadata_provenance": {
        "const": "source_measurements_and_attributed_assertions",
        "default": "source_measurements_and_attributed_assertions",
        "title": "Metadata Provenance",
        "type": "string"
      },
      "operation": {
        "title": "Operation",
        "type": "string"
      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "result": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Result",
        "type": "object"
      },
      "source_bytes_mutated": {
        "const": false,
        "default": false,
        "title": "Source Bytes Mutated",
        "type": "boolean"
      }
    },
    "required": [
      "project_id",
      "operation",
      "result"
    ],
    "title": "SourceOperationResult",
    "type": "object"
  },
  "path_fields": [],
  "permission": "write",
  "profile": "sources",
  "project_required": true,
  "queryable_in_delta": false,
  "queued": false,
  "read_schemas": [],
  "required_tools": [],
  "requires_delta": false,
  "schema": "evidence-lane.action-schema.v4",
  "studio_read": false,
  "toolchain": {
    "contract_digest": "0bc19538d35a1f5f434e367df49f21aad1ffc6419b417daabb76fd1f7a03459e",
    "fallback_after_invocation": false,
    "installation_implied": false,
    "installation_matrix": "toolchains/shared-toolchain.v4.json",
    "no_fallback_reason": "No equivalent alternate adapter is registered.",
    "operation": "source_graph_impact",
    "profile": "sources",
    "routes": [
      {
        "adapter": "evidence_lane_plugin.source_intake:register_source_actions.<locals>.bind.<locals>.handler",
        "argument_suffixes": {},
        "argument_values": {},
        "extension": null,
        "fidelity": "exact_contract",
        "host_profiles": [],
        "provider": "engine_cpu",
        "reason": "Registered engine adapter",
        "route_id": "source_graph_impact.engine",
        "systems": [
          "Windows",
          "Darwin",
          "Linux"
        ],
        "tool_ids": [
          "Python"
        ]
      }
    ],
    "selection": "ordered_pre_invocation_readiness_and_exact_fidelity",
    "worker_operations": []
  },
  "verification_checks": [],
  "worker_operations": [],
  "workflow": "manage-project-sources"
}
