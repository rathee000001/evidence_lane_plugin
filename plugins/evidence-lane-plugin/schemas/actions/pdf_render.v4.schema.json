        "default": 12000000,
        "maximum": 25000000,
        "minimum": 1000,
        "title": "Max Pixels Per Page",
        "type": "integer"
      },
      "pages": {
        "items": {
          "type": "integer"
        },
        "maxItems": 50,
        "minItems": 1,
        "title": "Pages",
        "type": "array"
      },
      "snapshot_id": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Snapshot Id",
        "type": "string"
      }
    },
    "required": [
      "snapshot_id",
      "pages"
    ],
    "title": "PdfRender",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": true,
  "name": "pdf_render",
