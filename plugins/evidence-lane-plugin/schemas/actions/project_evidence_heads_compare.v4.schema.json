{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "aaf5bcde49b099d6bfedea0a0057f49ddca2624e26e8327d285bf62585bfd44a",
  "authority": "engine_typed_action_registry",
  "cross_project_read": true,
  "description": "Compare exact published project evidence lane heads without reading historical content.",
  "inputSchema": {
    "$defs": {
      "RootReference": {
        "additionalProperties": false,
        "properties": {
          "commit_id": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Id"
          },
          "head_digest": {
            "pattern": "^(?:[0-9a-f]{64})?$",
            "title": "Head Digest",
            "type": "string"
          },
          "revision": {
            "minimum": 0,
            "title": "Revision",
            "type": "integer"
          },
          "singleton": {
            "const": 1,
            "default": 1,
            "title": "Singleton",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "head_digest",
          "commit_id"
        ],
        "title": "RootReference",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "left_root": {
        "$ref": "#/$defs/RootReference"
      },
      "max_bytes": {
        "default": 1048576,
        "maximum": 2097152,
        "minimum": 4096,
        "title": "Max Bytes",
        "type": "integer"
      },
      "max_commits": {
        "default": 128,
        "maximum": 2048,
        "minimum": 1,
        "title": "Max Commits",
        "type": "integer"
      },
      "right_root": {
        "$ref": "#/$defs/RootReference"
      },
      "timeout_ms": {
        "default": 10000,
        "maximum": 30000,
        "minimum": 100,
        "title": "Timeout Ms",
        "type": "integer"
      }
    },
    "required": [
      "left_root",
      "right_root"
    ],
    "title": "Diff",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "mutates": false,
  "name": "project_evidence_heads_compare",
  "outputSchema": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "mutation_performed": {
        "const": false,
        "default": false,
        "title": "Mutation Performed",
        "type": "boolean"
      },
      "operation": {
        "title": "Operation",
        "type": "string"
      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "refresh_performed": {
        "const": false,
        "default": false,
        "title": "Refresh Performed",
        "type": "boolean"
      },
      "result": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Result",
        "type": "object"
      }
    },
    "required": [
      "project_id",
      "operation",
      "result"
    ],
    "title": "ReadResult",
    "type": "object"
  },
  "path_fields": [],
  "permission": "read",
  "profile": "projects",
  "project_required": true,
  "queryable_in_delta": true,
  "queued": false,
