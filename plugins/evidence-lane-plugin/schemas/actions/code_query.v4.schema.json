  "description": "Search one exact Code snapshot with bounded FTS5/BM25 or typed fact queries.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "collection": {
        "default": "text",
        "enum": [
          "text",
          "files",
          "symbols",
          "imports",
          "calls",
          "routes",
          "dependencies",
          "receipts",
          "diagnostics",
          "changes"
