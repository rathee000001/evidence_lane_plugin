        "title": "Collection",
        "type": "string"
      },
      "lane_id": {
        "default": "local_code",
        "enum": [
          "local_code",
          "github_code"
        ],
        "title": "Lane Id",
        "type": "string"
      },
      "limit": {
        "default": 20,
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "match_mode": {
        "default": "all",
        "enum": [
          "all",
          "any"
        ],
        "title": "Match Mode",
        "type": "string"
      },
      "max_bytes": {
        "default": 65536,
        "maximum": 262144,
        "minimum": 2048,
        "title": "Max Bytes",
        "type": "integer"
      },
      "offset": {
        "default": 0,
        "maximum": 1000000,
        "minimum": 0,
        "title": "Offset",
        "type": "integer"
      },
      "path_prefix": {
        "anyOf": [
          {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Path Prefix"
      },
      "query": {
        "anyOf": [
          {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Query"
      },
      "snapshot_id": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Snapshot Id",
        "type": "string"
      }
    },
    "required": [
      "snapshot_id"
    ],
    "title": "CodeQuery",
    "type": "object"
