{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "action_set_sha256": "e316b2b30bb83105369ba4e44ce356b253bdd9212266c68c1a19dcfd368366fe",
  "authority": "engine_typed_action_registry",
  "cross_project_read": true,
  "description": "Fetch exact stored Code file or chunk bytes with bounded text or base64 output.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "byte_offset": {
        "default": 0,
        "maximum": 1048576,
        "minimum": 0,
        "title": "Byte Offset",
        "type": "integer"
      },
      "end_line": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "End Line"
      },
      "lane_id": {
        "default": "local_code",
        "enum": [
          "local_code",
          "github_code"
        ],
        "title": "Lane Id",
        "type": "string"
      },
      "max_bytes": {
        "default": 256000,
        "maximum": 1000000,
        "minimum": 1,
        "title": "Max Bytes",
        "type": "integer"
      },
      "max_lines": {
        "default": 400,
        "maximum": 1000,
        "minimum": 1,
        "title": "Max Lines",
        "type": "integer"
      },
      "ref_id": {
        "maxLength": 1100,
        "minLength": 6,
        "title": "Ref Id",
        "type": "string"
      },
      "snapshot_id": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Snapshot Id",
        "type": "string"
      },
      "start_line": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Start Line"
      }
    },
    "required": [
      "snapshot_id",
      "ref_id"
    ],
    "title": "Fetch",
    "type": "object"
  },
  "installed_execution_claimed": false,
  "lane_fetch": {
    "digest_result": "file_sha256",
    "lanes": [
      "local_code",
      "github_code"
    ],
    "offset_argument": "byte_offset",
    "path_argument": "ref_id",
    "path_prefix": "file:",
    "path_result": "path",
    "primary_representation": null,
    "size_result": "size_bytes"
  },
  "mutates": false,
  "name": "fetch",
  "outputSchema": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "mutation_performed": {
        "const": false,
        "default": false,
        "title": "Mutation Performed",
        "type": "boolean"
      },
      "operation": {
        "title": "Operation",
        "type": "string"
      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "refresh_performed": {
        "const": false,
        "default": false,
        "title": "Refresh Performed",
        "type": "boolean"
      },
      "result": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Result",
        "type": "object"
      }
    },
    "required": [
      "project_id",
      "operation",
      "result"
    ],
    "title": "ReadResult",
    "type": "object"
  },
