                "type": "string"
              },
              "type": "array"
            },
            "maxItems": 100,
            "title": "Rows",
            "type": "array"
          },
          "text": {
            "default": "",
            "maxLength": 16384,
            "title": "Text",
            "type": "string"
          },
          "width": {
            "exclusiveMinimum": 0,
            "maximum": 100,
            "title": "Width",
            "type": "number"
          },
          "x": {
            "maximum": 100,
            "minimum": 0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "maximum": 100,
            "minimum": 0,
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "name",
          "x",
          "y",
          "width",
          "height"
