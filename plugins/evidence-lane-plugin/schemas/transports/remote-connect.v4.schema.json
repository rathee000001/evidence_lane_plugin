{
  "$defs": {
    "ClientHello": {
      "additionalProperties": false,
      "properties": {
        "configured_profile": {
          "default": "unknown",
          "title": "Configured Profile",
          "type": "string"
        },
        "peer_capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Peer Capabilities",
          "type": "array"
        },
        "peer_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peer Name"
        },
        "peer_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peer Version"
        },
        "protocol": {
          "default": "local_api",
          "enum": [
            "local_api",
            "mcp_stdio"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "protocol_version": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Version"
        }
      },
      "title": "ClientHello",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "hello": {
      "$ref": "#/$defs/ClientHello"
    },
    "instance_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Instance Id",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    }
  },
  "required": [
    "instance_id",
    "policy_digest"
  ],
  "title": "RemoteConnect",
  "type": "object"
}
