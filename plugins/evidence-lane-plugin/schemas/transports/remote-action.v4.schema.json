{
  "$defs": {
    "ActionRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Action",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "project_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "ActionRequest",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connection_token": {
      "pattern": "^[A-Za-z0-9_-]{43,128}$",
      "title": "Connection Token",
      "type": "string"
    },
    "instance_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Instance Id",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ActionRequest"
    }
  },
  "required": [
    "instance_id",
    "policy_digest",
    "connection_token",
    "request"
  ],
  "title": "RemoteAction",
  "type": "object"
}
