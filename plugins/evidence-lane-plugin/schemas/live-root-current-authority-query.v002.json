{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lane.local/schemas/live-root-current-authority-query.v002.json",
  "title": "Evidence Lane live-root current-authority query",
  "description": "Hooks-independent query over the registry-derived working authority classes governed by ENV/UOP. Project Overlay is HIL-only, live-root files remain governed through their current sector or named authority, and accepted archives are never opened or queried.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "session_id", "query"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1, "maxLength": 2000},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
  },
  "x-evidence-lane-contract": {
    "schema": "evidence-lane.live-root-current-authority-query.v2",
    "hooks_required": false,
    "env_uop_role": "GOVERNING_CONTROL_PLANE_NOT_AUTHORITY_ARMS",
    "working_authority_classes_derived": true,
    "env_uop_governed_current_authority_classes": [
      {"id": "PROJECT_SECTORS_AND_ROOT_FILES", "members_from": "canonical_lane_registry", "includes_project_engulf": true},
      {"id": "AI_LEARNING"},
      {"id": "CANON_GRAPH"},
      {"id": "PROJECT_MEMORY_DB"},
      {"id": "HOST_CONVERSATION_MEMORY_MD"},
      {"id": "AGENTS_MD"},
      {"id": "PROJECT_UNIVERSE"},
      {"id": "CONNECTOR_BRAIN"}
    ],
    "hil_only_layers": ["PROJECT_OVERLAY"],
    "root_inventory": {
      "included": ["universe", "connector_brain", "sources", "sectors", "root_files", "other_live_root_directories"],
      "separate_governed_arms": ["ai_learning", "project_memory_db", "canon_graph", "agents_md", "host_memory_md"],
      "excluded_from_ordinary_query": ["accepted", "project_overlay"]
    },
    "retrieval": {
      "primary": ["FTS5", "BM25"],
      "relevant_match_fallback": ["normalized_related_query", "bounded_fuzzy_locator"],
      "direct_sector_fallback_on_memory_or_canon_no_hit": true
    },
    "stale_or_no_hit": {
      "refresh_order": ["AI_LEARNING", "CANON_GRAPH", "PROJECT_MEMORY", "PROJECT_UNIVERSE"],
      "active_task_mismatch_is_stale": true,
      "stale_active_task_hits_suppressed_before_fallback": true,
      "connector_brain_action": "INTEGRITY_VALIDATE_CURRENT_CATALOG",
      "maximum_refresh_cycles": 1,
      "maximum_query_retries": 1,
      "continuing_ai_learning_no_hit_is_valid": true
    },
    "archive_policy": {
      "accepted_hil_zip_opened": false,
      "accepted_hil_zip_queried": false,
      "root_nested_sector_history_allowed": true
    },
    "public_consumers": [
      "prompt_intent",
      "skills",
      "SDK",
      "MCP",
      "hooks_off_explicit_actions",
      "current_hook_event_registry"
    ]
  }
}
