{
  "$id": "evidence-lane://hooks/Stop/input/v4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "hook_event_name": {
      "const": "Stop"
    },
    "last_assistant_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "maxLength": 200,
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "stop_hook_active": {
      "type": "boolean"
    },
    "turn_id": {
      "maxLength": 128,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "hook_event_name",
    "session_id"
  ],
  "title": "Evidence Lane Stop visible input",
  "type": "object",
  "x-evidence-lane-captured-fields": [
    "hook_event_name",
    "last_assistant_message",
    "model",
    "session_id",
    "stop_hook_active",
    "turn_id"
  ],
  "x-native-task-attestation": "not_provided"
}
