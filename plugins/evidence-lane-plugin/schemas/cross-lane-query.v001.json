{
  "schema": "evidence-lane.cross-lane-query-contract.v1",
  "contract_version": 1,
  "scope": "ONE_PROJECT_LIVE_ROOT_EXPLICIT_LANE_SET",
  "lane_set": {
    "minimum_lanes": 2,
    "maximum_lanes": 8,
    "canonical_and_unique": true,
    "implicit_lane_discovery": false
  },
  "ranking": {
    "mode": "INDEPENDENT_PER_LANE_SOURCE_RANK_ONLY",
    "cross_lane_score_emitted": false,
    "raw_bm25_compared_between_lanes": false
  },
  "relation_types": [
    "EXACT_SOURCE_SHA256",
    "EXACT_CHUNK_SHA256",
    "EXACT_PATH_LOCATOR"
  ],
  "conflict_types": [
    "PATH_LOCATOR_CONTENT_CONFLICT",
    "SOURCE_LOCATOR_CONTENT_CONFLICT"
  ],
  "budgets": {
    "maximum_results_per_lane": 100,
    "maximum_timeout_ms_per_lane": 60000,
    "default_aggregate_limit": "LANE_COUNT_X_SELECTED_RESULTS_PER_LANE",
    "maximum_aggregate_limit": 200,
    "aggregate_product_rule": "LANE_COUNT_X_SELECTED_RESULTS_PER_LANE_MUST_NOT_EXCEED_OR_OUTGROW_AGGREGATE_LIMIT",
    "default_relation_limit": 100,
    "maximum_relation_limit": 200,
    "default_conflict_limit": 100,
    "maximum_conflict_limit": 200,
    "default_synthesis_limit": 50,
    "maximum_synthesis_limit": 100
  },
  "authority_provenance": [
    "project_id",
    "live_root_authority_ref",
    "bundle_sha256",
    "canonical_lane_id",
    "ref_id",
    "path",
    "locator",
    "source_sha256",
    "chunk_sha256",
    "parser_state"
  ],
  "synthesis": {
    "mode": "EVIDENCE_ONLY_NO_SEMANTIC_INFERENCE",
    "sources": [
      "SUPPORTED_RELATION",
      "EXPLICIT_CONFLICT"
    ],
    "free_form_model_summary": false
  },
  "receipt": {
    "schema": "evidence-lane.cross-lane-query-receipt.v1",
    "sealed_by": "SHA256_CANONICAL_JSON_WITHOUT_RECEIPT_SHA256",
    "binds": [
      "project_id",
      "live_root_authority_ref",
      "bundle_sha256",
      "canonical_lane_set",
      "query",
      "retrieval",
      "rank_contract",
      "parallel_receipt_sha256",
      "lane_receipts_sha256",
      "budgets",
      "results_sha256",
      "relations_sha256",
      "conflicts_sha256",
      "synthesis_sha256"
    ],
    "persisted": false,
    "reason_not_persisted": "QUERY_ROUTE_IS_READ_ONLY"
  }
}
