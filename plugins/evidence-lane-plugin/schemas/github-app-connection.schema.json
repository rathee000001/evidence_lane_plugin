{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencelane.org/schemas/github-app-connection.schema.json",
  "title": "Evidence Lane GitHub App connection backend",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "app_name", "app_slug", "description", "homepage_url", "post_authorization_redirect_url", "testing_url", "primary_profile", "alternate_profile", "oauth_security", "device_flow_security", "webhook", "secret_references", "secret_values_in_source", "project_pv_secret_storage_allowed", "workspace_secret_storage_allowed", "live_settings_write_gate", "mcp_inventory_separate", "receipt_sha256"],
  "properties": {
    "schema": {"const": "evidence-lane.github-app-connection.v1"},
    "status": {"const": "CURRENT_BACKEND_CONTRACT"},
    "app_name": {"const": "Evidence Lane"},
    "app_slug": {"const": "evidence-lane"},
    "description": {"type": "string", "minLength": 40, "maxLength": 1024},
    "homepage_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "post_authorization_redirect_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "testing_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "primary_profile": {"allOf": [{"$ref": "#/$defs/profile"}, {"properties": {"profile_id": {"const": "OAUTH_ON_INSTALL"}, "request_oauth_on_install": {"const": true}, "setup_url": {"type": "null"}, "setup_on_update": {"const": false}}}]},
    "alternate_profile": {"allOf": [{"$ref": "#/$defs/profile"}, {"properties": {"profile_id": {"const": "SETUP_REDIRECT_ON_UPDATE"}, "request_oauth_on_install": {"const": false}, "setup_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "setup_on_update": {"const": true}}}]},
    "oauth_security": {"type": "object", "additionalProperties": false, "required": ["authorization_code_state_required", "pkce_method", "callback_identity_revalidated", "access_token_cookie_encryption", "access_token_returned_to_browser"], "properties": {"authorization_code_state_required": {"const": true}, "pkce_method": {"const": "S256"}, "callback_identity_revalidated": {"const": true}, "access_token_cookie_encryption": {"const": "AES-256-GCM"}, "access_token_returned_to_browser": {"const": false}}},
    "device_flow_security": {"type": "object", "additionalProperties": false, "required": ["intended_surface", "provider_poll_interval_enforced", "raw_device_code_returned_to_browser", "opaque_poll_token_encryption", "provider_expiry_enforced"], "properties": {"intended_surface": {"const": "CODEX_CLI_OR_HEADLESS_HOST"}, "provider_poll_interval_enforced": {"const": true}, "raw_device_code_returned_to_browser": {"const": false}, "opaque_poll_token_encryption": {"const": "AES-256-GCM"}, "provider_expiry_enforced": {"const": true}}},
    "webhook": {"type": "object", "additionalProperties": false, "required": ["active", "url", "content_type", "tls_verification_required", "signature_header", "delivery_header", "event_header", "events"], "properties": {"active": {"const": true}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "content_type": {"const": "json"}, "tls_verification_required": {"const": true}, "signature_header": {"const": "X-Hub-Signature-256"}, "delivery_header": {"const": "X-GitHub-Delivery"}, "event_header": {"const": "X-GitHub-Event"}, "events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["check_run", "check_suite", "installation", "installation_repositories", "push", "workflow_run"]}}}},
    "secret_references": {"type": "object", "additionalProperties": false, "required": ["client_id", "client_secret", "webhook_secret", "session_secret"], "properties": {"client_id": {"const": "EVIDENCE_LANE_GITHUB_APP_CLIENT_ID"}, "client_secret": {"const": "EVIDENCE_LANE_GITHUB_APP_CLIENT_SECRET"}, "webhook_secret": {"const": "EVIDENCE_LANE_GITHUB_APP_WEBHOOK_SECRET"}, "session_secret": {"const": "EVIDENCE_LANE_GITHUB_APP_SESSION_SECRET"}}},
    "secret_values_in_source": {"const": false},
    "project_pv_secret_storage_allowed": {"const": false},
    "workspace_secret_storage_allowed": {"const": false},
    "live_settings_write_gate": {"const": "EXPLICIT_POST_BRANCH_MAIN_MERGE_AND_GITHUB_APP_UPGRADE_APPROVAL"},
    "mcp_inventory_separate": {"const": true},
    "receipt_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  },
  "$defs": {"profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "callback_urls", "request_oauth_on_install", "device_flow_enabled", "setup_url", "setup_on_update", "github_mutual_exclusion"], "properties": {"profile_id": {"enum": ["OAUTH_ON_INSTALL", "SETUP_REDIRECT_ON_UPDATE"]}, "callback_urls": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}}, "request_oauth_on_install": {"type": "boolean"}, "device_flow_enabled": {"const": true}, "setup_url": {"type": ["string", "null"], "format": "uri"}, "setup_on_update": {"type": "boolean"}, "github_mutual_exclusion": {"type": "string", "minLength": 20}}}}
}
