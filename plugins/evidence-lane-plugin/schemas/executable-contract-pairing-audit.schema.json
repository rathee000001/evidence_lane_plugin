{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencelane.org/schemas/executable-contract-pairing-audit.schema.json",
  "title": "Evidence Lane executable contract pairing audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "action_count",
    "actions",
    "skill_count",
    "skills",
    "hook_event_count",
    "hook_handler_count",
    "hooks",
    "schema_file_count",
    "source_module_count",
    "installed_test_count",
    "test_contract",
    "checks",
    "negative_proofs",
    "source_contracts",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "evidence-lane.executable-contract-pairing-audit.v1"},
    "status": {"const": "PASS"},
    "action_count": {"const": 91},
    "actions": {
      "type": "array",
      "minItems": 91,
      "maxItems": 91,
      "items": {
        "type": "object",
        "required": [
          "action",
          "status",
          "intent_event",
          "owner_skill",
          "skill_workflows",
          "schema",
          "internal_sdk",
          "internal_sdk_explicit",
          "sdk_binding",
          "mcp_binding",
          "outer_route",
          "env_selection",
          "uop_authorization",
          "named_or_sector_authority_route",
          "ordered_tools",
          "action_boundary_hook_events",
          "validation_and_receipt_required",
          "test_selectors",
          "fixture_classes",
          "source_test_policy",
          "action_receipt_sha256"
        ],
        "additionalProperties": true
      }
    },
    "skill_count": {"const": 26},
    "skills": {"type": "array", "minItems": 26, "maxItems": 26},
    "hook_event_count": {"const": 11},
    "hook_handler_count": {"const": 44},
    "hooks": {"type": "array", "minItems": 11, "maxItems": 11},
    "schema_file_count": {"type": "integer", "minimum": 91},
    "source_module_count": {"type": "integer", "minimum": 1},
    "installed_test_count": {"type": "integer", "minimum": 1},
    "test_contract": {"type": "object"},
    "checks": {"type": "object", "additionalProperties": {"const": true}},
    "negative_proofs": {"type": "object", "additionalProperties": {"const": false}},
    "source_contracts": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
