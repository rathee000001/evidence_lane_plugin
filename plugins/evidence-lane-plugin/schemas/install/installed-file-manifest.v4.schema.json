{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencelane.org/schemas/install/installed-file-manifest.v4.schema.json",
  "type": "object",
  "required": [
    "schema",
    "status",
    "file_count",
    "total_bytes",
    "files_sha256",
    "files",
    "mutable_engine_state_excluded",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "evidence-lane.installed-file-manifest.v4"
    },
    "status": {
      "const": "COMPLETE_IMMUTABLE_RELEASE"
    },
    "file_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32000000000
    },
    "files_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300000
    },
    "mutable_engine_state_excluded": {
      "const": true
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
