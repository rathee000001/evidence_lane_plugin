{
  "$id": "https://evidencelane.org/schemas/install/installed-file-manifest.v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "file_count": {
      "maximum": 300000,
      "minimum": 1,
      "type": "integer"
    },
    "files": {
      "maxItems": 300000,
      "minItems": 1,
      "type": "array"
    },
    "files_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mutable_engine_state_excluded": {
      "const": true
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "evidence-lane.installed-file-manifest.v4"
    },
    "status": {
      "const": "COMPLETE_IMMUTABLE_RELEASE"
    },
    "total_bytes": {
      "maximum": 32000000000,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "status",
    "file_count",
    "total_bytes",
    "files_sha256",
    "files",
    "mutable_engine_state_excluded",
    "receipt_sha256"
  ],
  "type": "object"
}
