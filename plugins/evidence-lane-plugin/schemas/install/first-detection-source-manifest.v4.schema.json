{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencelane.org/schemas/install/first-detection-source-manifest.v4.schema.json",
  "type": "object",
  "required": [
    "schema",
    "status",
    "repository",
    "sparse_root",
    "excluded_self_referential_paths",
    "file_count",
    "total_bytes",
    "files_sha256",
    "files",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "evidence-lane.first-detection-source-manifest.v4"
    },
    "status": {
      "const": "COMPLETE_EXACT_SPARSE_ROOT"
    },
    "repository": {
      "const": "https://github.com/rathee000001/evidence_lane_plugin"
    },
    "sparse_root": {
      "const": "plugins/evidence-lane-plugin"
    },
    "file_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "files": {
      "$ref": "#/$defs/files"
    },
    "files_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32768,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
