{
  "$defs": {
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 32768,
      "minItems": 1,
      "type": "array"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://evidencelane.org/schemas/install/first-detection-source-manifest.v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "file_count": {
      "maximum": 32768,
      "minimum": 1,
      "type": "integer"
    },
    "files": {
      "$ref": "#/$defs/files"
    },
    "files_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "repository": {
      "const": "https://github.com/rathee000001/evidence_lane_plugin"
    },
    "schema": {
      "const": "evidence-lane.first-detection-source-manifest.v4"
    },
    "sparse_root": {
      "const": "plugins/evidence-lane-plugin"
    },
    "status": {
      "const": "COMPLETE_EXACT_SPARSE_ROOT"
    },
    "total_bytes": {
      "maximum": 268435456,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "status",
    "repository",
    "sparse_root",
    "excluded_self_referential_paths",
    "file_count",
    "total_bytes",
    "files_sha256",
    "files",
    "receipt_sha256"
  ],
  "type": "object"
}
