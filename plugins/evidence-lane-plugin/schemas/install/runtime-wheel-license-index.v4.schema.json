{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencelane.org/schemas/install/runtime-wheel-license-index.v4.schema.json",
  "type": "object",
  "required": [
    "schema",
    "status",
    "wheel_count",
    "records",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "evidence-lane.runtime-wheel-license-index.v4"
    },
    "status": {
      "const": "COMPLETE_RELEASE_WHEEL_LICENSE_EVIDENCE"
    },
    "wheel_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
