{
  "$id": "https://evidencelane.org/schemas/install/runtime-wheel-license-index.v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "records": {
      "maxItems": 2000,
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "evidence-lane.runtime-wheel-license-index.v4"
    },
    "status": {
      "const": "COMPLETE_RELEASE_WHEEL_LICENSE_EVIDENCE"
    },
    "wheel_count": {
      "maximum": 2000,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "status",
    "wheel_count",
    "records",
    "receipt_sha256"
  ],
  "type": "object"
}
