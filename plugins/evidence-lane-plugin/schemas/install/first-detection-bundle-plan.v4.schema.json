{
  "$id": "https://evidencelane.org/schemas/install/first-detection-bundle-plan.v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "asset_groups": {
      "maxItems": 11,
      "minItems": 11,
      "type": "array"
    },
    "components": {
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "external_service_configuration": {
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    },
    "installation_state": {
      "const": "not_installed"
    },
    "installed_native_execution_claimed": {
      "const": false
    },
    "materialization_steps": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "component_id": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "create_venv",
              "pip_install"
            ]
          }
        },
        "required": [
          "operation",
          "component_id"
        ],
        "type": "object"
      },
      "minItems": 10,
      "type": "array"
    },
    "model_assets": {
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "native_inputs": {
      "maxItems": 13,
      "minItems": 13,
      "type": "array"
    },
    "offline_wheel_sets": {
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "provider_environments": {
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "retained_tool_count": {
      "maximum": 512,
      "minimum": 1,
      "type": "integer"
    },
    "schema": {
      "const": "evidence-lane.first-detection-bundle-plan.v4"
    },
    "status": {
      "const": "COMPLETE_PREINSTALL_SOURCE_PLAN"
    },
    "tool_assignments": {
      "maxItems": 512,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "status",
    "plugin",
    "target",
    "release_asset_policy",
    "components",
    "tool_assignments",
    "retained_tool_count",
    "provider_environments",
    "model_assets",
    "asset_groups",
    "native_inputs",
    "node_runtime",
    "python_runtimes",
    "git_runtime",
    "external_service_configuration",
    "offline_wheel_sets",
    "materialization_steps",
    "entrypoints",
    "source_inputs",
    "license_index",
    "excluded_office",
    "installation_state",
    "installed_native_execution_claimed",
    "receipt_sha256"
  ],
  "title": "Evidence Lane complete first-detection bundle plan v4",
  "type": "object"
}
