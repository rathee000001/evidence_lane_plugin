{
  "$defs": {
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://evidencelane.org/schemas/install/first-detection-installation.v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entrypoints": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "required": [
        "runtime_python",
        "runtime_pythonw",
        "plugin_root",
        "studio_launcher_executable",
        "mcp_launcher",
        "engine_launcher"
      ],
      "type": "object"
    },
    "installation_root": {
      "minLength": 3,
      "type": "string"
    },
    "project_state_root": {
      "type": "null"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "release_binding_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "release_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schema": {
      "const": "evidence-lane.first-detection-installation.v4"
    },
    "shared_once_across_projects": {
      "const": true
    },
    "status": {
      "const": "ACTIVE_INSTALLATION"
    }
  },
  "required": [
    "schema",
    "status",
    "installation_root",
    "release_binding_sha256",
    "release_receipt_sha256",
    "entrypoints",
    "shared_once_across_projects",
    "project_state_root",
    "receipt_sha256"
  ],
  "title": "Evidence Lane active shared installation v4",
  "type": "object"
}
