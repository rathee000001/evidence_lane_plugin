{
  "$defs": {
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://evidencelane.org/schemas/install/first-detection-component.v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "component_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "file_count": {
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 100000,
      "minItems": 1,
      "type": "array"
    },
    "files_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "part_count": {
      "maximum": 999,
      "minimum": 1,
      "type": "integer"
    },
    "part_index": {
      "maximum": 999,
      "minimum": 1,
      "type": "integer"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schema": {
      "const": "evidence-lane.first-detection-component.v4"
    },
    "status": {
      "const": "COMPLETE_RELEASE_COMPONENT"
    },
    "total_bytes": {
      "maximum": 2100000000,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "status",
    "component_id",
    "part_index",
    "part_count",
    "file_count",
    "total_bytes",
    "files_sha256",
    "files",
    "receipt_sha256"
  ],
  "title": "Evidence Lane release component v4",
  "type": "object"
}
