{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencelane.org/schemas/uop-domain-catalog.v2.schema.json",
  "title": "Evidence Lane adapted UOP15 domain catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "authority",
    "source_provenance",
    "behavior_source",
    "subgraph_contracts",
    "tables",
    "counts",
    "import_policy",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "evidence-lane.uop-domain-catalog.v2"
    },
    "status": {
      "const": "PASS_FULL_MMD_BEHAVIOR_BOUND"
    },
    "authority": {
      "const": "UOP15_CODEX_DOMAIN_CATALOG"
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "classification",
        "source_is_codex_authority",
        "source_database_sha256",
        "source_mmd_sha256",
        "source_dot_sha256",
        "source_database_mutated"
      ],
      "properties": {
        "source_is_codex_authority": {
          "const": false
        },
        "source_database_mutated": {
          "const": false
        },
        "source_database_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "source_mmd_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "source_dot_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        }
      }
    },
    "behavior_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packaged_path",
        "subgraph_count",
        "node_count",
        "edge_count",
        "dot_node_count",
        "dot_edge_count",
        "all_behaviors_require_codex_owner_or_exclusion"
      ],
      "properties": {
        "packaged_path": {
          "const": "toolchains/references/uop15-working-behavior.mmd"
        },
        "subgraph_count": {
          "const": 8
        },
        "node_count": {
          "const": 80
        },
        "edge_count": {
          "const": 57
        },
        "dot_node_count": {
          "const": 89
        },
        "dot_edge_count": {
          "const": 73
        },
        "all_behaviors_require_codex_owner_or_exclusion": {
          "const": true
        }
      }
    },
    "subgraph_contracts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "source_subgraph_id",
          "canonical_codex_owner",
          "classification",
          "source_sha256"
        ],
        "additionalProperties": true
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uop_deep_research_access_operator_v14",
        "uop_delta_operator",
        "uop_disclosure_boundary_operator",
        "uop_flash_receipt_v151",
        "uop_flash_receipt_v152",
        "uop_future_addition_ledger_v14",
        "uop_future_addition_ledger_v15",
        "uop_governance_root",
        "uop_governance_root_v15",
        "uop_human_gate_operator",
        "uop_knowledge_compression_operator",
        "uop_mode_cluster_operator",
        "uop_prompt_override_operator_v14",
        "uop_public_boundary_v15",
        "uop_public_operator_registry_v15",
        "uop_source_registry",
        "uop_source_state_operator",
        "uop_spatial_operator"
      ],
      "properties": {
        "uop_deep_research_access_operator_v14": {
          "$ref": "#/$defs/table"
        },
        "uop_delta_operator": {
          "$ref": "#/$defs/table"
        },
        "uop_disclosure_boundary_operator": {
          "$ref": "#/$defs/table"
        },
        "uop_flash_receipt_v151": {
          "$ref": "#/$defs/table"
        },
        "uop_flash_receipt_v152": {
          "$ref": "#/$defs/table"
        },
        "uop_future_addition_ledger_v14": {
          "$ref": "#/$defs/table"
        },
        "uop_future_addition_ledger_v15": {
          "$ref": "#/$defs/table"
        },
        "uop_governance_root": {
          "$ref": "#/$defs/table"
        },
        "uop_governance_root_v15": {
          "$ref": "#/$defs/table"
        },
        "uop_human_gate_operator": {
          "$ref": "#/$defs/table"
        },
        "uop_knowledge_compression_operator": {
          "$ref": "#/$defs/table"
        },
        "uop_mode_cluster_operator": {
          "$ref": "#/$defs/table"
        },
        "uop_prompt_override_operator_v14": {
          "$ref": "#/$defs/table"
        },
        "uop_public_boundary_v15": {
          "$ref": "#/$defs/table"
        },
        "uop_public_operator_registry_v15": {
          "$ref": "#/$defs/table"
        },
        "uop_source_registry": {
          "$ref": "#/$defs/table"
        },
        "uop_source_state_operator": {
          "$ref": "#/$defs/table"
        },
        "uop_spatial_operator": {
          "$ref": "#/$defs/table"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "import_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chatgpt_host_identity_imported",
        "historical_active_state_imported",
        "project_template_imported",
        "behavior_labels_are_commands",
        "current_codex_owner_required",
        "current_project_learning_plan_hil_boundaries_preserved",
        "per_delta_auto_admission_has_individual_hil",
        "historical_and_successor_deferred_behaviors_queryable_but_not_executable"
      ],
      "properties": {
        "chatgpt_host_identity_imported": {
          "const": false
        },
        "historical_active_state_imported": {
          "const": false
        },
        "project_template_imported": {
          "const": false
        },
        "behavior_labels_are_commands": {
          "const": false
        },
        "current_codex_owner_required": {
          "const": true
        },
        "current_project_learning_plan_hil_boundaries_preserved": {
          "const": true
        },
        "per_delta_auto_admission_has_individual_hil": {
          "const": false
        },
        "historical_and_successor_deferred_behaviors_queryable_but_not_executable": {
          "const": true
        }
      }
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "rows",
        "row_set_sha256"
      ],
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "row_set_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        }
      }
    }
  }
}
