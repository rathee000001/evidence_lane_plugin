{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-lane.local/schemas/live-root-six-authority-query.v001.json",
  "title": "Evidence Lane live-root six-authority query",
  "description": "Hooks-independent ENV/UOP-governed query across six distinct live authorities. Accepted HIL archives are never opened or queried.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "session_id", "query"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1, "maxLength": 2000},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
  },
  "x-evidence-lane-contract": {
    "schema": "evidence-lane.live-root-six-authority-query.v1",
    "hooks_required": false,
    "governance_order": ["ENV", "UOP"],
    "authorities": [
      {"id": "PROJECT_SECTORS", "members": 18, "includes_project_engulf": true},
      {"id": "AI_LEARNING"},
      {"id": "CANON_GRAPH"},
      {"id": "PROJECT_MEMORY"},
      {"id": "AGENTS_MD"},
      {"id": "HOST_CONVERSATION_MEMORY_MD"}
    ],
    "root_inventory": {
      "included": ["project_overlay", "universe", "sources", "sectors", "root_files", "other_live_root_directories"],
      "excluded": ["accepted", "ai_learning", "memory", "canon_generated_graph_bundle"]
    },
    "retrieval": {
      "primary": ["FTS5", "BM25"],
      "relevant_match_fallback": ["normalized_related_query", "bounded_fuzzy_locator"],
      "direct_sector_fallback_on_memory_or_canon_no_hit": true
    },
    "stale_or_no_hit": {
      "refresh_order": ["AI_LEARNING", "CANON_GRAPH", "PROJECT_MEMORY"],
      "maximum_refresh_cycles": 1,
      "maximum_query_retries": 1,
      "continuing_ai_learning_no_hit_is_valid": true
    },
    "archive_policy": {
      "accepted_hil_zip_opened": false,
      "accepted_hil_zip_queried": false,
      "root_nested_sector_history_allowed": true
    },
    "public_consumers": [
      "prompt_intent",
      "skills",
      "commands",
      "SDK",
      "MCP",
      "hooks_off_explicit_actions",
      "all_eleven_hooks"
    ]
  }
}
