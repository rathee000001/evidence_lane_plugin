{
  "ambient_python_required": false,
  "event_specific_handler_classes": true,
  "host_stage_count": 4,
  "host_stage_runner": "hooks/stage_runner.py",
  "host_stages": [
    {
      "id": "VALIDATE",
      "owners": [
        "hook_admission"
      ],
      "status": "Validating and redacting Evidence Lane {event}"
    },
    {
      "id": "SEAL",
      "owners": [
        "hook_classification",
        "hook_lifecycle_boundary"
      ],
      "status": "Classifying and sealing Evidence Lane {event}"
    },
    {
      "id": "TRANSPORT",
      "owners": [
        "event_specific_handler",
        "hook_transport"
      ],
      "status": "Handling and delivering Evidence Lane {event}"
    },
    {
      "id": "EMIT",
      "owners": [
        "hook_receipts",
        "hook_output"
      ],
      "status": "Verifying and emitting Evidence Lane {event}"
    }
  ],
  "monolithic_hook_implementation": false,
  "runtime_bridge": "hooks/runner.mjs",
  "schema": "evidence-lane.hook-stage-registry.v4",
  "stage_count": 6,
  "stages": [
    {
      "id": "validate_and_redact_input",
      "implementation": "hook_admission.admit_hook",
      "owner": "hook_admission"
    },
    {
      "id": "classify_event",
      "implementation": "hook_classification.classify_hook",
      "owner": "hook_classification"
    },
    {
      "id": "handle_event",
      "implementation": "hook_event_handlers.<Event>Handler.handle",
      "owner": "event_specific_handler"
    },
    {
      "automatic_retry": false,
      "id": "authenticate_and_deliver_once",
      "implementation": "hook_transport.deliver_hook",
      "owner": "hook_transport"
    },
    {
      "id": "verify_and_seal_receipt",
      "implementation": "hook_receipts.seal_hook_receipt",
      "owner": "hook_receipts"
    },
    {
      "id": "project_bounded_output",
      "implementation": "hook_output.project_hook_output",
      "owner": "hook_output"
    }
  ]
}
