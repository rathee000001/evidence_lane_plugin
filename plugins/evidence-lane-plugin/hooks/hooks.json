{
  "description": "Evidence Lane exact-session turn control: warm-attach the already-active package-local native MCP route with zero tunnel provisioning wait, PREPARE secret-redacted visible input before execution, reproject the paired Plan/Delta/source-change display during an ongoing Goal, recover interrupted turns at SessionStart, and COMMIT the visible response plus trustworthy host metrics. Hooks never mutate source, PVs, pointers, candidates, HIL, or credentials.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\session_start.py\"",
            "timeout": 10,
            "statusMessage": "Warm-attaching Evidence Lane locally"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/prompt_submit.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\prompt_submit.py\"",
            "timeout": 10,
            "statusMessage": "Preparing Evidence Lane governed turn"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:Bash|apply_patch|update_plan|mcp__evidence_lane__(?:pv_plan_steer_delta|pv_task_transition|pv_task_backlog|render_project_panel|render_runtime_panel))$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_tool_use.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\post_tool_use.py\"",
            "timeout": 10,
            "statusMessage": "Projecting Evidence Lane Plan and changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/stop_response.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\stop_response.py\"",
            "timeout": 10,
            "statusMessage": "Committing Evidence Lane governed turn"
          }
        ]
      }
    ]
  }
}
