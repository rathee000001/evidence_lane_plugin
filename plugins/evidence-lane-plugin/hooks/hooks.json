{
  "description": "Evidence Lane exact-session turn control: warm-attach the already-active package-local native MCP route with zero tunnel provisioning wait, PREPARE secret-redacted visible input before execution, recover interrupted turns at SessionStart, and COMMIT the visible response plus trustworthy host metrics. Hooks never mutate source, PVs, pointers, candidates, HIL, or credentials.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\session_start.py\"",
            "timeout": 10,
            "statusMessage": "Warm-attaching Evidence Lane locally"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/prompt_submit.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\prompt_submit.py\"",
            "timeout": 10,
            "statusMessage": "Preparing Evidence Lane governed turn"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/stop_response.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\stop_response.py\"",
            "timeout": 10,
            "statusMessage": "Committing Evidence Lane governed turn"
          }
        ]
      }
    ]
  }
}
