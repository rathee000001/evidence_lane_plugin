{
  "description": "Evidence Lane exact-session lifecycle transport: warm-attach at SessionStart, PREPARE at UserPromptSubmit, guard and receipt tool activity at PreToolUse/PostToolUse, seal and rehydrate compaction at PreCompact/PostCompact, COMMIT at Stop, and best-effort flush at SessionEnd. Skills own behavior, native reads, classification, and Plan refresh. Hooks never mutate source, PVs, pointers, candidates, HIL, or credentials.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\session_start.py\"",
            "timeout": 10,
            "statusMessage": "Warm-attaching Evidence Lane locally"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/prompt_submit.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\prompt_submit.py\"",
            "timeout": 10,
            "statusMessage": "Preparing Evidence Lane governed turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/pre_tool_use.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\pre_tool_use.py\"",
            "timeout": 10,
            "statusMessage": "Guarding Evidence Lane governed tool use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_tool_use.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\post_tool_use.py\"",
            "timeout": 10,
            "statusMessage": "Projecting Evidence Lane Plan and changes"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/lifecycle_boundary.py\" PreCompact",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\lifecycle_boundary.py\" PreCompact",
            "timeout": 10,
            "statusMessage": "Sealing Evidence Lane compaction boundary"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/lifecycle_boundary.py\" PostCompact",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\lifecycle_boundary.py\" PostCompact",
            "timeout": 10,
            "statusMessage": "Rehydrating Evidence Lane after compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/stop_response.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\stop_response.py\"",
            "timeout": 10,
            "statusMessage": "Committing Evidence Lane governed turn"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/lifecycle_boundary.py\" SessionEnd",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\lifecycle_boundary.py\" SessionEnd",
            "timeout": 10,
            "statusMessage": "Flushing Evidence Lane lifecycle boundary"
          }
        ]
      }
    ]
  }
}
