{
  "description": "Evidence Lane exact-session lifecycle transport: the registry-derived ordered command adapters validate, redact, bound, deduplicate, seal, and pass host signals to the installed lifecycle skill runtime. PermissionRequest and subagent events are observation-only and never grant, deny, or control a host action. After each exact consumer returns, the adapter issues and consumes one content-addressed behavior-handoff receipt; the receipt verifies ownership and binding but performs no behavior. The skill runtime owns Entry, PREPARE, tool/change receipts, compaction continuity, COMMIT, and best-effort boundary flush; skills also own native reads, classification, Plan refresh, Goal behavior, and HIL sequencing. Hook adapters never own source, Git, PV, pointer, candidate, HIL, Plan, Goal, approval, or credential behavior.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event SessionStart --handler session_start.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" SessionStart session_start.py",
            "timeout": 10,
            "statusMessage": "Warm-attaching Evidence Lane locally"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event SubagentStart --handler subagent_start.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" SubagentStart subagent_start.py",
            "timeout": 10,
            "statusMessage": "Observing a bound Evidence Lane subagent start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event UserPromptSubmit --handler prompt_submit.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" UserPromptSubmit prompt_submit.py",
            "timeout": 10,
            "statusMessage": "Preparing Evidence Lane governed turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event PreToolUse --handler pre_tool_use.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" PreToolUse pre_tool_use.py",
            "timeout": 10,
            "statusMessage": "Guarding Evidence Lane governed tool use"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event PermissionRequest --handler permission_request.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" PermissionRequest permission_request.py",
            "timeout": 10,
            "statusMessage": "Observing a bound Evidence Lane permission request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event PostToolUse --handler post_tool_use.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" PostToolUse post_tool_use.py",
            "timeout": 10,
            "statusMessage": "Projecting Evidence Lane Plan and changes"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event PreCompact --handler lifecycle_boundary.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" PreCompact lifecycle_boundary.py",
            "timeout": 10,
            "statusMessage": "Sealing Evidence Lane compaction boundary"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event PostCompact --handler lifecycle_boundary.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" PostCompact lifecycle_boundary.py",
            "timeout": 10,
            "statusMessage": "Rehydrating Evidence Lane after compaction"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event SubagentStop --handler subagent_stop.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" SubagentStop subagent_stop.py",
            "timeout": 10,
            "statusMessage": "Observing a bound Evidence Lane subagent stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event Stop --handler stop_response.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" Stop stop_response.py",
            "timeout": 10,
            "statusMessage": "Committing Evidence Lane governed turn"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event SessionEnd --handler lifecycle_boundary.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" SessionEnd lifecycle_boundary.py",
            "timeout": 3,
            "statusMessage": "Flushing Evidence Lane lifecycle boundary"
          }
        ]
      }
    ]
  }
}
