{
  "description": "Evidence Lane exact-session lifecycle transport: eight ordered hook adapters validate, redact, bound, deduplicate, seal, and pass host signals to the installed lifecycle skill runtime. After that exact consumer returns, the adapter issues and consumes one content-addressed behavior-handoff receipt; the receipt verifies ownership and binding but performs no behavior. The skill runtime owns Entry, PREPARE, tool/change receipts, compaction continuity, COMMIT, and best-effort boundary flush; skills also own native reads, classification, Plan refresh, Goal behavior, and HIL sequencing. Hook adapters never own source, Git, PV, pointer, candidate, HIL, Plan, Goal, or credential behavior.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event SessionStart --handler session_start.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" SessionStart session_start.py",
            "timeout": 10,
            "statusMessage": "Warm-attaching Evidence Lane locally"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event UserPromptSubmit --handler prompt_submit.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" UserPromptSubmit prompt_submit.py",
            "timeout": 10,
            "statusMessage": "Preparing Evidence Lane governed turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event PreToolUse --handler pre_tool_use.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" PreToolUse pre_tool_use.py",
            "timeout": 10,
            "statusMessage": "Guarding Evidence Lane governed tool use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event PostToolUse --handler post_tool_use.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" PostToolUse post_tool_use.py",
            "timeout": 10,
            "statusMessage": "Projecting Evidence Lane Plan and changes"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event PreCompact --handler lifecycle_boundary.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" PreCompact lifecycle_boundary.py",
            "timeout": 10,
            "statusMessage": "Sealing Evidence Lane compaction boundary"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event PostCompact --handler lifecycle_boundary.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" PostCompact lifecycle_boundary.py",
            "timeout": 10,
            "statusMessage": "Rehydrating Evidence Lane after compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event Stop --handler stop_response.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" Stop stop_response.py",
            "timeout": 10,
            "statusMessage": "Committing Evidence Lane governed turn"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event SessionEnd --handler lifecycle_boundary.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" SessionEnd lifecycle_boundary.py",
            "timeout": 3,
            "statusMessage": "Flushing Evidence Lane lifecycle boundary"
          }
        ]
      }
    ]
  }
}
