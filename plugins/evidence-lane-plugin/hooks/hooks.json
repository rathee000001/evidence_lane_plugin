{
  "description": "Evidence Lane ordered native lifecycle pipeline. Every event class exposes four real host handlers: validate/bound, deduplicate/seal, execute the event transport exactly once, and verify/emit its result. Internal SDK metadata remains outside this host-owned schema.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event SessionStart --handler subhook_validate.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" SessionStart subhook_validate.py",
            "timeout": 10,
            "statusMessage": "Validating and bounding Evidence Lane hook signal"
          },
          {
            "type": "command",
            "command": "python3 -B \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event SessionStart --handler subhook_seal.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" SessionStart subhook_seal.py",
            "timeout": 10,
            "statusMessage": "Deduplicating and sealing Evidence Lane hook occurrence"
          },
          {
            "type": "command",
            "command": "python3 -B \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event SessionStart --handler subhook_transport.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" SessionStart subhook_transport.py",
            "timeout": 10,
            "statusMessage": "Warm-attaching Evidence Lane locally"
          },
          {
            "type": "command",
            "command": "python3 -B \"$PLUGIN_ROOT/hooks/invoke_hook.py\" --event SessionStart --handler subhook_emit.py",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\EvidenceLaneHookHost.exe\" SessionStart subhook_emit.py",
            "timeout": 10,
            "statusMessage": "Verifying and emitting Evidence Lane hook result"
          }
        ]
      }
    ],
