{
  "description": "Supported v4 visible-event capture through the plugin-owned engine; no lifecycle or host-control instructions.",
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "command": "python3 -I -B \"${PLUGIN_ROOT}/hooks/events/Interrupt/handler.py\"",
            "commandWindows": "& python -I -B \"${PLUGIN_ROOT}\\hooks\\events\\Interrupt\\handler.py\"",
            "statusMessage": "Record bound Evidence Lane Interrupt evidence",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
