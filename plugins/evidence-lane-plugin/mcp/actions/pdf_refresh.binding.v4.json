            "identifier": {
              "title": "Identifier",
              "type": "string"
            },
            "kind": {
              "enum": [
                "receipt",
                "object",
                "source",
                "test",
                "commit",
                "installation",
                "user_decision"
              ],
              "title": "Kind",
              "type": "string"
            },
            "project_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Project Id"
            }
          },
          "required": [
            "kind",
            "identifier"
