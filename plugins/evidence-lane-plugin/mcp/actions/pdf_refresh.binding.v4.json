  "tool": {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Snapshot exact PDF bytes, page text, geometry and separate form/widget evidence.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "expected_snapshot": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expected Snapshot"
            },
            "extract_tables": {
              "default": true,
              "title": "Extract Tables",
              "type": "boolean"
            },
            "filename": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Filename",
              "type": "string"
            },
            "lane_id": {
              "const": "pdf_ocr",
              "default": "pdf_ocr",
              "title": "Lane Id",
              "type": "string"
            },
            "max_file_bytes": {
              "default": 8388608,
              "maximum": 16777216,
              "minimum": 1,
              "title": "Max File Bytes",
              "type": "integer"
            },
            "max_pages": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Max Pages",
              "type": "integer"
            },
            "text_backend": {
              "default": "auto",
              "enum": [
                "auto",
                "pymupdf",
                "pdfplumber",
                "pypdf",
                "poppler"
              ],
              "title": "Text Backend",
              "type": "string"
            }
          },
          "required": [
            "filename"
          ],
          "title": "PdfIndex",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
      ],
      "type": "object"
    },
    "name": "pdf_refresh",
    "outputSchema": {
      "$defs": {
        "EvidenceReference": {
          "additionalProperties": false,
          "properties": {
