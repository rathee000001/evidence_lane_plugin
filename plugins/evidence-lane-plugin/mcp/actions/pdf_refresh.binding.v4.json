          "title": "Request Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "queued",
            "waiting"
