            "git_mode": {
              "default": "AUTO",
              "enum": [
                "AUTO",
                "REQUIRED",
                "DISABLED"
              ],
              "title": "Git Mode",
              "type": "string"
            },
            "max_result_bytes": {
              "default": 524288,
              "maximum": 2097152,
              "minimum": 8192,
              "title": "Max Result Bytes",
              "type": "integer"
            },
            "requested_outcome": {
              "maxLength": 4000,
              "minLength": 1,
              "title": "Requested Outcome",
              "type": "string"
            },
            "work_classification_request": {
              "anyOf": [
                {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Work Classification Request"
