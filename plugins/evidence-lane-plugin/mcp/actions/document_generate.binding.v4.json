{
  "action": "document_generate",
  "action_set_sha256": "b4971ad1d61e8bcbb0fb841e8626b12bc7f232606c1651b5607d7188f37ba758",
  "adapter_executes_project_operations": false,
  "authority": "engine_typed_action_registry",
  "execution_owner": "connected_engine_registry",
  "installed_execution_claimed": false,
  "schema": "evidence-lane.mcp-binding.v4",
  "sdk_binding": "sdk/actions/document_generate.action.v4.json",
  "sdk_binding_sha256": "02fa2b7ec633e354df91bc97856532eb07ecc9b490694ce3359e46bcad4b0217",
  "tool": {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Publish a new immutable lane-owned DOCX version with explicit structural and layout fidelity.",
    "inputSchema": {
      "$defs": {
        "DocumentBlock": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "paragraph",
                "heading",
                "table",
                "page_break"
              ],
              "title": "Kind",
              "type": "string"
            },
            "level": {
              "default": 1,
              "maximum": 6,
              "minimum": 1,
              "title": "Level",
              "type": "integer"
            },
            "rows": {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "maxItems": 200,
              "title": "Rows",
              "type": "array"
            },
            "text": {
              "default": "",
              "maxLength": 16384,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "title": "DocumentBlock",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "blocks": {
              "items": {
                "$ref": "#/$defs/DocumentBlock"
              },
              "maxItems": 200,
              "minItems": 1,
              "title": "Blocks",
              "type": "array"
            },
            "expected_snapshot": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expected Snapshot"
            },
            "lane_id": {
              "const": "docs",
              "default": "docs",
              "title": "Lane Id",
              "type": "string"
            },
            "logical_name": {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[^/\\\\:]+\\.docx$",
              "title": "Logical Name",
              "type": "string"
            },
            "title": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "logical_name",
            "title",
            "blocks"
          ],
          "title": "DocumentGenerate",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
      ],
      "type": "object"
    },
    "name": "document_generate",
    "outputSchema": {
      "$defs": {
        "EvidenceReference": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Digest"
            },
            "identifier": {
              "title": "Identifier",
              "type": "string"
            },
            "kind": {
              "enum": [
                "receipt",
                "object",
                "source",
                "test",
                "commit",
                "installation",
                "user_decision"
              ],
              "title": "Kind",
              "type": "string"
            },
            "project_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Project Id"
            }
          },
          "required": [
            "kind",
            "identifier"
          ],
          "title": "EvidenceReference",
          "type": "object"
        },
        "JsonValue": {},
        "PublicError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "title": "Code",
              "type": "string"
            },
            "details": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "title": "Details",
              "type": "object"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "PublicError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "plan_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        },
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "queued",
            "waiting"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_execution": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Execution"
        }
      },
      "required": [
        "request_id",
        "action",
        "status"
      ],
      "title": "ActionResponse",
      "type": "object"
    }
  }
}
