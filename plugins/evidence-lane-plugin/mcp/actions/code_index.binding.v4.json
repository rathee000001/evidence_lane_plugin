              "type": "integer"
            },
            "max_files": {
              "default": 64,
              "maximum": 512,
              "minimum": 1,
              "title": "Max Files",
              "type": "integer"
            },
            "max_total_bytes": {
              "default": 4194304,
              "maximum": 33554432,
              "minimum": 1,
              "title": "Max Total Bytes",
              "type": "integer"
            },
            "paths": {
              "items": {
