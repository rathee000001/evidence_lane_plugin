          ],
          "title": "CodeIndex",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
