                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Value"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "title": "Value",
          "type": "object"
