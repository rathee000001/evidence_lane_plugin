          "additionalProperties": false,
          "properties": {
            "max_bytes": {
              "default": 131072,
              "maximum": 262144,
              "minimum": 2048,
              "title": "Max Bytes",
              "type": "integer"
            },
            "projects": {
              "items": {
                "$ref": "#/$defs/ProjectQuery"
              },
              "maxItems": 4,
              "minItems": 2,
              "title": "Projects",
              "type": "array"
            },
            "require_links": {
              "default": false,
              "title": "Require Links",
              "type": "boolean"
            },
            "timeout_ms": {
              "default": 10000,
              "maximum": 30000,
              "minimum": 100,
              "title": "Timeout Ms",
              "type": "integer"
