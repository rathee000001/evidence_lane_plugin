          "type": "object"
        },
        "ProjectQuery": {
          "additionalProperties": false,
          "properties": {
            "expected_plan_revision": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expected Plan Revision"
            },
            "project_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "title": "Project Id",
              "type": "string"
