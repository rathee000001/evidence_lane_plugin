{
  "action": "memory_ingest",
  "action_set_sha256": "e316b2b30bb83105369ba4e44ce356b253bdd9212266c68c1a19dcfd368366fe",
  "adapter_executes_project_operations": false,
  "authority": "engine_typed_action_registry",
  "execution_owner": "connected_engine_registry",
  "installed_execution_claimed": false,
  "schema": "evidence-lane.mcp-binding.v4",
  "sdk_binding": "sdk/actions/memory_ingest.action.v4.json",
  "sdk_binding_sha256": "4860af9175e97ae8e769d7e6d61e474546949b41b30dd9d7246e8fe27f37cf04",
  "tool": {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Index bounded attributed locators and typed links to existing project records.",
    "inputSchema": {
      "$defs": {
        "MemoryEdge": {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "$ref": "#/$defs/MemoryReference"
            },
            "kind": {
              "enum": [
                "DERIVED_FROM",
                "EVIDENCES",
                "LEARNED_FROM",
                "MAPS_TO",
                "RELATED_TO",
                "REVOKES",
                "SUPERSEDES",
                "SUPPRESSES"
              ],
              "title": "Kind",
              "type": "string"
            },
            "source_id": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Source Id",
              "type": "string"
            },
            "target_id": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Target Id",
              "type": "string"
            }
          },
          "required": [
            "source_id",
            "target_id",
            "kind",
            "evidence"
          ],
          "title": "MemoryEdge",
          "type": "object"
        },
        "MemoryLocator": {
          "additionalProperties": false,
          "properties": {
            "label": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Label",
              "type": "string"
            },
            "reference": {
              "$ref": "#/$defs/MemoryReference"
            },
            "search_terms": {
              "items": {
                "type": "string"
              },
              "maxItems": 24,
              "title": "Search Terms",
              "type": "array"
            }
          },
          "required": [
            "reference",
            "label"
          ],
          "title": "MemoryLocator",
          "type": "object"
        },
        "MemoryReference": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Digest",
              "type": "string"
            },
            "key": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "title": "Key",
              "type": "string"
            },
            "kind": {
              "enum": [
                "plan_task",
                "lineage_event",
                "learning_version",
                "receipt",
                "source_object",
                "canon_exchange"
              ],
              "title": "Kind",
              "type": "string"
            },
            "lane_id": {
              "anyOf": [
                {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Lane Id"
            },
            "profile": {
              "anyOf": [
                {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Profile"
            },
            "revision": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Revision"
            }
          },
          "required": [
            "kind",
            "key",
            "digest"
          ],
          "title": "MemoryReference",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "edges": {
              "items": {
                "$ref": "#/$defs/MemoryEdge"
              },
              "maxItems": 100,
              "title": "Edges",
              "type": "array"
            },
            "locators": {
              "items": {
                "$ref": "#/$defs/MemoryLocator"
              },
              "maxItems": 100,
              "title": "Locators",
              "type": "array"
            },
            "request_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "title": "Request Id",
              "type": "string"
            }
          },
          "title": "MemoryIngest",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
      ],
      "type": "object"
    },
    "name": "memory_ingest",
    "outputSchema": {
      "$defs": {
        "EvidenceReference": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Digest"
            },
            "identifier": {
              "title": "Identifier",
              "type": "string"
            },
            "kind": {
              "enum": [
                "receipt",
                "object",
                "source",
                "test",
                "commit",
                "installation",
                "user_decision"
              ],
              "title": "Kind",
              "type": "string"
            },
            "project_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Project Id"
            }
          },
          "required": [
            "kind",
            "identifier"
          ],
          "title": "EvidenceReference",
          "type": "object"
        },
        "JsonValue": {},
        "PublicError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "title": "Code",
              "type": "string"
            },
            "details": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "title": "Details",
              "type": "object"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "PublicError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "plan_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        },
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "queued",
            "waiting"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_execution": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Execution"
        }
      },
      "required": [
        "request_id",
        "action",
        "status"
      ],
      "title": "ActionResponse",
      "type": "object"
    }
  }
}
