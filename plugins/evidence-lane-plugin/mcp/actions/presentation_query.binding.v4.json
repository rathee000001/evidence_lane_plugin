{
  "action": "presentation_query",
  "action_set_sha256": "aaf5bcde49b099d6bfedea0a0057f49ddca2624e26e8327d285bf62585bfd44a",
  "adapter_executes_project_operations": false,
  "authority": "engine_typed_action_registry",
  "execution_owner": "connected_engine_registry",
  "installed_execution_claimed": false,
  "schema": "evidence-lane.mcp-binding.v4",
  "sdk_binding": "sdk/actions/presentation_query.action.v4.json",
  "sdk_binding_sha256": "4995c14c2548426e982ba62724b44eee8ab026599cb57b121b5b31a8418aafcf",
  "tool": {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Read bounded native structures or literal FTS5/BM25 matches from an exact presentation version.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "collection": {
              "default": "text",
              "enum": [
                "metadata",
                "text",
                "slide",
                "notes",
                "shape",
                "text_block",
                "table",
                "image",
                "relationship",
                "chart"
              ],
              "title": "Collection",
              "type": "string"
            },
            "lane_id": {
              "const": "ppt",
              "default": "ppt",
              "title": "Lane Id",
              "type": "string"
            },
            "limit": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "match_mode": {
              "default": "all",
              "enum": [
                "all",
                "any"
              ],
              "title": "Match Mode",
              "type": "string"
            },
            "max_bytes": {
              "default": 65536,
              "maximum": 262144,
              "minimum": 2048,
              "title": "Max Bytes",
              "type": "integer"
            },
            "offset": {
              "default": 0,
              "maximum": 100000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            },
            "query": {
              "anyOf": [
                {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Query"
            },
            "snapshot_id": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Snapshot Id",
              "type": "string"
            }
          },
          "required": [
            "snapshot_id"
          ],
          "title": "PresentationQuery",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
      ],
      "type": "object"
    },
    "name": "presentation_query",
    "outputSchema": {
      "$defs": {
        "EvidenceReference": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Digest"
            },
            "identifier": {
              "title": "Identifier",
              "type": "string"
            },
            "kind": {
              "enum": [
                "receipt",
                "object",
                "source",
                "test",
                "commit",
                "installation",
                "user_decision"
              ],
              "title": "Kind",
              "type": "string"
            },
            "project_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Project Id"
            }
          },
          "required": [
            "kind",
            "identifier"
          ],
          "title": "EvidenceReference",
          "type": "object"
        },
        "JsonValue": {},
        "PublicError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "title": "Code",
              "type": "string"
            },
            "details": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "title": "Details",
              "type": "object"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "PublicError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "plan_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        },
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "queued",
            "waiting"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_execution": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Execution"
        }
      },
      "required": [
        "request_id",
        "action",
        "status"
      ],
      "title": "ActionResponse",
      "type": "object"
    }
  }
}
