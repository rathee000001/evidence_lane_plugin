    "description": "Capture one authorized bounded HTTP response chain into immutable Research evidence.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "encoding": {
              "default": "utf-8",
              "enum": [
                "utf-8",
                "utf-8-sig",
                "windows-1252",
                "iso-8859-1",
                "utf-16"
              ],
              "title": "Encoding",
              "type": "string"
            },
            "expected_snapshot": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expected Snapshot"
            },
            "lane_id": {
              "const": "research",
              "default": "research",
              "title": "Lane Id",
              "type": "string"
            },
            "max_bytes": {
              "default": 1048576,
              "maximum": 8388608,
              "minimum": 1024,
              "title": "Max Bytes",
              "type": "integer"
            },
            "max_redirects": {
              "default": 5,
              "maximum": 8,
              "minimum": 0,
              "title": "Max Redirects",
              "type": "integer"
            },
            "media": {
              "default": "auto",
              "enum": [
                "auto",
                "html",
                "text",
                "opaque"
              ],
              "title": "Media",
              "type": "string"
            },
            "timeout_seconds": {
              "default": 20,
              "maximum": 60,
              "minimum": 1,
              "title": "Timeout Seconds",
              "type": "integer"
            },
            "transport": {
              "default": "auto",
              "enum": [
                "auto",
                "httpx",
                "requests"
              ],
              "title": "Transport",
              "type": "string"
            },
            "url": {
              "maxLength": 8192,
              "minLength": 1,
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "Capture",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
      ],
      "type": "object"
    },
    "name": "research_web_capture",
