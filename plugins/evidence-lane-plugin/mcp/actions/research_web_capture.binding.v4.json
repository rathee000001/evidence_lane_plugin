                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Digest"
            },
            "identifier": {
              "title": "Identifier",
              "type": "string"
            },
            "kind": {
              "enum": [
                "receipt",
                "object",
                "source",
                "test",
                "commit",
                "installation",
                "user_decision"
              ],
