  "adapter_executes_project_operations": false,
  "authority": "engine_typed_action_registry",
  "execution_owner": "connected_engine_registry",
  "installed_execution_claimed": false,
  "schema": "evidence-lane.mcp-binding.v4",
  "sdk_binding": "sdk/actions/presentation_edit.action.v4.json",
  "sdk_binding_sha256": "fa4094804d0b81f49d1fab272b0b410c6ce5d1266379e81a6c37b952a1b74b54",
  "tool": {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Publish a new immutable lane-owned PPTX version with explicit structural and layout fidelity.",
    "inputSchema": {
      "$defs": {
        "PresentationReplacement": {
          "additionalProperties": false,
          "properties": {
            "expected_text": {
              "maxLength": 32768,
              "title": "Expected Text",
              "type": "string"
            },
            "paragraph_index": {
              "maximum": 8191,
              "minimum": 0,
              "title": "Paragraph Index",
              "type": "integer"
            },
            "part": {
              "pattern": "^ppt/(slides/slide|notesSlides/notesSlide)\\d+\\.xml$",
              "title": "Part",
              "type": "string"
            },
            "replacement_text": {
              "maxLength": 32768,
              "title": "Replacement Text",
              "type": "string"
            }
          },
          "required": [
            "part",
            "paragraph_index",
            "expected_text",
            "replacement_text"
          ],
          "title": "PresentationReplacement",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "expected_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Expected Sha256",
              "type": "string"
            },
            "lane_id": {
              "const": "ppt",
              "default": "ppt",
              "title": "Lane Id",
              "type": "string"
            },
            "replacements": {
              "items": {
                "$ref": "#/$defs/PresentationReplacement"
              },
              "maxItems": 32,
              "title": "Replacements",
              "type": "array"
            },
            "slide_order": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100,
                  "minItems": 1,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Slide Order"
            },
            "snapshot_id": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Snapshot Id",
              "type": "string"
            }
          },
          "required": [
            "snapshot_id",
            "expected_sha256"
          ],
          "title": "PresentationEdit",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
      ],
      "type": "object"
    },
    "name": "presentation_edit",
