  "tool": {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Publish one immutable raster derivative with explicit frame, alpha and metadata handling.",
    "inputSchema": {
      "$defs": {
        "RasterCrop": {
          "additionalProperties": false,
          "properties": {
            "bottom": {
              "maximum": 25000,
              "minimum": 1,
              "title": "Bottom",
              "type": "integer"
            },
            "left": {
              "maximum": 25000,
              "minimum": 0,
              "title": "Left",
              "type": "integer"
            },
            "right": {
              "maximum": 25000,
              "minimum": 1,
              "title": "Right",
              "type": "integer"
            },
            "top": {
              "maximum": 25000,
              "minimum": 0,
              "title": "Top",
              "type": "integer"
            }
          },
          "required": [
            "left",
            "top",
            "right",
            "bottom"
          ],
          "title": "RasterCrop",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "apply_exif_orientation": {
              "default": true,
              "title": "Apply Exif Orientation",
              "type": "boolean"
            },
            "color_mode": {
              "default": "preserve",
