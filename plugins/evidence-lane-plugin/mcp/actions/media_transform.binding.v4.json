                "preserve",
                "RGB",
                "RGBA",
                "L"
              ],
              "title": "Color Mode",
              "type": "string"
            },
            "crop": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RasterCrop"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "expected_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Expected Sha256",
              "type": "string"
            },
            "flip": {
              "default": "none",
              "enum": [
                "none",
                "horizontal",
                "vertical"
              ],
              "title": "Flip",
              "type": "string"
            },
            "frame": {
              "anyOf": [
                {
                  "maximum": 500,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Frame"
            },
            "height": {
              "anyOf": [
                {
                  "maximum": 10000,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Height"
            },
            "jpeg_background": {
              "anyOf": [
                {
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Jpeg Background"
            },
            "lane_id": {
              "const": "images_ocr",
              "default": "images_ocr",
              "title": "Lane Id",
              "type": "string"
            },
            "logical_name": {
              "maxLength": 180,
              "minLength": 1,
              "title": "Logical Name",
              "type": "string"
            },
            "max_pixels": {
              "default": 12000000,
              "maximum": 25000000,
              "minimum": 1,
              "title": "Max Pixels",
              "type": "integer"
            },
            "metadata": {
              "default": "preserve_supported",
              "enum": [
                "preserve_supported",
                "strip"
              ],
              "title": "Metadata",
              "type": "string"
            },
            "output_format": {
              "default": "PNG",
              "enum": [
                "PNG",
                "JPEG",
                "WEBP",
                "TIFF"
              ],
              "title": "Output Format",
              "type": "string"
            },
            "quality": {
              "default": 92,
              "maximum": 100,
              "minimum": 1,
              "title": "Quality",
              "type": "integer"
            },
            "rotate_clockwise": {
              "default": 0,
              "enum": [
                0,
                90,
                180,
                270
              ],
              "title": "Rotate Clockwise",
              "type": "integer"
            },
            "snapshot_id": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Snapshot Id",
              "type": "string"
            },
            "webp_lossless": {
              "default": true,
              "title": "Webp Lossless",
              "type": "boolean"
            },
            "width": {
              "anyOf": [
                {
                  "maximum": 10000,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Width"
            }
          },
          "required": [
            "snapshot_id",
            "expected_sha256",
            "logical_name"
