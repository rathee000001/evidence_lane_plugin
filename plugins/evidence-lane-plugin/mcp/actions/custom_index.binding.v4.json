{
  "action": "custom_index",
  "action_set_sha256": "e316b2b30bb83105369ba4e44ce356b253bdd9212266c68c1a19dcfd368366fe",
  "adapter_executes_project_operations": false,
  "authority": "engine_typed_action_registry",
  "execution_owner": "connected_engine_registry",
  "installed_execution_claimed": false,
  "schema": "evidence-lane.mcp-binding.v4",
  "sdk_binding": "sdk/actions/custom_index.action.v4.json",
  "sdk_binding_sha256": "ab04e9c373181b6194632fb04f67d41633bc8a5f3535498ba5f7a2bd72468509",
  "tool": {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Index exact selected source bytes and attributed bounded facts in the separate custom lane.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "adapter_contract": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Adapter Contract"
            },
            "expected_snapshot": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expected Snapshot"
            },
            "filename": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Filename",
              "type": "string"
            },
            "lane_id": {
              "default": "custom",
              "pattern": "^(?:custom|custom__[a-z][a-z0-9_]{0,39})$",
              "title": "Lane Id",
              "type": "string"
            },
            "max_file_bytes": {
              "default": 1048576,
              "maximum": 8388608,
              "minimum": 1,
              "title": "Max File Bytes",
              "type": "integer"
            },
            "parser": {
              "default": "auto",
              "enum": [
                "auto",
                "text",
                "json",
                "notebook",
                "archive",
                "sqlite",
                "opaque",
                "document",
                "presentation",
                "spreadsheet",
                "data",
                "pdf_pymupdf",
                "pdf_pypdf",
                "pdf_pdfplumber",
                "media"
              ],
              "title": "Parser",
              "type": "string"
            },
            "sqlite_rows": {
              "default": 100,
              "maximum": 200,
              "minimum": 0,
              "title": "Sqlite Rows",
              "type": "integer"
            },
            "sqlite_tables": {
              "items": {
                "type": "string"
              },
              "maxItems": 32,
              "title": "Sqlite Tables",
              "type": "array"
            }
          },
          "required": [
            "filename"
          ],
          "title": "CustomIndex",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
      ],
      "type": "object"
    },
    "name": "custom_index",
    "outputSchema": {
      "$defs": {
        "EvidenceReference": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Digest"
            },
            "identifier": {
              "title": "Identifier",
              "type": "string"
            },
            "kind": {
              "enum": [
                "receipt",
                "object",
                "source",
                "test",
                "commit",
                "installation",
                "user_decision"
              ],
              "title": "Kind",
              "type": "string"
            },
            "project_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Project Id"
            }
          },
          "required": [
            "kind",
            "identifier"
          ],
          "title": "EvidenceReference",
          "type": "object"
        },
        "JsonValue": {},
        "PublicError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "title": "Code",
              "type": "string"
            },
            "details": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "title": "Details",
              "type": "object"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "PublicError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "plan_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        },
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "queued",
            "waiting"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_execution": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Execution"
        }
      },
      "required": [
        "request_id",
        "action",
        "status"
      ],
      "title": "ActionResponse",
      "type": "object"
    }
  }
}
