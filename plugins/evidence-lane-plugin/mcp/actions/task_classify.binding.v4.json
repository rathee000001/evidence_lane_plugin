  "tool": {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Record source-bound intent, focus, owning lanes and next workflow action; classification does not apply a Plan steer or authorize work.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "classification_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "title": "Classification Id",
              "type": "string"
            },
            "code_lane": {
              "default": "local_code",
              "enum": [
                "local_code",
                "github_code"
              ],
              "title": "Code Lane",
              "type": "string"
            },
            "custom_modes": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "maxItems": 8,
              "title": "Custom Modes",
              "type": "array"
            },
            "explicit_modes": {
              "items": {
                "type": "string"
              },
              "maxItems": 16,
              "title": "Explicit Modes",
              "type": "array"
            },
            "focus": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Focus",
              "type": "string"
            },
            "intent": {
              "enum": [
                "informational",
                "semantic",
                "stop",
                "work"
              ],
              "title": "Intent",
              "type": "string"
            },
            "lanes": {
              "items": {
                "type": "string"
              },
              "maxItems": 32,
              "title": "Lanes",
              "type": "array"
            },
            "next_action": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "title": "Next Action",
              "type": "string"
            },
            "source_cursor": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Source Cursor",
              "type": "string"
            },
            "source_event_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "title": "Source Event Id",
              "type": "string"
            },
            "source_text": {
              "anyOf": [
                {
                  "maxLength": 65536,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source Text"
            },
            "workflow": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Workflow",
              "type": "string"
            }
          },
          "required": [
            "classification_id",
            "source_event_id",
            "source_cursor",
            "intent",
            "focus",
            "workflow",
            "next_action"
          ],
          "title": "EntryClassify",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
      ],
      "type": "object"
    },
    "name": "task_classify",
