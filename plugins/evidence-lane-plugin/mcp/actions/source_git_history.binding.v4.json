            "max_total_object_bytes": {
              "default": 67108864,
              "maximum": 8589934592,
              "minimum": 1,
              "title": "Max Total Object Bytes",
              "type": "integer"
            },
            "max_tree_entries": {
              "default": 50000,
              "maximum": 5000000,
              "minimum": 1,
              "title": "Max Tree Entries",
              "type": "integer"
