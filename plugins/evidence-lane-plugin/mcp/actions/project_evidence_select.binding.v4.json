{
  "action": "project_evidence_select",
  "action_set_sha256": "aaf5bcde49b099d6bfedea0a0057f49ddca2624e26e8327d285bf62585bfd44a",
  "adapter_executes_project_operations": false,
  "authority": "engine_typed_action_registry",
  "execution_owner": "connected_engine_registry",
  "installed_execution_claimed": false,
  "schema": "evidence-lane.mcp-binding.v4",
  "sdk_binding": "sdk/actions/project_evidence_select.action.v4.json",
  "sdk_binding_sha256": "9e716c293d34ae06a6f69c12839f4bcfcec92ab3f1b94c95b8bb68660cde60ee",
  "tool": {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Select deterministic metadata slices using explicit estimated-token and item budgets; verify content through its owning authority.",
    "inputSchema": {
      "$defs": {
        "EvidenceSlice": {
          "additionalProperties": false,
          "properties": {
            "content_id": {
              "maxLength": 192,
              "minLength": 1,
              "title": "Content Id",
              "type": "string"
            },
            "content_sha256": {
              "pattern": "^[0-9a-fA-F]{64}$",
              "title": "Content Sha256",
              "type": "string"
            },
            "priority": {
              "default": 0,
              "maximum": 1000,
              "minimum": -1000,
              "title": "Priority",
              "type": "integer"
            },
            "token_count": {
              "maximum": 1000000,
              "minimum": 1,
              "title": "Token Count",
              "type": "integer"
            }
          },
          "required": [
            "content_id",
            "content_sha256",
            "token_count"
          ],
          "title": "EvidenceSlice",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "authority_id": {
              "title": "Authority Id",
              "type": "string"
            },
            "max_slices": {
              "default": 20,
              "maximum": 200,
              "minimum": 1,
              "title": "Max Slices",
              "type": "integer"
            },
            "slices": {
              "items": {
                "$ref": "#/$defs/EvidenceSlice"
              },
              "maxItems": 200,
              "minItems": 1,
              "title": "Slices",
              "type": "array"
            },
            "token_budget": {
              "maximum": 1000000,
              "minimum": 1,
              "title": "Token Budget",
              "type": "integer"
            }
          },
          "required": [
            "authority_id",
            "slices",
            "token_budget"
          ],
          "title": "ProjectEvidenceSelectionRequest",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
      ],
      "type": "object"
    },
    "name": "project_evidence_select",
    "outputSchema": {
      "$defs": {
        "EvidenceReference": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Digest"
            },
            "identifier": {
              "title": "Identifier",
              "type": "string"
            },
            "kind": {
              "enum": [
                "receipt",
                "object",
                "source",
                "test",
                "commit",
                "installation",
                "user_decision"
              ],
              "title": "Kind",
              "type": "string"
            },
            "project_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Project Id"
            }
          },
          "required": [
            "kind",
            "identifier"
          ],
          "title": "EvidenceReference",
          "type": "object"
        },
        "JsonValue": {},
        "PublicError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "title": "Code",
              "type": "string"
            },
            "details": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "title": "Details",
              "type": "object"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "PublicError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "plan_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        },
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "queued",
            "waiting"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_execution": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Execution"
        }
      },
      "required": [
        "request_id",
        "action",
        "status"
      ],
      "title": "ActionResponse",
      "type": "object"
    }
  }
}
