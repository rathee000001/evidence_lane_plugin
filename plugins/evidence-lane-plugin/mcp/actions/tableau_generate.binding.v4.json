{
  "action": "tableau_generate",
  "action_set_sha256": "b4971ad1d61e8bcbb0fb841e8626b12bc7f232606c1651b5607d7188f37ba758",
  "adapter_executes_project_operations": false,
  "authority": "engine_typed_action_registry",
  "execution_owner": "connected_engine_registry",
  "installed_execution_claimed": false,
  "schema": "evidence-lane.mcp-binding.v4",
  "sdk_binding": "sdk/actions/tableau_generate.action.v4.json",
  "sdk_binding_sha256": "0ebc424c16612ef5cf78cc0e2175f12d603d3f45ee6f8acaef4486aa7cc8b9a9",
  "tool": {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Publish a new native Hyper extract or an exact selected XML edit as immutable lane-owned bytes.",
    "inputSchema": {
      "$defs": {
        "HyperColumn": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "nullable": {
              "default": true,
              "title": "Nullable",
              "type": "boolean"
            },
            "precision": {
              "default": 18,
              "maximum": 38,
              "minimum": 1,
              "title": "Precision",
              "type": "integer"
            },
            "scale": {
              "default": 4,
              "maximum": 38,
              "minimum": 0,
              "title": "Scale",
              "type": "integer"
            },
            "type": {
              "enum": [
                "text",
                "big_int",
                "double",
                "bool",
                "date",
                "timestamp",
                "numeric"
              ],
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "title": "HyperColumn",
          "type": "object"
        },
        "HyperTable": {
          "additionalProperties": false,
          "properties": {
            "columns": {
              "items": {
                "$ref": "#/$defs/HyperColumn"
              },
              "maxItems": 128,
              "minItems": 1,
              "title": "Columns",
              "type": "array"
            },
            "name": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "rows": {
              "items": {
                "items": {
                  "$ref": "#/$defs/JsonValue"
                },
                "type": "array"
              },
              "maxItems": 1000,
              "title": "Rows",
              "type": "array"
            },
            "schema_name": {
              "default": "Extract",
              "maxLength": 200,
              "minLength": 1,
              "title": "Schema Name",
              "type": "string"
            }
          },
          "required": [
            "name",
            "columns"
          ],
          "title": "HyperTable",
          "type": "object"
        },
        "JsonValue": {}
      },
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": false,
          "properties": {
            "expected_snapshot": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expected Snapshot"
            },
            "lane_id": {
              "const": "tableau",
              "default": "tableau",
              "title": "Lane Id",
              "type": "string"
            },
            "logical_name": {
              "maxLength": 180,
              "pattern": "^[^/\\\\:]+\\.hyper$",
              "title": "Logical Name",
              "type": "string"
            },
            "tables": {
              "items": {
                "$ref": "#/$defs/HyperTable"
              },
              "maxItems": 16,
              "minItems": 1,
              "title": "Tables",
              "type": "array"
            }
          },
          "required": [
            "logical_name",
            "tables"
          ],
          "title": "TableauGenerate",
          "type": "object"
        },
        "expected_revision": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arguments"
      ],
      "type": "object"
    },
    "name": "tableau_generate",
    "outputSchema": {
      "$defs": {
        "EvidenceReference": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Digest"
            },
            "identifier": {
              "title": "Identifier",
              "type": "string"
            },
            "kind": {
              "enum": [
                "receipt",
                "object",
                "source",
                "test",
                "commit",
                "installation",
                "user_decision"
              ],
              "title": "Kind",
              "type": "string"
            },
            "project_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Project Id"
            }
          },
          "required": [
            "kind",
            "identifier"
          ],
          "title": "EvidenceReference",
          "type": "object"
        },
        "JsonValue": {},
        "PublicError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "title": "Code",
              "type": "string"
            },
            "details": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "title": "Details",
              "type": "object"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "PublicError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "plan_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        },
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "queued",
            "waiting"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_execution": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Execution"
        }
      },
      "required": [
        "request_id",
        "action",
        "status"
      ],
      "title": "ActionResponse",
      "type": "object"
    }
  }
}
