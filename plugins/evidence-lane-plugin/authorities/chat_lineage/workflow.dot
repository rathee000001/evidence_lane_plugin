digraph workflow_chat_lineage {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  sdk [label="Authenticated SDK and native MCP client" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Exact selected scope and bounded recorded evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  writer [label="Engine coordinator and owning project writer" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Current stored Plan operation and Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  owner [label="chat_lineage current executable owner" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_capture_bind [label=capture_bind color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_continuation_accept [label=continuation_accept color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_continuation_cancel [label=continuation_cancel color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_continuation_context [label=continuation_context color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_continuation_offer [label=continuation_offer color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_continuation_read [label=continuation_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_lineage_read [label=lineage_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_lineage_record [label=lineage_record color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_prompt_index_status [label=prompt_index_status color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_classify [label=task_classify color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  sdk -> action_capture_bind [label=write]
  action_capture_bind -> writer [label=boot]
  sdk -> action_continuation_accept [label=write]
  action_continuation_accept -> writer [label="state-travel"]
  sdk -> action_continuation_cancel [label=write]
  action_continuation_cancel -> writer [label="state-travel"]
  sdk -> action_continuation_context [label=read]
  action_continuation_context -> read [label="state-travel"]
  sdk -> action_continuation_offer [label=write]
  action_continuation_offer -> writer [label="state-travel"]
  sdk -> action_continuation_read [label=read]
  action_continuation_read -> read [label="state-travel"]
  sdk -> action_lineage_read [label=read]
  action_lineage_read -> read [label=lifecycle]
  sdk -> action_lineage_record [label=write]
  action_lineage_record -> writer [label=lifecycle]
  sdk -> action_prompt_index_status [label=read]
  action_prompt_index_status -> read [label="source-intake"]
  sdk -> action_task_classify [label=write]
  action_task_classify -> writer [label=lifecycle]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_capture_bind -> action_continuation_accept [constraint=true style=invis weight=100]
  action_continuation_cancel -> action_continuation_context [constraint=true style=invis weight=100]
  action_continuation_read -> action_lineage_read [constraint=true style=invis weight=100]
  action_prompt_index_status -> action_task_classify [constraint=true style=invis weight=100]
}
