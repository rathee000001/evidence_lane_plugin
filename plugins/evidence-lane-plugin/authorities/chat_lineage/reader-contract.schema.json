{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AuthorityRequest_continuation_context": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "continuation_context",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/ContinuationContextRequest"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_continuation_context",
      "type": "object"
    },
    "AuthorityRequest_continuation_read": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "continuation_read",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/ContinuationRead"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_continuation_read",
      "type": "object"
    },
    "AuthorityRequest_lineage_read": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "lineage_read",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/LineageRead"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_lineage_read",
      "type": "object"
    },
    "AuthorityRequest_prompt_index_status": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "prompt_index_status",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/PromptRead"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_prompt_index_status",
      "type": "object"
    },
    "ContinuationContextRequest": {
      "additionalProperties": false,
      "properties": {
        "continuation_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Continuation Id",
          "type": "string"
        },
        "continuation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Continuation Digest",
          "type": "string"
        },
        "limit": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "continuation_id",
        "continuation_digest"
      ],
      "title": "ContinuationContextRequest",
      "type": "object"
    },
    "ContinuationRead": {
      "additionalProperties": false,
      "properties": {
        "participant_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participant Id"
        },
        "after_sequence": {
          "default": 0,
          "minimum": 0,
          "title": "After Sequence",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "ContinuationRead",
      "type": "object"
    },
    "LineageRead": {
      "additionalProperties": false,
      "properties": {
        "match_mode": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Match Mode",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "after_sequence": {
          "default": 0,
          "minimum": 0,
          "title": "After Sequence",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "LineageRead",
      "type": "object"
    },
    "PromptRead": {
      "additionalProperties": false,
      "properties": {
        "reported_session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Session Id"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "after_index": {
          "default": 0,
          "minimum": 0,
          "title": "After Index",
          "type": "integer"
        }
      },
      "title": "PromptRead",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "continuation_context": "#/$defs/AuthorityRequest_continuation_context",
      "continuation_read": "#/$defs/AuthorityRequest_continuation_read",
      "lineage_read": "#/$defs/AuthorityRequest_lineage_read",
      "prompt_index_status": "#/$defs/AuthorityRequest_prompt_index_status"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AuthorityRequest_continuation_context"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_continuation_read"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_lineage_read"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_prompt_index_status"
    }
  ],
  "title": "chat_lineage typed SDK requests"
}
