digraph workflow_sessions {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  sdk [label="Authenticated SDK and native MCP client" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Exact selected scope and bounded recorded evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  owner [label="sessions current executable owner" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  writer [label="Engine coordinator and owning project writer" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_client_context [label=client_context color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_engine_health [label=engine_health color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_env_uop_inspect [label=env_uop_inspect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_lifecycle_transition_law [label=lifecycle_transition_law color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_work_classify [label=project_work_classify color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_render_runtime_panel [label=render_runtime_panel color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_runtime_doctor [label=runtime_doctor color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_runtime_status [label=runtime_status color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_boot [label=session_boot color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_context [label=session_context color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_exit [label=session_exit color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_exit_boundary [label=session_exit_boundary color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_flash_status [label=session_flash_status color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_resume [label=session_resume color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_status [label=session_status color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  sdk -> action_client_context [label=read]
  action_client_context -> read [label="open-project-session"]
  sdk -> action_engine_health [label=read]
  action_engine_health -> read [label="open-project-session"]
  sdk -> action_env_uop_inspect [label=read]
  action_env_uop_inspect -> read [label="evidence-lane"]
  sdk -> action_lifecycle_transition_law [label=read]
  action_lifecycle_transition_law -> read [label="evidence-lane"]
  sdk -> action_project_work_classify [label=read]
  action_project_work_classify -> read [label="classify-project-work"]
  sdk -> action_render_runtime_panel [label=read]
  action_render_runtime_panel -> read [label="open-project-session"]
  sdk -> action_runtime_doctor [label=read]
  action_runtime_doctor -> read [label="open-project-session"]
  sdk -> action_runtime_status [label=read]
  action_runtime_status -> read [label="select-project-tools"]
  sdk -> action_session_boot [label=write]
  action_session_boot -> writer [label="open-project-session"]
  sdk -> action_session_context [label=read]
  action_session_context -> read [label="open-project-session"]
  sdk -> action_session_exit [label=write]
  action_session_exit -> writer [label="close-project-session"]
  sdk -> action_session_exit_boundary [label=read]
  action_session_exit_boundary -> read [label="close-project-session"]
  sdk -> action_session_flash_status [label=read]
  action_session_flash_status -> read [label="open-project-session"]
  sdk -> action_session_resume [label=write]
  action_session_resume -> writer [label="open-project-session"]
  sdk -> action_session_status [label=read]
  action_session_status -> read [label="open-project-session"]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_client_context -> action_engine_health [constraint=true style=invis weight=100]
  action_engine_health -> action_env_uop_inspect [constraint=true style=invis weight=100]
  action_env_uop_inspect -> action_lifecycle_transition_law [constraint=true style=invis weight=100]
  action_project_work_classify -> action_render_runtime_panel [constraint=true style=invis weight=100]
  action_render_runtime_panel -> action_runtime_doctor [constraint=true style=invis weight=100]
  action_runtime_doctor -> action_runtime_status [constraint=true style=invis weight=100]
  action_session_boot -> action_session_context [constraint=true style=invis weight=100]
  action_session_context -> action_session_exit [constraint=true style=invis weight=100]
  action_session_exit -> action_session_exit_boundary [constraint=true style=invis weight=100]
  action_session_flash_status -> action_session_resume [constraint=true style=invis weight=100]
  action_session_resume -> action_session_status [constraint=true style=invis weight=100]
}
