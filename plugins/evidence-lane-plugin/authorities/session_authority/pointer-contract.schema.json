{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "none",
        "active",
        "closed"
      ],
      "title": "State",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "generation": {
      "default": 0,
      "title": "Generation",
      "type": "integer"
    },
    "owner_client_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Client Id"
    },
    "owner_engine_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Engine Id"
    },
    "reported_session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reported Session Id"
    },
    "flash_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Flash Digest"
    },
    "event_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Digest"
    },
    "runtime_package_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Package Digest"
    },
    "root_pv": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Root Pv",
      "type": "object"
    },
    "plan": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Plan",
      "type": "object"
    },
    "capture_bound": {
      "default": false,
      "title": "Capture Bound",
      "type": "boolean"
    },
    "owner_authenticated": {
      "default": false,
      "title": "Owner Authenticated",
      "type": "boolean"
    },
    "flash_current": {
      "default": false,
      "title": "Flash Current",
      "type": "boolean"
    },
    "context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context"
    },
    "host_observation": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Host Observation"
    },
    "operation": {
      "default": "status",
      "title": "Operation",
      "type": "string"
    },
    "observation_scope": {
      "default": "current_read",
      "enum": [
        "current_read",
        "at_transition_commit"
      ],
      "title": "Observation Scope",
      "type": "string"
    },
    "exit_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Reason"
    },
    "storage_route": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Storage Route"
    },
    "state_authority": {
      "const": "receipts_lane_sqlite",
      "default": "receipts_lane_sqlite",
      "title": "State Authority",
      "type": "string"
    },
    "identity_scope": {
      "const": "authenticated_engine_client",
      "default": "authenticated_engine_client",
      "title": "Identity Scope",
      "type": "string"
    },
    "reported_session_identity": {
      "const": "client_report_only",
      "default": "client_report_only",
      "title": "Reported Session Identity",
      "type": "string"
    },
    "native_task_attestation": {
      "const": "not_provided",
      "default": "not_provided",
      "title": "Native Task Attestation",
      "type": "string"
    },
    "hook_execution_attested": {
      "const": false,
      "default": false,
      "title": "Hook Execution Attested",
      "type": "boolean"
    },
    "native_plan_updated": {
      "const": false,
      "default": false,
      "title": "Native Plan Updated",
      "type": "boolean"
    },
    "jobs_replayed": {
      "const": false,
      "default": false,
      "title": "Jobs Replayed",
      "type": "boolean"
    },
    "terminal_exit": {
      "const": false,
      "default": false,
      "title": "Terminal Exit",
      "type": "boolean"
    },
    "native_goal_completed": {
      "const": false,
      "default": false,
      "title": "Native Goal Completed",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "state",
    "root_pv",
    "plan"
  ],
  "title": "Exact session head, locked Flash and owner attribution",
  "type": "object"
}
