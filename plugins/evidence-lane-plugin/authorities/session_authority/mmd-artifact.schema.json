{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "session_authority MERMAID_TRAVERSAL_MAP artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "session_authority"
    },
    "artifact_path": {
      "const": "session-authority.mmd"
    },
    "artifact_role": {
      "const": "MERMAID_TRAVERSAL_MAP"
    },
    "syntax": {
      "const": "MERMAID_FLOWCHART"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "authority_support.validate_authority_support"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "645D42C9BF5CA5764BB2B691C0B5834D5534E2199E5753CD82E6D408215A7646"
}
