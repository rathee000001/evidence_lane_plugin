{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AuthorityRequest_session_boot": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "session_boot",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/SessionBoot"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_session_boot",
      "type": "object"
    },
    "AuthorityRequest_session_exit": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "session_exit",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/SessionExit"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_session_exit",
      "type": "object"
    },
    "AuthorityRequest_session_resume": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "session_resume",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/SessionResume"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_session_resume",
      "type": "object"
    },
    "SessionBoot": {
      "additionalProperties": false,
      "properties": {
        "reported_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Reported Session Id",
          "type": "string"
        },
        "expected_root_pv_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Root Pv Digest",
          "type": "string"
        },
        "require_native_attestation": {
          "default": false,
          "title": "Require Native Attestation",
          "type": "boolean"
        }
      },
      "required": [
        "reported_session_id",
        "expected_root_pv_digest"
      ],
      "title": "SessionBoot",
      "type": "object"
    },
    "SessionExit": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "expected_generation": {
          "minimum": 1,
          "title": "Expected Generation",
          "type": "integer"
        },
        "expected_event_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Event Digest",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "expected_generation",
        "expected_event_digest",
        "reason"
      ],
      "title": "SessionExit",
      "type": "object"
    },
    "SessionResume": {
      "additionalProperties": false,
      "properties": {
        "reported_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Reported Session Id",
          "type": "string"
        },
        "expected_root_pv_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Root Pv Digest",
          "type": "string"
        },
        "require_native_attestation": {
          "default": false,
          "title": "Require Native Attestation",
          "type": "boolean"
        },
        "session_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "expected_generation": {
          "minimum": 1,
          "title": "Expected Generation",
          "type": "integer"
        },
        "expected_event_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Event Digest",
          "type": "string"
        },
        "continuation_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation Id"
        }
      },
      "required": [
        "reported_session_id",
        "expected_root_pv_digest",
        "session_id",
        "expected_generation",
        "expected_event_digest"
      ],
      "title": "SessionResume",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "session_boot": "#/$defs/AuthorityRequest_session_boot",
      "session_exit": "#/$defs/AuthorityRequest_session_exit",
      "session_resume": "#/$defs/AuthorityRequest_session_resume"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AuthorityRequest_session_boot"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_session_exit"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_session_resume"
    }
  ],
  "title": "sessions typed SDK requests"
}
