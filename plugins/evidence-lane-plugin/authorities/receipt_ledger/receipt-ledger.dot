digraph schema_receipts {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  t_accelerator_settings [label="accelerator_settings\nrevision, config_json, digest, actor_id, configured_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_access_grants [label="access_grants\ngrant_id, principal_id, permissions_json, roots_json, expires_at, revoked_at, created_at, parent_grant_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_capture_decisions [label="capture_decisions\nsequence, event_id, previous_digest, digest, body_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_extensions_events [label="extensions_events\nsequence, event_id, plugin_id, event_type, actor_id, occurred_at, details_json, prior_digest, digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_extensions_registration [label="extensions_registration\nplugin_id, current_version, revoked_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_extensions_versions [label="extensions_versions\nplugin_id, version, registration_json, digest, configured_at, actor_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_gitpush_current [label="gitpush_current\naction_id, sequence, digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_gitpush_events [label="gitpush_events\naction_id, sequence, digest, body_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_hostmemory_imports [label="hostmemory_imports\nrequest_id, actor_id, input_digest, receipt_id, receipt_digest, result_json, result_digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_lane_identity [label="lane_identity\nsingleton, project_id, lane_id, kind, storage_layout, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_objects [label="objects\ndigest, size_bytes, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_receipts [label="receipts\nreceipt_id, kind, body_json, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_recovery_backups [label="recovery_backups\nrequest_id, actor_id, input_digest, result_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_recovery_control [label="recovery_control\nsingleton, recovery_digest, required_after_revision, cleared_by_revision" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_recovery_history [label="recovery_history\nsequence, digest, body_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_remote_probe [label="remote_probe\nprincipal_id, policy_digest, nonce_digest, object_digest, engine_id, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_migrations [label="schema_migrations\nowner, version, digest, description, applied_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_ownership [label="schema_ownership\nobject_name, owner, object_type" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_storage_selection_events [label="storage_selection_events\nsequence, request_id, client_id, input_digest, previous_digest, body_json, digest, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_access_grants -> t_access_grants [label=parent_grant_id]
  t_extensions_events -> t_extensions_registration [label=plugin_id]
  t_extensions_versions -> t_extensions_registration [label=plugin_id]
  t_gitpush_current -> t_gitpush_events [label=action_id]
  t_gitpush_current -> t_gitpush_events [label=sequence]
  t_hostmemory_imports -> t_receipts [label=receipt_id]
}
