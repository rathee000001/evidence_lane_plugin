  "title": "receipt_ledger DOT_TRAVERSAL_MAP artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "receipt_ledger"
    },
    "artifact_path": {
      "const": "receipt-ledger.dot"
    },
    "artifact_role": {
      "const": "DOT_TRAVERSAL_MAP"
    },
    "syntax": {
      "const": "GRAPHVIZ_DOT"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "authority_support.validate_authority_support"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "044B85350E8D131436666F4EB1C9B0D7EC1A63097A864C20594BF688955CEE08"
}
