digraph workflow_receipts {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  sdk [label="Authenticated SDK and native MCP client" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Exact selected scope and bounded recorded evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  writer [label="Engine coordinator and owning project writer" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Current stored Plan operation and Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  owner [label="receipts current executable owner" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_accelerator_configure [label=accelerator_configure color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_accelerator_read [label=accelerator_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_capture_bind [label=capture_bind color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_connector_configure [label=connector_configure color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_connector_read [label=connector_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_connector_revoke [label=connector_revoke color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_remote_git_action_read [label=remote_git_action_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_remote_git_execute_push [label=remote_git_execute_push color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_remote_git_prepare_push [label=remote_git_prepare_push color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_boot [label=session_boot color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_context [label=session_context color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_exit [label=session_exit color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_exit_boundary [label=session_exit_boundary color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_resume [label=session_resume color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_session_status [label=session_status color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_storage_connector_inspect [label=storage_connector_inspect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_storage_connector_select [label=storage_connector_select color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  sdk -> action_accelerator_configure [label=admin]
  action_accelerator_configure -> writer [label="select-project-tools"]
  sdk -> action_accelerator_read [label=read]
  action_accelerator_read -> read [label="select-project-tools"]
  sdk -> action_capture_bind [label=write]
  action_capture_bind -> writer [label="open-project-session"]
  sdk -> action_connector_configure [label=admin]
  action_connector_configure -> writer [label="configure-project-connector"]
  sdk -> action_connector_read [label=read]
  action_connector_read -> read [label="inspect-project-connectors"]
  sdk -> action_connector_revoke [label=admin]
  action_connector_revoke -> writer [label="revoke-project-connector"]
  sdk -> action_remote_git_action_read [label=read]
  action_remote_git_action_read -> read [label="run-project-lifecycle"]
  sdk -> action_remote_git_execute_push [label=publish]
  delta -> action_remote_git_execute_push [label="required current operation contract"]
  action_remote_git_execute_push -> writer [label="run-project-lifecycle"]
  sdk -> action_remote_git_prepare_push [label=publish]
  delta -> action_remote_git_prepare_push [label="required current operation contract"]
  action_remote_git_prepare_push -> writer [label="run-project-lifecycle"]
  sdk -> action_session_boot [label=write]
  action_session_boot -> writer [label="open-project-session"]
  sdk -> action_session_context [label=read]
  action_session_context -> read [label="open-project-session"]
  sdk -> action_session_exit [label=write]
  action_session_exit -> writer [label="close-project-session"]
  sdk -> action_session_exit_boundary [label=read]
  action_session_exit_boundary -> read [label="close-project-session"]
  sdk -> action_session_resume [label=write]
  action_session_resume -> writer [label="open-project-session"]
  sdk -> action_session_status [label=read]
  action_session_status -> read [label="open-project-session"]
  sdk -> action_storage_connector_inspect [label=read]
  action_storage_connector_inspect -> read [label="select-project-storage"]
  sdk -> action_storage_connector_select [label=admin]
  action_storage_connector_select -> writer [label="select-project-storage"]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_accelerator_configure -> action_accelerator_read [constraint=true style=invis weight=100]
  action_connector_configure -> action_connector_read [constraint=true style=invis weight=100]
  action_remote_git_execute_push -> action_remote_git_prepare_push [constraint=true style=invis weight=100]
  action_session_exit -> action_session_exit_boundary [constraint=true style=invis weight=100]
  action_storage_connector_inspect -> action_storage_connector_select [constraint=true style=invis weight=100]
}
