{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AcceleratorConfig": {
      "additionalProperties": false,
      "properties": {
        "requested_profile": {
          "default": "cpu",
          "enum": [
            "cpu",
            "auto",
            "nvidia",
            "amd"
          ],
          "title": "Requested Profile",
          "type": "string"
        },
        "enabled_vendor_plugins": {
          "items": {
            "enum": [
              "nvidia",
              "amd"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Enabled Vendor Plugins",
          "type": "array"
        },
        "purpose": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "action_classes": {
          "items": {
            "enum": [
              "RETRIEVAL",
              "OCR_MEDIA",
              "EVALUATION"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Action Classes",
          "type": "array"
        },
        "device_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "memory_budget_percent": {
          "default": 80,
          "maximum": 95,
          "minimum": 1,
          "title": "Memory Budget Percent",
          "type": "integer"
        },
        "temperature_limit_c": {
          "default": 83,
          "maximum": 110,
          "minimum": 30,
          "title": "Temperature Limit C",
          "type": "integer"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "action_classes",
        "expires_at"
      ],
      "title": "AcceleratorConfig",
      "type": "object"
    },
    "AcceleratorConfigure": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "$ref": "#/$defs/AcceleratorConfig"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        }
      },
      "required": [
        "config",
        "expected_revision"
      ],
      "title": "AcceleratorConfigure",
      "type": "object"
    },
    "AuthorityRequest_accelerator_configure": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "accelerator_configure",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/AcceleratorConfigure"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_accelerator_configure",
      "type": "object"
    },
