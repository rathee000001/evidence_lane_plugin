    "CaptureBind": {
      "additionalProperties": false,
      "properties": {
        "reported_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Reported Session Id",
          "type": "string"
        }
      },
      "required": [
        "reported_session_id"
      ],
      "title": "CaptureBind",
      "type": "object"
    },
    "ConnectorConfigure": {
      "additionalProperties": false,
      "properties": {
        "registration": {
          "$ref": "#/$defs/PluginRegistration"
        },
        "expected_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Version"
        }
      },
      "required": [
        "registration"
      ],
      "title": "ConnectorConfigure",
      "type": "object"
    },
    "ConnectorRevoke": {
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "title": "Plugin Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "expected_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Digest",
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "expected_version",
        "expected_digest"
      ],
      "title": "ConnectorRevoke",
      "type": "object"
    },
    "PluginRegistration": {
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "title": "Plugin Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "plugin_kind": {
          "enum": [
            "connector",
            "toolchain"
          ],
          "title": "Plugin Kind",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "purpose": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "config_env_keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Config Env Keys",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "allowed_lanes": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Allowed Lanes",
          "type": "array"
        },
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Allowed Actions",
          "type": "array"
        },
        "write_roots": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Write Roots",
          "type": "array"
        },
        "read_roots": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Read Roots",
          "type": "array"
        },
        "resource_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Resource Ids",
          "type": "array"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9_-]{2,63}$",
          "title": "Role",
          "type": "string"
        },
        "role_schema": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Role Schema",
          "type": "object"
        },
        "host_profiles": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Host Profiles",
          "type": "array"
        },
        "backend_runtime": {
          "enum": [
            "python",
            "java",
            "kotlin",
            "go",
            "rust",
            "cpp",
            "external_mcp"
          ],
          "title": "Backend Runtime",
          "type": "string"
        },
        "backend_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{2,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend Id"
        },
        "backend_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend Version"
        }
      },
      "required": [
        "plugin_id",
        "name",
        "plugin_kind",
        "description",
        "purpose",
        "capabilities",
        "allowed_lanes",
        "allowed_actions",
        "expires_at",
        "role",
        "role_schema",
        "host_profiles",
        "backend_runtime"
      ],
      "title": "PluginRegistration",
      "type": "object"
    },
    "SessionBoot": {
      "additionalProperties": false,
      "properties": {
        "reported_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Reported Session Id",
          "type": "string"
        },
        "expected_root_pv_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Root Pv Digest",
          "type": "string"
        },
        "require_native_attestation": {
          "default": false,
          "title": "Require Native Attestation",
          "type": "boolean"
        }
      },
      "required": [
        "reported_session_id",
        "expected_root_pv_digest"
      ],
      "title": "SessionBoot",
      "type": "object"
    },
    "SessionExit": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "expected_generation": {
          "minimum": 1,
          "title": "Expected Generation",
          "type": "integer"
        },
        "expected_event_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Event Digest",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "expected_generation",
        "expected_event_digest",
        "reason"
      ],
      "title": "SessionExit",
      "type": "object"
    },
    "SessionResume": {
      "additionalProperties": false,
      "properties": {
        "reported_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Reported Session Id",
          "type": "string"
        },
        "expected_root_pv_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Root Pv Digest",
          "type": "string"
        },
        "require_native_attestation": {
          "default": false,
          "title": "Require Native Attestation",
          "type": "boolean"
        },
        "session_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "expected_generation": {
          "minimum": 1,
          "title": "Expected Generation",
          "type": "integer"
        },
        "expected_event_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Event Digest",
          "type": "string"
        },
        "continuation_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation Id"
        }
      },
      "required": [
        "reported_session_id",
        "expected_root_pv_digest",
        "session_id",
        "expected_generation",
        "expected_event_digest"
      ],
      "title": "SessionResume",
      "type": "object"
    },
    "StorageSelect": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "AUTO",
            "LOCAL_SQLITE",
            "CONFIGURED_DURABLE_CONNECTOR"
          ],
          "title": "Mode",
          "type": "string"
        },
        "connector_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connector Id"
        },
        "expected_event_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Event Digest"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
