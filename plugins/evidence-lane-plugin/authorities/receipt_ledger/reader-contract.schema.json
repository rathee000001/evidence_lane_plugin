      "type": "object"
    },
    "ConnectorRead": {
      "additionalProperties": false,
      "properties": {
        "after_id": {
          "default": "",
          "maxLength": 64,
          "title": "After Id",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_bytes": {
          "default": 65536,
          "maximum": 262144,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "title": "ConnectorRead",
      "type": "object"
    },
    "PushRead": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[0-9a-f-]{36}$",
          "title": "Action Id",
          "type": "string"
        }
      },
      "required": [
        "action_id"
      ],
      "title": "PushRead",
      "type": "object"
    },
    "SessionBoundaryRead": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "ordinary_turn",
            "delta_append",
            "session_exit",
            "work_handoff",
            "goal_completion"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_event_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Event Id"
        },
        "source_cursor": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Cursor"
        },
        "continuation_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation Id"
        },
        "continuation_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation Digest"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SessionBoundaryRead",
      "type": "object"
    },
    "SessionStatusRequest": {
      "additionalProperties": false,
      "properties": {},
      "title": "SessionStatusRequest",
      "type": "object"
    },
    "StorageInspect": {
      "additionalProperties": false,
      "properties": {
        "history_limit": {
          "default": 4096,
          "maximum": 4096,
          "minimum": 1,
          "title": "History Limit",
          "type": "integer"
        }
      },
      "title": "StorageInspect",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "accelerator_read": "#/$defs/AuthorityRequest_accelerator_read",
      "connector_read": "#/$defs/AuthorityRequest_connector_read",
      "remote_git_action_read": "#/$defs/AuthorityRequest_remote_git_action_read",
      "session_context": "#/$defs/AuthorityRequest_session_context",
      "session_exit_boundary": "#/$defs/AuthorityRequest_session_exit_boundary",
      "session_status": "#/$defs/AuthorityRequest_session_status",
      "storage_connector_inspect": "#/$defs/AuthorityRequest_storage_connector_inspect"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AuthorityRequest_accelerator_read"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_connector_read"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_remote_git_action_read"
    },
    {
