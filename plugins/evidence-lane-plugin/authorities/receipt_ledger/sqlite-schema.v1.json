    },
    {
      "type": "table",
      "name": "authority_index_content_cas",
      "tbl_name": "authority_index_content_cas",
      "sql": "CREATE TABLE authority_index_content_cas(\n            sha256 TEXT PRIMARY KEY,\n            size_bytes INTEGER NOT NULL CHECK(size_bytes >= 0),\n            compression TEXT NOT NULL,\n            compressed_bytes BLOB NOT NULL,\n            first_seen_at TEXT NOT NULL\n        ) STRICT"
    },
    {
      "type": "table",
      "name": "authority_index_fts",
      "tbl_name": "authority_index_fts",
      "sql": "CREATE VIRTUAL TABLE authority_index_fts USING fts5(\n            node_id UNINDEXED,\n            authority_id UNINDEXED,\n            source_table UNINDEXED,\n            source_identity UNINDEXED,\n            text_content,\n            content='',\n            contentless_delete=1,\n            tokenize='unicode61'\n        )"
    },
    {
      "type": "table",
      "name": "authority_index_fts_config",
      "tbl_name": "authority_index_fts_config",
      "sql": "CREATE TABLE 'authority_index_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID"
    },
    {
      "type": "table",
      "name": "authority_index_fts_data",
      "tbl_name": "authority_index_fts_data",
      "sql": "CREATE TABLE 'authority_index_fts_data'(id INTEGER PRIMARY KEY, block BLOB)"
    },
    {
      "type": "table",
      "name": "authority_index_fts_docsize",
      "tbl_name": "authority_index_fts_docsize",
      "sql": "CREATE TABLE 'authority_index_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB, origin INTEGER)"
    },
    {
      "type": "table",
      "name": "authority_index_fts_idx",
      "tbl_name": "authority_index_fts_idx",
      "sql": "CREATE TABLE 'authority_index_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID"
    },
    {
      "type": "table",
      "name": "authority_index_node",
      "tbl_name": "authority_index_node",
      "sql": "CREATE TABLE authority_index_node(\n            node_id TEXT PRIMARY KEY,\n            source_id TEXT NOT NULL REFERENCES authority_index_source(source_id)\n                ON DELETE CASCADE,\n            ordinal INTEGER NOT NULL,\n            char_start INTEGER NOT NULL,\n            char_end INTEGER NOT NULL,\n            text_sha256 TEXT NOT NULL\n                REFERENCES authority_index_content_cas(sha256),\n            metadata_sha256 TEXT NOT NULL\n                REFERENCES authority_index_content_cas(sha256),\n            UNIQUE(source_id, ordinal)\n        ) STRICT"
    },
    {
      "type": "table",
      "name": "authority_index_refresh_receipt",
      "tbl_name": "authority_index_refresh_receipt",
      "sql": "CREATE TABLE authority_index_refresh_receipt(\n            sequence INTEGER PRIMARY KEY,\n            authority_id TEXT NOT NULL,\n            source_count INTEGER NOT NULL,\n            node_count INTEGER NOT NULL,\n            indexed_table_count INTEGER NOT NULL,\n            llama_index_core_version TEXT NOT NULL,\n            chunk_size_tokens INTEGER NOT NULL,\n            chunk_overlap_tokens INTEGER NOT NULL,\n            prior_receipt_sha256 TEXT,\n            recorded_at TEXT NOT NULL,\n            receipt_sha256 TEXT NOT NULL UNIQUE,\n            receipt_json TEXT NOT NULL\n        ) STRICT"
    },
    {
      "type": "table",
      "name": "authority_index_source",
      "tbl_name": "authority_index_source",
      "sql": "CREATE TABLE authority_index_source(\n            source_id TEXT PRIMARY KEY,\n            authority_id TEXT NOT NULL,\n            source_table TEXT NOT NULL,\n            source_identity TEXT NOT NULL,\n            source_text_sha256 TEXT NOT NULL,\n            metadata_sha256 TEXT NOT NULL\n                REFERENCES authority_index_content_cas(sha256),\n            recorded_at TEXT NOT NULL,\n            UNIQUE(authority_id, source_table, source_identity)\n        ) STRICT"
    },
    {
      "type": "table",
      "name": "receipt_content_cas",
      "tbl_name": "receipt_content_cas",
      "sql": "CREATE TABLE receipt_content_cas(\n                receipt_sha256 TEXT PRIMARY KEY,\n                byte_count INTEGER NOT NULL CHECK(byte_count >= 0),\n                compression TEXT NOT NULL,\n                compressed_bytes BLOB NOT NULL,\n                first_recorded_at TEXT NOT NULL\n            ) STRICT"
    },
    {
      "type": "table",
      "name": "receipt_fts",
      "tbl_name": "receipt_fts",
      "sql": "CREATE VIRTUAL TABLE receipt_fts USING fts5(\n                receipt_sha256 UNINDEXED,\n                logical_path,\n                receipt_kind,\n                schema_id,\n                payload_text,\n                content='',\n                contentless_delete=1,\n                tokenize='unicode61'\n            )"
    },
    {
      "type": "table",
      "name": "receipt_fts_config",
      "tbl_name": "receipt_fts_config",
      "sql": "CREATE TABLE 'receipt_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID"
    },
    {
      "type": "table",
      "name": "receipt_fts_data",
      "tbl_name": "receipt_fts_data",
      "sql": "CREATE TABLE 'receipt_fts_data'(id INTEGER PRIMARY KEY, block BLOB)"
    },
    {
      "type": "table",
      "name": "receipt_fts_docsize",
      "tbl_name": "receipt_fts_docsize",
      "sql": "CREATE TABLE 'receipt_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB, origin INTEGER)"
    },
    {
      "type": "table",
      "name": "receipt_fts_idx",
      "tbl_name": "receipt_fts_idx",
      "sql": "CREATE TABLE 'receipt_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID"
    },
    {
      "type": "table",
      "name": "receipt_link",
      "tbl_name": "receipt_link",
      "sql": "CREATE TABLE receipt_link(\n                link_id INTEGER PRIMARY KEY,\n                source_receipt_sha256 TEXT NOT NULL\n                    REFERENCES receipt_record(receipt_sha256),\n                relation TEXT NOT NULL,\n                target_receipt_sha256 TEXT NOT NULL,\n                metadata_json TEXT NOT NULL,\n                UNIQUE(source_receipt_sha256, relation, target_receipt_sha256)\n            ) STRICT"
    },
    {
      "type": "table",
      "name": "receipt_migration_batch",
      "tbl_name": "receipt_migration_batch",
      "sql": "CREATE TABLE receipt_migration_batch(\n                batch_id TEXT PRIMARY KEY,\n                source_root TEXT NOT NULL,\n                source_file_count INTEGER NOT NULL,\n                source_bytes INTEGER NOT NULL,\n                ingested_count INTEGER NOT NULL,\n                duplicate_count INTEGER NOT NULL,\n                removed_count INTEGER NOT NULL,\n                source_removal_authorized INTEGER NOT NULL\n                    CHECK(source_removal_authorized IN (0,1)),\n                receipt_sha256 TEXT NOT NULL UNIQUE,\n                receipt_json TEXT NOT NULL,\n                recorded_at TEXT NOT NULL\n            ) STRICT"
    },
    {
      "type": "table",
      "name": "receipt_record",
      "tbl_name": "receipt_record",
      "sql": "CREATE TABLE receipt_record(\n                sequence INTEGER PRIMARY KEY,\n                receipt_sha256 TEXT NOT NULL UNIQUE\n                    REFERENCES receipt_content_cas(receipt_sha256),\n                logical_path TEXT NOT NULL UNIQUE,\n                receipt_kind TEXT NOT NULL,\n                schema_id TEXT,\n                project_id TEXT,\n                session_id TEXT,\n                host_task_id TEXT,\n                media_type TEXT NOT NULL,\n                byte_count INTEGER NOT NULL CHECK(byte_count >= 0),\n                payload_json TEXT,\n                prior_receipt_sha256 TEXT,\n                supersedes_receipt_sha256 TEXT,\n                recorded_at TEXT NOT NULL,\n                source_file_removed INTEGER NOT NULL DEFAULT 0\n                    CHECK(source_file_removed IN (0,1))\n            ) STRICT"
    },
    {
      "type": "trigger",
      "name": "receipt_record_no_delete",
      "tbl_name": "receipt_record",
      "sql": "CREATE TRIGGER receipt_record_no_delete\n            BEFORE DELETE ON receipt_record BEGIN\n              SELECT RAISE(ABORT, 'receipt ledger is append-only');\n            END"
    },
    {
      "type": "trigger",
      "name": "receipt_record_no_update",
      "tbl_name": "receipt_record",
      "sql": "CREATE TRIGGER receipt_record_no_update\n            BEFORE UPDATE ON receipt_record BEGIN\n              SELECT RAISE(ABORT, 'receipt ledger is append-only');\n            END"
    }
  ],
