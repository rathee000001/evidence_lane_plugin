      "name": "authority_index_node_source_idx",
      "tbl_name": "authority_index_node",
      "sql": "CREATE INDEX authority_index_node_source_idx\n        ON authority_index_node(source_id, ordinal)"
    },
    {
      "type": "index",
      "name": "authority_index_source_table_idx",
      "tbl_name": "authority_index_source",
      "sql": "CREATE INDEX authority_index_source_table_idx\n        ON authority_index_source(authority_id, source_table, source_identity)"
    },
    {
      "type": "index",
      "name": "receipt_record_kind_idx",
      "tbl_name": "receipt_record",
      "sql": "CREATE INDEX receipt_record_kind_idx\n            ON receipt_record(receipt_kind, sequence)"
    },
    {
      "type": "index",
      "name": "receipt_record_project_session_idx",
      "tbl_name": "receipt_record",
