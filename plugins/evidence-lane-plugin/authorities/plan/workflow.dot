digraph workflow_plan {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  sdk [label="Authenticated SDK and native MCP client" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Exact selected scope and bounded recorded evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  writer [label="Engine coordinator and owning project writer" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Current stored Plan operation and Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  owner [label="plan current executable owner" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_delta_enter [label=delta_enter color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_delta_enter_planned [label=delta_enter_planned color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_delta_query [label=delta_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_delta_status [label=delta_status color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_job_reconcile_effect [label=job_reconcile_effect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_job_recovery_inspect [label=job_recovery_inspect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_plan_create [label=plan_create color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_plan_host_bind [label=plan_host_bind color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_plan_host_status [label=plan_host_status color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_plan_host_sync [label=plan_host_sync color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_plan_read [label=plan_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_plan_refresh [label=plan_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_steer_preview [label=steer_preview color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_steer_submit [label=steer_submit color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_validation_policy_read [label=validation_policy_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_validation_policy_set [label=validation_policy_set color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  sdk -> action_delta_enter [label=write]
  action_delta_enter -> writer [label=build]
  sdk -> action_delta_enter_planned [label=write]
  action_delta_enter_planned -> writer [label=build]
  sdk -> action_delta_query [label=read]
  action_delta_query -> read [label=evi]
  sdk -> action_delta_status [label=read]
  action_delta_status -> read [label=build]
  sdk -> action_job_reconcile_effect [label=admin]
  action_job_reconcile_effect -> writer [label=recover]
  sdk -> action_job_recovery_inspect [label=read]
  action_job_recovery_inspect -> read [label=recover]
  sdk -> action_plan_create [label=write]
  action_plan_create -> writer [label=plan]
  sdk -> action_plan_host_bind [label=admin]
  action_plan_host_bind -> writer [label=plan]
  sdk -> action_plan_host_status [label=read]
  action_plan_host_status -> read [label=plan]
  sdk -> action_plan_host_sync [label=write]
  action_plan_host_sync -> writer [label=plan]
  sdk -> action_plan_read [label=read]
  action_plan_read -> read [label=plan]
  sdk -> action_plan_refresh [label=write]
  action_plan_refresh -> writer [label=plan]
  sdk -> action_steer_preview [label=read]
  action_steer_preview -> read [label=plan]
  sdk -> action_steer_submit [label=write]
  action_steer_submit -> writer [label=plan]
  sdk -> action_validation_policy_read [label=read]
  action_validation_policy_read -> read [label=plan]
  sdk -> action_validation_policy_set [label=write]
  action_validation_policy_set -> writer [label=plan]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_delta_enter -> action_delta_enter_planned [constraint=true style=invis weight=100]
  action_delta_query -> action_delta_status [constraint=true style=invis weight=100]
  action_plan_create -> action_plan_host_bind [constraint=true style=invis weight=100]
  action_plan_read -> action_plan_refresh [constraint=true style=invis weight=100]
  action_validation_policy_read -> action_validation_policy_set [constraint=true style=invis weight=100]
}
