        "check_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Check Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/ValidationSelector"
        },
        "command": {
          "$ref": "#/$defs/ValidationCommand"
        }
      },
      "required": [
        "check_id",
        "title",
        "command"
      ],
      "title": "ValidationRule",
      "type": "object"
    },
    "ValidationSelector": {
      "additionalProperties": false,
      "description": "OR within each list; AND across nonempty path/profile/action lists.",
      "properties": {
        "paths": {
          "items": {
            "type": "string"
