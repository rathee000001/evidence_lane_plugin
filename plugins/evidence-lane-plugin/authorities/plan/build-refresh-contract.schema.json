          "type": "array"
        },
        "working_directory": {
          "default": ".",
          "maxLength": 500,
          "minLength": 1,
          "title": "Working Directory",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 300,
          "maximum": 1800,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_output_bytes": {
          "default": 8192,
          "description": "Maximum captured bytes in each output stream.",
          "maximum": 65536,
          "minimum": 256,
          "title": "Max Output Bytes",
          "type": "integer"
        }
      },
      "required": [
        "tool_id",
        "executable",
        "executable_sha256"
      ],
      "title": "ValidationCommand",
      "type": "object"
    },
    "ValidationPolicy": {
      "additionalProperties": false,
      "description": "Only additional project checks; owning profile verifiers remain mandatory.",
