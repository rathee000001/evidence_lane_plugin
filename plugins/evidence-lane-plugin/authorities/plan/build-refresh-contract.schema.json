        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "input_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Input Paths",
          "type": "array"
        },
        "exclude_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Exclude Paths",
          "type": "array"
