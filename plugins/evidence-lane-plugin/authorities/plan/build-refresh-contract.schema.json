          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "intent": {
          "enum": [
            "informational",
            "semantic",
            "stop"
          ],
          "title": "Intent",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "affected_task_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2000,
          "title": "Affected Task Ids",
          "type": "array"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 65536,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        }
      },
      "required": [
        "source_event_id",
        "source_cursor",
        "expected_revision",
        "intent",
        "rationale"
      ],
      "title": "SteerIntent",
      "type": "object"
    },
    "TaskBudget": {
      "additionalProperties": false,
      "properties": {
        "max_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 64,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_input_bytes": {
          "default": 1048576,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max Input Bytes",
          "type": "integer"
        },
        "max_output_bytes": {
          "default": 4194304,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        }
      },
      "title": "TaskBudget",
      "type": "object"
    },
    "TaskDefinition": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "requested_outcome": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Requested Outcome",
          "type": "string"
        },
        "profile": {
          "default": "core",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Profile",
          "type": "string"
        },
        "permitted_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Permitted Paths",
          "type": "array"
        },
        "permitted_tools": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Permitted Tools",
          "type": "array"
        },
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Allowed Actions",
          "type": "array"
        },
        "acceptance_checks": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Acceptance Checks",
          "type": "array"
        },
        "stop_condition": {
          "default": "Stop on failed verification or unavailable required capability.",
          "maxLength": 1000,
          "title": "Stop Condition",
          "type": "string"
        },
        "dependencies": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependencies"
        },
        "plan_group": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Group"
        },
        "commit_batch_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Batch Id"
        },
        "budget": {
          "$ref": "#/$defs/TaskBudget"
        },
        "mode_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskModeBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskOperation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validation_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskValidationBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "task_id",
        "title",
        "requested_outcome"
      ],
      "title": "TaskDefinition",
      "type": "object"
    },
    "TaskModeBinding": {
      "additionalProperties": false,
      "description": "Exact, project-owned classification reference; never ambient session state.",
      "properties": {
        "classification_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Classification Id",
          "type": "string"
        },
        "classification_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Classification Digest",
          "type": "string"
        },
        "source_event_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Source Event Id",
          "type": "string"
        },
        "source_cursor": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Cursor",
          "type": "string"
        },
        "selection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Sha256",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        }
      },
      "required": [
        "classification_id",
        "classification_digest",
        "source_event_id",
        "source_cursor",
        "selection_sha256",
        "manifest_digest"
      ],
      "title": "TaskModeBinding",
      "type": "object"
    },
    "TaskOperation": {
      "additionalProperties": false,
      "description": "One exact operation owned by this Plan contract, not a second job queue.",
      "properties": {
        "action": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Action",
          "type": "string"
