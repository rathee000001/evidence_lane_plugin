        "max_files": {
          "default": 2048,
          "maximum": 8192,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_file_bytes": {
          "default": 8388608,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 67108864,
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
