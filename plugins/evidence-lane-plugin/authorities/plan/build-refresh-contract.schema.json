          "maxItems": 64,
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Profiles",
          "type": "array"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Actions",
          "type": "array"
        }
      },
      "title": "ValidationSelector",
      "type": "object"
    }
