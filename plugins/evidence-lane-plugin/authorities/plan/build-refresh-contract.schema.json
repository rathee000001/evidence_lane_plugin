      "additionalProperties": false,
      "description": "Pinned executor plus literal arguments; no shell expansion or PATH lookup.",
      "properties": {
        "tool_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Tool Id",
          "type": "string"
        },
        "executable": {
          "maxLength": 2000,
          "minLength": 1,
