digraph schema_plan {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  t_delta_exits [label="delta_exits\njob_id, verification_object, receipt_id, next_task_id, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_delta_runs [label="delta_runs\njob_id, request_id, actor_id, task_id, plan_revision, contract_digest, binding_digest, entry_object, state, result_object, error_code, created_at, updated_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_jobs_effects [label="jobs_effects\neffect_id, job_id, effect_key, state, description, evidence_object, created_at, updated_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_jobs_jobs [label="jobs_jobs\njob_id, request_id, client_id, request_digest, request_json, action, plan_revision, state, owner_fence, execution_id, phase, checkpoint_object, resumable, cancellation_reason, result_json, error_code, created_at, updated_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_lane_identity [label="lane_identity\nsingleton, project_id, lane_id, kind, storage_layout, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_objects [label="objects\ndigest, size_bytes, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_plan_current [label="plan_current\nsingleton, revision, event_head" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_plan_dependencies [label="plan_dependencies\nrevision, task_id, dependency_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_plan_events [label="plan_events\nsequence, event_id, revision, task_id, kind, actor_id, payload_json, previous_digest, digest, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_plan_host_bindings [label="plan_host_bindings\nbinding_id, request_id, host_task_id, host_plan_id, plan_path, current_sha256, bound_by, binding_digest, active, created_at, updated_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_plan_host_projections [label="plan_host_projections\nsequence, projection_id, binding_id, plan_revision, plan_event_head, document_digest, rows_json, rows_digest, markdown_text, markdown_sha256, state, previous_projection_id, prepared_by, prepared_at, attempts, last_error, file_before_sha2..." color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_plan_revisions [label="plan_revisions\nrevision, plan_id, title, request_id, document_json, document_digest, parent_revision, actor_id, reason, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_plan_tasks [label="plan_tasks\nrevision, task_id, position, definition_json, contract_digest, state, last_event" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_migrations [label="schema_migrations\nowner, version, digest, description, applied_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_ownership [label="schema_ownership\nobject_name, owner, object_type" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_steer_control [label="steer_control\nsingleton, paused, source_event_id, source_cursor, actor_id, updated_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_steer_interrupts [label="steer_interrupts\nevent_id, source_cursor, actor_id, receipt_id, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_steer_requests [label="steer_requests\nrequest_id, source_event_id, source_cursor, actor_id, expected_revision, intent, affected_json, rationale, identity_digest, state, checkpoint_object, applied_revision, created_at, updated_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_validation_policy_current [label="validation_policy_current\nsingleton, revision" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_validation_policy_revisions [label="validation_policy_revisions\nrevision, request_id, request_digest, policy_json, policy_digest, previous_digest, revision_digest, actor_id, receipt_id, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_validationrun_summaries [label="validationrun_summaries\njob_id, task_id, plan_revision, contract_digest, summary_object, receipt_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_delta_exits -> t_objects [label=verification_object]
  t_delta_exits -> t_delta_runs [label=job_id]
  t_delta_runs -> t_plan_tasks [label=plan_revision]
  t_delta_runs -> t_plan_tasks [label=task_id]
  t_delta_runs -> t_objects [label=result_object]
  t_delta_runs -> t_objects [label=entry_object]
  t_delta_runs -> t_jobs_jobs [label=job_id]
  t_jobs_effects -> t_objects [label=evidence_object]
  t_jobs_effects -> t_jobs_jobs [label=job_id]
  t_jobs_jobs -> t_objects [label=checkpoint_object]
  t_plan_current -> t_plan_revisions [label=revision]
  t_plan_dependencies -> t_plan_tasks [label=revision]
  t_plan_dependencies -> t_plan_tasks [label=dependency_id]
  t_plan_dependencies -> t_plan_tasks [label=revision]
  t_plan_dependencies -> t_plan_tasks [label=task_id]
  t_plan_events -> t_plan_revisions [label=revision]
  t_plan_host_projections -> t_plan_revisions [label=plan_revision]
  t_plan_host_projections -> t_plan_host_bindings [label=binding_id]
  t_plan_revisions -> t_plan_revisions [label=parent_revision]
  t_plan_tasks -> t_plan_revisions [label=revision]
  t_steer_requests -> t_objects [label=checkpoint_object]
  t_validation_policy_current -> t_validation_policy_revisions [label=revision]
}
