            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/JobRecoveryRead"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_job_recovery_inspect",
      "type": "object"
    },
    "AuthorityRequest_plan_host_status": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "plan_host_status",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/HostPlanProjectionRead"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_plan_host_status",
      "type": "object"
    },
    "AuthorityRequest_plan_read": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "plan_read",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/PlanRead"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_plan_read",
      "type": "object"
    },
    "AuthorityRequest_steer_preview": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "steer_preview",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/SteerIntent"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_steer_preview",
      "type": "object"
    },
    "AuthorityRequest_validation_policy_read": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "validation_policy_read",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/ValidationPolicyRead"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_validation_policy_read",
      "type": "object"
    },
    "DeltaQuery": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "plan_revision": {
          "minimum": 1,
          "title": "Plan Revision",
          "type": "integer"
        },
        "action": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Action",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "max_bytes": {
          "default": 65536,
          "maximum": 262144,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "plan_revision",
        "action"
      ],
      "title": "DeltaQuery",
      "type": "object"
    },
    "DeltaStatusRequest": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Job Id",
          "type": "string"
        },
        "include_result": {
          "default": false,
          "title": "Include Result",
          "type": "boolean"
        },
        "include_verification": {
          "default": false,
          "title": "Include Verification",
          "type": "boolean"
        },
        "max_bytes": {
          "default": 65536,
          "maximum": 262144,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "DeltaStatusRequest",
      "type": "object"
    },
    "HostPlanProjectionRead": {
      "additionalProperties": false,
      "properties": {
        "projection_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Id"
        }
      },
      "title": "HostPlanProjectionRead",
      "type": "object"
    },
    "JobRecoveryRead": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "JobRecoveryRead",
      "type": "object"
    },
    "JsonValue": {},
    "PlanRead": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "offset": {
          "default": 0,
          "maximum": 2000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "PlanRead",
      "type": "object"
    },
    "SteerIntent": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "source_event_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Source Event Id",
          "type": "string"
        },
        "source_cursor": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Cursor",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "intent": {
          "enum": [
            "informational",
            "semantic",
            "stop"
          ],
          "title": "Intent",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "affected_task_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2000,
          "title": "Affected Task Ids",
          "type": "array"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 65536,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        }
      },
      "required": [
        "source_event_id",
        "source_cursor",
        "expected_revision",
        "intent",
        "rationale"
      ],
      "title": "SteerIntent",
      "type": "object"
    },
    "ValidationPolicyRead": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "expected_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Digest"
        }
      },
      "title": "ValidationPolicyRead",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "delta_query": "#/$defs/AuthorityRequest_delta_query",
      "delta_status": "#/$defs/AuthorityRequest_delta_status",
      "job_recovery_inspect": "#/$defs/AuthorityRequest_job_recovery_inspect",
      "plan_host_status": "#/$defs/AuthorityRequest_plan_host_status",
      "plan_read": "#/$defs/AuthorityRequest_plan_read",
      "steer_preview": "#/$defs/AuthorityRequest_steer_preview",
      "validation_policy_read": "#/$defs/AuthorityRequest_validation_policy_read"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AuthorityRequest_delta_query"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_delta_status"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_job_recovery_inspect"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_plan_host_status"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_plan_read"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_steer_preview"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_validation_policy_read"
    }
  ],
  "title": "plan typed SDK requests"
}
