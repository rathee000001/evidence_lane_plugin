{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "view_id": {
      "title": "View Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "published",
        "empty"
      ],
      "title": "State",
      "type": "string"
    },
    "generation": {
      "title": "Generation",
      "type": "integer"
    },
    "snapshot_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Snapshot Digest"
    },
    "files": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "title": "Files",
      "type": "array"
    },
    "source_authority_mutated": {
      "const": false,
      "default": false,
      "title": "Source Authority Mutated",
      "type": "boolean"
    },
    "reused_snapshot": {
      "default": false,
      "title": "Reused Snapshot",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "view_id",
    "state",
    "generation",
    "snapshot_digest",
    "files"
  ],
  "title": "plan selected project graph publication",
  "type": "object",
  "x-format": "mmd",
  "x-lane-id": "plan",
  "x-view-contracts": [
    {
      "view_id": "plan.dependencies",
      "lane_id": "plan",
      "folder": "authorities/plan",
      "version": 1,
      "meaning": "Current Plan tasks, states and declared dependencies.",
      "consumer": "artifact_export",
      "implementation_digest": "1554d49eb5fb3530d012d2abd0b25a0e43764cb547937cca635910339eb46c4a",
      "files": {
        "mmd": "plan.mmd",
        "dot": "plan.dot",
        "pointer": "plan-pointer.json"
      },
      "scope": {
        "query": false,
        "include_history": false,
        "max_nodes": 200,
        "max_edges": 500
      },
      "source_owners": [
        "plan"
      ],
      "node_kinds": [
        "plan_task"
      ],
      "edge_kinds": [
        "DEPENDS_ON"
      ],
      "schemas": [
        {
          "owner": "plan",
          "version": 1,
          "digest": "894079043dd019dfeba959e2775a2d8c7503ad08b384ff8e7c5ac5ad7387666c"
        },
        {
          "owner": "plan",
          "version": 2,
          "digest": "cb9132a93a80e1dc059d9cf60e1a12cd7b0bbf636db1d22cc0334b56e9ae3543"
        },
        {
          "owner": "plan",
          "version": 3,
          "digest": "d8bca37d7340c6873d3a4d3dc58cc43bbe157c124b02d708f5d303ee74bbdb79"
        }
      ],
      "authority": "owning_lane_sqlite",
      "current_selector": "owning_lane_sqlite",
      "head_reader": "declared_owner_events",
      "pointer_scope": "immutable_snapshot_navigation",
      "shared_tools": {
        "mmd": {
          "primary": "langgraph_graph_exporter",
          "dependencies": [
            "langgraph",
            "langchain-core",
            "graphviz",
            "rustworkx"
          ]
        },
        "dot": {
          "primary": "python_graphviz",
          "dependencies": [
            "langgraph",
            "langchain-core",
            "graphviz",
            "rustworkx"
          ],
          "native_validation": "explicit_native_choice_requires_shared_binary_and_supported_client_profile"
        }
      },
      "graph_execution": {
        "analysis": "bounded_rustworkx",
        "default_dot_validation": "source",
        "native_failure_fallback": false,
        "package_projection_runtime_observations": false
      }
    }
  ],
  "x-automatic-refresh": false
}
