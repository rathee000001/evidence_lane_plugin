{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_overlay MERMAID_TRAVERSAL_MAP artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "project_overlay"
    },
    "artifact_path": {
      "const": "project_overlay.mmd"
    },
    "artifact_role": {
      "const": "MERMAID_TRAVERSAL_MAP"
    },
    "syntax": {
      "const": "MERMAID_FLOWCHART"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "authority_support.validate_authority_support"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "BDB2A3C942FFD5BD91202ADB0D18B07B175D40E2A98AFFCAB1C1E7A65C682D78"
}
