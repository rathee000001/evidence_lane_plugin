{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_overlay SQLITE_AUTHORITY artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "project_overlay"
    },
    "artifact_path": {
      "const": "project_overlay.sqlite"
    },
    "artifact_role": {
      "const": "SQLITE_AUTHORITY"
    },
    "syntax": {
      "const": "SQLITE3_FTS5"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "authority_support._schema_snapshot"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "EA4098F52965DC5CB0111439FEB15E0E175C31D02DACE1F0C539D18BAAB91A6C"
}
