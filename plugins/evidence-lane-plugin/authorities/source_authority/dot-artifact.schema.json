{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source_authority DOT_TRAVERSAL_MAP artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "source_authority"
    },
    "artifact_path": {
      "const": "source_authority.dot"
    },
    "artifact_role": {
      "const": "DOT_TRAVERSAL_MAP"
    },
    "syntax": {
      "const": "GRAPHVIZ_DOT"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "authority_support.validate_authority_support"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "A24B86B85AD253C517ACF2EA9E2AB47B001594DB9CDC0A087A4B919ABCB463AB"
}
