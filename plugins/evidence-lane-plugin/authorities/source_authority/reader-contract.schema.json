    "Fetch": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "default": "local_code",
          "enum": [
            "local_code",
            "github_code"
          ],
          "title": "Lane Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "ref_id": {
          "maxLength": 1100,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        },
        "max_bytes": {
          "default": 256000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "max_lines": {
          "default": 400,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Lines",
          "type": "integer"
        },
        "byte_offset": {
          "default": 0,
          "maximum": 1048576,
          "minimum": 0,
          "title": "Byte Offset",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "ref_id"
      ],
      "title": "Fetch",
      "type": "object"
    },
    "GitBranchRead": {
      "additionalProperties": false,
      "properties": {},
      "title": "GitBranchRead",
      "type": "object"
    },
    "JsonValue": {},
    "MaterializationRead": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "MaterializationRead",
      "type": "object"
    },
    "PreparationRead": {
      "additionalProperties": false,
      "properties": {
        "preparation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preparation Id",
          "type": "string"
        }
      },
      "required": [
        "preparation_id"
      ],
      "title": "PreparationRead",
      "type": "object"
    },
    "ReadRegistrations": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "anyOf": [
            {
              "pattern": "^custom__[a-z][a-z0-9_]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lane Id"
        },
        "contract_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Sha256"
        },
        "offset": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_bytes": {
          "default": 65536,
          "maximum": 262144,
          "minimum": 2048,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "title": "ReadRegistrations",
      "type": "object"
    },
    "SnapshotSelection": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Lane Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "lane_id",
        "snapshot_id"
      ],
      "title": "SnapshotSelection",
      "type": "object"
    },
    "SourceBatchRequest": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Batch Id",
          "type": "string"
        }
      },
      "required": [
        "batch_id"
      ],
      "title": "SourceBatchRequest",
      "type": "object"
    },
    "SourceIntakeRequest": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "code_mode": {
          "default": "local_code",
          "enum": [
            "local_code",
            "github_code"
          ],
          "title": "Code Mode",
          "type": "string"
        },
        "overrides": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 256,
          "title": "Overrides",
          "type": "object"
        },
        "git_mode": {
          "default": "AUTO",
          "enum": [
            "AUTO",
            "REQUIRED",
            "DISABLED"
          ],
          "title": "Git Mode",
          "type": "string"
        },
        "source_assertions": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "maxProperties": 256,
          "title": "Source Assertions",
          "type": "object"
        },
        "parent_route_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Route Id"
        }
      },
      "required": [
        "sources"
      ],
      "title": "SourceIntakeRequest",
      "type": "object"
    },
    "SourceReadRequest": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "default": "batches",
          "enum": [
            "batches",
            "occurrences",
            "relations",
            "provenance",
            "graphs",
            "schemas",
            "identities",
            "sqlite_assets",
            "sqlite_receipts",
            "sqlite_schema",
            "sqlite_tables",
            "sqlite_foreign_keys"
          ],
          "title": "Collection",
          "type": "string"
        },
        "batch_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Id"
        },
        "inspection_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inspection Id"
        },
        "offset": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_bytes": {
          "default": 65536,
          "maximum": 262144,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "title": "SourceReadRequest",
      "type": "object"
    },
    "SourceRoutesRead": {
      "additionalProperties": false,
      "properties": {
        "route_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Route Id",
          "type": "string"
        }
      },
      "required": [
        "route_id"
      ],
      "title": "SourceRoutesRead",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "custom_lanes_read": "#/$defs/AuthorityRequest_custom_lanes_read",
      "fetch": "#/$defs/AuthorityRequest_fetch",
      "git_branch_authority": "#/$defs/AuthorityRequest_git_branch_authority",
      "source_classify": "#/$defs/AuthorityRequest_source_classify",
      "source_materialization_read": "#/$defs/AuthorityRequest_source_materialization_read",
      "source_preparation_read": "#/$defs/AuthorityRequest_source_preparation_read",
      "source_read": "#/$defs/AuthorityRequest_source_read",
      "source_routes_read": "#/$defs/AuthorityRequest_source_routes_read",
      "source_snapshot_state": "#/$defs/AuthorityRequest_source_snapshot_state",
      "source_verify": "#/$defs/AuthorityRequest_source_verify"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AuthorityRequest_custom_lanes_read"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_fetch"
    },
    {
      "$ref": "#/$defs/AuthorityRequest_git_branch_authority"
