digraph schema_data {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  t_data_chunk [label="data_chunk\nsnapshot_id, chunk_id, item_id, ordinal, text_object" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_chunk_fts [label="data_chunk_fts\nsnapshot_id, chunk_id, text_content" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_column [label="data_column\nsnapshot_id, item_id, kind, ordinal, part, payload_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_current [label="data_current\nsource_id, snapshot_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_derivative [label="data_derivative\nderivative_id, snapshot_id, kind, manifest_object, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_export [label="data_export\nexport_id, snapshot_id, destination, before_sha256, after_sha256, effect_id, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_lineage [label="data_lineage\nsnapshot_id, item_id, kind, ordinal, part, payload_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_sample [label="data_sample\nsnapshot_id, item_id, kind, ordinal, part, payload_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_source [label="data_source\nsource_id, logical_name, source_path, origin, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_table [label="data_table\nsnapshot_id, item_id, kind, ordinal, part, payload_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_version [label="data_version\nsnapshot_id, source_id, generation, previous_snapshot, manifest_object, raw_object, facts_object, parser_contract, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_lane_identity [label="lane_identity\nsingleton, project_id, lane_id, kind, storage_layout, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_objects [label="objects\ndigest, size_bytes, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_migrations [label="schema_migrations\nowner, version, digest, description, applied_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_ownership [label="schema_ownership\nobject_name, owner, object_type" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_selector_retirement [label="selector_retirement\nsnapshot_id, proof_object, job_id, plan_revision, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_data_chunk -> t_objects [label=text_object]
  t_data_chunk -> t_data_version [label=snapshot_id]
  t_data_column -> t_data_version [label=snapshot_id]
  t_data_current -> t_data_version [label=snapshot_id]
  t_data_current -> t_data_source [label=source_id]
  t_data_derivative -> t_objects [label=manifest_object]
  t_data_derivative -> t_data_version [label=snapshot_id]
  t_data_export -> t_data_version [label=snapshot_id]
  t_data_lineage -> t_data_version [label=snapshot_id]
  t_data_sample -> t_data_version [label=snapshot_id]
  t_data_table -> t_data_version [label=snapshot_id]
  t_data_version -> t_objects [label=facts_object]
  t_data_version -> t_objects [label=raw_object]
  t_data_version -> t_objects [label=manifest_object]
  t_data_version -> t_data_version [label=previous_snapshot]
  t_data_version -> t_data_source [label=source_id]
  t_selector_retirement -> t_objects [label=proof_object]
  t_selector_retirement -> t_objects [label=snapshot_id]
}
