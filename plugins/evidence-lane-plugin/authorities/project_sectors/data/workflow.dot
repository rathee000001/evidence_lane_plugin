digraph workflow_data {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="data owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_current [label=data_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_export [label=data_export color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_generate [label=data_generate color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_index [label=data_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_index_arrow [label=data_index_arrow color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_inspect_duckdb [label=data_inspect_duckdb color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_inspect_pandas [label=data_inspect_pandas color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_inspect_polars [label=data_inspect_polars color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_inspection_read [label=data_inspection_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_query [label=data_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_read [label=data_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_refresh [label=data_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_refresh_arrow [label=data_refresh_arrow color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_data_transform [label=data_transform color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read -> action_data_current [label=read]
  lane -> action_data_current [label="bounded recorded evidence"]
  delta -> action_data_export [label=data]
  action_data_export -> lane [label="owned publication"]
  action_data_export -> verify [label=tabular_export_hash_verified]
  delta -> action_data_generate [label=data]
  action_data_generate -> lane [label="owned publication"]
  action_data_generate -> verify [label=tabular_snapshot_integrity]
  delta -> action_data_index [label=data]
  action_data_index -> lane [label="owned publication"]
  action_data_index -> verify [label="tabular_snapshot_integrity, tabular_source_hash_unchanged"]
  delta -> action_data_index_arrow [label=data]
  action_data_index_arrow -> lane [label="owned publication"]
  action_data_index_arrow -> verify [label="tabular_snapshot_integrity, tabular_source_hash_unchanged"]
  delta -> action_data_inspect_duckdb [label=data]
  action_data_inspect_duckdb -> lane [label="owned publication"]
  action_data_inspect_duckdb -> verify [label=tabular_inspection_reconciled]
  delta -> action_data_inspect_pandas [label=data]
  action_data_inspect_pandas -> lane [label="owned publication"]
  action_data_inspect_pandas -> verify [label=tabular_inspection_reconciled]
  delta -> action_data_inspect_polars [label=data]
  action_data_inspect_polars -> lane [label="owned publication"]
  action_data_inspect_polars -> verify [label=tabular_inspection_reconciled]
  read -> action_data_inspection_read [label=read]
  lane -> action_data_inspection_read [label="bounded recorded evidence"]
  read -> action_data_query [label=read]
  lane -> action_data_query [label="bounded recorded evidence"]
  read -> action_data_read [label=read]
  lane -> action_data_read [label="bounded recorded evidence"]
  delta -> action_data_refresh [label=data]
  action_data_refresh -> lane [label="owned publication"]
  action_data_refresh -> verify [label="tabular_snapshot_integrity, tabular_source_hash_unchanged"]
  delta -> action_data_refresh_arrow [label=data]
  action_data_refresh_arrow -> lane [label="owned publication"]
  action_data_refresh_arrow -> verify [label="tabular_snapshot_integrity, tabular_source_hash_unchanged"]
  delta -> action_data_transform [label=data]
  action_data_transform -> lane [label="owned publication"]
  action_data_transform -> verify [label=tabular_snapshot_integrity]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  action_data_current -> action_data_inspection_read [constraint=true style=invis weight=100]
  action_data_read -> action_source_snapshot_state [constraint=true style=invis weight=100]
  action_data_index -> action_data_index_arrow [constraint=true style=invis weight=100]
  action_data_inspect_pandas -> action_data_inspect_polars [constraint=true style=invis weight=100]
  action_data_transform -> action_source_snapshot_retire [constraint=true style=invis weight=100]
}
