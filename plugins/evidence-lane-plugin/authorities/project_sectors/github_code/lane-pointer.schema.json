{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Code lane pointer",
  "type": "object",
  "required": [
    "schema",
    "lane_id",
    "parent_pv",
    "proposed_pv",
    "pointer_generation"
  ],
  "properties": {
    "schema": {
      "const": "evidence-lane.lane-pointer-evidence.v1"
    },
    "lane_id": {
      "const": "github_code"
    },
    "parent_pv": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposed_pv": {
      "type": "string",
      "minLength": 1
    },
    "pointer_generation": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true,
  "receipt_sha256": "E758E9E48427C7611ABD219ADAB8F6345A5780903AA1C12DDFAAEFF03954A790"
}
