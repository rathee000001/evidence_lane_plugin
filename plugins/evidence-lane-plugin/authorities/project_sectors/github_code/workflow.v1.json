      },
      {
        "id": "LANE_PARSE",
        "label": "Parse with github_code_reverse_history_v2"
      },
      {
        "id": "LANE_CHUNK",
        "label": "Chunk once with tiered_git_history_v2_incremental"
      },
      {
        "id": "STRUCTURED_FACTS",
        "label": "Project lane facts into 15 lane tables"
      },
      {
        "id": "SQLITE_COMMIT",
        "label": "Write owning SQLite generation atomically"
      },
      {
        "id": "RETRIEVAL_INDEX",
        "label": "Refresh code_chunk_fts and reusable indexes"
      },
      {
        "id": "TOPOLOGY_GRAPH",
        "label": "Derive lane-specific MMD and DOT topology"
      },
      {
        "id": "RESULT_VALIDATE",
        "label": "Validate schema, tools, hashes and authority effects"
      },
      {
        "id": "ATOMIC_REFRESH",
        "label": "Swap changed generation; reuse unchanged atoms"
      }
    ],
