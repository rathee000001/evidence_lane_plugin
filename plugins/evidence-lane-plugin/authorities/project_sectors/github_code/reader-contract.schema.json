{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Code bounded reader request",
  "type": "object",
  "required": [
    "project_id",
    "lane_id",
    "query",
    "retrieval",
    "limit"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "lane_id": {
      "const": "github_code"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "retrieval": {
      "enum": [
        "hybrid",
        "fts5",
        "bm25",
        "tfidf"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "1F855250BEBBC528CF8B1322DD465AB1401FAA83FD28E3C11E1F0BB19C7ABFEB"
}
