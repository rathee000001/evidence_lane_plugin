digraph workflow_artifacts {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="artifacts owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_artifacts_current [label=artifacts_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_artifacts_index [label=artifacts_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_artifacts_index_media [label=artifacts_index_media color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_artifacts_query [label=artifacts_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_artifacts_read [label=artifacts_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_artifacts_refresh [label=artifacts_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_artifacts_refresh_media [label=artifacts_refresh_media color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read -> action_artifacts_current [label=read]
  lane -> action_artifacts_current [label="bounded recorded evidence"]
  delta -> action_artifacts_index [label=artifacts]
  action_artifacts_index -> lane [label="owned publication"]
  action_artifacts_index -> verify [label="sector_evidence_snapshot_integrity, sector_evidence_source_hash_unchanged"]
  delta -> action_artifacts_index_media [label=artifacts]
  action_artifacts_index_media -> lane [label="owned publication"]
  action_artifacts_index_media -> verify [label="sector_evidence_snapshot_integrity, sector_evidence_source_hash_unchanged"]
  read -> action_artifacts_query [label=read]
  lane -> action_artifacts_query [label="bounded recorded evidence"]
  read -> action_artifacts_read [label=read]
  lane -> action_artifacts_read [label="bounded recorded evidence"]
  delta -> action_artifacts_refresh [label=artifacts]
  action_artifacts_refresh -> lane [label="owned publication"]
  action_artifacts_refresh -> verify [label="sector_evidence_snapshot_integrity, sector_evidence_source_hash_unchanged"]
  delta -> action_artifacts_refresh_media [label=artifacts]
  action_artifacts_refresh_media -> lane [label="owned publication"]
  action_artifacts_refresh_media -> verify [label="sector_evidence_snapshot_integrity, sector_evidence_source_hash_unchanged"]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  action_artifacts_index -> action_artifacts_index_media [constraint=true style=invis weight=100]
  action_artifacts_index_media -> action_artifacts_refresh [constraint=true style=invis weight=100]
  action_artifacts_refresh_media -> action_source_snapshot_retire [constraint=true style=invis weight=100]
}
