{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data / Excel / CSV bounded reader request",
  "type": "object",
  "required": [
    "project_id",
    "lane_id",
    "query",
    "retrieval",
    "limit"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "lane_id": {
      "const": "data_excel"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "retrieval": {
      "enum": [
        "hybrid",
        "fts5",
        "bm25",
        "tfidf"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "AA9A989185C4CFEE69956D2FED6FDFDD741529C86FF4AF269EAD23C88A3F069A"
}
