digraph workflow_data_excel {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="data_excel owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_current [label=spreadsheet_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_edit [label=spreadsheet_edit color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_export [label=spreadsheet_export color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_generate [label=spreadsheet_generate color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_index [label=spreadsheet_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_index_values [label=spreadsheet_index_values color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_inspect_openpyxl [label=spreadsheet_inspect_openpyxl color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_inspect_pandas [label=spreadsheet_inspect_pandas color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_inspection_read [label=spreadsheet_inspection_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_query [label=spreadsheet_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_read [label=spreadsheet_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_recalculate [label=spreadsheet_recalculate color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_refresh [label=spreadsheet_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_refresh_values [label=spreadsheet_refresh_values color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_render [label=spreadsheet_render color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_spreadsheet_render_read [label=spreadsheet_render_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  read -> action_spreadsheet_current [label=read]
  lane -> action_spreadsheet_current [label="bounded recorded evidence"]
  delta -> action_spreadsheet_edit [label=spreadsheet]
  action_spreadsheet_edit -> lane [label="owned publication"]
  action_spreadsheet_edit -> verify [label=tabular_snapshot_integrity]
  delta -> action_spreadsheet_export [label=spreadsheet]
  action_spreadsheet_export -> lane [label="owned publication"]
  action_spreadsheet_export -> verify [label=tabular_export_hash_verified]
  delta -> action_spreadsheet_generate [label=spreadsheet]
  action_spreadsheet_generate -> lane [label="owned publication"]
  action_spreadsheet_generate -> verify [label=tabular_snapshot_integrity]
  delta -> action_spreadsheet_index [label=spreadsheet]
  action_spreadsheet_index -> lane [label="owned publication"]
  action_spreadsheet_index -> verify [label="tabular_snapshot_integrity, tabular_source_hash_unchanged"]
  delta -> action_spreadsheet_index_values [label=spreadsheet]
  action_spreadsheet_index_values -> lane [label="owned publication"]
  action_spreadsheet_index_values -> verify [label="tabular_snapshot_integrity, tabular_source_hash_unchanged"]
  delta -> action_spreadsheet_inspect_openpyxl [label=spreadsheet]
  action_spreadsheet_inspect_openpyxl -> lane [label="owned publication"]
  action_spreadsheet_inspect_openpyxl -> verify [label=tabular_inspection_reconciled]
  delta -> action_spreadsheet_inspect_pandas [label=spreadsheet]
  action_spreadsheet_inspect_pandas -> lane [label="owned publication"]
  action_spreadsheet_inspect_pandas -> verify [label=tabular_inspection_reconciled]
  read -> action_spreadsheet_inspection_read [label=read]
  lane -> action_spreadsheet_inspection_read [label="bounded recorded evidence"]
  read -> action_spreadsheet_query [label=read]
  lane -> action_spreadsheet_query [label="bounded recorded evidence"]
  read -> action_spreadsheet_read [label=read]
  lane -> action_spreadsheet_read [label="bounded recorded evidence"]
  delta -> action_spreadsheet_recalculate [label=spreadsheet]
  action_spreadsheet_recalculate -> lane [label="owned publication"]
  action_spreadsheet_recalculate -> verify [label=tabular_snapshot_integrity]
  delta -> action_spreadsheet_refresh [label=spreadsheet]
  action_spreadsheet_refresh -> lane [label="owned publication"]
  action_spreadsheet_refresh -> verify [label="tabular_snapshot_integrity, tabular_source_hash_unchanged"]
  delta -> action_spreadsheet_refresh_values [label=spreadsheet]
  action_spreadsheet_refresh_values -> lane [label="owned publication"]
  action_spreadsheet_refresh_values -> verify [label="tabular_snapshot_integrity, tabular_source_hash_unchanged"]
  delta -> action_spreadsheet_render [label=spreadsheet]
  action_spreadsheet_render -> lane [label="owned publication"]
  action_spreadsheet_render -> verify [label=spreadsheet_render_bytes_verified]
  read -> action_spreadsheet_render_read [label=read]
  lane -> action_spreadsheet_render_read [label="bounded recorded evidence"]
  action_source_snapshot_retire -> action_spreadsheet_edit [constraint=true style=invis weight=100]
  action_spreadsheet_index -> action_spreadsheet_index_values [constraint=true style=invis weight=100]
  action_spreadsheet_recalculate -> action_spreadsheet_refresh [constraint=true style=invis weight=100]
  action_source_snapshot_state -> action_spreadsheet_current [constraint=true style=invis weight=100]
  action_spreadsheet_read -> action_spreadsheet_render_read [constraint=true style=invis weight=100]
}
