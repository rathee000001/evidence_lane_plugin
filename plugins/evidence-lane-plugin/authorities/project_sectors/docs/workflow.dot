digraph workflow_docs {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="docs owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_convert [label=document_convert color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_current [label=document_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_edit [label=document_edit color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_enrich [label=document_enrich color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_enrichment_read [label=document_enrichment_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_export [label=document_export color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_generate [label=document_generate color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_index [label=document_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_query [label=document_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_read [label=document_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_refresh [label=document_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_render [label=document_render color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_document_render_read [label=document_render_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta -> action_document_convert [label=document]
  action_document_convert -> lane [label="owned publication"]
  action_document_convert -> verify [label="document_snapshot_integrity, document_source_hash_unchanged"]
  read -> action_document_current [label=read]
  lane -> action_document_current [label="bounded recorded evidence"]
  delta -> action_document_edit [label=document]
  action_document_edit -> lane [label="owned publication"]
  action_document_edit -> verify [label=document_snapshot_integrity]
  delta -> action_document_enrich [label=document]
  action_document_enrich -> lane [label="owned publication"]
  action_document_enrich -> verify [label=document_enrichment_integrity]
  read -> action_document_enrichment_read [label=read]
  lane -> action_document_enrichment_read [label="bounded recorded evidence"]
  delta -> action_document_export [label=document]
  action_document_export -> lane [label="owned publication"]
  action_document_export -> verify [label=document_export_hash_verified]
  delta -> action_document_generate [label=document]
  action_document_generate -> lane [label="owned publication"]
  action_document_generate -> verify [label=document_snapshot_integrity]
  delta -> action_document_index [label=document]
  action_document_index -> lane [label="owned publication"]
  action_document_index -> verify [label="document_snapshot_integrity, document_source_hash_unchanged"]
  read -> action_document_query [label=read]
  lane -> action_document_query [label="bounded recorded evidence"]
  read -> action_document_read [label=read]
  lane -> action_document_read [label="bounded recorded evidence"]
  delta -> action_document_refresh [label=document]
  action_document_refresh -> lane [label="owned publication"]
  action_document_refresh -> verify [label="document_snapshot_integrity, document_source_hash_unchanged"]
  delta -> action_document_render [label=document]
  action_document_render -> lane [label="owned publication"]
  action_document_render -> verify [label=document_render_bytes_verified]
  read -> action_document_render_read [label=read]
  lane -> action_document_render_read [label="bounded recorded evidence"]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  action_document_convert -> action_document_edit [constraint=true style=invis weight=100]
  action_document_export -> action_document_generate [constraint=true style=invis weight=100]
  action_document_refresh -> action_document_render [constraint=true style=invis weight=100]
  action_document_current -> action_document_enrichment_read [constraint=true style=invis weight=100]
  action_document_render_read -> action_source_snapshot_state [constraint=true style=invis weight=100]
}
