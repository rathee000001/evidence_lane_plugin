digraph workflow_power_bi {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="power_bi owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_powerbi_current [label=powerbi_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_powerbi_edit [label=powerbi_edit color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_powerbi_export [label=powerbi_export color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_powerbi_generate [label=powerbi_generate color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_powerbi_index [label=powerbi_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_powerbi_query [label=powerbi_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_powerbi_read [label=powerbi_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_powerbi_refresh [label=powerbi_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_powerbi_schema [label=powerbi_schema color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read -> action_powerbi_current [label=read]
  lane -> action_powerbi_current [label="bounded recorded evidence"]
  delta -> action_powerbi_edit [label=power_bi]
  action_powerbi_edit -> lane [label="owned publication"]
  action_powerbi_edit -> verify [label=powerbi_snapshot_integrity]
  delta -> action_powerbi_export [label=power_bi]
  action_powerbi_export -> lane [label="owned publication"]
  action_powerbi_export -> verify [label=powerbi_export_hash_verified]
  delta -> action_powerbi_generate [label=power_bi]
  action_powerbi_generate -> lane [label="owned publication"]
  action_powerbi_generate -> verify [label=powerbi_snapshot_integrity]
  delta -> action_powerbi_index [label=power_bi]
  action_powerbi_index -> lane [label="owned publication"]
  action_powerbi_index -> verify [label="powerbi_snapshot_integrity, powerbi_source_hash_unchanged"]
  read -> action_powerbi_query [label=read]
  lane -> action_powerbi_query [label="bounded recorded evidence"]
  read -> action_powerbi_read [label=read]
  lane -> action_powerbi_read [label="bounded recorded evidence"]
  delta -> action_powerbi_refresh [label=power_bi]
  action_powerbi_refresh -> lane [label="owned publication"]
  action_powerbi_refresh -> verify [label="powerbi_snapshot_integrity, powerbi_source_hash_unchanged"]
  read -> action_powerbi_schema [label=read]
  lane -> action_powerbi_schema [label="bounded recorded evidence"]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  action_powerbi_current -> action_powerbi_query [constraint=true style=invis weight=100]
  action_powerbi_schema -> action_source_snapshot_state [constraint=true style=invis weight=100]
  action_powerbi_export -> action_powerbi_generate [constraint=true style=invis weight=100]
  action_powerbi_refresh -> action_source_snapshot_retire [constraint=true style=invis weight=100]
}
