{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "custom SQLITE_AUTHORITY artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "custom"
    },
    "artifact_path": {
      "const": "custom_sector_v001.sqlite"
    },
    "artifact_role": {
      "const": "SQLITE_AUTHORITY"
    },
    "syntax": {
      "const": "SQLITE3_FTS5"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "lane_engine.lane_schema_builder_projection"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "F67C8467EA928BE211041DD74B82930F5385608BCE1B956D22D49A9FF0A21BDF"
}
