{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "custom MERMAID_TRAVERSAL_MAP artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "custom"
    },
    "artifact_path": {
      "const": "custom.mmd"
    },
    "artifact_role": {
      "const": "MERMAID_TRAVERSAL_MAP"
    },
    "syntax": {
      "const": "MERMAID_FLOWCHART"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "topology_reconciliation.validate_mermaid"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "9B184AAE73D83158E2B1FF2BCBAD367D6EE977BFE66B1E75A58B1720EC5C1AAC"
}
