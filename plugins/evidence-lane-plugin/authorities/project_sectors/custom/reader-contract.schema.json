{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custom bounded reader request",
  "type": "object",
  "required": [
    "project_id",
    "lane_id",
    "query",
    "retrieval",
    "limit"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "lane_id": {
      "const": "custom"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "retrieval": {
      "enum": [
        "hybrid",
        "fts5",
        "bm25",
        "tfidf"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "FB34F05CB1C1BDD6C42AAA5060D9CF0CE41B8B4188A546C7D21F5BC22283F210"
}
