{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SectorArgs_custom_current_custom": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "default": "custom",
          "pattern": "^(?:custom|custom__[a-z][a-z0-9_]{0,39})$",
          "title": "Lane Id",
          "type": "string"
        }
      },
      "title": "SectorArgs_custom_current_custom",
      "type": "object"
    },
    "SectorArgs_custom_query_custom": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "default": "custom",
          "pattern": "^(?:custom|custom__[a-z][a-z0-9_]{0,39})$",
          "title": "Lane Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "collection": {
          "default": "text",
          "title": "Collection",
          "type": "string"
        },
        "match_mode": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Match Mode",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_bytes": {
          "default": 65536,
          "maximum": 262144,
          "minimum": 2048,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "SectorArgs_custom_query_custom",
      "type": "object"
    },
    "SectorArgs_custom_read_custom": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "default": "custom",
          "pattern": "^(?:custom|custom__[a-z][a-z0-9_]{0,39})$",
          "title": "Lane Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "representation": {
          "default": "snapshot",
          "enum": [
            "snapshot",
            "original_source"
          ],
          "title": "Representation",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "maximum": 8388608,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "max_bytes": {
          "default": 65536,
          "maximum": 131072,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "SectorArgs_custom_read_custom",
      "type": "object"
    },
    "SectorArgs_source_snapshot_state_custom": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "pattern": "^(?:custom|custom__[a-z][a-z0-9_]{0,39})$",
          "title": "Lane Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "lane_id",
        "snapshot_id"
      ],
      "title": "SectorArgs_source_snapshot_state_custom",
      "type": "object"
    },
    "SectorRequest_custom_current": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "custom_current",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/SectorArgs_custom_current_custom"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "SectorRequest_custom_current",
      "type": "object"
    },
    "SectorRequest_custom_query": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "custom_query",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/SectorArgs_custom_query_custom"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "SectorRequest_custom_query",
      "type": "object"
    },
    "SectorRequest_custom_read": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "custom_read",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/SectorArgs_custom_read_custom"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "SectorRequest_custom_read",
      "type": "object"
    },
    "SectorRequest_source_snapshot_state": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "source_snapshot_state",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/SectorArgs_source_snapshot_state_custom"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "SectorRequest_source_snapshot_state",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "custom_current": "#/$defs/SectorRequest_custom_current",
      "custom_query": "#/$defs/SectorRequest_custom_query",
      "custom_read": "#/$defs/SectorRequest_custom_read",
      "source_snapshot_state": "#/$defs/SectorRequest_source_snapshot_state"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SectorRequest_custom_current"
    },
    {
      "$ref": "#/$defs/SectorRequest_custom_query"
    },
    {
      "$ref": "#/$defs/SectorRequest_custom_read"
    },
    {
      "$ref": "#/$defs/SectorRequest_source_snapshot_state"
    }
  ],
  "title": "Custom typed reader requests"
}
