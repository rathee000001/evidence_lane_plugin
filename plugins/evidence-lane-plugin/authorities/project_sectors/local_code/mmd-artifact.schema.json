    },
    "validator": {
      "const": "topology_reconciliation.validate_mermaid"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "0F70FE66DC28189CA97AB5FA0111D801F1096269DC3A567E33A4CC7D929E99FD"
