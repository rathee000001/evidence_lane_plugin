digraph workflow_local_code {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="local_code owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_apply [label=code_apply color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_current [label=code_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_impact [label=code_impact color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_index [label=code_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_index_syntax [label=code_index_syntax color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_query [label=code_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_read [label=code_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_refresh [label=code_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_semantic_index [label=code_semantic_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_semantic_query [label=code_semantic_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_semantic_query_faiss [label=code_semantic_query_faiss color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_code_semantic_query_vec [label=code_semantic_query_vec color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_fetch [label=fetch color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pv_summary [label=pv_summary color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta -> action_code_apply [label=code]
  action_code_apply -> lane [label="owned publication"]
  action_code_apply -> verify [label=code_replacement_hash_verified]
  read -> action_code_current [label=read]
  lane -> action_code_current [label="bounded recorded evidence"]
  read -> action_code_impact [label=read]
  lane -> action_code_impact [label="bounded recorded evidence"]
  delta -> action_code_index [label=code]
  action_code_index -> lane [label="owned publication"]
  action_code_index -> verify [label="code_snapshot_integrity, code_source_hashes_unchanged"]
  delta -> action_code_index_syntax [label=code]
  action_code_index_syntax -> lane [label="owned publication"]
  action_code_index_syntax -> verify [label="code_snapshot_integrity, code_source_hashes_unchanged"]
  read -> action_code_query [label=read]
  lane -> action_code_query [label="bounded recorded evidence"]
  read -> action_code_read [label=read]
  lane -> action_code_read [label="bounded recorded evidence"]
  delta -> action_code_refresh [label=code]
  action_code_refresh -> lane [label="owned publication"]
  action_code_refresh -> verify [label="code_snapshot_integrity, code_source_hashes_unchanged"]
  delta -> action_code_semantic_index [label=code]
  action_code_semantic_index -> lane [label="owned publication"]
  action_code_semantic_index -> verify [label=code_embedding_hashes_verified]
  read -> action_code_semantic_query [label=read]
  lane -> action_code_semantic_query [label="bounded recorded evidence"]
  read -> action_code_semantic_query_faiss [label=read]
  lane -> action_code_semantic_query_faiss [label="bounded recorded evidence"]
  read -> action_code_semantic_query_vec [label=read]
  lane -> action_code_semantic_query_vec [label="bounded recorded evidence"]
  read -> action_fetch [label=read]
  lane -> action_fetch [label="bounded recorded evidence"]
  read -> action_pv_summary [label=read]
  lane -> action_pv_summary [label="bounded recorded evidence"]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  action_code_apply -> action_code_index [constraint=true style=invis weight=100]
  action_code_refresh -> action_code_semantic_index [constraint=true style=invis weight=100]
  action_code_impact -> action_code_query [constraint=true style=invis weight=100]
  action_code_semantic_query -> action_code_semantic_query_faiss [constraint=true style=invis weight=100]
  action_pv_summary -> action_source_snapshot_state [constraint=true style=invis weight=100]
}
