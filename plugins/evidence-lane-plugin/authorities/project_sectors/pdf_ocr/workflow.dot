digraph workflow_pdf_ocr {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="pdf_ocr owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_current [label=pdf_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_edit [label=pdf_edit color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_enrich [label=pdf_enrich color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_enrichment_read [label=pdf_enrichment_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_export [label=pdf_export color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_generate [label=pdf_generate color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_index [label=pdf_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_ocr [label=pdf_ocr color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_ocr_read [label=pdf_ocr_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_query [label=pdf_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_read [label=pdf_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_refresh [label=pdf_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_render [label=pdf_render color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pdf_render_read [label=pdf_render_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read -> action_pdf_current [label=read]
  lane -> action_pdf_current [label="bounded recorded evidence"]
  delta -> action_pdf_edit [label=pdf_ocr]
  action_pdf_edit -> lane [label="owned publication"]
  action_pdf_edit -> verify [label=pdf_snapshot_integrity]
  delta -> action_pdf_enrich [label=pdf_ocr]
  action_pdf_enrich -> lane [label="owned publication"]
  action_pdf_enrich -> verify [label=pdf_enrichment_integrity]
  read -> action_pdf_enrichment_read [label=read]
  lane -> action_pdf_enrichment_read [label="bounded recorded evidence"]
  delta -> action_pdf_export [label=pdf_ocr]
  action_pdf_export -> lane [label="owned publication"]
  action_pdf_export -> verify [label=pdf_export_hash_verified]
  delta -> action_pdf_generate [label=pdf_ocr]
  action_pdf_generate -> lane [label="owned publication"]
  action_pdf_generate -> verify [label=pdf_snapshot_integrity]
  delta -> action_pdf_index [label=pdf_ocr]
  action_pdf_index -> lane [label="owned publication"]
  action_pdf_index -> verify [label="pdf_snapshot_integrity, pdf_source_hash_unchanged"]
  delta -> action_pdf_ocr [label=pdf_ocr]
  action_pdf_ocr -> lane [label="owned publication"]
  action_pdf_ocr -> verify [label=pdf_ocr_integrity]
  read -> action_pdf_ocr_read [label=read]
  lane -> action_pdf_ocr_read [label="bounded recorded evidence"]
  read -> action_pdf_query [label=read]
  lane -> action_pdf_query [label="bounded recorded evidence"]
  read -> action_pdf_read [label=read]
  lane -> action_pdf_read [label="bounded recorded evidence"]
  delta -> action_pdf_refresh [label=pdf_ocr]
  action_pdf_refresh -> lane [label="owned publication"]
  action_pdf_refresh -> verify [label="pdf_snapshot_integrity, pdf_source_hash_unchanged"]
  delta -> action_pdf_render [label=pdf_ocr]
  action_pdf_render -> lane [label="owned publication"]
  action_pdf_render -> verify [label=pdf_render_integrity]
  read -> action_pdf_render_read [label=read]
  lane -> action_pdf_render_read [label="bounded recorded evidence"]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  action_pdf_current -> action_pdf_enrichment_read [constraint=true style=invis weight=100]
  action_pdf_query -> action_pdf_read [constraint=true style=invis weight=100]
  action_pdf_edit -> action_pdf_enrich [constraint=true style=invis weight=100]
  action_pdf_generate -> action_pdf_index [constraint=true style=invis weight=100]
  action_pdf_render -> action_source_snapshot_retire [constraint=true style=invis weight=100]
}
