digraph workflow_images_ocr {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="images_ocr owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_current [label=media_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_export [label=media_export color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_extract [label=media_extract color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_extraction_read [label=media_extraction_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_index [label=media_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_ocr [label=media_ocr color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_ocr_read [label=media_ocr_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_query [label=media_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_read [label=media_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_refresh [label=media_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_media_transform [label=media_transform color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read -> action_media_current [label=read]
  lane -> action_media_current [label="bounded recorded evidence"]
  delta -> action_media_export [label=images_ocr]
  action_media_export -> lane [label="owned publication"]
  action_media_export -> verify [label=media_export_hash_verified]
  delta -> action_media_extract [label=images_ocr]
  action_media_extract -> lane [label="owned publication"]
  action_media_extract -> verify [label=media_derivative_integrity]
  read -> action_media_extraction_read [label=read]
  lane -> action_media_extraction_read [label="bounded recorded evidence"]
  delta -> action_media_index [label=images_ocr]
  action_media_index -> lane [label="owned publication"]
  action_media_index -> verify [label="media_snapshot_integrity, media_source_hash_unchanged"]
  delta -> action_media_ocr [label=images_ocr]
  action_media_ocr -> lane [label="owned publication"]
  action_media_ocr -> verify [label=media_derivative_integrity]
  read -> action_media_ocr_read [label=read]
  lane -> action_media_ocr_read [label="bounded recorded evidence"]
  read -> action_media_query [label=read]
  lane -> action_media_query [label="bounded recorded evidence"]
  read -> action_media_read [label=read]
  lane -> action_media_read [label="bounded recorded evidence"]
  delta -> action_media_refresh [label=images_ocr]
  action_media_refresh -> lane [label="owned publication"]
  action_media_refresh -> verify [label="media_snapshot_integrity, media_source_hash_unchanged"]
  delta -> action_media_transform [label=images_ocr]
  action_media_transform -> lane [label="owned publication"]
  action_media_transform -> verify [label=media_snapshot_integrity]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  action_media_current -> action_media_extraction_read [constraint=true style=invis weight=100]
  action_media_extraction_read -> action_media_ocr_read [constraint=true style=invis weight=100]
  action_media_read -> action_source_snapshot_state [constraint=true style=invis weight=100]
  action_media_extract -> action_media_index [constraint=true style=invis weight=100]
  action_media_refresh -> action_media_transform [constraint=true style=invis weight=100]
}
