{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discussion bounded reader request",
  "type": "object",
  "required": [
    "project_id",
    "lane_id",
    "query",
    "retrieval",
    "limit"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "lane_id": {
      "const": "discussion"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "retrieval": {
      "enum": [
        "hybrid",
        "fts5",
        "bm25",
        "tfidf"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "A85DC486C814B427A559C0A771406172B66275D9D93429D236A94E051275DD86"
}
