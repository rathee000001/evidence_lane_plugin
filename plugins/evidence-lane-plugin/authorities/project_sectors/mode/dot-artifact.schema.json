{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mode DOT_TRAVERSAL_MAP artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "mode"
    },
    "artifact_path": {
      "const": "mode.dot"
    },
    "artifact_role": {
      "const": "DOT_TRAVERSAL_MAP"
    },
    "syntax": {
      "const": "GRAPHVIZ_DOT"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "topology_reconciliation.validate_dot"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "57BA54E89A45CFA65980A555C867BF8A3155C07054FA9828D355E0E222D3FE38"
}
