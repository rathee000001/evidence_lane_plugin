    "lane_id",
    "query",
    "retrieval",
    "limit"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "lane_id": {
      "const": "mode"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "retrieval": {
      "enum": [
        "hybrid",
        "fts5",
        "bm25",
        "tfidf"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "56D7A9AFCD06FADFBE3BB91DA9F85EB5CC0DF23B78F881373CCE55F1D3B6F24E"
