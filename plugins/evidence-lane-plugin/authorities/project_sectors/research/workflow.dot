digraph workflow_research {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="research owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_research_current [label=research_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_research_index [label=research_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_research_index_media [label=research_index_media color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_research_query [label=research_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_research_read [label=research_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_research_refresh [label=research_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_research_refresh_media [label=research_refresh_media color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_research_web_capture [label=research_web_capture color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_research_web_discover [label=research_web_discover color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_research_web_extract [label=research_web_extract color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read -> action_research_current [label=read]
  lane -> action_research_current [label="bounded recorded evidence"]
  delta -> action_research_index [label=research]
  action_research_index -> lane [label="owned publication"]
  action_research_index -> verify [label="sector_evidence_snapshot_integrity, sector_evidence_source_hash_unchanged"]
  delta -> action_research_index_media [label=research]
  action_research_index_media -> lane [label="owned publication"]
  action_research_index_media -> verify [label="sector_evidence_snapshot_integrity, sector_evidence_source_hash_unchanged"]
  read -> action_research_query [label=read]
  lane -> action_research_query [label="bounded recorded evidence"]
  read -> action_research_read [label=read]
  lane -> action_research_read [label="bounded recorded evidence"]
  delta -> action_research_refresh [label=research]
  action_research_refresh -> lane [label="owned publication"]
  action_research_refresh -> verify [label="sector_evidence_snapshot_integrity, sector_evidence_source_hash_unchanged"]
  delta -> action_research_refresh_media [label=research]
  action_research_refresh_media -> lane [label="owned publication"]
  action_research_refresh_media -> verify [label="sector_evidence_snapshot_integrity, sector_evidence_source_hash_unchanged"]
  delta -> action_research_web_capture [label=research]
  action_research_web_capture -> lane [label="owned publication"]
  action_research_web_capture -> verify [label=research_web_snapshot_integrity]
  delta -> action_research_web_discover [label=research]
  action_research_web_discover -> lane [label="owned publication"]
  action_research_web_discover -> verify [label=research_discovery_snapshot_integrity]
  delta -> action_research_web_extract [label=research]
  action_research_web_extract -> lane [label="owned publication"]
  action_research_web_extract -> verify [label=research_web_snapshot_integrity]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  action_research_index -> action_research_index_media [constraint=true style=invis weight=100]
  action_research_index_media -> action_research_refresh [constraint=true style=invis weight=100]
  action_research_refresh_media -> action_research_web_capture [constraint=true style=invis weight=100]
  action_research_web_extract -> action_source_snapshot_retire [constraint=true style=invis weight=100]
}
