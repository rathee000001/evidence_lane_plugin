    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "topology_reconciliation.validate_dot"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "0BCA66793A8D8754AE315643779D872739E85091D0B9EA47205CA243428A0779"
