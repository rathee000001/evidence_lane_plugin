digraph workflow_tableau {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="tableau owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_tableau_current [label=tableau_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_tableau_edit [label=tableau_edit color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_tableau_export [label=tableau_export color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_tableau_generate [label=tableau_generate color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_tableau_index [label=tableau_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_tableau_query [label=tableau_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_tableau_read [label=tableau_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_tableau_refresh [label=tableau_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  read -> action_tableau_current [label=read]
  lane -> action_tableau_current [label="bounded recorded evidence"]
  delta -> action_tableau_edit [label=tableau]
  action_tableau_edit -> lane [label="owned publication"]
  action_tableau_edit -> verify [label=tableau_snapshot_integrity]
  delta -> action_tableau_export [label=tableau]
  action_tableau_export -> lane [label="owned publication"]
  action_tableau_export -> verify [label=tableau_export_hash_verified]
  delta -> action_tableau_generate [label=tableau]
  action_tableau_generate -> lane [label="owned publication"]
  action_tableau_generate -> verify [label=tableau_snapshot_integrity]
  delta -> action_tableau_index [label=tableau]
  action_tableau_index -> lane [label="owned publication"]
  action_tableau_index -> verify [label="tableau_snapshot_integrity, tableau_source_hash_unchanged"]
  read -> action_tableau_query [label=read]
  lane -> action_tableau_query [label="bounded recorded evidence"]
  read -> action_tableau_read [label=read]
  lane -> action_tableau_read [label="bounded recorded evidence"]
  delta -> action_tableau_refresh [label=tableau]
  action_tableau_refresh -> lane [label="owned publication"]
  action_tableau_refresh -> verify [label="tableau_snapshot_integrity, tableau_source_hash_unchanged"]
  action_source_snapshot_retire -> action_tableau_edit [constraint=true style=invis weight=100]
  action_tableau_edit -> action_tableau_export [constraint=true style=invis weight=100]
  action_tableau_generate -> action_tableau_index [constraint=true style=invis weight=100]
  action_tableau_index -> action_tableau_refresh [constraint=true style=invis weight=100]
}
