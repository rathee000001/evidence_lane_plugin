{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "lane_id",
    "builder",
    "reader",
    "runtime",
    "actions",
    "views",
    "workflow",
    "workflow_mmd",
    "workflow_dot",
    "dependency_installation_inferred",
    "runtime_state_folder",
    "source_package_folder"
  ],
  "properties": {
    "schema": {
      "const": "evidence-lane.installed-lane-tooling.v4"
    },
    "lane_id": {
      "const": "tableau"
    },
    "builder": {
      "const": "builder.py:build_lane_sources"
    },
    "reader": {
      "const": "reader.py:read_lane_source"
    },
    "actions": {
      "type": "array",
      "minItems": 1
    },
    "views": {
      "type": "array"
    },
    "dependency_installation_inferred": {
      "const": false
    }
  },
  "title": "Tableau current lane tooling"
}
