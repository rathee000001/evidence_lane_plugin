  "discriminator": {
    "mapping": {
      "source_snapshot_state": "#/$defs/SectorRequest_source_snapshot_state",
      "tableau_current": "#/$defs/SectorRequest_tableau_current",
      "tableau_query": "#/$defs/SectorRequest_tableau_query",
      "tableau_read": "#/$defs/SectorRequest_tableau_read"
