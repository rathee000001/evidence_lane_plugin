  },
  "oneOf": [
    {
      "$ref": "#/$defs/SectorRequest_source_snapshot_state"
    },
    {
      "$ref": "#/$defs/SectorRequest_tableau_current"
    },
    {
      "$ref": "#/$defs/SectorRequest_tableau_query"
    },
    {
      "$ref": "#/$defs/SectorRequest_tableau_read"
    }
  ],
  "title": "Tableau typed reader requests"
}
