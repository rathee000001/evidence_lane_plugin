{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SectorArgs_source_snapshot_state_tableau": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "const": "tableau",
          "title": "Lane Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "lane_id",
        "snapshot_id"
      ],
      "title": "SectorArgs_source_snapshot_state_tableau",
      "type": "object"
    },
    "SectorArgs_tableau_current_tableau": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "const": "tableau",
          "default": "tableau",
          "title": "Lane Id",
          "type": "string"
        }
      },
      "title": "SectorArgs_tableau_current_tableau",
      "type": "object"
    },
    "SectorArgs_tableau_query_tableau": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "const": "tableau",
          "default": "tableau",
          "title": "Lane Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "match_mode": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Match Mode",
          "type": "string"
        },
        "collection": {
          "default": "text",
          "enum": [
            "metadata",
            "text",
            "workbook",
            "datasource",
            "sheet",
            "dashboard",
            "story",
            "column",
            "calculation",
            "relationship",
            "connection",
            "filter",
            "parameter",
            "mark",
            "layout",
            "package_member",
            "hyper_schema",
            "hyper_table",
            "hyper_column",
            "hyper_row",
            "opaque"
          ],
          "title": "Collection",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "offset": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_bytes": {
          "default": 65536,
          "maximum": 262144,
          "minimum": 2048,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "SectorArgs_tableau_query_tableau",
      "type": "object"
    },
    "SectorArgs_tableau_read_tableau": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "const": "tableau",
          "default": "tableau",
          "title": "Lane Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "representation": {
          "default": "tableau",
          "enum": [
            "tableau",
            "original_source",
            "member"
          ],
          "title": "Representation",
          "type": "string"
        },
        "member": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Member"
        },
        "offset": {
          "default": 0,
          "maximum": 33554432,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "max_bytes": {
          "default": 65536,
          "maximum": 131072,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "SectorArgs_tableau_read_tableau",
      "type": "object"
    },
    "SectorRequest_source_snapshot_state": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "source_snapshot_state",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "arguments": {
          "$ref": "#/$defs/SectorArgs_source_snapshot_state_tableau"
        }
      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "SectorRequest_source_snapshot_state",
      "type": "object"
    },
