      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "const": "ppt",
          "default": "ppt",
          "title": "Lane Id",
          "type": "string"
        }
      },
      "title": "SectorArgs_presentation_current_ppt",
      "type": "object"
    },
    "SectorArgs_presentation_enrichment_read_ppt": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "const": "ppt",
          "default": "ppt",
          "title": "Lane Id",
          "type": "string"
        },
        "enrichment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Enrichment Id",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "maximum": 2097152,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "max_characters": {
          "default": 32768,
          "maximum": 65536,
          "minimum": 1,
          "title": "Max Characters",
          "type": "integer"
        },
        "include_structure": {
          "default": false,
          "title": "Include Structure",
          "type": "boolean"
        },
        "max_structure_bytes": {
          "default": 131072,
          "maximum": 524288,
          "minimum": 4096,
          "title": "Max Structure Bytes",
          "type": "integer"
        }
      },
      "required": [
        "enrichment_id"
      ],
      "title": "SectorArgs_presentation_enrichment_read_ppt",
      "type": "object"
    },
