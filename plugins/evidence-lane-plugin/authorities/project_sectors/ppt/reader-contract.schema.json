          "title": "Lane Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "match_mode": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Match Mode",
          "type": "string"
        },
        "collection": {
          "default": "text",
          "enum": [
            "metadata",
            "text",
            "slide",
            "notes",
            "shape",
            "text_block",
            "table",
            "image",
            "relationship",
            "chart"
          ],
          "title": "Collection",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "offset": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_bytes": {
          "default": 65536,
          "maximum": 262144,
          "minimum": 2048,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id"
