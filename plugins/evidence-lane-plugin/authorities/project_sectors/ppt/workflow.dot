digraph workflow_ppt {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  lane [label="ppt owning database and immutable files" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Exact current Plan and normal Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  verify [label="Owning acceptance checks and verified Delta exit" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Scoped authenticated SDK read" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_convert [label=presentation_convert color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_current [label=presentation_current color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_edit [label=presentation_edit color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_enrich [label=presentation_enrich color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_enrichment_read [label=presentation_enrichment_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_export [label=presentation_export color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_generate [label=presentation_generate color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_index [label=presentation_index color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_query [label=presentation_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_read [label=presentation_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_refresh [label=presentation_refresh color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_render [label=presentation_render color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_presentation_render_read [label=presentation_render_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_retire [label=source_snapshot_retire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_source_snapshot_state [label=source_snapshot_state color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta -> action_presentation_convert [label=presentation]
  action_presentation_convert -> lane [label="owned publication"]
  action_presentation_convert -> verify [label="presentation_snapshot_integrity, presentation_source_hash_unchanged"]
  read -> action_presentation_current [label=read]
  lane -> action_presentation_current [label="bounded recorded evidence"]
  delta -> action_presentation_edit [label=presentation]
  action_presentation_edit -> lane [label="owned publication"]
  action_presentation_edit -> verify [label=presentation_snapshot_integrity]
  delta -> action_presentation_enrich [label=presentation]
  action_presentation_enrich -> lane [label="owned publication"]
  action_presentation_enrich -> verify [label=presentation_enrichment_integrity]
  read -> action_presentation_enrichment_read [label=read]
  lane -> action_presentation_enrichment_read [label="bounded recorded evidence"]
  delta -> action_presentation_export [label=presentation]
  action_presentation_export -> lane [label="owned publication"]
  action_presentation_export -> verify [label=presentation_export_hash_verified]
  delta -> action_presentation_generate [label=presentation]
  action_presentation_generate -> lane [label="owned publication"]
  action_presentation_generate -> verify [label=presentation_snapshot_integrity]
  delta -> action_presentation_index [label=presentation]
  action_presentation_index -> lane [label="owned publication"]
  action_presentation_index -> verify [label="presentation_snapshot_integrity, presentation_source_hash_unchanged"]
  read -> action_presentation_query [label=read]
  lane -> action_presentation_query [label="bounded recorded evidence"]
  read -> action_presentation_read [label=read]
  lane -> action_presentation_read [label="bounded recorded evidence"]
  delta -> action_presentation_refresh [label=presentation]
  action_presentation_refresh -> lane [label="owned publication"]
  action_presentation_refresh -> verify [label="presentation_snapshot_integrity, presentation_source_hash_unchanged"]
  delta -> action_presentation_render [label=presentation]
  action_presentation_render -> lane [label="owned publication"]
  action_presentation_render -> verify [label=presentation_render_bytes_verified]
  read -> action_presentation_render_read [label=read]
  lane -> action_presentation_render_read [label="bounded recorded evidence"]
  delta -> action_source_snapshot_retire [label=sources]
  action_source_snapshot_retire -> lane [label="owned publication"]
  action_source_snapshot_retire -> verify [label=source_selector_retirement_verified]
  read -> action_source_snapshot_state [label=read]
  lane -> action_source_snapshot_state [label="bounded recorded evidence"]
  action_presentation_convert -> action_presentation_edit [constraint=true style=invis weight=100]
  action_presentation_export -> action_presentation_generate [constraint=true style=invis weight=100]
  action_presentation_refresh -> action_presentation_render [constraint=true style=invis weight=100]
  action_presentation_current -> action_presentation_enrichment_read [constraint=true style=invis weight=100]
  action_presentation_render_read -> action_source_snapshot_state [constraint=true style=invis weight=100]
}
