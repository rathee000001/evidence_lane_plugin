    },
    {
      "type": "index",
      "name": "idx_canon_decision_once",
      "tbl_name": "canon_event",
      "sql": "CREATE UNIQUE INDEX idx_canon_decision_once\nON canon_event(decision_key_sha256)\nWHERE decision_key_sha256 IS NOT NULL"
    },
    {
