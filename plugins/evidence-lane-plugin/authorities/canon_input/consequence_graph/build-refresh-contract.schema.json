    "AuthorityRequest_canon_task_edge_register": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "canon_task_edge_register",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
