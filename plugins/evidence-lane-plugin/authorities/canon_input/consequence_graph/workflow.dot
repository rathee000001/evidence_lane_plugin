digraph workflow_canon_consequence_graph {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  sdk [label="Authenticated SDK and native MCP client" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Exact selected scope and bounded recorded evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  writer [label="Engine coordinator and owning project writer" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Current stored Plan operation and Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  owner [label="canon_consequence_graph current executable owner" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_canon_backfire [label=canon_backfire color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_canon_graph [label=canon_graph color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_canon_inspect [label=canon_inspect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_canon_task_edge_bind [label=canon_task_edge_bind color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_canon_task_edge_register [label=canon_task_edge_register color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_canon_task_result [label=canon_task_result color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  sdk -> action_canon_backfire [label=write]
  action_canon_backfire -> writer [label=canon]
  sdk -> action_canon_graph [label=read]
  action_canon_graph -> read [label=canon]
  sdk -> action_canon_inspect [label=read]
  action_canon_inspect -> read [label=canon]
  sdk -> action_canon_task_edge_bind [label=write]
  action_canon_task_edge_bind -> writer [label=canon]
  sdk -> action_canon_task_edge_register [label=write]
  action_canon_task_edge_register -> writer [label=canon]
  sdk -> action_canon_task_result [label=write]
  action_canon_task_result -> writer [label=canon]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_canon_backfire -> action_canon_graph [constraint=true style=invis weight=100]
  action_canon_graph -> action_canon_inspect [constraint=true style=invis weight=100]
  action_canon_task_edge_bind -> action_canon_task_edge_register [constraint=true style=invis weight=100]
  action_canon_task_edge_register -> action_canon_task_result [constraint=true style=invis weight=100]
}
