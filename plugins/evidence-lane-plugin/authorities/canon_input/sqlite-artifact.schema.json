{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon_input SQLITE_AUTHORITY artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "canon_input"
    },
    "artifact_path": {
      "const": "canon-input.sqlite"
    },
    "artifact_role": {
      "const": "SQLITE_AUTHORITY"
    },
    "syntax": {
      "const": "SQLITE3_FTS5"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "authority_support._schema_snapshot"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "A963682F50F20264B860928251FF3A8D6BC3F22790BF29A690DD7B134E1BB282"
}
