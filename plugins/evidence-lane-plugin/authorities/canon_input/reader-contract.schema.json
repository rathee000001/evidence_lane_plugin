          "type": "integer"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "action": {
          "const": "task_evidence_inbox",
          "title": "Action",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
