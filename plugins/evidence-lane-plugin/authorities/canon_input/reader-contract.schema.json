      },
      "required": [
        "action",
        "project_id",
        "arguments"
      ],
      "title": "AuthorityRequest_task_evidence_graph",
      "type": "object"
    },
    "AuthorityRequest_task_evidence_inbox": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 4,
