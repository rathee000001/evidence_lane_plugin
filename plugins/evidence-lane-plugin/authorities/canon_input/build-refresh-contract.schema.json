        },
        "failure_class": {
          "enum": [
            "EXECUTION_FAILURE_REQUIRES_UPSTREAM_ACTION",
            "MISSING_INFORMATION_FROM_SOURCE",
            "NEW_REQUIREMENT_FROM_SOURCE",
            "LINKED_TASK_INPUT_REQUIRED"
          ],
          "title": "Failure Class",
          "type": "string"
        },
        "requested_revision": {
          "maximum": 1000000,
          "minimum": 2,
          "title": "Requested Revision",
          "type": "integer"
        },
        "dependency_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Dependency Ids",
          "type": "array"
        },
        "return_route": {
          "$ref": "#/$defs/CanonTaskEndpoint"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/CanonTaskEndpoint"
          },
          "maxItems": 32,
          "title": "Trace",
          "type": "array"
        },
        "automatic_retry_allowed": {
          "const": false,
          "default": false,
          "title": "Automatic Retry Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "admitted_exchange_id",
        "admitted_envelope_digest",
        "failure_class",
        "requested_revision",
        "return_route"
      ],
      "title": "CanonBackfireDetails",
      "type": "object"
    },
    "CanonDecide": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "exchange_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Exchange Id",
          "type": "string"
        },
        "envelope_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Envelope Digest",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "decision": {
          "enum": [
            "admit",
            "reject",
            "clarify"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "incompatible_input_decision": {
          "anyOf": [
            {
              "const": "ACCEPT",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incompatible Input Decision"
        }
      },
      "required": [
        "exchange_id",
        "envelope_digest",
        "expected_version",
        "decision",
        "reason"
      ],
      "title": "CanonDecide",
      "type": "object"
    },
    "CanonExpected": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "receiver_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Receiver Id",
          "type": "string"
        },
        "contract_key": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Contract Key",
          "type": "string"
        },
        "expected_version": {
          "default": 0,
          "minimum": 0,
          "title": "Expected Version",
          "type": "integer"
        },
        "sender_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Sender Ids",
          "type": "array"
        },
        "sender_endpoints": {
          "items": {
            "$ref": "#/$defs/CanonTaskEndpoint"
          },
          "maxItems": 32,
          "title": "Sender Endpoints",
          "type": "array"
        },
        "kinds": {
          "items": {
            "enum": [
              "requirements",
              "evidence",
              "correction",
              "plan_proposal",
              "result",
              "clarification",
              "backfire"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Kinds",
          "type": "array"
        },
        "fields": {
          "additionalProperties": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "null"
            ],
            "type": "string"
          },
          "maxProperties": 32,
          "title": "Fields",
          "type": "object"
        },
        "required_reference_kinds": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Required Reference Kinds",
          "type": "array"
        },
        "max_bytes": {
          "default": 32768,
          "maximum": 65536,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        },
        "auto_admit": {
          "default": false,
          "title": "Auto Admit",
          "type": "boolean"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "receiver_id",
        "contract_key",
        "kinds"
      ],
      "title": "CanonExpected",
      "type": "object"
    },
    "CanonJoin": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "reported_host_task_id": {
          "anyOf": [
