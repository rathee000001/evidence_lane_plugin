    "CanonBackfire": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "admitted_exchange_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Admitted Exchange Id",
          "type": "string"
        },
        "admitted_envelope_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Admitted Envelope Digest",
          "type": "string"
        },
        "failure_class": {
          "enum": [
            "EXECUTION_FAILURE_REQUIRES_UPSTREAM_ACTION",
            "MISSING_INFORMATION_FROM_SOURCE",
            "NEW_REQUIREMENT_FROM_SOURCE",
            "LINKED_TASK_INPUT_REQUIRED"
          ],
          "title": "Failure Class",
          "type": "string"
        },
        "recipient": {
          "$ref": "#/$defs/CanonTaskEndpoint"
        },
        "requested_contract": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Requested Contract",
          "type": "string"
        },
        "requested_revision": {
          "maximum": 1000000,
          "minimum": 2,
          "title": "Requested Revision",
          "type": "integer"
        },
        "payload": {
          "$ref": "#/$defs/CanonPayload"
        },
        "dependency_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Dependency Ids",
          "type": "array"
        },
        "return_route": {
          "$ref": "#/$defs/CanonTaskEndpoint"
        },
        "return_contract": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Return Contract",
          "type": "string"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/CanonTaskEndpoint"
          },
          "maxItems": 30,
          "title": "Trace",
          "type": "array"
        },
        "expires_at": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "admitted_exchange_id",
        "admitted_envelope_digest",
        "failure_class",
        "recipient",
        "requested_contract",
        "requested_revision",
        "payload",
        "return_route",
        "return_contract",
        "expires_at"
      ],
      "title": "CanonBackfire",
      "type": "object"
    },
    "CanonBackfireDetails": {
      "additionalProperties": false,
      "properties": {
        "admitted_exchange_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
