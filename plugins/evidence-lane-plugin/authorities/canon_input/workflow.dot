digraph workflow_canon {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  sdk [label="Authenticated SDK and native MCP client" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Exact selected scope and bounded recorded evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  writer [label="Engine coordinator and owning project writer" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Current stored Plan operation and Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  owner [label="canon current executable owner" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_classify [label=task_evidence_classify color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_decide [label=task_evidence_decide color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_edge_bind [label=task_evidence_edge_bind color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_edge_register [label=task_evidence_edge_register color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_expect [label=task_evidence_expect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_graph [label=task_evidence_graph color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_inbox [label=task_evidence_inbox color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_input_request [label=task_evidence_input_request color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_inspect [label=task_evidence_inspect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_packet_classify [label=task_evidence_packet_classify color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_participant_register [label=task_evidence_participant_register color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_read [label=task_evidence_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_receive [label=task_evidence_receive color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_result [label=task_evidence_result color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_send [label=task_evidence_send color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_task_evidence_supersede [label=task_evidence_supersede color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  sdk -> action_task_evidence_classify [label=read]
  action_task_evidence_classify -> read [label="exchange-task-evidence"]
  sdk -> action_task_evidence_decide [label=write]
  action_task_evidence_decide -> writer [label="exchange-task-evidence"]
  sdk -> action_task_evidence_edge_bind [label=write]
  action_task_evidence_edge_bind -> writer [label="exchange-task-evidence"]
  sdk -> action_task_evidence_edge_register [label=write]
  action_task_evidence_edge_register -> writer [label="exchange-task-evidence"]
  sdk -> action_task_evidence_expect [label=write]
  action_task_evidence_expect -> writer [label="exchange-task-evidence"]
  sdk -> action_task_evidence_graph [label=read]
  action_task_evidence_graph -> read [label="exchange-task-evidence"]
  sdk -> action_task_evidence_inbox [label=read]
  action_task_evidence_inbox -> read [label="exchange-task-evidence"]
  sdk -> action_task_evidence_input_request [label=write]
  action_task_evidence_input_request -> writer [label="exchange-task-evidence"]
  sdk -> action_task_evidence_inspect [label=read]
  action_task_evidence_inspect -> read [label="exchange-task-evidence"]
  sdk -> action_task_evidence_packet_classify [label=read]
  action_task_evidence_packet_classify -> read [label="exchange-task-evidence"]
  sdk -> action_task_evidence_participant_register [label=write]
  action_task_evidence_participant_register -> writer [label="exchange-task-evidence"]
  sdk -> action_task_evidence_read [label=read]
  action_task_evidence_read -> read [label="exchange-task-evidence"]
  sdk -> action_task_evidence_receive [label=write]
  action_task_evidence_receive -> writer [label="exchange-task-evidence"]
  sdk -> action_task_evidence_result [label=write]
  action_task_evidence_result -> writer [label="exchange-task-evidence"]
  sdk -> action_task_evidence_send [label=write]
  action_task_evidence_send -> writer [label="exchange-task-evidence"]
  sdk -> action_task_evidence_supersede [label=write]
  action_task_evidence_supersede -> writer [label="exchange-task-evidence"]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_task_evidence_classify -> action_task_evidence_decide [constraint=true style=invis weight=100]
  action_task_evidence_edge_bind -> action_task_evidence_edge_register [constraint=true style=invis weight=100]
  action_task_evidence_inbox -> action_task_evidence_input_request [constraint=true style=invis weight=100]
  action_task_evidence_participant_register -> action_task_evidence_read [constraint=true style=invis weight=100]
  action_task_evidence_send -> action_task_evidence_supersede [constraint=true style=invis weight=100]
}
