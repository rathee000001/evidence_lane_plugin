digraph schema_canon {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  t_canon_contract_current [label="canon_contract_current\nreceiver_id, contract_key, contract_digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_canon_contracts [label="canon_contracts\ncontract_digest, receiver_id, contract_key, version, body_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_canon_events [label="canon_events\nsequence, request_id, kind, actor_id, input_digest, result_json, previous_digest, digest, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_canon_exchanges [label="canon_exchanges\nsequence, exchange_id, sender_id, receiver_id, kind, envelope_digest, body_json, state, version, state_digest, parent_id, created_at, source_project_id, destination_project_id, local_role, artifact_path" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_canon_participants [label="canon_participants\nparticipant_id, owner_client_id, body_json, digest, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_canon_supersessions [label="canon_supersessions\nexchange_id, request_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_canon_task_edge_bindings [label="canon_task_edge_bindings\nedge_id, request_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_canon_task_edges [label="canon_task_edges\nsequence, edge_id, edge_digest, source_node, destination_node, body_json, artifact_path" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_lane_identity [label="lane_identity\nsingleton, project_id, lane_id, kind, storage_layout, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_objects [label="objects\ndigest, size_bytes, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_migrations [label="schema_migrations\nowner, version, digest, description, applied_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_ownership [label="schema_ownership\nobject_name, owner, object_type" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_canon_contract_current -> t_canon_contracts [label=contract_digest]
  t_canon_contract_current -> t_canon_participants [label=receiver_id]
  t_canon_contracts -> t_canon_participants [label=receiver_id]
  t_canon_exchanges -> t_canon_exchanges [label=parent_id]
  t_canon_supersessions -> t_canon_events [label=request_id]
  t_canon_supersessions -> t_canon_exchanges [label=exchange_id]
  t_canon_task_edge_bindings -> t_canon_events [label=request_id]
  t_canon_task_edge_bindings -> t_canon_task_edges [label=edge_id]
}
