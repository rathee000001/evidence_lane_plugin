digraph workflow_universe {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  sdk [label="Authenticated SDK and native MCP client" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Exact selected scope and bounded recorded evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  writer [label="Engine coordinator and owning project writer" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Current stored Plan operation and Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  owner [label="universe current executable owner" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_link [label=project_evidence_link color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_links_read [label=project_evidence_links_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_links_verify [label=project_evidence_links_verify color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_map_inspect [label=project_evidence_map_inspect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_map_query [label=project_evidence_map_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_network_create [label=project_evidence_network_create color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_network_grant [label=project_evidence_network_grant color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_network_link [label=project_evidence_network_link color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_network_read [label=project_evidence_network_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_network_register [label=project_evidence_network_register color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_network_revoke [label=project_evidence_network_revoke color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_network_verify [label=project_evidence_network_verify color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_evidence_unlink [label=project_evidence_unlink color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  sdk -> action_project_evidence_link [label=write]
  action_project_evidence_link -> writer [label="inspect-project-evidence-map"]
  sdk -> action_project_evidence_links_read [label=read]
  action_project_evidence_links_read -> read [label="inspect-project-evidence-map"]
  sdk -> action_project_evidence_links_verify [label=read]
  action_project_evidence_links_verify -> read [label="inspect-project-evidence-map"]
  sdk -> action_project_evidence_map_inspect [label=read]
  action_project_evidence_map_inspect -> read [label="inspect-project-evidence-map"]
  sdk -> action_project_evidence_map_query [label=read]
  action_project_evidence_map_query -> read [label="inspect-project-evidence-map"]
  sdk -> action_project_evidence_network_create [label=write]
  action_project_evidence_network_create -> writer [label="link-project-evidence-network"]
  sdk -> action_project_evidence_network_grant [label=write]
  action_project_evidence_network_grant -> writer [label="link-project-evidence-network"]
  sdk -> action_project_evidence_network_link [label=write]
  action_project_evidence_network_link -> writer [label="link-project-evidence-network"]
  sdk -> action_project_evidence_network_read [label=read]
  action_project_evidence_network_read -> read [label="link-project-evidence-network"]
  sdk -> action_project_evidence_network_register [label=write]
  action_project_evidence_network_register -> writer [label="link-project-evidence-network"]
  sdk -> action_project_evidence_network_revoke [label=write]
  action_project_evidence_network_revoke -> writer [label="link-project-evidence-network"]
  sdk -> action_project_evidence_network_verify [label=read]
  action_project_evidence_network_verify -> read [label="link-project-evidence-network"]
  sdk -> action_project_evidence_unlink [label=write]
  action_project_evidence_unlink -> writer [label="inspect-project-evidence-map"]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_project_evidence_link -> action_project_evidence_links_read [constraint=true style=invis weight=100]
  action_project_evidence_links_verify -> action_project_evidence_map_inspect [constraint=true style=invis weight=100]
  action_project_evidence_network_create -> action_project_evidence_network_grant [constraint=true style=invis weight=100]
  action_project_evidence_network_read -> action_project_evidence_network_register [constraint=true style=invis weight=100]
  action_project_evidence_network_revoke -> action_project_evidence_network_verify [constraint=true style=invis weight=100]
}
