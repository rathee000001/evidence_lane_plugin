digraph workflow_universe {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  sdk [label="Authenticated SDK and native MCP client" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Exact selected scope and bounded recorded evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  writer [label="Engine coordinator and owning project writer" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Current stored Plan operation and Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  owner [label="universe current executable owner" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_bigger_universe_create [label=bigger_universe_create color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_bigger_universe_grant [label=bigger_universe_grant color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_bigger_universe_link [label=bigger_universe_link color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_bigger_universe_read [label=bigger_universe_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_bigger_universe_register [label=bigger_universe_register color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_bigger_universe_revoke [label=bigger_universe_revoke color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_bigger_universe_verify [label=bigger_universe_verify color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_linked_projects_read [label=linked_projects_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_link [label=project_link color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_unlink [label=project_unlink color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_universe_inspect [label=universe_inspect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_universe_links_verify [label=universe_links_verify color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_universe_query [label=universe_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  sdk -> action_bigger_universe_create [label=write]
  action_bigger_universe_create -> writer [label="bigger-universe"]
  sdk -> action_bigger_universe_grant [label=write]
  action_bigger_universe_grant -> writer [label="bigger-universe"]
  sdk -> action_bigger_universe_link [label=write]
  action_bigger_universe_link -> writer [label="bigger-universe"]
  sdk -> action_bigger_universe_read [label=read]
  action_bigger_universe_read -> read [label="bigger-universe"]
  sdk -> action_bigger_universe_register [label=write]
  action_bigger_universe_register -> writer [label="bigger-universe"]
  sdk -> action_bigger_universe_revoke [label=write]
  action_bigger_universe_revoke -> writer [label="bigger-universe"]
  sdk -> action_bigger_universe_verify [label=read]
  action_bigger_universe_verify -> read [label="bigger-universe"]
  sdk -> action_linked_projects_read [label=read]
  action_linked_projects_read -> read [label=universe]
  sdk -> action_project_link [label=write]
  action_project_link -> writer [label=universe]
  sdk -> action_project_unlink [label=write]
  action_project_unlink -> writer [label=universe]
  sdk -> action_universe_inspect [label=read]
  action_universe_inspect -> read [label=universe]
  sdk -> action_universe_links_verify [label=read]
  action_universe_links_verify -> read [label=universe]
  sdk -> action_universe_query [label=read]
  action_universe_query -> read [label=universe]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_bigger_universe_create -> action_bigger_universe_grant [constraint=true style=invis weight=100]
  action_bigger_universe_link -> action_bigger_universe_read [constraint=true style=invis weight=100]
  action_bigger_universe_revoke -> action_bigger_universe_verify [constraint=true style=invis weight=100]
  action_project_link -> action_project_unlink [constraint=true style=invis weight=100]
  action_universe_inspect -> action_universe_links_verify [constraint=true style=invis weight=100]
}
