{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_universe installed authority manifest",
  "type": "object",
  "required": [
    "schema",
    "status",
    "authority_id",
    "database",
    "database_sha256",
    "members",
    "live_project_bytes_in_template",
    "authority_merged_with_sector_or_peer"
  ],
  "properties": {
    "schema": {
      "const": "evidence-lane.installed-authority-surface.v1"
    },
    "status": {
      "const": "PASS"
    },
    "authority_id": {
      "const": "project_universe"
    },
    "database": {
      "const": "project_universe.sqlite"
    },
    "database_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "members": {
      "type": "array",
      "minItems": 1
    },
    "live_project_bytes_in_template": {
      "const": false
    },
    "authority_merged_with_sector_or_peer": {
      "const": false
    }
  },
  "additionalProperties": true,
  "receipt_sha256": "8952E8545F7A49407C943459B2E433AA43EA9CD4F92791CE48F761DDF3DA5CE8"
}
