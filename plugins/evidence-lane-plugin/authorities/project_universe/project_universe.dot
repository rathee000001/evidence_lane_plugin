digraph schema_universe {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  t_federation_grants [label="federation_grants\ngrant_id, body_json, digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_federation_identity [label="federation_identity\nsingleton, federation_id, body_json, digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_federation_lane_heads [label="federation_lane_heads\nproject_id, lane_id, mini_brain_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_federation_links [label="federation_links\nedge_id, grant_id, body_json, digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_federation_member_history [label="federation_member_history\nproject_id, version, body_json, digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_federation_members [label="federation_members\nproject_id, version, body_json, digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_federation_mini_brains [label="federation_mini_brains\nmini_brain_id, project_id, lane_id, body_json, digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_federation_revocations [label="federation_revocations\ngrant_id, body_json, digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_lane_identity [label="lane_identity\nsingleton, project_id, lane_id, kind, storage_layout, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_objects [label="objects\ndigest, size_bytes, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_migrations [label="schema_migrations\nowner, version, digest, description, applied_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_ownership [label="schema_ownership\nobject_name, owner, object_type" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_universe_link_events [label="universe_link_events\nsequence, request_id, actor_id, input_digest, body_json, previous_digest, digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_universe_links [label="universe_links\ntarget_project_id, version, state, binding_digest, body_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_federation_lane_heads -> t_federation_mini_brains [label=mini_brain_id]
  t_federation_links -> t_federation_grants [label=grant_id]
  t_federation_revocations -> t_federation_grants [label=grant_id]
}
