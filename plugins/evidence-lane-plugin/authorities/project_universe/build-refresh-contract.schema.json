    "FederationCreate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "FederationCreate",
      "type": "object"
    },
    "FederationGrant": {
      "additionalProperties": false,
      "properties": {
        "source_mini_brain_id": {
          "pattern": "^mini_[0-9a-f]{64}$",
          "title": "Source Mini Brain Id",
          "type": "string"
        },
        "target_mini_brain_id": {
          "pattern": "^mini_[0-9a-f]{64}$",
          "title": "Target Mini Brain Id",
          "type": "string"
        },
        "relation": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Relation",
          "type": "string"
        },
        "lifetime_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Lifetime Seconds",
          "type": "integer"
        }
      },
      "required": [
        "source_mini_brain_id",
        "target_mini_brain_id",
        "relation"
      ],
      "title": "FederationGrant",
      "type": "object"
    },
    "FederationLink": {
      "additionalProperties": false,
      "properties": {
        "grant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Grant Id",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 16,
          "minProperties": 1,
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "grant_id",
        "evidence"
      ],
      "title": "FederationLink",
      "type": "object"
    },
    "FederationRegister": {
      "additionalProperties": false,
      "properties": {
        "target_project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Target Project Id",
          "type": "string"
        },
        "expected_version": {
          "default": 0,
          "minimum": 0,
          "title": "Expected Version",
          "type": "integer"
        },
        "expected_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Snapshot Sha256",
          "type": "string"
        },
        "inspection": {
          "$ref": "#/$defs/UniverseInspect"
        }
      },
      "required": [
        "target_project_id",
        "expected_snapshot_sha256"
      ],
      "title": "FederationRegister",
      "type": "object"
    },
