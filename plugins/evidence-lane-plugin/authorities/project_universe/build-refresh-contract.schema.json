      ],
      "title": "ProjectUnlink",
      "type": "object"
    },
    "UniverseInspect": {
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "default": 10000,
          "maximum": 30000,
          "minimum": 100,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "max_files": {
          "default": 4096,
          "maximum": 20000,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_bytes": {
          "default": 67108864,
          "maximum": 268435456,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        },
        "verify_files": {
          "default": true,
          "title": "Verify Files",
          "type": "boolean"
        }
      },
      "title": "UniverseInspect",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "project_evidence_link": "#/$defs/AuthorityRequest_project_evidence_link",
      "project_evidence_network_create": "#/$defs/AuthorityRequest_project_evidence_network_create",
      "project_evidence_network_grant": "#/$defs/AuthorityRequest_project_evidence_network_grant",
      "project_evidence_network_link": "#/$defs/AuthorityRequest_project_evidence_network_link",
      "project_evidence_network_register": "#/$defs/AuthorityRequest_project_evidence_network_register",
      "project_evidence_network_revoke": "#/$defs/AuthorityRequest_project_evidence_network_revoke",
      "project_evidence_unlink": "#/$defs/AuthorityRequest_project_evidence_unlink"
    },
    "propertyName": "action"
  },
  "oneOf": [
