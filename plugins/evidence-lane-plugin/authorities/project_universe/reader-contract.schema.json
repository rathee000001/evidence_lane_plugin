          "type": "integer"
        }
      },
      "title": "ProjectLinksVerify",
      "type": "object"
    },
    "UniverseInspect": {
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "default": 10000,
          "maximum": 30000,
          "minimum": 100,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "max_files": {
          "default": 4096,
          "maximum": 20000,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_bytes": {
          "default": 67108864,
          "maximum": 268435456,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        },
        "verify_files": {
          "default": true,
          "title": "Verify Files",
          "type": "boolean"
        }
      },
      "title": "UniverseInspect",
      "type": "object"
    },
    "UniverseQuery": {
      "additionalProperties": false,
      "properties": {
        "node_limit": {
          "default": 100,
          "maximum": 200,
          "minimum": 1,
          "title": "Node Limit",
          "type": "integer"
        },
        "edge_limit": {
          "default": 200,
          "maximum": 500,
          "minimum": 0,
          "title": "Edge Limit",
          "type": "integer"
        },
        "task_offset": {
          "default": 0,
          "maximum": 2000,
          "minimum": 0,
          "title": "Task Offset",
          "type": "integer"
        },
        "source_offset": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Source Offset",
          "type": "integer"
        },
        "topology_offset": {
          "default": 0,
          "maximum": 64,
          "minimum": 0,
          "title": "Topology Offset",
          "type": "integer"
        },
        "include_tasks": {
          "default": true,
          "title": "Include Tasks",
          "type": "boolean"
        },
        "include_sources": {
          "default": true,
          "title": "Include Sources",
          "type": "boolean"
        },
        "include_links": {
          "default": true,
          "title": "Include Links",
          "type": "boolean"
        },
        "linked_project_after": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linked Project After"
        },
        "query": {
          "default": "",
          "maxLength": 500,
          "title": "Query",
          "type": "string"
        },
        "node_kind": {
          "anyOf": [
            {
              "enum": [
                "project",
                "root_pv",
                "lane",
                "plan_task",
                "source_reference",
                "linked_project"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Kind"
        }
      },
      "title": "UniverseQuery",
      "type": "object"
    }
