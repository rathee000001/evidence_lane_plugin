    "FederationRead": {
      "additionalProperties": false,
      "properties": {
        "view": {
          "default": "members",
          "enum": [
            "members",
            "mini_brains",
            "links",
            "grants"
          ],
          "title": "View",
          "type": "string"
        },
        "after_id": {
          "default": "",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_-]*$",
          "title": "After Id",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "target_project_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Project Id"
        }
      },
      "title": "FederationRead",
      "type": "object"
    },
    "FederationVerify": {
      "additionalProperties": false,
      "properties": {
        "max_records": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Records",
          "type": "integer"
        }
      },
      "title": "FederationVerify",
      "type": "object"
    },
    "LinkedProjectsRead": {
