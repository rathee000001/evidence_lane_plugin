{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_authority MERMAID_TRAVERSAL_MAP artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "project_authority"
    },
    "artifact_path": {
      "const": "project_authority.mmd"
    },
    "artifact_role": {
      "const": "MERMAID_TRAVERSAL_MAP"
    },
    "syntax": {
      "const": "MERMAID_FLOWCHART"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "authority_support.validate_authority_support"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "EE2B0E80C39246022DC6E5603A31C58F42BB794047238328BE7C283982B3F4CA"
}
