{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_authority installed authority manifest",
  "type": "object",
  "required": [
    "schema",
    "status",
    "authority_id",
    "database",
    "database_sha256",
    "members",
    "live_project_bytes_in_template",
    "authority_merged_with_sector_or_peer"
  ],
  "properties": {
    "schema": {
      "const": "evidence-lane.installed-authority-surface.v1"
    },
    "status": {
      "const": "PASS"
    },
    "authority_id": {
      "const": "project_authority"
    },
    "database": {
      "const": "project-authority.sqlite"
    },
    "database_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "members": {
      "type": "array",
      "minItems": 1
    },
    "live_project_bytes_in_template": {
      "const": false
    },
    "authority_merged_with_sector_or_peer": {
      "const": false
    }
  },
  "additionalProperties": true,
  "receipt_sha256": "A33EB32523E18099D66386A67D5878BCC72ED8695B5787A4D6443DEF243F7FF7"
}
