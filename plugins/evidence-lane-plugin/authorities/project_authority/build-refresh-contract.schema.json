    "ContinuationOffer": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "participant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Participant Id",
          "type": "string"
        },
        "destination_participant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Destination Participant Id",
          "type": "string"
        },
        "plan_revision": {
          "minimum": 1,
          "title": "Plan Revision",
          "type": "integer"
        },
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "contract_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Digest",
          "type": "string"
        },
        "memory_checkpoint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Checkpoint"
        },
        "expires_in_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 30,
          "title": "Expires In Seconds",
          "type": "integer"
        },
        "require_native_attestation": {
          "default": false,
          "title": "Require Native Attestation",
          "type": "boolean"
        }
      },
      "required": [
        "participant_id",
        "destination_participant_id",
        "plan_revision",
        "task_id",
        "contract_digest"
      ],
      "title": "ContinuationOffer",
      "type": "object"
    },
