  action_lane_fetch -> read [label="manage-project-sources"]
  sdk -> action_lane_search [label=read]
  action_lane_search -> read [label="evidence-lane"]
  sdk -> action_lane_status [label=read]
  action_lane_status -> read [label="evidence-lane"]
  sdk -> action_linked_project_evidence_query [label=read]
  action_linked_project_evidence_query -> read [label="inspect-project-evidence-map"]
  sdk -> action_project_backup [label=admin]
  action_project_backup -> writer [label="recover-project-state"]
  sdk -> action_project_backup_verify [label=admin]
  action_project_backup_verify -> read [label="recover-project-state"]
  sdk -> action_project_catalog [label=project_admin]
  action_project_catalog -> read [label="evidence-lane"]
  sdk -> action_project_deselect [label=project_admin]
  action_project_deselect -> writer [label="close-project-session"]
  sdk -> action_project_evidence_heads_compare [label=read]
  action_project_evidence_heads_compare -> read [label="evidence-lane"]
  sdk -> action_project_evidence_history [label=read]
  action_project_evidence_history -> read [label="evidence-lane"]
  sdk -> action_project_recovery_inspect [label=read]
  action_project_recovery_inspect -> read [label="recover-project-state"]
  sdk -> action_project_register [label=project_admin]
  action_project_register -> writer [label="select-project-storage"]
  sdk -> action_project_select [label=project_admin]
  action_project_select -> writer [label="open-project-session"]
  sdk -> action_project_status [label=read]
  action_project_status -> read [label="open-project-session"]
  sdk -> action_restoration_read [label=read]
  action_restoration_read -> read [label="recover-project-state"]
  sdk -> action_restoration_reindex [label=write]
  action_restoration_reindex -> writer [label="recover-project-state"]
  sdk -> action_search [label=read]
  action_search -> read [label="evidence-lane"]
  sdk -> action_storage_status [label=read]
  action_storage_status -> read [label="select-project-storage"]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_code_snapshot_summary -> action_continuation_recovery_cancel [constraint=true style=invis weight=100]
  action_git_restore_reconcile -> action_lane_catalog [constraint=true style=invis weight=100]
  action_project_backup -> action_project_backup_verify [constraint=true style=invis weight=100]
  action_project_recovery_inspect -> action_project_register [constraint=true style=invis weight=100]
