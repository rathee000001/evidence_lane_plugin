digraph workflow_project_authority {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  sdk [label="Authenticated SDK and native MCP client" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Exact selected scope and bounded recorded evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  writer [label="Engine coordinator and owning project writer" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Current stored Plan operation and Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  owner [label="project_authority current executable owner" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_continuation_recovery_cancel [label=continuation_recovery_cancel color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_continuation_recovery_offer [label=continuation_recovery_offer color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_cross_project_query [label=cross_project_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_git_restore [label=git_restore color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_git_restore_abandon [label=git_restore_abandon color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_git_restore_preview [label=git_restore_preview color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_git_restore_reconcile [label=git_restore_reconcile color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_lane_catalog [label=lane_catalog color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_lane_fetch [label=lane_fetch color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_lane_search [label=lane_search color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_lane_status [label=lane_status color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_backup [label=project_backup color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_backup_verify [label=project_backup_verify color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_catalog [label=project_catalog color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_deselect [label=project_deselect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_recovery_inspect [label=project_recovery_inspect color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_register [label=project_register color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_select [label=project_select color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_status [label=project_status color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pv_diff [label=pv_diff color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pv_history [label=pv_history color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_pv_summary [label=pv_summary color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_restoration_read [label=restoration_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_restoration_reindex [label=restoration_reindex color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_search [label=search color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_storage_status [label=storage_status color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  sdk -> action_continuation_recovery_cancel [label=admin]
  action_continuation_recovery_cancel -> writer [label=recover]
  sdk -> action_continuation_recovery_offer [label=admin]
  action_continuation_recovery_offer -> writer [label=recover]
  sdk -> action_cross_project_query [label=read]
  action_cross_project_query -> read [label=universe]
  sdk -> action_git_restore [label=admin]
  action_git_restore -> writer [label=recover]
  sdk -> action_git_restore_abandon [label=admin]
  action_git_restore_abandon -> writer [label=recover]
  sdk -> action_git_restore_preview [label=read]
  action_git_restore_preview -> read [label=recover]
  sdk -> action_git_restore_reconcile [label=admin]
  action_git_restore_reconcile -> writer [label=recover]
  sdk -> action_lane_catalog [label=read]
  action_lane_catalog -> read [label=evi]
  sdk -> action_lane_fetch [label=read]
  action_lane_fetch -> read [label="source-intake"]
  sdk -> action_lane_search [label=read]
  action_lane_search -> read [label=evi]
  sdk -> action_lane_status [label=read]
  action_lane_status -> read [label=evi]
  sdk -> action_project_backup [label=admin]
  action_project_backup -> writer [label=recover]
  sdk -> action_project_backup_verify [label=admin]
  action_project_backup_verify -> read [label=recover]
  sdk -> action_project_catalog [label=project_admin]
  action_project_catalog -> read [label=evi]
  sdk -> action_project_deselect [label=project_admin]
  action_project_deselect -> writer [label="exit-boot"]
  sdk -> action_project_recovery_inspect [label=read]
  action_project_recovery_inspect -> read [label=recover]
  sdk -> action_project_register [label=project_admin]
  action_project_register -> writer [label=storage]
  sdk -> action_project_select [label=project_admin]
  action_project_select -> writer [label=boot]
  sdk -> action_project_status [label=read]
  action_project_status -> read [label=boot]
  sdk -> action_pv_diff [label=read]
  action_pv_diff -> read [label=evi]
  sdk -> action_pv_history [label=read]
  action_pv_history -> read [label=evi]
  sdk -> action_pv_summary [label=read]
  action_pv_summary -> read [label="source-intake"]
  sdk -> action_restoration_read [label=read]
  action_restoration_read -> read [label=recover]
  sdk -> action_restoration_reindex [label=write]
  action_restoration_reindex -> writer [label=recover]
  sdk -> action_search [label=read]
  action_search -> read [label=evi]
  sdk -> action_storage_status [label=read]
  action_storage_status -> read [label=storage]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_continuation_recovery_cancel -> action_continuation_recovery_offer [constraint=true style=invis weight=100]
  action_git_restore_reconcile -> action_lane_catalog [constraint=true style=invis weight=100]
  action_project_backup_verify -> action_project_catalog [constraint=true style=invis weight=100]
  action_project_status -> action_pv_diff [constraint=true style=invis weight=100]
  action_search -> action_storage_status [constraint=true style=invis weight=100]
}
