{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_authority SQLITE_AUTHORITY artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "project_authority"
    },
    "artifact_path": {
      "const": "project-authority.sqlite"
    },
    "artifact_role": {
      "const": "SQLITE_AUTHORITY"
    },
    "syntax": {
      "const": "SQLITE3_FTS5"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "authority_support._schema_snapshot"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "D34260D45FD9AF0ABFFFEDD134F9A296091B4C89C37752D42D69E6CFB0DBB210"
}
