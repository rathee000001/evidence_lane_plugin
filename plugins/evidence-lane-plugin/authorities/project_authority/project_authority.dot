digraph schema_project_authority {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  t_project [label="project\nsingleton, project_id, source_root, format_version, storage_layout, created_at, registration_digest" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_project_registration [label="project_registration\nsingleton, body_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_root_lane_catalog [label="root_lane_catalog\nlane_id, kind, database_path, initialized_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_root_lane_heads [label="root_lane_heads\nlane_id, revision, head_digest, commit_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_root_pv_head [label="root_pv_head\nsingleton, revision, head_digest, commit_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_root_transaction_journal [label="root_transaction_journal\ncommit_id, phase, body_json, created_at, updated_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_writer_lease [label="writer_lease\nsingleton, fence, owner_id, engine_id, expires_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_root_lane_heads -> t_root_lane_catalog [label=lane_id]
}
