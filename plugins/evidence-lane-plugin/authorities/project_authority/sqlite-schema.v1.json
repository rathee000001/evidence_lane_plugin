    {
      "type": "table",
      "name": "authority_index_content_cas",
      "tbl_name": "authority_index_content_cas",
      "sql": "CREATE TABLE authority_index_content_cas(\n            sha256 TEXT PRIMARY KEY,\n            size_bytes INTEGER NOT NULL CHECK(size_bytes >= 0),\n            compression TEXT NOT NULL,\n            compressed_bytes BLOB NOT NULL,\n            first_seen_at TEXT NOT NULL\n        ) STRICT"
    },
    {
      "type": "table",
      "name": "authority_index_fts",
      "tbl_name": "authority_index_fts",
      "sql": "CREATE VIRTUAL TABLE authority_index_fts USING fts5(\n            node_id UNINDEXED,\n            authority_id UNINDEXED,\n            source_table UNINDEXED,\n            source_identity UNINDEXED,\n            text_content,\n            content='',\n            contentless_delete=1,\n            tokenize='unicode61'\n        )"
    },
    {
      "type": "table",
      "name": "authority_index_fts_config",
      "tbl_name": "authority_index_fts_config",
      "sql": "CREATE TABLE 'authority_index_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID"
    },
    {
      "type": "table",
      "name": "authority_index_fts_data",
      "tbl_name": "authority_index_fts_data",
      "sql": "CREATE TABLE 'authority_index_fts_data'(id INTEGER PRIMARY KEY, block BLOB)"
    },
    {
      "type": "table",
      "name": "authority_index_fts_docsize",
      "tbl_name": "authority_index_fts_docsize",
      "sql": "CREATE TABLE 'authority_index_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB, origin INTEGER)"
    },
    {
      "type": "table",
      "name": "authority_index_fts_idx",
      "tbl_name": "authority_index_fts_idx",
      "sql": "CREATE TABLE 'authority_index_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID"
    },
    {
      "type": "table",
      "name": "authority_index_node",
      "tbl_name": "authority_index_node",
      "sql": "CREATE TABLE authority_index_node(\n            node_id TEXT PRIMARY KEY,\n            source_id TEXT NOT NULL REFERENCES authority_index_source(source_id)\n                ON DELETE CASCADE,\n            ordinal INTEGER NOT NULL,\n            char_start INTEGER NOT NULL,\n            char_end INTEGER NOT NULL,\n            text_sha256 TEXT NOT NULL\n                REFERENCES authority_index_content_cas(sha256),\n            metadata_sha256 TEXT NOT NULL\n                REFERENCES authority_index_content_cas(sha256),\n            UNIQUE(source_id, ordinal)\n        ) STRICT"
    },
    {
      "type": "table",
      "name": "authority_index_refresh_receipt",
      "tbl_name": "authority_index_refresh_receipt",
      "sql": "CREATE TABLE authority_index_refresh_receipt(\n            sequence INTEGER PRIMARY KEY,\n            authority_id TEXT NOT NULL,\n            source_count INTEGER NOT NULL,\n            node_count INTEGER NOT NULL,\n            indexed_table_count INTEGER NOT NULL,\n            llama_index_core_version TEXT NOT NULL,\n            chunk_size_tokens INTEGER NOT NULL,\n            chunk_overlap_tokens INTEGER NOT NULL,\n            prior_receipt_sha256 TEXT,\n            recorded_at TEXT NOT NULL,\n            receipt_sha256 TEXT NOT NULL UNIQUE,\n            receipt_json TEXT NOT NULL\n        ) STRICT"
    },
    {
      "type": "table",
      "name": "authority_index_source",
      "tbl_name": "authority_index_source",
      "sql": "CREATE TABLE authority_index_source(\n            source_id TEXT PRIMARY KEY,\n            authority_id TEXT NOT NULL,\n            source_table TEXT NOT NULL,\n            source_identity TEXT NOT NULL,\n            source_text_sha256 TEXT NOT NULL,\n            metadata_sha256 TEXT NOT NULL\n                REFERENCES authority_index_content_cas(sha256),\n            recorded_at TEXT NOT NULL,\n            UNIQUE(authority_id, source_table, source_identity)\n        ) STRICT"
    },
    {
      "type": "table",
      "name": "project_authority_fts",
      "tbl_name": "project_authority_fts",
      "sql": "CREATE VIRTUAL TABLE project_authority_fts USING fts5(\n                record_id UNINDEXED,\n                record_kind,\n                project_id,\n                authority_id,\n                payload_text,\n                tokenize='unicode61'\n            )"
    },
    {
      "type": "table",
      "name": "project_authority_fts_config",
      "tbl_name": "project_authority_fts_config",
      "sql": "CREATE TABLE 'project_authority_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID"
    },
    {
      "type": "table",
      "name": "project_authority_fts_content",
      "tbl_name": "project_authority_fts_content",
      "sql": "CREATE TABLE 'project_authority_fts_content'(id INTEGER PRIMARY KEY, c0, c1, c2, c3, c4)"
    },
    {
      "type": "table",
      "name": "project_authority_fts_data",
      "tbl_name": "project_authority_fts_data",
