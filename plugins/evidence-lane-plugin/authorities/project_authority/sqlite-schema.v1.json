      "sql": "CREATE TABLE project_registration(\n                project_id TEXT PRIMARY KEY,\n                project_root TEXT NOT NULL,\n                project_root_identity_sha256 TEXT NOT NULL,\n                registration_state TEXT NOT NULL,\n                payload_json TEXT NOT NULL,\n                payload_sha256 TEXT NOT NULL,\n                registered_at TEXT NOT NULL,\n                updated_at TEXT NOT NULL\n            ) STRICT"
    },
    {
      "type": "table",
      "name": "workspace_binding",
      "tbl_name": "workspace_binding",
      "sql": "CREATE TABLE workspace_binding(\n                binding_id TEXT PRIMARY KEY,\n                project_id TEXT NOT NULL,\n                host_task_id TEXT NOT NULL,\n                workspace_root TEXT NOT NULL,\n                repository_identity_sha256 TEXT,\n                branch TEXT,\n                commit_sha TEXT,\n                tree_sha TEXT,\n                dirty_identity_sha256 TEXT,\n                state TEXT NOT NULL,\n                payload_json TEXT NOT NULL,\n                payload_sha256 TEXT NOT NULL,\n                recorded_at TEXT NOT NULL\n            ) STRICT"
    }
