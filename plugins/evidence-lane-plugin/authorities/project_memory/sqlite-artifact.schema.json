{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_memory SQLITE_AUTHORITY artifact receipt",
  "type": "object",
  "required": [
    "authority_id",
    "artifact_path",
    "artifact_role",
    "syntax",
    "bytes",
    "sha256",
    "validator",
    "status"
  ],
  "properties": {
    "authority_id": {
      "const": "project_memory"
    },
    "artifact_path": {
      "const": "memory.sqlite"
    },
    "artifact_role": {
      "const": "SQLITE_AUTHORITY"
    },
    "syntax": {
      "const": "SQLITE3_FTS5"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "validator": {
      "const": "authority_support._schema_snapshot"
    },
    "status": {
      "const": "PASS"
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "B71DCD7CBEF268DD9596C0CF6FF9CB0D6573A6CFBD8906BF9770EA9079479200"
}
