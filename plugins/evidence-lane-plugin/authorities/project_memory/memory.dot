digraph schema_memory {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  t_lane_identity [label="lane_identity\nsingleton, project_id, lane_id, kind, storage_layout, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_memory_checkpoints [label="memory_checkpoints\ncheckpoint_digest, body_json" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_memory_edges [label="memory_edges\nedge_id, source_id, target_id, kind, body_json, row_digest, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_memory_events [label="memory_events\nsequence, request_id, kind, actor_id, input_digest, result_json, previous_digest, digest, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_memory_fts [label="memory_fts\nlocator_id, label, text" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_memory_locators [label="memory_locators\nlocator_id, reference_kind, reference_key, reference_digest, reference_revision, profile, body_json, row_digest, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_objects [label="objects\ndigest, size_bytes, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_migrations [label="schema_migrations\nowner, version, digest, description, applied_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_ownership [label="schema_ownership\nobject_name, owner, object_type" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_memory_edges -> t_memory_locators [label=target_id]
  t_memory_edges -> t_memory_locators [label=source_id]
}
