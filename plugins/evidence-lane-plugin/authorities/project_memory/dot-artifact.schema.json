      },
      "title": "Files",
      "type": "array"
    },
    "source_authority_mutated": {
      "const": false,
      "default": false,
      "title": "Source Authority Mutated",
      "type": "boolean"
    },
    "reused_snapshot": {
      "default": false,
      "title": "Reused Snapshot",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "view_id",
    "state",
    "generation",
    "snapshot_digest",
    "files"
  ],
