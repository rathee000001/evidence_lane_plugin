    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "receipt_sha256": "447F8F80BEEBDD52F1E238286A6DC28DCEAD5DBEC559F43D525AA4760A2DD548"
}
