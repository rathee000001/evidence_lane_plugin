digraph workflow_memory {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  sdk [label="Authenticated SDK and native MCP client" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  read [label="Exact selected scope and bounded recorded evidence" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  writer [label="Engine coordinator and owning project writer" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  delta [label="Current stored Plan operation and Delta admission" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  owner [label="memory current executable owner" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_context_index_query [label=context_index_query color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_context_index_sync [label=context_index_sync color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_memory_checkpoint [label=memory_checkpoint color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_memory_ingest [label=memory_ingest color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_memory_read [label=memory_read color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_memory_rehydrate [label=memory_rehydrate color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  action_project_memory_record_link [label=project_memory_record_link color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  sdk -> action_context_index_query [label=tools]
  delta -> action_context_index_query [label="required current operation contract"]
  action_context_index_query -> read [label=memory]
  sdk -> action_context_index_sync [label=publish]
  delta -> action_context_index_sync [label="required current operation contract"]
  action_context_index_sync -> writer [label=memory]
  sdk -> action_memory_checkpoint [label=write]
  action_memory_checkpoint -> writer [label=memory]
  sdk -> action_memory_ingest [label=write]
  action_memory_ingest -> writer [label=memory]
  sdk -> action_memory_read [label=read]
  action_memory_read -> read [label=memory]
  sdk -> action_memory_rehydrate [label=read]
  action_memory_rehydrate -> read [label=memory]
  sdk -> action_project_memory_record_link [label=write]
  action_project_memory_record_link -> writer [label=memory]
  writer -> owner [label="owned mutation and attributed result"]
  owner -> read [label="published state"]
  action_context_index_query -> action_context_index_sync [constraint=true style=invis weight=100]
  action_context_index_sync -> action_memory_checkpoint [constraint=true style=invis weight=100]
  action_memory_ingest -> action_memory_read [constraint=true style=invis weight=100]
  action_memory_read -> action_memory_rehydrate [constraint=true style=invis weight=100]
}
