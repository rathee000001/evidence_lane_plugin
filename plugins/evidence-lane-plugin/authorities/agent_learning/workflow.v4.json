      "name": "learning_record_host_memory_import",
      "description": "Record explicit host-memory provenance and its exact Plan-task link without reading host memory or creating Learning.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
