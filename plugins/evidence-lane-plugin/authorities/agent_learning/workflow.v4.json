          "source_kind": {
            "enum": [
              "CODEX_LOCAL_MEMORY",
              "CHATGPT_SAVED_MEMORY",
              "CHATGPT_CHAT_HISTORY_MEMORY"
            ],
            "title": "Source Kind",
            "type": "string"
          },
          "source_locator": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Source Locator",
            "type": "string"
          },
          "source_record_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Source Record Sha256",
            "type": "string"
          },
          "source_context_id_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Source Context Id Sha256",
            "type": "string"
          },
          "observed_at": {
            "maxLength": 40,
            "minLength": 20,
            "title": "Observed At",
            "type": "string"
          },
          "purpose": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "task_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "title": "Task Id",
            "type": "string"
          },
          "plan_revision": {
            "minimum": 1,
            "title": "Plan Revision",
            "type": "integer"
          },
          "contract_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Contract Digest",
            "type": "string"
          },
          "delta_job_id": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Delta Job Id"
          }
        },
        "required": [
          "source_kind",
          "source_locator",
          "source_record_sha256",
          "source_context_id_sha256",
          "observed_at",
          "purpose",
          "task_id",
          "plan_revision",
          "contract_digest"
        ],
        "title": "HostMemoryImport",
        "type": "object"
