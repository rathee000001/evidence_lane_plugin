{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "view_id": {
      "title": "View Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "published",
        "empty"
      ],
      "title": "State",
      "type": "string"
    },
    "generation": {
      "title": "Generation",
      "type": "integer"
    },
    "snapshot_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Snapshot Digest"
    },
    "files": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "title": "Files",
      "type": "array"
    },
    "source_authority_mutated": {
      "const": false,
      "default": false,
      "title": "Source Authority Mutated",
      "type": "boolean"
    },
    "reused_snapshot": {
      "default": false,
      "title": "Reused Snapshot",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "view_id",
    "state",
    "generation",
    "snapshot_digest",
    "files"
  ],
  "title": "learning selected project graph publication",
  "type": "object",
  "x-format": "mmd",
  "x-lane-id": "learning",
  "x-view-contracts": [
    {
      "view_id": "learning.provenance",
      "lane_id": "learning",
      "folder": "authorities/learning",
      "version": 1,
      "meaning": "Verified observations, their exact source receipts and version relationships.",
      "consumer": "artifact_export",
      "implementation_digest": "5fa8a57a0f32ad1bc25128db8b0426d2feea89fbd60d53bc32243d82d8790980",
      "files": {
        "mmd": "agent-learning.mmd",
        "dot": "agent-learning.dot"
      },
      "scope": {
        "query": true,
        "include_history": true,
        "max_nodes": 200,
        "max_edges": 500
      },
      "source_owners": [
        "learning"
      ],
      "node_kinds": [
        "learning_version",
        "verified_exit"
      ],
      "edge_kinds": [
        "VERIFIED_SOURCE_OF",
        "PREVIOUS_VERSION"
      ],
      "schemas": [
        {
          "owner": "learning",
          "version": 1,
          "digest": "ef20a7527722366f6784e2213f262f242256169a296a86a2af902adb4ef27e38"
        }
      ],
      "authority": "owning_lane_sqlite",
      "current_selector": "owning_lane_sqlite",
      "head_reader": "declared_owner_events",
      "pointer_scope": null,
      "shared_tools": {
        "mmd": {
          "primary": "langgraph_graph_exporter",
          "dependencies": [
            "langgraph",
            "langchain-core",
            "graphviz",
            "rustworkx"
          ]
        },
        "dot": {
          "primary": "python_graphviz",
