digraph schema_learning {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  t_lane_identity [label="lane_identity\nsingleton, project_id, lane_id, kind, storage_layout, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_learning_controls [label="learning_controls\nlesson_key, revoked_by, reason, revoked_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_learning_current [label="learning_current\nlesson_key, version_id" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_learning_events [label="learning_events\nsequence, event_id, version_id, kind, actor_id, body_json, previous_digest, digest, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_learning_fts [label="learning_fts\nversion_id, text" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_learning_versions [label="learning_versions\nversion_id, lesson_key, version, profile, action, scope_json, content_digest, source_job_id, source_receipt_id, state, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_objects [label="objects\ndigest, size_bytes, created_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_migrations [label="schema_migrations\nowner, version, digest, description, applied_at" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_schema_ownership [label="schema_ownership\nobject_name, owner, object_type" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  t_learning_current -> t_learning_versions [label=version_id]
  t_learning_events -> t_learning_versions [label=version_id]
  t_learning_versions -> t_objects [label=content_digest]
}
