{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "LearningRead": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "profile": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "action": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "limit": {
          "default": 8,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "include_history": {
          "default": false,
          "title": "Include History",
          "type": "boolean"
        }
      },
      "title": "LearningRead",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 4,
      "default": 4,
      "title": "Protocol Version",
      "type": "integer"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "action": {
      "const": "learning_read",
      "title": "Action",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "expected_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "arguments": {
      "$ref": "#/$defs/LearningRead"
    }
  },
  "required": [
    "action",
    "project_id",
    "arguments"
  ],
  "title": "learning typed SDK requests",
  "type": "object"
}
