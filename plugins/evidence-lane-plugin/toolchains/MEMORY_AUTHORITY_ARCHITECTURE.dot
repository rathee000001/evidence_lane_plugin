digraph memory_authorities {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  C [label="Classified input or result" color="#101828" fillcolor="#101828" fontcolor=white shape=box style="rounded,filled"]
  subgraph cluster_memory_shells {
    label="Separate memory and authority shells — linked, never merged" rankdir=TB
    M1 [label="sensory live capture\ncapture_routing, bounded_io" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    M2 [label="task working context\nsession_authority, codex_turn_control" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    M3 [label="episodic chat lineage\nchat_lineage, session_authority, receipt_ledger" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    M4 [label="semantic project memory\nproject_memory" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    M5 [label="accepted learning\nagent_learning" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    M6 [label="canon and project truth\ncanon_input, project_authority, accepted_pv_pointer" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    M7 [label="host instructions and recall\nAGENTS.md, host_MEMORY.md" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  C -> M1
  C -> M2
  C -> M3
  C -> M4
  C -> M5
  C -> M6
  C -> M7
  M2 -> M5 [label="accepted link only" style=dashed]
  M3 -> M4 [label="hash/receipt links" style=dashed]
  M4 -> M6 [label="never auto-promotes" style=dashed]
  M1 -> M2 [constraint=true style=invis weight=100]
  M2 -> M3 [constraint=true style=invis weight=100]
  M4 -> M5 [constraint=true style=invis weight=100]
  M5 -> M6 [constraint=true style=invis weight=100]
}
