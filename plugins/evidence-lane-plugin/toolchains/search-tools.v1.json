{
  "schema": "evidence-lane.search-toolchain-manifest.v1",
  "version": 1,
  "scope": "ALL_GOVERNED_PROJECTS",
  "resolution_order": [
    "PACKAGE_LOCAL_VERIFIED_BINARY",
    "EXPLICIT_CONFIGURED_VERIFIED_HOST_BINARY",
    "DETERMINISTIC_BUILTIN_FALLBACK"
  ],
  "auto_download_during_mcp_handshake": false,
  "path_lookup_allowed": false,
  "shell_execution_allowed": false,
  "source_write_authority": false,
  "git_authority": false,
  "lifecycle_authority": false,
  "candidate_authority": false,
  "hil_authority": false,
  "pointer_authority": false,
  "fts_authority": {
    "backend": "SQLITE_FTS5",
    "query_mode": "BOUNDED_FTS5",
    "scope": "PLAN_LANE_CHATLINEAGE_AND_PROJECT_SECTORS",
    "pointer_and_locator_required": true,
    "model_context_policy": "BOUNDED_QUERY_RESULTS_ONLY",
    "pv_package_loaded_into_model_context": false,
    "fallback": "FAIL_CLOSED_WHEN_SQLITE_FTS5_UNAVAILABLE"
  },
  "bounds": {
    "max_query_chars": 1024,
    "max_candidates": 10000,
    "max_candidate_chars": 4096,
    "max_results": 500,
    "max_files": 20000,
    "max_file_bytes": 5242880,
    "max_total_read_bytes": 67108864,
    "max_process_output_bytes": 2097152,
    "timeout_seconds": 10
  },
  "tools": [
    {
      "tool_id": "ripgrep",
      "command": "rg",
      "role": "BOUNDED_LITERAL_CONTENT_AND_FILE_SEARCH",
      "version": "15.2.0",
      "version_pattern": "^ripgrep 15\\.2\\.0(?: |$)",
      "license_spdx": "MIT OR Unlicense",
      "upstream": "https://github.com/BurntSushi/ripgrep",
      "configured_path_env": "EVIDENCE_LANE_RG_EXECUTABLE",
      "configured_sha256_env": "EVIDENCE_LANE_RG_SHA256",
      "fallback_backend": "PYTHON_BOUNDED_LITERAL_SCAN",
      "package_binaries": {
        "windows-x86_64": {
          "path": "toolchains/bin/windows-x86_64/rg.exe",
          "sha256": "14231169855EC5205CF5A1B6F1DB358FF4AED4247C86B69CE8AAE647C77F6680",
          "size_bytes": 4218880,
          "provenance": "WinGet BurntSushi.ripgrep.MSVC 15.2.0; package bytes independently hash-verified",
          "licenses": [
            "toolchains/licenses/ripgrep-15.2.0/LICENSE-MIT",
            "toolchains/licenses/ripgrep-15.2.0/UNLICENSE"
          ]
        }
      }
    }
  ]
}
