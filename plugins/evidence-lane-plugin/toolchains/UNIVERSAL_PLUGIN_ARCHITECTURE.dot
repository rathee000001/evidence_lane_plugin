digraph universal_plugin_architecture {
  // EVIDENCE_LANE_GRAPH_ENGINE=PYTHON_GRAPHVIZ
  // PYTHON_GRAPHVIZ_VERSION=0.21
  bgcolor=white compound=true fontname=Arial newrank=true nodesep=0.35 rankdir=TB ranksep=0.65 splines=polyline
  node [color="#667085" fontname=Arial shape=box style="rounded,filled"]
  edge [color="#667085" fontname=Arial]
  subgraph cluster_operating_cycle {
    label="Operating cycle + Delta lifecycle" rankdir=TB
    INTENT [label="User intent / prompt / steer" color="#101828" fillcolor="#101828" fontcolor=white shape=box style="rounded,filled"]
    BOOT [label="Boot or resume exact runtime identity" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    FLASH [label="Locked ENV15/UOP15 Flash" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    STATE_TRAVEL [label="User-timed State Travel" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    SOURCE_INTAKE [label="Source Intake and exact source identity" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    RECIPE [label="Project Recipe" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    MODE [label="Ordered Mode intersections" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    PLAN_GOAL [label="Canonical Plan + Goal" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    DELTA_ENTRY [label="Governed Delta entry" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    ATOMIC_WORK [label="Atomic implementation or analysis work" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    MID_DELTA [label="Mid-Delta evidence / steer / failure" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    DELTA_EXIT [label="Verified Delta exit" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    REFRESH [label="Changed-hash authority refresh + CAS reuse" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    CANDIDATE [label="Unaccepted candidate when required" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    HIL [label="Owning HIL presentation only" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    FUSE [label="Exact approved Fuse" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    ROLLBACK [label="Governed logical Rollback" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    EXIT_BOOT [label="Explicit Exit Boot" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
    NEXT [label="Next Delta or next-task State Travel" color="#ba4236" fillcolor="#fff1f0" shape=box style="rounded,filled"]
  }
  subgraph cluster_execution_stack {
    label="Typed skill/action execution stack" rankdir=TB
    SKILL [label="Governed skill + 127 current ordered workflow steps" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    ACTION [label="Typed public/internal action (91 current registry rows)" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    SCHEMA [label="Input/output schema and current route contract" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    INTERNAL_SDK [label="Internal SDK execution owner" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    ENV [label="ENV15 environment, host, lane, locality, availability and grant" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    UOP [label="UOP15 operators, formulas, work/privacy/disclosure/HIL gates" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    AUTHORITY_RESOLVE [label="Owning lane or named/root authority" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TOOL_RESOLVE [label="Conditional tool role and ordered primary/fallback" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    OUTER_SDK [label="Outer SDK local or transport route" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    FASTMCP [label="FastMCP composition when compatible" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    NATIVE_MCP [label="Pinned native MCP compatibility transport" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    DOMAIN_MCP [label="Purpose-bound domain MCP server" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    VALIDATE [label="Schema, result, authority and HIL-effect validation" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    RECEIPT [label="Exact input/route/result/provenance receipt" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_hosts {
    label="Codex host variants" rankdir=TB
    HOST_STABLE_CODEX [label="Stable Codex" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOST_CODEX_BETA [label="Codex Beta" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOST_CODEX_CLI [label=CODEX_CLI color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOST_CODEX_VM [label=CODEX_VM color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_lanes {
    label="Current project sector lanes" rankdir=TB
    LANE_GITHUB_CODE [label=github_code color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_LOCAL_CODE [label=local_code color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_CHAT_LINEAGE [label=chat_lineage color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_DISCUSSION [label=discussion color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_ANALYSIS [label=analysis color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_PLAN [label=plan color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_MODE [label=mode color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_DOCS [label=docs color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_DATA_EXCEL [label=data_excel color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_PPT [label=ppt color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_PDF_OCR [label=pdf_ocr color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_IMAGES_OCR [label=images_ocr color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_ARTIFACTS [label=artifacts color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_CUSTOM [label=custom color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_BRAIN_LOADER [label=brain_loader color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_RESEARCH [label=research color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_PROJECT_ENGULF [label=project_engulf color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    LANE_SQLITE_BRAIN [label=sqlite_brain color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_authorities {
    label="Named and root authorities" rankdir=TB
    AUTH_AGENT_LEARNING [label=agent_learning color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    AUTH_CANON_INPUT [label=canon_input color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    AUTH_PROJECT_MEMORY [label=project_memory color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    AUTH_PROJECT_OVERLAY [label=project_overlay color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    AUTH_SOURCE_AUTHORITY [label=source_authority color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    AUTH_PROJECT_UNIVERSE [label=project_universe color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    AUTH_CONNECTOR_BRAIN [label=connector_brain color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    AUTH_PROJECT_AUTHORITY [label=project_authority color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    AUTH_RECEIPT_LEDGER [label=receipt_ledger color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    AUTH_SESSION_AUTHORITY [label=session_authority color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    AUTH_INSTRUCTIONS [label=instructions color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_memory {
    label="Separate memory roles" rankdir=TB
    MEMORY_SENSORY_LIVE_CAPTURE [label="sensory live capture" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MEMORY_TASK_WORKING_CONTEXT [label="task working context" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MEMORY_EPISODIC_CHAT_LINEAGE [label="episodic chat lineage" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MEMORY_SEMANTIC_PROJECT_MEMORY [label="semantic project memory" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MEMORY_ACCEPTED_LEARNING [label="accepted learning" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MEMORY_CANON_AND_PROJECT_TRUTH [label="canon and project truth" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    MEMORY_HOST_INSTRUCTIONS_AND_RECALL [label="host instructions and recall" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_tool_roles {
    label="Conditional tool role classes" rankdir=TB
    TOOLS_TASK_EXECUTION [label="Task Execution: 82 current rows" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TOOLS_TRANSPORT_OR_ORCHESTRATION [label="Transport Or Orchestration: 12 current rows" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TOOLS_OBSERVABILITY_OR_EVALUATION_ATTACHMENT [label="Observability Or Evaluation Attachment: 8 current rows" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    TOOLS_EXTERNAL_SERVICE_OR_STORE [label="External Service Or Store: 17 current rows" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_hook_timing {
    label="Codex host hook timing" rankdir=TB
    HOOK_SESSIONSTART [label="SessionStart: SESSION_ENTRY_BEFORE_VISIBLE_INPUT" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOOK_SUBAGENTSTART [label="SubagentStart: OPTIONAL_SUBAGENT_ENTRY_OBSERVATION" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOOK_USERPROMPTSUBMIT [label="UserPromptSubmit: BEFORE_MODEL_REASONING_AND_TOOL_SELECTION" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOOK_PRETOOLUSE [label="PreToolUse: AFTER_ACTION_SELECTION_BEFORE_TOOL_EXECUTION" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    HOOK_PERMISSIONREQUEST [label="PermissionRequest: OPTIONAL_BETWEEN_PRETOOL_AND_TOOL_EXECUTION" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOOK_POSTTOOLUSE [label="PostToolUse: AFTER_TOOL_RESULT_BEFORE_NEXT_ACTION" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOOK_PRECOMPACT [label="PreCompact: BEFORE_CONTEXT_COMPACTION" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOOK_POSTCOMPACT [label="PostCompact: AFTER_CONTEXT_COMPACTION_BEFORE_NEXT_ACTION" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOOK_SUBAGENTSTOP [label="SubagentStop: OPTIONAL_SUBAGENT_EXIT_OBSERVATION" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
    HOOK_STOP [label="Stop: AFTER_VISIBLE_RESPONSE_BEFORE_NEXT_TURN" color="#c88722" fillcolor="#fff7e7" shape=box style="rounded,filled"]
    HOOK_SESSIONEND [label="SessionEnd: BEST_EFFORT_AFTER_SESSION_END" color="#7147c7" fillcolor="#f0ebff" shape=box style="rounded,filled"]
  }
  subgraph cluster_round_trip {
    label="Generated round-trip proof" rankdir=TB
    REGISTRIES [label="Executable registries" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    GENERATED_GRAPH [label="Generated MMD + DOT" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    PARSED_GRAPH [label="Strict parser round trip" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    SQLITE_GRAPH [label="Owning SQLite topology" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
    REGENERATED_GRAPH [label="Regenerated graph + hash equality" color="#667085" fillcolor="#f7f9fc" shape=box style="rounded,filled"]
  }
  INTENT -> BOOT
  BOOT -> FLASH
  FLASH -> STATE_TRAVEL
  STATE_TRAVEL -> SOURCE_INTAKE
  SOURCE_INTAKE -> RECIPE
  RECIPE -> MODE
  MODE -> PLAN_GOAL
  PLAN_GOAL -> DELTA_ENTRY
  DELTA_ENTRY -> ATOMIC_WORK
  ATOMIC_WORK -> MID_DELTA
  MID_DELTA -> DELTA_EXIT
  DELTA_EXIT -> REFRESH
  REFRESH -> CANDIDATE
  CANDIDATE -> HIL
  MID_DELTA -> ATOMIC_WORK [label="continue bounded work" style=dashed]
  HIL -> FUSE [label="exact approval" style=dashed]
  HIL -> ROLLBACK [label="rollback decision" style=dashed]
  HIL -> NEXT [label="retain/research/reject/fail" style=dashed]
  FUSE -> NEXT
  ROLLBACK -> NEXT
  NEXT -> DELTA_ENTRY [label="next Delta" style=dashed]
  NEXT -> STATE_TRAVEL [label="next task" style=dashed]
  NEXT -> EXIT_BOOT [label="explicit close" style=dashed]
  SKILL -> ACTION
  ACTION -> SCHEMA
  SCHEMA -> INTERNAL_SDK
  INTERNAL_SDK -> ENV
  ENV -> UOP
  UOP -> AUTHORITY_RESOLVE
  AUTHORITY_RESOLVE -> TOOL_RESOLVE
  OUTER_SDK -> FASTMCP [label="composition selected" style=dashed]
  OUTER_SDK -> NATIVE_MCP [label="compatibility required" style=dashed]
  OUTER_SDK -> AUTHORITY_RESOLVE [label="package-local" style=dashed]
  FASTMCP -> DOMAIN_MCP [style=dashed]
  NATIVE_MCP -> DOMAIN_MCP [style=dashed]
  HOOK_SESSIONSTART -> INTENT [label="session entry" style=dashed]
  HOOK_SUBAGENTSTART -> SKILL [label="optional observation" style=dashed]
  HOOK_USERPROMPTSUBMIT -> SKILL [label="prepare entry" style=dashed]
  TOOL_RESOLVE -> HOOK_PRETOOLUSE [label="prospective boundary"]
  HOOK_PRETOOLUSE -> HOOK_PERMISSIONREQUEST [label="permission requested" style=dashed]
  HOOK_PRETOOLUSE -> OUTER_SDK [label=execute style=dashed]
  HOOK_PERMISSIONREQUEST -> OUTER_SDK [label=observed style=dashed]
  DOMAIN_MCP -> HOOK_POSTTOOLUSE [label="tool result"]
  AUTHORITY_RESOLVE -> HOOK_POSTTOOLUSE [label="local result"]
  HOOK_POSTTOOLUSE -> VALIDATE [label="receipt projection"]
  RECEIPT -> HOOK_PRECOMPACT [label="compaction requested" style=dashed]
  HOOK_PRECOMPACT -> HOOK_POSTCOMPACT [label="host compacts" style=dashed]
  HOOK_POSTCOMPACT -> SKILL [label=reentry style=dashed]
  HOOK_SUBAGENTSTOP -> RECEIPT [label="optional observation" style=dashed]
  RECEIPT -> HOOK_STOP [label="visible response stops"]
  HOOK_STOP -> HOOK_SESSIONEND [label="session closes" style=dashed]
  VALIDATE -> RECEIPT
  INTENT -> SKILL
  RECEIPT -> MID_DELTA [label="work evidence"]
  RECEIPT -> DELTA_EXIT [label="exit evidence" style=dashed]
  REFRESH -> AUTHORITY_RESOLVE
  HOST_STABLE_CODEX -> SKILL
  HOST_CODEX_BETA -> SKILL
  HOST_CODEX_CLI -> SKILL
  HOST_CODEX_VM -> SKILL
  AUTHORITY_RESOLVE -> LANE_GITHUB_CODE
